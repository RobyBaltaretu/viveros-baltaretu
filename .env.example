# Variables de BUILD. En Cloudflare se definen en:
# Workers & Pages → (Worker) → Settings → Build → Variables and secrets.
# En local, copia este archivo a .env si las necesitas. Ninguna es secreta.

# URL pública con https:// y sin barra final (canonical y hreflang). Obligatoria en Workers Builds.
SITE_URL=

# Proyecto de Keystatic Cloud con el formato "equipo/proyecto".
# `npm run panel:local` la ignora y edita los archivos locales.
PUBLIC_KEYSTATIC_CLOUD_PROJECT=

# Clave de sitio (pública) del widget de Turnstile.
PUBLIC_TURNSTILE_SITE_KEY=

# Rama de producción si no es `main` (para la regla de fichas sin revisar).
# PRODUCTION_BRANCH=main
