# Variables de runtime del Worker para `npm run preview` (copia este archivo a .dev.vars).
# En producción se definen en Cloudflare: Workers & Pages → (Worker) → Settings → Variables & Secrets.
# .dev.vars está en .gitignore: nunca subas claves reales al repositorio.

# Clave secreta de prueba oficial de Turnstile (siempre valida). En producción, la de tu widget.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Dirección verificada en Email Routing que recibe los avisos de presupuesto.
EMAIL_DESTINO=
# Remitente del dominio con Email Routing, p. ej. presupuestos@tudominio.es
EMAIL_REMITENTE=

# Panel propio. Token largo (mínimo 32 caracteres) para el build, la importación y las copias.
# Genera uno con: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
CONTENIDO_TOKEN=

# Asistente (opcional): clave gratuita de Groq. En Baltaretu, respaldo de Workers AI; en Turia, el modelo principal (orden en cliente.config.json, `ia.asistente`).
# Se crea en https://console.groq.com sin tarjeta. Sin ella, el asistente usa solo Workers AI y las reglas locales.
GROQ_API_KEY=

# Simulador de reformas (solo clientes con `ia.simulador: "gemini"`, hoy Creaciones Turia): clave de pago de Gemini
# (Google AI Studio). Nunca se envía desde el navegador. Tope duro en D1: `ia.simulacionesMes` (250 ≈ 10 € al mes).
GEMINI_API_KEY=
