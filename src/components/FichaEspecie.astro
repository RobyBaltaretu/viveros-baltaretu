---
/**
 * Ficha de especie: comparador de escala, tabla de medidas, precio "desde",
 * galería (o marcador de foto) y botón para añadir a la lista de presupuesto.
 */
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { migas, producto } from '../lib/seo/datos-estructurados';
import BaseLayout from '../layouts/BaseLayout.astro';
import TarjetaEspecie from './catalogo/TarjetaEspecie.astro';
import BotonLista from './ficha/BotonLista.astro';
import ComparadorEscala from './ficha/ComparadorEscala.astro';
import { siluetaDe } from './ilustraciones/siluetas';
import Boton from './ui/Boton.astro';
import Contenedor from './ui/Contenedor.astro';
import FotoOPlaceholder from './ui/FotoOPlaceholder.astro';
import Seccion from './ui/Seccion.astro';
import { disponibilidades, familias, formatos, rutaFamilia, rutaFicha, rutas, textos, type Idioma } from '../i18n/ui';
import { obtenerEspecies } from '../lib/catalogo';
import { obtenerCondiciones } from '../lib/condiciones';
import { formatearImporte, formatearPrecio, formatearRango } from '../lib/catalogo/formato';

interface Props {
  idioma: Idioma;
  especie: CollectionEntry<'catalogo'>;
}

const { idioma, especie } = Astro.props;
const condiciones = await obtenerCondiciones();
const { data } = especie;
const t = textos[idioma];
const nombre = data.nombre[idioma];
const [principal, ...resto] = data.fotos;
const relacionadas = (await obtenerEspecies(idioma))
  .filter((e) => e.data.familia === data.familia && e.data.slug !== data.slug)
  .slice(0, 3);

const abs = (ruta: string) => new URL(ruta, Astro.site).href;
const url = abs(rutaFicha(idioma, data.slug));
// La foto principal, si existe, también es la imagen al compartir en redes.
const imagenSocial = principal ? (await getImage({ src: principal.imagen, width: 1200, format: 'jpg' })).src : undefined;
const datos = [
  producto({
    nombre,
    nombreCientifico: data.nombreCientifico,
    descripcion: data.descripcion[idioma],
    url,
    categoria: familias[data.familia][idioma],
    precioDesde: data.precioDesde,
    disponibilidad: data.disponibilidad,
    imagen: imagenSocial && abs(imagenSocial),
  }),
  migas([
    { nombre: t.catalogo, url: abs(rutas.catalogo[idioma]) },
    { nombre: familias[data.familia][idioma], url: abs(rutaFamilia(idioma, data.familia)) },
    { nombre, url },
  ]),
];

const medidas: [string, string][] = [
  [t.nombreCientifico, data.nombreCientifico],
  [t.altura, formatearRango(data.alturaMin, data.alturaMax, 'm', idioma)],
  ...(data.perimetroTroncoCm
    ? [[t.perimetroTronco, formatearRango(data.perimetroTroncoCm[0], data.perimetroTroncoCm[1], 'cm', idioma)] as [string, string]]
    : []),
  [t.formatos, data.formatos.map((f) => formatos[f][idioma]).join(', ')],
  [t.disponibilidad, disponibilidades[data.disponibilidad][idioma]],
  [t.filtroCompra, data.ventaUnitaria ? t.compraMayorYUnidad : t.compraMayor],
  [t.origen, data.origen],
  [t.precio, formatearPrecio(data.precioDesde, data.unidadPrecio, idioma)],
  ...(data.ventaUnitaria && data.precioUnidad != null
    ? [[t.precioPorUnidad, `${formatearImporte(data.precioUnidad, idioma)} ${t.masEnvio}`] as [string, string]]
    : []),
];
---

<BaseLayout
  idioma={idioma}
  titulo={data.seo[idioma].titulo}
  descripcion={data.seo[idioma].descripcion}
  alternativas={{ es: rutaFicha('es', data.slug), en: rutaFicha('en', data.slug) }}
  datosEstructurados={datos}
  imagenSocial={imagenSocial}
  mensajeWhatsapp={t.whatsappEspecie.replace('{nombre}', nombre).replace('{cientifico}', data.nombreCientifico)}
>
  <Seccion espacio="ninguno" class="pt-8 pb-16 sm:pt-12 sm:pb-20">
    <Contenedor>
      <nav aria-label={t.migas}>
        <ol class="flex flex-wrap items-center gap-2 text-sm text-gris">
          <li><a href={rutas.catalogo[idioma]} class="inline-flex min-h-6 items-center underline-offset-4 hover:text-oliva hover:underline">{t.catalogo}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={rutaFamilia(idioma, data.familia)} class="inline-flex min-h-6 items-center underline-offset-4 hover:text-oliva hover:underline">{familias[data.familia][idioma]}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-tinta">{nombre}</li>
        </ol>
      </nav>

      {!data.revisado && <p class="mt-6 rounded-tarjeta border border-terracota bg-papel p-4 text-sm font-medium text-terracota">{t.avisoNoRevisado}</p>}

      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-16">
        <div class="grid min-w-0 content-start gap-4">
          <FotoOPlaceholder
            foto={principal && { imagen: principal.imagen, alt: principal.alt[idioma] }}
            pendiente={nombre}
            silueta={siluetaDe(data)}
            proporcion="4 / 3"
            prioridad
            sizes="(min-width: 1024px) 50vw, 100vw"
          />
          {
            resto.length > 0 && (
              <ul class="grid grid-cols-3 gap-4">
                {resto.map((foto) => (
                  <li>
                    <FotoOPlaceholder
                      foto={{ imagen: foto.imagen, alt: foto.alt[idioma] }}
                      pendiente={nombre}
                      silueta={siluetaDe(data)}
                      proporcion="1 / 1"
                      sizes="(min-width: 1024px) 16vw, 33vw"
                    />
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="min-w-0">
          {data.ventaUnitaria && <p class="inline-flex rounded-full bg-verdor px-3 py-1 text-sm font-semibold text-oliva">{t.ventaUnitaria}</p>}
          <h1 class="titular-gigante mt-4">{nombre}</h1>
          <p class="mt-2 italic text-gris">{data.nombreCientifico}</p>
          <p class="mt-6 texto-entrada">{data.descripcion[idioma]}</p>

          <dl class="mt-8 grid gap-4 rounded-panel border border-linea bg-papel p-6 sm:grid-cols-2">
            <div>
              <dt class="text-sm font-semibold text-gris">{t.precioMayor}</dt>
              <dd class="mt-1 font-titular text-2xl font-bold">{formatearPrecio(data.precioDesde, data.unidadPrecio, idioma)}</dd>
            </div>
            {
              data.ventaUnitaria && data.precioUnidad != null && (
                <div>
                  <dt class="text-sm font-semibold text-gris">{t.precioPorUnidad}</dt>
                  <dd class="mt-1 font-titular text-2xl font-bold">
                    {formatearImporte(data.precioUnidad, idioma)} <span class="text-base font-medium text-gris">{t.masEnvio}</span>
                  </dd>
                </div>
              )
            }
          </dl>
          {
            data.ventaUnitaria && (
              <p class="mt-3 text-sm text-gris">
                {t.ventaUnitariaDetalle} {condiciones.envioUnidad[idioma]}
              </p>
            )
          }

          <div class="mt-8 flex flex-wrap gap-3" data-acciones-ficha>
            <BotonLista idioma={idioma} slug={data.slug} nombre={nombre} />
            <Boton href={rutas.presupuesto[idioma]} tamano="grande" variante="secundario">{t.pedirPresupuesto}</Boton>
          </div>
        </div>
      </div>
    </Contenedor>
  </Seccion>

  <Seccion tono="papel">
    <Contenedor class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
      <div class="min-w-0">
        <h2 class="titular-grande">{t.medidasTitulo}</h2>
        <table class="mt-8 w-full border-collapse text-left">
          <caption class="sr-only">{t.medidasTitulo}: {nombre}</caption>
          <tbody>
            {
              medidas.map(([etiqueta, valor]) => (
                <tr class="border-b border-linea">
                  <th scope="row" class="w-2/5 py-4 pr-4 align-top font-medium text-gris">{etiqueta}</th>
                  <td class="py-4 align-top font-semibold">{valor}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <ComparadorEscala
        idioma={idioma}
        nombre={nombre}
        silueta={siluetaDe(data)}
        alturaMin={data.alturaMin}
        alturaMax={data.alturaMax}
      />
    </Contenedor>
  </Seccion>

  {
    relacionadas.length > 0 && (
      <Seccion>
        <Contenedor>
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="titular-grande">{t.masDeLaFamilia.replace('{familia}', familias[data.familia][idioma].toLowerCase())}</h2>
            <a href={rutaFamilia(idioma, data.familia)} class="font-semibold underline underline-offset-4 hover:text-terracota">
              {familias[data.familia][idioma]}
            </a>
          </div>
          <ul class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {relacionadas.map((e) => (
              <TarjetaEspecie especie={e} idioma={idioma} />
            ))}
          </ul>
        </Contenedor>
      </Seccion>
    )
  }
          {
            data.disponibilidad !== 'agotado' && (
              <div class="barra-ficha solo-js lg:hidden" data-barra-ficha hidden>
                <p class="min-w-0 leading-tight">
                  <span class="block truncate text-sm text-gris">{nombre}</span>
                  <span class="font-semibold">{formatearPrecio(data.precioDesde, data.unidadPrecio, idioma)}</span>
                </p>
                <BotonLista idioma={idioma} slug={data.slug} nombre={nombre} compacto />
              </div>
            )
          }
</BaseLayout>

<style>
  .barra-ficha {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 25;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 1rem max(0.625rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-linea);
    background: color-mix(in oklab, var(--color-papel) 94%, transparent);
    backdrop-filter: blur(10px);
  }
  .barra-ficha[hidden] {
    display: none;
  }
  /* Con la barra a la vista, el botón de WhatsApp sube para no taparla. */
  :global(body:has([data-barra-ficha]:not([hidden])) .boton-whatsapp) {
    bottom: 5.5rem;
  }
</style>

<script>
  // En el móvil, cuando los botones principales salen de la pantalla, aparece la barra fija con «Añadir».
  const barra = document.querySelector<HTMLElement>('[data-barra-ficha]');
  const acciones = document.querySelector('[data-acciones-ficha]');
  if (barra && acciones) {
    let pendiente = false;
    const revisar = () => {
      pendiente = false;
      barra.hidden = acciones.getBoundingClientRect().bottom > 0;
    };
    addEventListener('scroll', () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(revisar);
      }
    }, { passive: true });
    revisar();
  }
</script>
