---
// Provisional con el sistema de diseño: la ficha completa (comparador de escala, lista de presupuesto) llega en el bloque 4.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SILUETA_POR_FAMILIA } from './ilustraciones/siluetas';
import Contenedor from './ui/Contenedor.astro';
import FotoOPlaceholder from './ui/FotoOPlaceholder.astro';
import Seccion from './ui/Seccion.astro';
import { disponibilidades, familias, formatos, rutaFicha, rutas, textos, type Idioma } from '../i18n/ui';
import { formatearPrecio, formatearRango } from '../lib/catalogo/formato';

interface Props {
  idioma: Idioma;
  especie: CollectionEntry<'catalogo'>;
}

const { idioma, especie } = Astro.props;
const { data } = especie;
const t = textos[idioma];
const fotoPrincipal = data.fotos[0];
---

<BaseLayout
  idioma={idioma}
  titulo={data.seo[idioma].titulo}
  descripcion={data.seo[idioma].descripcion}
  alternativas={{ es: rutaFicha('es', data.slug), en: rutaFicha('en', data.slug) }}
>
  <Seccion>
    <Contenedor class="grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        {!data.revisado && <p class="mb-6 rounded-2xl border border-lima p-4 text-lima">{t.avisoNoRevisado}</p>}
        <h1 class="titular-grande">{data.nombre[idioma]}</h1>
        <p class="mt-3 texto-entrada italic text-salvia">{data.nombreCientifico}</p>
        <p class="mt-6 titular-medio text-lima">{formatearPrecio(data.precioDesde, data.unidadPrecio, idioma)}</p>
        <p class="mt-6 max-w-prose texto-entrada">{data.descripcion[idioma]}</p>

        <dl class="mt-10 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-3 border-t border-linea-oscura pt-6">
          <dt class="text-salvia">{t.familia}</dt>
          <dd>{familias[data.familia][idioma]}</dd>
          <dt class="text-salvia">{t.altura}</dt>
          <dd>{formatearRango(data.alturaMin, data.alturaMax, 'm', idioma)}</dd>
          {
            data.perimetroTroncoCm && (
              <>
                <dt class="text-salvia">{t.perimetroTronco}</dt>
                <dd>{formatearRango(data.perimetroTroncoCm[0], data.perimetroTroncoCm[1], 'cm', idioma)}</dd>
              </>
            )
          }
          <dt class="text-salvia">{t.formatos}</dt>
          <dd>{data.formatos.map((f) => formatos[f][idioma]).join(', ')}</dd>
          <dt class="text-salvia">{t.disponibilidad}</dt>
          <dd>{disponibilidades[data.disponibilidad][idioma]}</dd>
          <dt class="text-salvia">{t.origen}</dt>
          <dd>{data.origen}</dd>
        </dl>

        <p class="mt-10"><a href={rutas.catalogo[idioma]} class="font-semibold underline underline-offset-4 hover:text-lima">{t.volverAlCatalogo}</a></p>
      </div>

      <div class="grid gap-4">
        <FotoOPlaceholder
          foto={fotoPrincipal && { imagen: fotoPrincipal.imagen, alt: fotoPrincipal.alt[idioma] }}
          pendiente={data.nombre[idioma]}
          silueta={SILUETA_POR_FAMILIA[data.familia]}
          prioridad
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
        {
          data.fotos.length > 1 && (
            <ul class="grid grid-cols-2 gap-4">
              {data.fotos.slice(1).map((foto) => (
                <li>
                  <FotoOPlaceholder
                    foto={{ imagen: foto.imagen, alt: foto.alt[idioma] }}
                    pendiente={data.nombre[idioma]}
                    silueta={SILUETA_POR_FAMILIA[data.familia]}
                    proporcion="1 / 1"
                    sizes="(min-width: 1024px) 25vw, 50vw"
                  />
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </Contenedor>
  </Seccion>
</BaseLayout>
