---
/**
 * Siluetas botánicas propias. Cada dibujo apoya en el borde inferior del viewBox
 * (el suelo) y ocupa toda su altura, para poder escalarlo con exactitud en el
 * comparador de escala: altura del SVG = altura real de la planta.
 *
 * Colores: `currentColor` para el follaje y `--tono-tronco` para tronco y tallos.
 * Las hojas van en grupos `.hoja` (balanceo CSS en global.css, desactivado con
 * prefers-reduced-motion).
 */
import type { HTMLAttributes } from 'astro/types';
import { PROPORCION, type TipoSilueta } from './siluetas';

interface Props extends Omit<HTMLAttributes<'svg'>, 'viewBox'> {
  tipo: TipoSilueta;
  /** Si se indica, la silueta se anuncia como imagen con este texto; si no, es decorativa. */
  titulo?: string;
  /** Desactiva el balanceo (p. ej. en miniaturas). */
  quieta?: boolean;
}

const { tipo, titulo, quieta = false, class: clase, ...resto } = Astro.props;

const { ancho, alto } = PROPORCION[tipo];
const hoja = quieta ? '' : 'hoja';

// Hoja de palmera / cica apuntando a la derecha con la base en (0,0).
const frondaPalmera = 'M0 0 C18 -17 46 -18 68 9 C46 -3 21 -3 0 5 Z';
const frondaCica = 'M0 0 C14 -7 38 -9 62 -3 C40 1 18 3 0 4 Z';
const angulosPalmera = [-58, -26, 6, 34];
const angulosCica = [-62, -38, -14, 8];
---

<svg
  viewBox={`0 0 ${ancho} ${alto}`}
  xmlns="http://www.w3.org/2000/svg"
  class:list={['silueta', `silueta-${tipo}`, clase]}
  role={titulo ? 'img' : undefined}
  aria-label={titulo}
  aria-hidden={titulo ? undefined : 'true'}
  focusable="false"
  {...resto}
>
  {
    tipo === 'palmera' && (
      <>
        <path
          fill="var(--tono-tronco, currentColor)"
          d="M72 260 C73 205 75 135 77 66 L85 66 C85 135 86 205 90 260 Z"
        />
        <g fill="none" stroke="var(--color-fondo-silueta, transparent)" stroke-width="1.4" opacity="0.6">
          <path d="M74 236 q7 -4 14 0 M74 206 q6 -4 13 0 M75 176 q6 -4 12 0 M76 146 q5 -3 10 0 M76 116 q5 -3 9 0 M77 88 q4 -3 8 0" />
        </g>
        {angulosPalmera.map((a, i) => (
          <g transform={`translate(81 64) rotate(${a})`}>
            <g class={hoja} style={`--retraso-hoja:-${i * 1.3}s`}>
              <path fill="currentColor" d={frondaPalmera} />
            </g>
          </g>
        ))}
        {angulosPalmera.map((a, i) => (
          <g transform={`translate(81 64) scale(-1 1) rotate(${a})`}>
            <g class={hoja} style={`--retraso-hoja:-${i * 1.1 + 0.6}s`}>
              <path fill="currentColor" d={frondaPalmera} />
            </g>
          </g>
        ))}
        <g transform="translate(81 64) rotate(-92)">
          <g class={hoja} style="--retraso-hoja:-2s">
            <path fill="currentColor" d="M0 0 C10 -10 30 -10 46 4 C30 -1 14 -1 0 4 Z" />
          </g>
        </g>
      </>
    )
  }
  {
    tipo === 'cica' && (
      <>
        <path fill="var(--tono-tronco, currentColor)" d="M72 110 L73 92 C76 87 84 87 87 92 L88 110 Z" />
        {angulosCica.map((a, i) => (
          <g transform={`translate(81 90) rotate(${a})`}>
            <g class={hoja} style={`--retraso-hoja:-${i * 1.4}s; --duracion-hoja: 9s`}>
              <path fill="currentColor" d={frondaCica} />
            </g>
          </g>
        ))}
        {angulosCica.map((a, i) => (
          <g transform={`translate(79 90) scale(-1 1) rotate(${a})`}>
            <g class={hoja} style={`--retraso-hoja:-${i * 1.2 + 0.7}s; --duracion-hoja: 9s`}>
              <path fill="currentColor" d={frondaCica} />
            </g>
          </g>
        ))}
        <g transform="translate(80 88) rotate(-90)">
          <g class={hoja} style="--duracion-hoja: 9s">
            <path fill="currentColor" d="M0 0 C12 -6 32 -7 52 -2 C34 1 16 3 0 4 Z" />
          </g>
        </g>
      </>
    )
  }
  {
    tipo === 'olivo' && (
      <>
        <path
          fill="var(--tono-tronco, currentColor)"
          d="M74 220 C68 196 84 178 76 158 C71 145 60 136 54 118 L62 115 C68 130 76 138 82 148 C85 134 94 122 106 112 L111 118 C100 128 93 142 92 158 C91 180 100 198 96 220 Z"
        />
        <g class={hoja} style="--origen-hoja: 50% 100%; --duracion-hoja: 9s">
          <g fill="currentColor">
            <ellipse cx="52" cy="92" rx="34" ry="24" />
            <ellipse cx="88" cy="66" rx="40" ry="30" />
            <ellipse cx="124" cy="92" rx="34" ry="24" />
            <ellipse cx="86" cy="104" rx="30" ry="18" />
            <ellipse cx="24" cy="108" rx="18" ry="12" />
            <ellipse cx="150" cy="110" rx="16" ry="11" />
            <ellipse cx="96" cy="36" rx="22" ry="16" />
          </g>
        </g>
      </>
    )
  }
  {
    tipo === 'higuera' && (
      <>
        <path
          fill="var(--tono-tronco, currentColor)"
          d="M82 200 C85 172 80 150 66 128 L75 123 C84 136 89 146 92 156 C96 140 108 128 124 118 L128 125 C112 136 103 150 101 168 C100 180 101 190 104 200 Z"
        />
        <g class={hoja} style="--origen-hoja: 50% 100%; --duracion-hoja: 8s">
          <g fill="currentColor">
            <circle cx="46" cy="104" r="32" />
            <circle cx="88" cy="74" r="40" />
            <circle cx="134" cy="84" r="38" />
            <circle cx="164" cy="112" r="22" />
            <circle cx="104" cy="114" r="30" />
            <circle cx="20" cy="124" r="18" />
            <circle cx="116" cy="40" r="24" />
          </g>
        </g>
      </>
    )
  }
  {
    tipo === 'persona' && (
      <g fill="currentColor">
        <circle cx="28" cy="11.5" r="11" />
        <path d="M15 27 C20 24 36 24 41 27 C46 30 48 40 49 52 L52 94 L45 95 L41 57 L40 102 L38 180 L30 180 L28.5 110 L27 180 L19 180 L17 102 L16 57 L12 95 L5 94 L8 52 C9 40 10 30 15 27 Z" />
      </g>
    )
  }
</svg>

<style>
  /* En la capa base para que las utilidades de Tailwind (p. ej. `hidden`) puedan sobrescribirlo. */
  @layer base {
    .silueta {
      display: block;
      overflow: visible;
    }
  }
</style>
