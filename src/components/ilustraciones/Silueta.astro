---
/**
 * Alzados botánicos a línea, como en un plano de paisajismo. Cada dibujo apoya en
 * el borde inferior del viewBox (el suelo) y ocupa toda su altura, para poder
 * escalarlo con exactitud: altura del SVG = altura real de la planta.
 *
 * - Trazo: `currentColor`, siempre del mismo grosor (vector-effect), sea cual sea el tamaño.
 * - Las copas se rellenan con `--fondo-dibujo` (el color de la superficie) para tapar
 *   lo que queda detrás, como en un dibujo a tinta.
 * - Las hojas van en grupos `.hoja` (balanceo CSS en global.css, desactivado con
 *   prefers-reduced-motion). Dentro de `.trazar`, los trazos se dibujan al cargar.
 */
import type { HTMLAttributes } from 'astro/types';
import { nuevoIdSilueta, PROPORCION, type TipoSilueta } from './siluetas';

interface Props extends Omit<HTMLAttributes<'svg'>, 'viewBox'> {
  tipo: TipoSilueta;
  /** Si se indica, la silueta se anuncia como imagen con este texto; si no, es decorativa. */
  titulo?: string;
  /** Desactiva el balanceo (p. ej. en miniaturas). */
  quieta?: boolean;
  /** Versión simplificada (sin textura de hojas) para tamaños pequeños. */
  simple?: boolean;
  /** Prepara los trazos para dibujarse al cargar (dentro de `.trazar`). */
  trazable?: boolean;
}

const { tipo, titulo, quieta = false, simple = false, trazable = false, class: clase, ...resto } = Astro.props;

const { ancho, alto } = PROPORCION[tipo];
const hoja = quieta ? '' : 'hoja';
const r = (n: number) => Math.round(n * 10) / 10;

// Generador pseudoaleatorio con semilla: el dibujo es siempre el mismo en cada build.
function aleatorio(semilla: number) {
  let s = semilla;
  return () => {
    s = (s * 16807) % 2147483647;
    return (s - 1) / 2147483646;
  };
}

/**
 * Fronda pinnada (palmera, cica) apuntando a la derecha desde (0,0): contorno de
 * pluma, nervio central curvo y foliolos inclinados hacia la punta.
 */
function fronda(largo: number, caida: number, anchura: number, paso = 0.08) {
  const c = { x: largo * 0.45, y: -largo * 0.32 };
  const f = { x: largo, y: caida };
  const punto = (t: number) => ({ x: 2 * (1 - t) * t * c.x + t ** 2 * f.x, y: 2 * (1 - t) * t * c.y + t ** 2 * f.y });
  const unitaria = (t: number) => {
    const x = 2 * (1 - t) * c.x + 2 * t * (f.x - c.x);
    const y = 2 * (1 - t) * c.y + 2 * t * (f.y - c.y);
    const m = Math.hypot(x, y) || 1;
    return { x: x / m, y: y / m };
  };
  // Semiancho de la pluma: crece rápido y se afila hacia la punta.
  const semiancho = (t: number) => anchura * Math.sin(Math.PI * Math.min(1, t ** 0.75));
  const borde = (t: number, lado: number) => {
    const p = punto(t);
    const u = unitaria(t);
    const h = semiancho(t) * lado;
    return { x: p.x - u.y * h, y: p.y + u.x * h };
  };
  const nervio = `M0 0 Q${r(c.x)} ${r(c.y)} ${r(f.x)} ${r(f.y)}`;
  if (simple) return nervio;
  const pasos = Array.from({ length: 19 }, (_, i) => i / 18);
  const arriba = pasos.map((t) => borde(t, -1));
  const abajo = pasos.map((t) => borde(t, 1)).reverse();
  let d = `${nervio} M${[...arriba, ...abajo].map((q) => `${r(q.x)} ${r(q.y)}`).join(' L')} Z`;
  for (let t = 0.1; t < 0.94; t += paso) {
    const p = punto(t);
    for (const lado of [-1, 1]) {
      // El foliolo llega al borde algo más adelante, como en una pluma.
      const q = borde(Math.min(1, t + paso * 0.9), lado);
      d += ` M${r(p.x)} ${r(p.y)} L${r(q.x)} ${r(q.y)}`;
    }
  }
  return d;
}

/** Copa de nube (olivo, higuera): círculos rellenos con el fondo, de atrás adelante. */
type Lobulo = [cx: number, cy: number, radio: number];
function texturaCopa(lobulos: Lobulo[], semilla: number, marca: (x: number, y: number, a: number) => string, cantidad: number) {
  if (simple) return '';
  const azar = aleatorio(semilla);
  let d = '';
  for (let i = 0; i < cantidad; i++) {
    const [cx, cy, rad] = lobulos[Math.floor(azar() * lobulos.length)]!;
    const a = azar() * Math.PI * 2;
    const dist = Math.sqrt(azar()) * rad * 0.72;
    d += marca(cx + Math.cos(a) * dist, cy + Math.sin(a) * dist, azar());
  }
  return d;
}

const anillosPalmera = Array.from({ length: 22 }, (_, i) => {
  const y = 250 - i * 8.6;
  const t = (260 - y) / 196;
  const izq = 72 + t * 5 - 0.5;
  const der = 90 - t * 5 + 0.5;
  return `M${r(izq)} ${r(y)} q${r((der - izq) / 2)} ${i % 2 ? 2.4 : 1.6} ${r(der - izq)} 0`;
}).join(' ');
const angulosPalmera = [-64, -40, -16, 8, 30, 52];
const frondaPalmera = fronda(80, 34, 7, 0.07);
const frondaPalmeraAlta = fronda(56, -8, 6, 0.08);

const angulosCica = [-58, -36, -14, 6, 24];
const frondaCica = fronda(66, 4, 6, 0.07);

const lobulosOlivo: Lobulo[] = [
  [96, 34, 20], [60, 56, 24], [124, 60, 26], [88, 66, 32], [36, 86, 22],
  [146, 92, 22], [56, 96, 28], [118, 98, 28], [86, 104, 22], [18, 106, 14], [160, 112, 13],
];
const lobulosHiguera: Lobulo[] = [
  [116, 40, 24], [76, 64, 34], [140, 74, 34], [104, 80, 36], [40, 98, 30],
  [166, 106, 22], [72, 110, 30], [124, 114, 30], [20, 122, 17], [100, 124, 22],
];
const troncoOlivo =
  'M74 220 C68 196 84 178 76 158 C71 145 60 136 54 118 L62 115 C68 130 76 138 82 148 C85 134 94 122 106 112 L111 118 C100 128 93 142 92 158 C91 180 100 198 96 220 Z';
const troncoHiguera =
  'M82 200 C85 172 80 150 66 128 L75 123 C84 136 89 146 92 156 C96 140 108 128 124 118 L128 125 C112 136 103 150 101 168 C100 180 101 190 104 200 Z';
const marcasOlivo = texturaCopa(
  lobulosOlivo,
  7,
  (x, y, k) => ` M${r(x)} ${r(y)} l${r(3 + k * 2)} ${r(-1 - k)}`,
  70,
);
const marcasHiguera = texturaCopa(
  lobulosHiguera,
  11,
  (x, y) => ` M${r(x - 3)} ${r(y - 2)} q3 4 6 0`,
  44,
);

// Atributos comunes en un grupo; aquí solo lo que cambia. pathLength solo hace falta para trazar.
const largo = trazable ? { pathLength: 1 } : {};
const fino = { ...largo, 'stroke-width': 0.9, opacity: 0.75 } as const;
const tapa = { ...largo, fill: 'var(--fondo-dibujo, transparent)' } as const;
const contorno = { ...largo, 'stroke-width': 2.5 } as const;
// Las frondas se definen una vez y se reutilizan con <use>.
const id = nuevoIdSilueta();
---

<svg
  viewBox={`0 0 ${ancho} ${alto}`}
  xmlns="http://www.w3.org/2000/svg"
  class:list={['silueta', `silueta-${tipo}`, clase]}
  role={titulo ? 'img' : undefined}
  aria-label={titulo}
  aria-hidden={titulo ? undefined : 'true'}
  focusable="false"
  {...resto}
>
  <g fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
    {
      tipo === 'palmera' && (
        // Las frondas sobresalen del tronco: se desplaza el dibujo para que quepan en el viewBox.
        <g transform="translate(6 0)">
          <defs>
            <path id={`${id}-f`} d={frondaPalmera} {...largo} />
            <path id={`${id}-a`} d={frondaPalmeraAlta} {...largo} />
          </defs>
          <path {...tapa} d="M72 260 C73 205 75 135 77 66 L85 66 C85 135 86 205 90 260 Z" />
          {!simple && <path {...fino} d={anillosPalmera} style="--retraso-trazo: 0.3s" />}
          {angulosPalmera.flatMap((a, i) => [
            [`translate(81 66) rotate(${a})`, i * 1.3, 0.6 + i * 0.08],
            [`translate(81 66) scale(-1 1) rotate(${a})`, i * 1.1 + 0.6, 0.64 + i * 0.08],
          ]).map(([transformacion, retraso, trazo]) => (
            <g transform={String(transformacion)}>
              <g class={hoja} style={`--retraso-hoja:-${retraso}s`}>
                <use href={`#${id}-f`} style={`--retraso-trazo: ${trazo}s`} />
              </g>
            </g>
          ))}
          {[-104, -76].map((a, i) => (
            <g transform={`translate(81 66) rotate(${a})`}>
              <g class={hoja} style={`--retraso-hoja:-${i * 1.7}s`}>
                <use href={`#${id}-a`} style={`--retraso-trazo: ${1.1 + i * 0.1}s`} />
              </g>
            </g>
          ))}
        </g>
      )
    }
    {
      tipo === 'cica' && (
        <>
          <defs>
            <path id={`${id}-f`} d={frondaCica} {...largo} />
          </defs>
          <path {...tapa} d="M71 110 L72 90 C76 84 84 84 88 90 L89 110 Z" />
          {!simple && <path {...fino} d="M73 104 l14 -8 M73 97 l14 -8 M74 108 l14 -8 M73 98 l14 8 M73 91 l14 8" />}
          {angulosCica.flatMap((a, i) => [
            [`translate(81 88) rotate(${a})`, i * 1.4, 0.4 + i * 0.08],
            [`translate(79 88) scale(-1 1) rotate(${a})`, i * 1.2 + 0.7, 0.44 + i * 0.08],
          ]).map(([transformacion, retraso, trazo]) => (
            <g transform={String(transformacion)}>
              <g class={hoja} style={`--retraso-hoja:-${retraso}s; --duracion-hoja: 9s`}>
                <use href={`#${id}-f`} style={`--retraso-trazo: ${trazo}s`} />
              </g>
            </g>
          ))}
          <g transform="translate(80 86) rotate(-90)">
            <g class={hoja} style="--duracion-hoja: 9s">
              <path {...largo} d={fronda(52, 0, 5, 0.08)} style="--retraso-trazo: 0.9s" />
            </g>
          </g>
        </>
      )
    }
    {
      (tipo === 'olivo' || tipo === 'higuera') && (
        <>
          <path {...tapa} d={tipo === 'olivo' ? troncoOlivo : troncoHiguera} />
          {!simple && tipo === 'olivo' && (
            <path {...fino} d="M80 214 C76 196 88 182 82 164 M88 212 C86 196 94 184 90 168 M84 150 C80 140 72 134 66 124" style="--retraso-trazo: 0.3s" />
          )}
          <g class={hoja} style={`--origen-hoja: 50% 100%; --duracion-hoja: ${tipo === 'olivo' ? 9 : 8}s`}>
            {/* Contorno de la copa: trazo doble y relleno encima, así solo queda la silueta exterior. */}
            {(tipo === 'olivo' ? lobulosOlivo : lobulosHiguera).map(([cx, cy, rad], i) => (
              <circle {...contorno} cx={cx} cy={cy} r={rad} style={`--retraso-trazo: ${0.5 + i * 0.07}s`} />
            ))}
            <g stroke="none" fill="var(--fondo-dibujo, transparent)">
              {(tipo === 'olivo' ? lobulosOlivo : lobulosHiguera).map(([cx, cy, rad]) => (
                <circle cx={cx} cy={cy} r={rad} style="--retraso-trazo: 0.6s" />
              ))}
            </g>
            {!simple && <path {...fino} d={tipo === 'olivo' ? marcasOlivo : marcasHiguera} style="--retraso-trazo: 1.2s" />}
          </g>
        </>
      )
    }
  </g>
  {
    tipo === 'persona' && (
      <g fill="currentColor">
        <circle cx="28" cy="11.5" r="11" />
        <path d="M15 27 C20 24 36 24 41 27 C46 30 48 40 49 52 L52 94 L45 95 L41 57 L40 102 L38 180 L30 180 L28.5 110 L27 180 L19 180 L17 102 L16 57 L12 95 L5 94 L8 52 C9 40 10 30 15 27 Z" />
      </g>
    )
  }
</svg>

<style>
  /* En la capa base para que las utilidades de Tailwind (p. ej. `hidden`) puedan sobrescribirlo. */
  @layer base {
    .silueta {
      display: block;
      overflow: visible;
    }
    /* Mismo grosor de trazo a cualquier tamaño (no se hereda: va en cada elemento). */
    .silueta :is(path, circle) {
      vector-effect: non-scaling-stroke;
    }
  }
</style>
