---
// Provisional hasta el bloque 5 (lista de presupuesto y formulario con Turnstile).
import BaseLayout from '../layouts/BaseLayout.astro';
import Contenedor from './ui/Contenedor.astro';
import Seccion from './ui/Seccion.astro';
import { rutas, textos, type Idioma } from '../i18n/ui';
import { esPlaceholder, obtenerEmpresa } from '../lib/empresa';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const empresa = await obtenerEmpresa();
const contactos = [
  { etiqueta: t.email, valor: empresa.email, enlace: esPlaceholder(empresa.email) ? undefined : `mailto:${empresa.email}` },
  {
    etiqueta: t.telefono,
    valor: empresa.telefono,
    enlace: esPlaceholder(empresa.telefono) ? undefined : `tel:${empresa.telefono.replace(/[^\d+]/g, '')}`,
  },
].filter((c) => c.valor);
---

<BaseLayout
  idioma={idioma}
  titulo={`${t.presupuestoTitulo} | ${empresa.nombre}`}
  descripcion={t.presupuestoProvisional}
  alternativas={rutas.presupuesto}
>
  <Seccion espacio="amplio">
    <Contenedor ancho="estrecho">
      <h1 class="titular-grande">{t.presupuestoTitulo}</h1>
      <p class="mt-6 texto-entrada text-salvia">{t.presupuestoProvisional}</p>
      <dl class="mt-10 grid gap-6">
        {
          contactos.map((c) => (
            <div>
              <dt class="antetitulo text-salvia">{c.etiqueta}</dt>
              <dd class="titular-medio mt-2 break-words">
                {c.enlace ? <a href={c.enlace} class="underline decoration-lima underline-offset-4">{c.valor}</a> : c.valor}
              </dd>
            </div>
          ))
        }
      </dl>
    </Contenedor>
  </Seccion>
</BaseLayout>
