---
/**
 * Sección de página con superficie clara u oscura. Las secciones se separan por
 * el cambio de superficie y, opcionalmente, por una línea fina (`filete`), como
 * las láminas de un plano.
 */
import type { HTMLAttributes } from 'astro/types';

type Tono = 'oscuro' | 'medio' | 'claro';
type Props = HTMLAttributes<'section'> & {
  tono?: Tono;
  /** Línea fina en el borde superior. */
  filete?: boolean;
  /** Relleno vertical. */
  espacio?: 'normal' | 'amplio' | 'ninguno';
  /** Elemento HTML (p. ej. `footer` para el pie, que debe ser hijo directo de body). */
  como?: 'section' | 'footer' | 'div';
};

const { tono = 'oscuro', filete = false, espacio = 'normal', como: Elemento = 'section', class: clase, ...resto } = Astro.props;
const superficie = { oscuro: 'superficie-oscura', medio: 'superficie-media', claro: 'superficie-clara' }[tono];
const espacios = { normal: 'py-20 sm:py-28', amplio: 'py-28 sm:py-40', ninguno: '' }[espacio];
---

<Elemento class:list={['relative', superficie, espacios, filete && 'border-t border-(--color-linea)', clase]} {...resto}>
  <slot />
</Elemento>
