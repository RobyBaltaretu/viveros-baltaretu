---
/**
 * Botón o enlace con aspecto de botón. El color del principal se adapta a la
 * superficie: lima sobre oscuro, bosque sobre claro (ver --boton-fondo).
 */
import type { HTMLAttributes } from 'astro/types';

type Variante = 'principal' | 'secundario' | 'texto';
type Comun = { variante?: Variante; tamano?: 'normal' | 'grande'; flecha?: boolean };
type Props = Comun & HTMLAttributes<'a'> & Pick<HTMLAttributes<'button'>, 'type' | 'disabled' | 'name' | 'value'>;

const { variante = 'principal', tamano = 'normal', flecha = false, class: clase, ...resto } = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-3 rounded-tarjeta font-semibold leading-none tracking-[0.01em] transition-[background-color,color,translate,scale,box-shadow,border-color] duration-300 ease-(--ease-suave) active:scale-[0.97] active:duration-100 disabled:cursor-not-allowed disabled:opacity-60';
const tamanos = { normal: 'min-h-12 px-5 text-base', grande: 'min-h-15 px-7 text-lg' };
const variantes = {
  principal:
    'bg-(--boton-fondo) text-(--boton-texto) hover:-translate-y-0.5 hover:shadow-[0_14px_34px_-14px_var(--boton-fondo)]',
  secundario: 'border border-current/60 hover:border-current hover:bg-current/8',
  texto: 'min-h-0 px-0 underline decoration-2 underline-offset-4 hover:decoration-(--color-acento)',
};
const clases = [base, variante !== 'texto' && tamanos[tamano], variantes[variante], clase];
const FLECHA =
  '<svg class="size-5 transition-transform duration-300 ease-(--ease-suave) group-hover:translate-x-1" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M11.3 4.3a1 1 0 0 1 1.4 0l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.4-1.4l3.3-3.3H3a1 1 0 1 1 0-2h11.6l-3.3-3.3a1 1 0 0 1 0-1.4Z"/></svg>';
---

{
  resto.href ? (
    <a class:list={clases} {...resto}>
      <slot />
      {flecha && <Fragment set:html={FLECHA} />}
    </a>
  ) : (
    <button class:list={clases} {...(resto as HTMLAttributes<'button'>)}>
      <slot />
      {flecha && <Fragment set:html={FLECHA} />}
    </button>
  )
}
