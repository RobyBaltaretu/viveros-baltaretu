---
/**
 * Muestra una foto real optimizada (AVIF/WebP, tamaños adaptables, dimensiones
 * fijas) o, mientras no haya fotos, una silueta con el rótulo "[FOTO: …]". Ambas
 * ocupan exactamente el mismo hueco, así que las fotos entran sin rediseñar.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Silueta from '../ilustraciones/Silueta.astro';
import type { TipoSilueta } from '../ilustraciones/siluetas';

interface Props {
  foto?: { imagen: ImageMetadata; alt: string } | undefined;
  /** Descripción de la foto que falta, sin corchetes (se muestra como "[FOTO: …]"). */
  pendiente: string;
  silueta: Exclude<TipoSilueta, 'persona'>;
  /** Relación de aspecto CSS, p. ej. "4 / 5". */
  proporcion?: string;
  /** Para la imagen principal de la página (LCP): carga inmediata y prioridad alta. */
  prioridad?: boolean;
  sizes?: string;
  class?: string;
}

const {
  foto,
  pendiente,
  silueta,
  proporcion = '4 / 5',
  prioridad = false,
  sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  class: clase,
} = Astro.props;
---

<figure
  class:list={['relative overflow-hidden rounded-tarjeta', !foto && 'superficie-media cuadricula border border-linea-oscura [--paso-cuadricula:1.5rem]', clase]}
  style={`aspect-ratio: ${proporcion}`}
>
  {
    foto ? (
      <Picture
        src={foto.imagen}
        alt={foto.alt}
        formats={['avif', 'webp']}
        widths={[400, 640, 960, 1280]}
        sizes={sizes}
        loading={prioridad ? 'eager' : 'lazy'}
        fetchpriority={prioridad ? 'high' : 'auto'}
        class="size-full object-cover"
      />
    ) : (
      <div class="flex size-full flex-col items-center justify-end gap-4 p-6">
        <Silueta tipo={silueta} quieta class="h-[68%] w-auto max-w-full text-texto" />
        <figcaption class="rotulo text-center text-salvia normal-case">[FOTO: {pendiente}]</figcaption>
      </div>
    )
  }
</figure>
