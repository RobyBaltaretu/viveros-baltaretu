---
/**
 * Tarjeta de especie del catálogo: foto (o dibujo), nombre, altura y precio.
 * Los atributos data-* permiten filtrarla en el navegador sin volver a
 * renderizar (ver FiltrosCatalogo).
 */
import type { CollectionEntry } from 'astro:content';
import { siluetaDe } from '../ilustraciones/siluetas';
import FotoOPlaceholder from '../ui/FotoOPlaceholder.astro';
import { disponibilidades, rutaFicha, textos, type Idioma } from '../../i18n/ui';
import { formatearImporte, formatearPrecio, formatearRango } from '../../lib/catalogo/formato';

interface Props {
  especie: CollectionEntry<'catalogo'>;
  idioma: Idioma;
  prioridad?: boolean;
}

const { especie, idioma, prioridad = false } = Astro.props;
const { data } = especie;
const t = textos[idioma];
const foto = data.fotos[0];
---

<li
  class="tarjeta-especie group relative flex flex-col rounded-panel border border-linea bg-papel p-3 transition-[border-color,translate,box-shadow] duration-300 ease-(--ease-suave) hover:border-oliva"
  data-familia={data.familia}
  data-altura-min={data.alturaMin}
  data-altura-max={data.alturaMax}
  data-formatos={data.formatos.join(',')}
  data-perimetro={data.perimetroTroncoCm?.join('-')}
  data-unidad={data.ventaUnitaria ? '1' : undefined}
>
  <div class="relative">
    <FotoOPlaceholder
      foto={foto && { imagen: foto.imagen, alt: foto.alt[idioma] }}
      pendiente={data.nombre[idioma]}
      silueta={siluetaDe(data)}
      prioridad={prioridad}
      proporcion="4 / 3"
      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
    />
    {
      data.ventaUnitaria && (
        <span class="absolute top-3 left-3 rounded-full bg-papel px-3 py-1 text-sm font-semibold text-oliva shadow-sm">
          {t.ventaUnitaria}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col px-2 pt-4 pb-2">
    <h3 class="titular-medio">
      <a href={rutaFicha(idioma, data.slug)} class="subrayado-hover after:absolute after:inset-0 after:rounded-panel">
        {data.nombre[idioma]}
      </a>
    </h3>
    <p class="mt-1 text-gris">
      {t.alturaEjemplar}: {formatearRango(data.alturaMin, data.alturaMax, 'm', idioma)}
      {data.disponibilidad === 'agotado' && <> · {disponibilidades.agotado[idioma]}</>}
    </p>
    <p class="mt-auto pt-4 font-semibold">
      {formatearPrecio(data.precioDesde, data.unidadPrecio, idioma)}
      {
        data.ventaUnitaria && data.precioUnidad != null && (
          <span class="block text-sm font-normal text-gris">
            {t.porUnidadDesde.replace('{precio}', formatearImporte(data.precioUnidad, idioma))}
          </span>
        )
      }
    </p>
  </div>
</li>
