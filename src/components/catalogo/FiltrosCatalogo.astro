---
/**
 * Filtros del catálogo. Filtro principal: la regla de altura (dos controles
 * deslizantes sobre una regla en metros). Además: familia, formato y perímetro.
 * Sin JavaScript no se muestran (clase `solo-js`) y se ven todas las especies.
 */
import { FORMATOS } from '../../lib/catalogo/schema';
import type { Familia } from '../../lib/catalogo/tipos';
import { familias, formatos, textos, type Idioma } from '../../i18n/ui';

interface Props {
  idioma: Idioma;
  alturaMaxima: number;
  /** id de la lista de tarjetas y del mensaje de "sin resultados". */
  idLista: string;
  idVacio: string;
  /** En las páginas de familia no se muestra el filtro de familia. */
  familiaFija?: Familia;
  /** Familias presentes, para no ofrecer opciones vacías. */
  familiasDisponibles: Familia[];
}

const { idioma, alturaMaxima, idLista, idVacio, familiaFija, familiasDisponibles } = Astro.props;
const t = textos[idioma];
const formato = new Intl.NumberFormat(idioma === 'es' ? 'es-ES' : 'en-GB', { maximumFractionDigits: 1 });
const pasoEtiquetas = alturaMaxima > 12 ? 2 : 1;
const marcas = Array.from({ length: Math.floor(alturaMaxima / pasoEtiquetas) + 1 }, (_, i) => i * pasoEtiquetas);
const perimetros = [
  ['', t.cualquiera],
  ['hasta-30', t.perimetroHasta30],
  ['30-80', t.perimetro30a80],
  ['mas-80', t.perimetroMas80],
] as const;
const textosScript = {
  rango: t.rangoAltura,
  cualquiera: t.cualquierAltura,
  resultados: t.resultados,
  resultadosUno: t.resultadosUno,
  locale: idioma === 'es' ? 'es-ES' : 'en-GB',
};
const chip =
  'inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-linea-oscura px-4 text-sm font-medium transition-colors hover:border-lima has-[:checked]:border-lima has-[:checked]:bg-lima has-[:checked]:text-bosque has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-3 has-[:focus-visible]:outline-lima';
---

<filtros-catalogo
  class="solo-js block"
  data-altura-maxima={alturaMaxima}
  data-lista={idLista}
  data-vacio={idVacio}
  data-familia-fija={familiaFija}
  data-textos={JSON.stringify(textosScript)}
>
  <form class="grid gap-10" aria-label={t.eligePorTamano}>
    <fieldset class="regla rounded-(--radius-amplio) border border-linea-oscura bg-superficie p-6 sm:p-8">
      <legend class="sr-only">{t.eligePorTamano}</legend>
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <p class="antetitulo text-salvia" aria-hidden="true">{t.eligePorTamano}</p>
        <p class="titular-grande text-lima" data-texto-rango aria-hidden="true">{t.cualquierAltura}</p>
      </div>

      <div class="regla-pista relative mt-8 h-10">
        <div class="absolute inset-x-0 top-1/2 h-2 -translate-y-1/2 rounded-full bg-linea-oscura"></div>
        <div class="banda absolute top-1/2 h-2 -translate-y-1/2 rounded-full bg-lima"></div>
        <label for={`${idLista}-altura-min`} class="sr-only">{t.alturaMinima}</label>
        <input id={`${idLista}-altura-min`} name="altura-min" type="range" min="0" max={alturaMaxima} step="0.5" value="0" />
        <label for={`${idLista}-altura-max`} class="sr-only">{t.alturaMaxima}</label>
        <input id={`${idLista}-altura-max`} name="altura-max" type="range" min="0" max={alturaMaxima} step="0.5" value={alturaMaxima} />
      </div>
      <div class="relative mx-3.5 mt-3 h-8" aria-hidden="true">
        {
          marcas.map((m) => (
            <span class="absolute top-0 flex -translate-x-1/2 flex-col items-center" style={`left: ${(m / alturaMaxima) * 100}%`}>
              <span class="h-2 w-px bg-salvia" />
              <span class="mt-1 whitespace-nowrap text-xs tabular-nums text-salvia">{formato.format(m)} m</span>
            </span>
          ))
        }
      </div>
    </fieldset>

    <div class="grid gap-8 lg:grid-cols-3">
      {
        !familiaFija && (
          <fieldset>
            <legend class="antetitulo text-salvia">{t.filtroFamilia}</legend>
            <div class="mt-4 flex flex-wrap gap-2">
              {familiasDisponibles.map((f) => (
                <label class={chip}>
                  <input type="checkbox" name="familia" value={f} class="size-4 accent-bosque" />
                  {familias[f][idioma]}
                </label>
              ))}
            </div>
          </fieldset>
        )
      }
      <fieldset>
        <legend class="antetitulo text-salvia">{t.filtroFormato}</legend>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            FORMATOS.map((f) => (
              <label class={chip}>
                <input type="checkbox" name="formato" value={f} class="size-4 accent-bosque" />
                {formatos[f][idioma]}
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset>
        <legend class="antetitulo text-salvia">{t.filtroPerimetro}</legend>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            perimetros.map(([valor, etiqueta]) => (
              <label class={chip}>
                <input type="radio" name="perimetro" value={valor} checked={valor === ''} class="size-4 accent-bosque" />
                {etiqueta}
              </label>
            ))
          }
        </div>
      </fieldset>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-linea-oscura pt-6">
      <p class="font-semibold" data-resultados aria-live="polite"></p>
      <button type="reset" class="font-semibold underline underline-offset-4 hover:text-lima">{t.borrarFiltros}</button>
    </div>
  </form>
</filtros-catalogo>

<style>
  /* Dos controles deslizantes superpuestos: solo los tiradores reciben el puntero. */
  .regla-pista input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    background: none;
    pointer-events: none;
    appearance: none;
  }
  .regla-pista input[type='range']::-webkit-slider-thumb {
    appearance: none;
    pointer-events: auto;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background: var(--color-lima);
    border: 4px solid var(--color-bosque);
    box-shadow: 0 0 0 2px var(--color-lima);
    cursor: grab;
  }
  .regla-pista input[type='range']::-moz-range-thumb {
    pointer-events: auto;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    background: var(--color-lima);
    border: 4px solid var(--color-bosque);
    box-shadow: 0 0 0 2px var(--color-lima);
    cursor: grab;
  }
  .regla-pista input[type='range']:focus-visible {
    outline: none;
  }
  .regla-pista input[type='range']:focus-visible::-webkit-slider-thumb {
    outline: 3px solid var(--color-texto);
    outline-offset: 3px;
  }
  .regla-pista input[type='range']:focus-visible::-moz-range-thumb {
    outline: 3px solid var(--color-texto);
    outline-offset: 3px;
  }
  /* La banda va de un tirador al otro (0,875 rem = medio tirador a cada lado). */
  .banda {
    left: calc(0.875rem + (100% - 1.75rem) * var(--desde-n, 0));
    right: calc(0.875rem + (100% - 1.75rem) * (1 - var(--hasta-n, 1)));
  }
</style>

<script>
  import {
    SIN_FILTROS,
    cumpleFiltros,
    escribirFiltros,
    leerFiltros,
    type EstadoFiltros,
    type RangoPerimetro,
  } from '../../lib/catalogo/filtros';
  import type { Familia, Formato } from '../../lib/catalogo/tipos';

  class FiltrosCatalogo extends HTMLElement {
    connectedCallback() {
      const maxima = Number(this.dataset.alturaMaxima);
      const textos = JSON.parse(this.dataset.textos ?? '{}') as Record<string, string>;
      const form = this.querySelector('form');
      const lista = document.getElementById(this.dataset.lista ?? '');
      const vacio = document.getElementById(this.dataset.vacio ?? '');
      const pista = this.querySelector<HTMLElement>('.regla-pista');
      const textoRango = this.querySelector<HTMLElement>('[data-texto-rango]');
      const resultados = this.querySelector<HTMLElement>('[data-resultados]');
      if (!form || !lista || !pista || !textoRango || !resultados) return;
      const min = form.elements.namedItem('altura-min') as HTMLInputElement;
      const max = form.elements.namedItem('altura-max') as HTMLInputElement;
      const tarjetas = [...lista.querySelectorAll<HTMLElement>('.tarjeta-especie')];
      const numero = new Intl.NumberFormat(textos.locale, { maximumFractionDigits: 1 });
      const marcados = (nombre: string) =>
        [...form.querySelectorAll<HTMLInputElement>(`input[name="${nombre}"]:checked`)].map((i) => i.value);

      const leer = (): EstadoFiltros => {
        const desde = Number(min.value);
        const hasta = Number(max.value);
        const perimetro = marcados('perimetro')[0];
        return {
          altura: desde === 0 && hasta === maxima ? null : [desde, hasta],
          familias: marcados('familia') as Familia[],
          formatos: marcados('formato') as Formato[],
          perimetro: perimetro ? (perimetro as RangoPerimetro) : null,
        };
      };

      const escribir = (e: EstadoFiltros) => {
        min.value = String(e.altura?.[0] ?? 0);
        max.value = String(e.altura?.[1] ?? maxima);
        for (const i of form.querySelectorAll<HTMLInputElement>('input[type="checkbox"], input[type="radio"]')) {
          if (i.name === 'familia') i.checked = e.familias.includes(i.value as Familia);
          if (i.name === 'formato') i.checked = e.formatos.includes(i.value as Formato);
          if (i.name === 'perimetro') i.checked = i.value === (e.perimetro ?? '');
        }
      };

      const pintar = (e: EstadoFiltros, actualizarUrl: boolean) => {
        const [desde, hasta] = e.altura ?? [0, maxima];
        pista.style.setProperty('--desde-n', String(desde / maxima));
        pista.style.setProperty('--hasta-n', String(hasta / maxima));
        min.setAttribute('aria-valuetext', `${numero.format(desde)} m`);
        max.setAttribute('aria-valuetext', `${numero.format(hasta)} m`);
        textoRango.textContent = e.altura
          ? textos.rango!.replace('{min}', numero.format(desde)).replace('{max}', numero.format(hasta))
          : textos.cualquiera!;

        let visibles = 0;
        for (const tarjeta of tarjetas) {
          const d = tarjeta.dataset;
          const perimetro = d.perimetro?.split('-').map(Number) as [number, number] | undefined;
          const cumple = cumpleFiltros(
            {
              familia: d.familia as Familia,
              alturaMin: Number(d.alturaMin),
              alturaMax: Number(d.alturaMax),
              formatos: (d.formatos ?? '').split(',') as Formato[],
              perimetro,
            },
            e,
          );
          tarjeta.hidden = !cumple;
          if (cumple) visibles++;
        }
        resultados.textContent =
          visibles === 1 ? textos.resultadosUno! : textos.resultados!.replace('{n}', String(visibles));
        if (vacio) vacio.hidden = visibles > 0;

        if (actualizarUrl) {
          const params = escribirFiltros(e);
          const url = `${location.pathname}${params.size ? `?${params}` : ''}${location.hash}`;
          history.replaceState(history.state, '', url);
        }
      };

      const inicial = leerFiltros(new URLSearchParams(location.search), maxima);
      if (this.dataset.familiaFija) inicial.familias = [];
      escribir(inicial);
      pintar(inicial, false);

      form.addEventListener('input', (evento) => {
        // Los tiradores no se cruzan: el que se mueve empuja al otro.
        if (evento.target === min && Number(min.value) > Number(max.value)) max.value = min.value;
        if (evento.target === max && Number(max.value) < Number(min.value)) min.value = max.value;
        pintar(leer(), true);
      });
      form.addEventListener('reset', (evento) => {
        evento.preventDefault();
        escribir(SIN_FILTROS);
        pintar(SIN_FILTROS, true);
      });
      form.addEventListener('submit', (evento) => evento.preventDefault());
    }
  }

  customElements.define('filtros-catalogo', FiltrosCatalogo);
</script>
