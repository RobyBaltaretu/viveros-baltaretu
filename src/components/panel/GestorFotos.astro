---
/** Subir y ordenar fotos (plantas y proyectos). Las acciones las procesa la página con formularioFotos. */
import { rutaDeImagen, type FotoFicha } from '../../server/panel/fotos.ts';

interface Props {
  fotos: FotoFicha[];
  /** Texto si no hay fotos. */
  vacio: string;
}
const { fotos, vacio } = Astro.props;
---

  <form method="post" enctype="multipart/form-data" class="mt-6 grid gap-4 rounded-panel border-2 border-linea bg-papel p-5" data-subir-foto>
    <input type="hidden" name="accion" value="subir" />
    <label for="foto" class="font-titular text-xl font-bold">Añadir una foto</label>
    <p id="foto-ayuda" class="text-gris">Al pulsar el botón de elegir archivo, el móvil te deja hacerla con la cámara o elegir una de la galería. Se recorta y se reduce sola para que cargue rápido.</p>
    <input id="foto" name="foto" type="file" accept="image/jpeg,image/png,image/webp,image/*" required aria-describedby="foto-ayuda" class="campo-panel" />
    <p><button class="boton-panel">Subir la foto</button></p>
    <p data-estado role="status" class="font-semibold"></p>
  </form>

  {fotos.length === 0 && <p class="mt-6">{vacio}</p>}
  <ol class="mt-6 grid gap-6" role="list">
    {
      fotos.map((f, i) => (
        <li class="grid gap-3 rounded-panel border-2 border-linea bg-papel p-4">
          <img src={`/api/panel/foto?ruta=${encodeURIComponent(rutaDeImagen(f.imagen))}`} alt={f.alt.es} class="aspect-[4/3] w-full rounded-tarjeta object-cover" loading="lazy" />
          {i === 0 && <p class="font-semibold text-oliva">Foto principal</p>}
          <form method="post" class="grid gap-3">
            <input type="hidden" name="accion" value="texto" />
            <input type="hidden" name="indice" value={i} />
            <label class="grid gap-1 font-semibold">
              Qué se ve en la foto
              <input class="campo-panel font-normal" name="alt.es" value={f.alt.es} maxlength="200" required />
            </label>
            <label class="grid gap-1 font-semibold">
              Lo mismo en inglés
              <input class="campo-panel font-normal" name="alt.en" value={f.alt.en} maxlength="200" required />
            </label>
            <p><button class="boton-panel boton-panel-secundario">Guardar el texto</button></p>
          </form>
          <div class="flex flex-wrap gap-3">
            {i > 0 && (
              <form method="post">
                <input type="hidden" name="accion" value="primera" />
                <input type="hidden" name="indice" value={i} />
                <button class="boton-panel boton-panel-secundario">Ponerla la primera</button>
              </form>
            )}
            <form method="post">
              <input type="hidden" name="accion" value="quitar" />
              <input type="hidden" name="indice" value={i} />
              <button class="boton-panel boton-panel-secundario">Quitar esta foto</button>
            </form>
          </div>
        </li>
      ))
    }
  </ol>

<script>
  // Antes de subir, la foto se reencuadra a 4:3 y se reduce a 1600 px de ancho en JPEG,
  // en el propio móvil. Sin JavaScript, el formulario envía la foto original.
  const form = document.querySelector<HTMLFormElement>('[data-subir-foto]');
  const estado = form?.querySelector<HTMLElement>('[data-estado]');
  form?.addEventListener('submit', async (evento) => {
    const entrada = form.querySelector<HTMLInputElement>('input[type=file]');
    const archivo = entrada?.files?.[0];
    if (!archivo || !('createImageBitmap' in window)) return;
    evento.preventDefault();
    const boton = form.querySelector('button');
    boton?.setAttribute('disabled', '');
    if (estado) estado.textContent = 'Preparando la foto…';
    try {
      const imagen = await createImageBitmap(archivo, { imageOrientation: 'from-image' });
      const proporcion = 4 / 3;
      let ancho = imagen.width;
      let alto = imagen.height;
      let x = 0;
      let y = 0;
      if (ancho / alto > proporcion) {
        ancho = Math.round(alto * proporcion);
        x = Math.round((imagen.width - ancho) / 2);
      } else {
        alto = Math.round(ancho / proporcion);
        y = Math.round((imagen.height - alto) / 2);
      }
      const escala = Math.min(1, 1600 / ancho);
      const lienzo = document.createElement('canvas');
      lienzo.width = Math.round(ancho * escala);
      lienzo.height = Math.round(alto * escala);
      lienzo.getContext('2d')?.drawImage(imagen, x, y, ancho, alto, 0, 0, lienzo.width, lienzo.height);
      const blob = await new Promise<Blob | null>((ok) => lienzo.toBlob(ok, 'image/jpeg', 0.82));
      if (!blob) throw new Error('sin imagen');
      const datos = new FormData();
      datos.set('accion', 'subir');
      datos.set('foto', blob, 'foto.jpg');
      if (estado) estado.textContent = 'Subiendo la foto…';
      const respuesta = await fetch(location.pathname, { method: 'POST', body: datos });
      // Sustituye la entrada del historial: ir atrás no vuelve al formulario enviado.
      location.replace(respuesta.url);
    } catch {
      // Si el navegador no puede prepararla, se envía tal cual.
      if (estado) estado.textContent = 'Subiendo la foto…';
      form.submit();
    }
  });
</script>
