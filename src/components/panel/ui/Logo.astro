---
/** Marca del panel: el monograma de Viveros Baltaretu con el nombre al lado (en public/: el build reescribe src/assets). */

interface Props {
  /** Solo el monograma. */
  compacto?: boolean;
}
const { compacto = false } = Astro.props;
---

<span class="logo-panel inline-flex items-center gap-3">
  <img src="/monograma.png" alt="" width="40" height="40" class="size-10 shrink-0" />
  {
    !compacto && (
      <span class="flex flex-col leading-tight">
        <span class="font-titular text-lg font-bold text-tinta">Baltaretu</span>
        <span class="text-sm text-gris">Panel del vivero</span>
      </span>
    )
  }
</span>
