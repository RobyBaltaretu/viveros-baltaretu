---
/**
 * Componente accesible de estado vacío para el panel de gestión.
 * Muestra icono temático, título semántico, descripción y Call To Action (CTA).
 */
import Icono from './Icono.astro';
import type { NombreIcono } from '../../../server/panel/iconos.ts';

interface Props {
  icono?: NombreIcono;
  titulo: string;
  descripcion?: string;
  cta?: {
    href: string;
    texto: string;
  };
  clase?: string;
}

const { icono = 'presupuestos', titulo, descripcion, cta, clase = '' } = Astro.props;
---

<div class:list={['estado-vacio caja-panel flex flex-col items-center justify-center p-8 text-center sm:p-12', clase]}>
  <div class="mb-4 grid size-16 place-items-center rounded-2xl bg-verdor text-oliva" aria-hidden="true">
    <Icono nombre={icono} clase="size-8" />
  </div>
  <h3 class="font-titular text-xl font-bold text-tinta">{titulo}</h3>
  {descripcion && <p class="mt-2 max-w-md text-base text-gris">{descripcion}</p>}
  {
    cta && (
      <a href={cta.href} class="boton-panel mt-6 min-h-[44px]">
        {cta.texto}
      </a>
    )
  }
</div>

<style>
  .estado-vacio {
    border: 1px dashed var(--color-linea);
    background: color-mix(in oklab, var(--color-papel) 80%, var(--color-crema));
  }
</style>
