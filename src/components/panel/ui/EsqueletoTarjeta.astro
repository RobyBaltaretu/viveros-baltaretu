---
/**
 * Componente esqueleto de carga accesible para el panel de gestión.
 */
interface Props {
  filas?: number;
  clase?: string;
}

const { filas = 3, clase = '' } = Astro.props;
---

<div class:list={['caja-panel animate-pulse p-4 sm:p-6', clase]} aria-hidden="true">
  <div class="h-6 w-1/3 rounded-lg bg-linea/60"></div>
  <div class="mt-4 space-y-3">
    {Array.from({ length: filas }).map(() => (
      <div class="h-12 w-full rounded-xl bg-linea/40"></div>
    ))}
  </div>
</div>
