---
/** Pantalla de aviso del panel (sin activar, sin acceso, sin permiso). */
import Ilustracion from './ui/Ilustracion.astro';

interface Props {
  titulo: string;
  texto: string;
}
const { titulo, texto } = Astro.props;
---

<section class="caja-panel grid justify-items-center gap-3 p-8 text-center">
  <Ilustracion escena="ayuda" clase="w-32" />
  <h1 class="titular-medio">{titulo}</h1>
  <p class="max-w-md text-gris">{texto}</p>
  <slot />
</section>
