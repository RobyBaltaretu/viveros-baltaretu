---
/** Pantalla de aviso del panel (sin activar, sin acceso, errores). */
interface Props {
  titulo: string;
  texto: string;
}
const { titulo, texto } = Astro.props;
---

<section class="rounded-panel border-2 border-linea bg-papel p-6">
  <h1 class="titular-medio">{titulo}</h1>
  <p class="mt-3">{texto}</p>
  <slot />
</section>
