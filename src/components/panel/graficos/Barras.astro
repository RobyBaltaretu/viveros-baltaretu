---
/**
 * Barras verticales agrupadas (por ejemplo, ingresos y gastos por mes). Un solo
 * eje en euros, barras finas con el extremo redondeado de 4 px, 2 px de aire
 * entre barras, rejilla discreta, leyenda arriba, nombre y valor de cada barra
 * al pasar por encima, y la tabla con los mismos datos debajo (la que se usa
 * con el teclado o un lector de pantalla).
 */
import { dinero } from '../../../server/facturas/importes.ts';

interface Props {
  titulo: string;
  /** Nombres cortos para el eje (por ejemplo «oct») y largos para la tabla y la ayuda («octubre de 2026»). */
  categorias: string[];
  nombres?: string[];
  series: { nombre: string; color: string; valores: number[] }[];
}
const { titulo, categorias, series, nombres = categorias } = Astro.props;

// Lienzo estrecho: en el móvil las letras se leen (unos 10 px) y en el ordenador no crecen de más (ancho máximo).
const ANCHO = 400;
const ALTO = 240;
const M = { arriba: 10, derecha: 4, abajo: 24, izquierda: 52 };
const ancho = ANCHO - M.izquierda - M.derecha;
const alto = ALTO - M.arriba - M.abajo;
const todos = series.flatMap((s) => s.valores);
const max = Math.max(...todos, 0);
const min = Math.min(...todos, 0);
// Escala "redonda": 1, 2 o 5 por potencia de 10.
const paso = (() => {
  const bruto = (max - min || 1) / 4;
  const p = 10 ** Math.floor(Math.log10(bruto));
  return [1, 2, 5, 10].map((k) => k * p).find((v) => v >= bruto) ?? bruto;
})();
const techo = Math.ceil(max / paso) * paso || paso;
const suelo = Math.floor(min / paso) * paso;
const y = (v: number) => M.arriba + ((techo - v) / (techo - suelo)) * alto;
const marcas = Array.from({ length: Math.round((techo - suelo) / paso) + 1 }, (_, i) => suelo + i * paso);
const grupo = ancho / categorias.length;
const hueco = 2;
const barra = Math.max(3, Math.min(12, (grupo * 0.7 - hueco * (series.length - 1)) / series.length));
const corto = (v: number) => (Math.abs(v) >= 1000 ? `${String(Math.round(v / 100) / 10).replace('.', ',')} mil` : String(Math.round(v)));
const id = `grafico-${titulo.replace(/\W+/g, '-').toLowerCase()}`;
/** Barra con el extremo de datos redondeado (4 px) y la base recta en el eje. */
const camino = (x: number, v: number) => {
  const y0 = y(0);
  const y1 = y(v);
  const h = Math.abs(y0 - y1);
  if (h < 0.5) return '';
  const r = Math.min(4, h, barra / 2);
  return v >= 0
    ? `M${x},${y0}V${y1 + r}Q${x},${y1} ${x + r},${y1}H${x + barra - r}Q${x + barra},${y1} ${x + barra},${y1 + r}V${y0}Z`
    : `M${x},${y0}V${y1 - r}Q${x},${y1} ${x + r},${y1}H${x + barra - r}Q${x + barra},${y1} ${x + barra},${y1 - r}V${y0}Z`;
};
---

<figure class="grafico grid gap-3" aria-labelledby={`${id}-titulo`}>
  <figcaption id={`${id}-titulo`} class="titular-medio">{titulo}</figcaption>
  <ul class="flex flex-wrap gap-4 text-base" role="list" aria-label="Leyenda">
    {
      series.map((s) => (
        <li class="flex items-center gap-2">
          <span class="inline-block size-3 rounded-sm" style={`background:${s.color}`} aria-hidden="true" />
          {s.nombre}
        </li>
      ))
    }
  </ul>
  <svg viewBox={`0 0 ${ANCHO} ${ALTO}`} class="h-auto w-full max-w-xl" role="img" aria-label={`${titulo}. Los datos están en la tabla de debajo.`}>
    {
      marcas.map((m) => (
        <g>
          <line x1={M.izquierda} x2={ANCHO - M.derecha} y1={y(m)} y2={y(m)} stroke={m === 0 ? 'var(--color-gris)' : 'var(--color-linea)'} stroke-width="1" />
          <text x={M.izquierda - 8} y={y(m) + 4} text-anchor="end" font-size="11" fill="var(--color-gris)">
            {corto(m)} €
          </text>
        </g>
      ))
    }
    {
      categorias.map((c, i) => {
        const x0 = M.izquierda + i * grupo + (grupo - (barra * series.length + hueco * (series.length - 1))) / 2;
        return (
          <g>
            {series.map((s, j) => {
              const v = s.valores[i] ?? 0;
              const x = x0 + j * (barra + hueco);
              return (
                <g class="marca">
                  <title>{`${nombres[i]} · ${s.nombre}: ${dinero(v)}`}</title>
                  <rect x={x - hueco} y={M.arriba} width={barra + hueco * 2} height={alto} fill="transparent" />
                  <path d={camino(x, v)} fill={s.color} />
                </g>
              );
            })}
            <text x={M.izquierda + i * grupo + grupo / 2} y={ALTO - 8} text-anchor="middle" font-size="11" fill="var(--color-gris)">
              {c}
            </text>
          </g>
        );
      })
    }
  </svg>
  <details class="rounded-tarjeta border-2 border-linea bg-papel p-3">
    <summary class="flex min-h-12 cursor-pointer items-center font-semibold">Ver los datos en una tabla</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-base">
        <thead>
          <tr>
            <th scope="col" class="py-1 text-left">Mes</th>
            {
              series.map((s) => (
                <th scope="col" class="py-1 text-right">
                  {s.nombre}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            categorias.map((c, i) => (
              <tr class="border-t border-linea">
                <th scope="row" class="py-1 text-left font-normal">
                  {nombres[i]}
                </th>
                {series.map((s) => (
                  <td class="py-1 text-right">{dinero(s.valores[i] ?? 0)}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .marca:hover path {
    opacity: 0.8;
  }
</style>
