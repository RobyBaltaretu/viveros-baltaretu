---
/**
 * Comparador de escala: la planta junto a una persona de 1,8 m, con un control
 * deslizante entre la altura mínima y la máxima de la ficha. Sin JavaScript se
 * muestra a su altura máxima y el control no aparece.
 */
import CintaMetrica from '../ui/CintaMetrica.astro';
import Silueta from '../ilustraciones/Silueta.astro';
import type { TipoSilueta } from '../ilustraciones/siluetas';
import { textos, type Idioma } from '../../i18n/ui';

interface Props {
  idioma: Idioma;
  nombre: string;
  silueta: Exclude<TipoSilueta, 'persona'>;
  alturaMin: number;
  alturaMax: number;
}

const { idioma, nombre, silueta, alturaMin, alturaMax } = Astro.props;
const t = textos[idioma];
const locale = idioma === 'es' ? 'es-ES' : 'en-GB';
const metros = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
const veces = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
const escena = Math.max(2, Math.ceil(alturaMax));
const paso = alturaMax - alturaMin > 4 ? 0.5 : 0.1;
const textoVeces = (m: number) => t.vecesPersona.replace('{n}', veces.format(m / 1.8));
const id = 'comparador-altura';
---

<comparador-escala
  class="block rounded-panel border border-linea-oscura bg-superficie p-6 sm:p-8"
  style={`--escena: ${escena}; --altura: ${alturaMax}`}
  data-locale={locale}
  data-veces={t.vecesPersona}
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h2 class="antetitulo text-salvia">{t.comparadorTitulo}</h2>
    <p class="titular-grande text-lima" aria-hidden="true"><span data-valor>{metros.format(alturaMax)}</span> m</p>
  </div>
  <p class="mt-1 text-right text-sm text-salvia" data-veces-texto aria-hidden="true">{textoVeces(alturaMax)}</p>

  <figure class="mt-6">
    <div
      class="cuadricula grid grid-cols-[3rem_auto_minmax(0,1fr)] items-end gap-x-[clamp(1rem,4vw,3rem)] border-b border-texto/50"
      style={`height: clamp(16rem, 52vh, 26rem); grid-template-rows: minmax(0, 1fr); --paso-cuadricula: calc(clamp(16rem, 52vh, 26rem) / ${escena})`}
    >
      <CintaMetrica alturaMax={escena} idioma={idioma} class="h-full text-salvia" />
      <div class="flex h-full flex-col justify-end">
        <Silueta tipo="persona" titulo={`${t.persona}, ${t.alturaPersona}`} class="w-auto text-lima" style={`height: ${(1.8 / escena) * 100}%`} />
      </div>
      <div class="flex h-full min-w-0 items-end justify-center">
        <Silueta
          tipo={silueta}
          class="planta w-auto max-w-full text-texto"
        />
      </div>
    </div>
    <figcaption class="sr-only" data-descripcion>
      {nombre}: {metros.format(alturaMax)} m, {textoVeces(alturaMax)}.
    </figcaption>
  </figure>

  {
    alturaMax > alturaMin && (
      <div class="solo-js mt-6">
        <label for={id} class="font-semibold">
          {t.alturaDelEjemplar}
        </label>
        <input
          id={id}
          type="range"
          min={alturaMin}
          max={alturaMax}
          step={paso}
          value={alturaMax}
          aria-valuetext={`${metros.format(alturaMax)} m`}
          class="mt-3 block w-full accent-lima"
        />
        <div class="mt-1 flex justify-between text-sm tabular-nums text-salvia" aria-hidden="true">
          <span>{metros.format(alturaMin)} m</span>
          <span>{metros.format(alturaMax)} m</span>
        </div>
        <p class="mt-4 text-sm text-salvia">{t.comparadorAyuda}</p>
      </div>
    )
  }
</comparador-escala>

<style>
  .planta {
    height: calc(var(--altura) / var(--escena) * 100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .planta {
      transition: height 0.35s var(--ease-suave);
    }
  }
</style>

<script>
  class ComparadorEscala extends HTMLElement {
    connectedCallback() {
      const control = this.querySelector<HTMLInputElement>('input[type="range"]');
      const valor = this.querySelector('[data-valor]');
      const vecesTexto = this.querySelector('[data-veces-texto]');
      const descripcion = this.querySelector('[data-descripcion]');
      if (!control || !valor || !vecesTexto || !descripcion) return;
      const locale = this.dataset.locale;
      const metros = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
      const plantilla = this.dataset.veces ?? '';
      const nombre = descripcion.textContent?.split(':')[0] ?? '';
      const actualizar = () => {
        const m = Number(control.value);
        this.style.setProperty('--altura', String(m));
        valor.textContent = metros.format(m);
        const veces = plantilla.replace('{n}', metros.format(m / 1.8));
        vecesTexto.textContent = veces;
        descripcion.textContent = `${nombre}: ${metros.format(m)} m, ${veces}.`;
        control.setAttribute('aria-valuetext', `${metros.format(m)} m, ${veces}`);
      };
      control.addEventListener('input', actualizar);
    }
  }
  customElements.define('comparador-escala', ComparadorEscala);
</script>
