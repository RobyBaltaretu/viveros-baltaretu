---
// Provisional con el sistema de diseño: el catálogo completo (regla de altura y filtros) llega en el bloque 3.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SILUETA_POR_FAMILIA as SILUETAS } from './ilustraciones/siluetas';
import Contenedor from './ui/Contenedor.astro';
import Etiqueta from './ui/Etiqueta.astro';
import FotoOPlaceholder from './ui/FotoOPlaceholder.astro';
import Seccion from './ui/Seccion.astro';
import { familias, rutaFicha, rutas, textos, type Idioma } from '../i18n/ui';
import { obtenerEspecies } from '../lib/catalogo';
import { formatearPrecio } from '../lib/catalogo/formato';
import { obtenerEmpresa } from '../lib/empresa';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const especies = await obtenerEspecies(idioma);
const empresa = await obtenerEmpresa();
---

<BaseLayout
  idioma={idioma}
  titulo={`${t.tituloCatalogo} | ${empresa.nombre}`}
  descripcion={t.descripcionCatalogo}
  alternativas={rutas.catalogo}
>
  <Seccion>
    <Contenedor>
      <h1 class="titular-grande">{t.tituloCatalogo}</h1>
      {
        especies.length === 0 ? (
          <p class="mt-8 texto-entrada text-salvia">{t.catalogoVacio}</p>
        ) : (
          <ul class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {especies.map(({ data }) => (
              <li class="group relative">
                <FotoOPlaceholder
                  foto={data.fotos[0] && { imagen: data.fotos[0].imagen, alt: data.fotos[0].alt[idioma] }}
                  pendiente={data.nombre[idioma]}
                  silueta={SILUETAS[data.familia]}
                />
                <h2 class="titular-medio mt-5">
                  <a href={rutaFicha(idioma, data.slug)} class="after:absolute after:inset-0 group-hover:text-lima">
                    {data.nombre[idioma]}
                  </a>
                </h2>
                <p class="mt-1 italic text-salvia">{data.nombreCientifico}</p>
                <p class="mt-3 flex flex-wrap items-center gap-2">
                  <Etiqueta>{familias[data.familia][idioma]}</Etiqueta>
                  <span class="font-semibold">{formatearPrecio(data.precioDesde, data.unidadPrecio, idioma)}</span>
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </Contenedor>
  </Seccion>
</BaseLayout>
