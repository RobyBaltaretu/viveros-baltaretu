---
import BaseLayout from '../layouts/BaseLayout.astro';
import BloqueConfianza from './portada/BloqueConfianza.astro';
import FranjaEspecies from './portada/FranjaEspecies.astro';
import Heroe from './portada/Heroe.astro';
import LlamadaPresupuesto from './portada/LlamadaPresupuesto.astro';
import MisionVision from './portada/MisionVision.astro';
import { rutas, type Idioma } from '../i18n/ui';
import { obtenerEspecies } from '../lib/catalogo';
import { obtenerEmpresa } from '../lib/empresa';
import { obtenerPortada } from '../lib/portada';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const [empresa, portada, especies] = await Promise.all([obtenerEmpresa(), obtenerPortada(), obtenerEspecies(idioma)]);
const titulo = `${portada.titular[idioma]} ${portada.titularDestacado[idioma]} | ${empresa.nombre}`;
---

<BaseLayout idioma={idioma} titulo={titulo} descripcion={portada.entradilla[idioma]} alternativas={rutas.inicio}>
  <Heroe idioma={idioma} portada={portada} especies={especies} />
  <FranjaEspecies idioma={idioma} titulo={portada.tituloFranja[idioma]} especies={especies} />
  <BloqueConfianza idioma={idioma} puntos={portada.confianza} />
  <MisionVision idioma={idioma} portada={portada} />
  <LlamadaPresupuesto idioma={idioma} titulo={portada.llamadaTitulo[idioma]} texto={portada.llamadaTexto[idioma]} />
</BaseLayout>
