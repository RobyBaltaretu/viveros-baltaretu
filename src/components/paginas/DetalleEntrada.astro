---
/** Detalle de un proyecto o de una guía. */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Secciones from './Secciones.astro';
import TarjetaEspecie from '../catalogo/TarjetaEspecie.astro';
import Contenedor from '../ui/Contenedor.astro';
import FotoOPlaceholder from '../ui/FotoOPlaceholder.astro';
import Seccion from '../ui/Seccion.astro';
import { rutaGuia, rutaProyecto, rutas, textos, type Idioma } from '../../i18n/ui';
import { obtenerEspecies } from '../../lib/catalogo';
import { obtenerEmpresa } from '../../lib/empresa';
import { articulo, migas } from '../../lib/seo/datos-estructurados';

interface Props {
  idioma: Idioma;
  entrada: CollectionEntry<'proyectos'> | CollectionEntry<'guias'>;
}

const { idioma, entrada } = Astro.props;
const { data } = entrada;
const t = textos[idioma];
const esProyecto = entrada.collection === 'proyectos';
const proyecto = esProyecto ? (entrada as CollectionEntry<'proyectos'>).data : null;
const empresa = await obtenerEmpresa();
const especies = proyecto ? (await obtenerEspecies(idioma)).filter((e) => proyecto.especies.includes(e.data.slug)) : [];
const ruta = (i: Idioma) => (esProyecto ? rutaProyecto(i, data.slug) : rutaGuia(i, data.slug));
const listado = esProyecto ? 'proyectos' : 'guias';
const abs = (r: string) => new URL(r, Astro.site).href;
const datos = [
  articulo({ titulo: data.titulo[idioma], descripcion: data.seoDescripcion[idioma], url: abs(ruta(idioma)), idioma }),
  migas([
    { nombre: t[listado], url: abs(rutas[listado][idioma]) },
    { nombre: data.titulo[idioma], url: abs(ruta(idioma)) },
  ]),
];
---

<BaseLayout
  idioma={idioma}
  titulo={`${data.titulo[idioma]} | ${empresa.nombre}`}
  descripcion={data.seoDescripcion[idioma]}
  alternativas={{ es: ruta('es'), en: ruta('en') }}
  datosEstructurados={datos}
  tipoSocial="article"
>
  <Seccion espacio="ninguno" class="pt-10 pb-20 sm:pt-14 sm:pb-24">
    <Contenedor>
      <nav aria-label={t.migas}>
        <ol class="flex flex-wrap items-center gap-2 text-sm text-gris">
          <li><a href={rutas[listado][idioma]} class="inline-flex min-h-6 items-center underline-offset-4 hover:text-terracota hover:underline">{t[listado]}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-tinta">{data.titulo[idioma]}</li>
        </ol>
      </nav>
      {!data.revisado && <p class="rotulo mt-6 rounded-tarjeta border border-terracota p-4 text-terracota">{t.avisoEjemplo}</p>}
      <h1 class="titular-gigante mt-8 max-w-5xl text-[clamp(2.5rem,1.4rem+4.5vw,6rem)]">{data.titulo[idioma]}</h1>
      {proyecto && <p class="mt-4 text-gris"><span class="sr-only">{t.ubicacion}: </span>{proyecto.ubicacion}</p>}
      <p class="mt-8 max-w-2xl texto-entrada text-gris">{data.resumen[idioma]}</p>
      {
        proyecto && (
          <FotoOPlaceholder
            foto={proyecto.fotos[0] && { imagen: proyecto.fotos[0].imagen, alt: proyecto.fotos[0].alt[idioma] }}
            pendiente={data.titulo[idioma]}
            silueta="palmera"
            proporcion="16 / 9"
            prioridad
            sizes="(min-width: 1440px) 1344px, 100vw"
            class="mt-12"
          />
        )
      }
    </Contenedor>
  </Seccion>

  {
    data.secciones.length > 0 && (
      <Seccion tono="papel">
        <Contenedor>
          <Secciones secciones={data.secciones} idioma={idioma} />
        </Contenedor>
      </Seccion>
    )
  }

  {
    especies.length > 0 && (
      <Seccion>
        <Contenedor>
          <h2 class="titular-grande">{t.especiesUsadas}</h2>
          <ul class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {especies.map((e) => (
              <TarjetaEspecie especie={e} idioma={idioma} />
            ))}
          </ul>
        </Contenedor>
      </Seccion>
    )
  }
</BaseLayout>
