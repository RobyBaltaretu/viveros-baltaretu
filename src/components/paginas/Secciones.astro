---
import { parrafos } from '../../lib/paginas';
import type { Seccion } from '../../lib/paginas/schema';
import type { Idioma } from '../../i18n/ui';

interface Props {
  secciones: Seccion[];
  idioma: Idioma;
  /** Nivel de los títulos de sección. */
  nivel?: 2 | 3;
}

const { secciones, idioma, nivel = 2 } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3';
---

<div class="grid gap-12">
  {
    secciones.map((s) => (
      <section class="aparecer grid gap-4 border-t border-(--color-linea-actual) pt-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-10">
        {s.titulo?.[idioma] ? <Titulo class="titular-medio">{s.titulo[idioma]}</Titulo> : <span />}
        <div class="grid max-w-prose gap-4 texto-entrada">
          {parrafos(s.texto[idioma]).map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </section>
    ))
  }
</div>
