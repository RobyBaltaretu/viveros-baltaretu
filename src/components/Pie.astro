---
import Silueta from './ilustraciones/Silueta.astro';
import Contenedor from './ui/Contenedor.astro';
import Seccion from './ui/Seccion.astro';
import { legales, navegacion, nombresIdioma, rutas, textos, type Idioma } from '../i18n/ui';
import { idAnalitica } from '../lib/cookies';
import { esPlaceholder, obtenerEmpresa } from '../lib/empresa';

interface Props {
  idioma: Idioma;
  alternativas: Record<Idioma, string>;
}

const { idioma, alternativas } = Astro.props;
const t = textos[idioma];
const empresa = await obtenerEmpresa();
const otroIdioma: Idioma = idioma === 'es' ? 'en' : 'es';
const telefonoEnlace = esPlaceholder(empresa.telefono) ? undefined : `tel:${empresa.telefono.replace(/[^\d+]/g, '')}`;
const emailEnlace = esPlaceholder(empresa.email) ? undefined : `mailto:${empresa.email}`;
---

<Seccion como="footer" tono="oliva" espacio="ninguno" class="pb-10">
    <!-- Cinta métrica horizontal: el motivo de la web, como borde superior del pie. -->
    <Contenedor class="pt-14 sm:pt-20">
      <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
        <div class="max-w-md">
          <img src="/logo-oscuro.png" alt={empresa.nombre} width="342" height="120" loading="lazy" class="h-16 w-auto" />
          <p class="mt-4 text-verdor">{t.lemaEmpresa}</p>
        </div>

        <div>
          <h2 class="antetitulo text-verdor">{t.contacto}</h2>
          <dl class="mt-4 space-y-3">
            {
              empresa.direccion && (
                <div>
                  <dt class="sr-only">{t.direccion}</dt>
                  <dd class="whitespace-pre-line">{empresa.direccion}</dd>
                </div>
              )
            }
            {
              empresa.telefono && (
                <div>
                  <dt class="sr-only">{t.telefono}</dt>
                  <dd>{telefonoEnlace ? <a href={telefonoEnlace} class="underline underline-offset-4 hover:text-white">{empresa.telefono}</a> : empresa.telefono}</dd>
                </div>
              )
            }
            {
              empresa.email && (
                <div>
                  <dt class="sr-only">{t.email}</dt>
                  <dd class="break-words">{emailEnlace ? <a href={emailEnlace} class="underline underline-offset-4 hover:text-white">{empresa.email}</a> : empresa.email}</dd>
                </div>
              )
            }
          </dl>
        </div>

        <nav aria-label={t.navegacion}>
          <h2 class="antetitulo text-verdor">{t.navegacion}</h2>
          <ul class="mt-4 space-y-3">
            <li><a href={rutas.inicio[idioma]} class="hover:text-white">{t.inicio}</a></li>
            {navegacion.map((clave) => <li><a href={rutas[clave][idioma]} class="hover:text-white">{t[clave]}</a></li>)}
          </ul>
        </nav>

        <div class="grid content-start gap-10">
          <nav aria-label={t.legal}>
            <h2 class="antetitulo text-verdor">{t.legal}</h2>
            <ul class="mt-4 space-y-3">
              {legales.map((clave) => <li><a href={rutas[clave][idioma]} class="hover:text-white">{t[clave]}</a></li>)}
              {
                idAnalitica() && (
                  <li class="solo-js">
                    <button type="button" data-configurar-cookies class="text-left hover:text-white">
                      {t.cookiesConfigurar}
                    </button>
                  </li>
                )
              }
            </ul>
          </nav>
          <div>
          <h2 class="antetitulo text-verdor">{t.idioma}</h2>
          <p class="mt-4">
            <a href={alternativas[otroIdioma]} hreflang={otroIdioma} lang={otroIdioma} class="underline underline-offset-4 hover:text-white">
              {nombresIdioma[otroIdioma]}
            </a>
          </p>
          </div>
        </div>
      </div>

      <div class="mt-16 flex flex-wrap items-end justify-between gap-6 border-t border-crema/25 pt-8 text-sm text-verdor">
        <p>© {new Date().getFullYear()} {empresa.nombre}. {t.derechos}</p>
        <Silueta tipo="palmera" quieta simple class="h-12 w-auto text-verdor" />
      </div>
    </Contenedor>
</Seccion>
