---
/**
 * Buscador por altura de la portada: una regla con dos tiradores y, en directo,
 * las especies del catálogo que cubren ese rango. El botón lleva al catálogo con
 * el mismo filtro en la URL (?altura=min-max). Sin JavaScript se ve la lista
 * completa y un enlace al catálogo.
 */
import type { CollectionEntry } from 'astro:content';
import Boton from '../ui/Boton.astro';
import Contenedor from '../ui/Contenedor.astro';
import Seccion from '../ui/Seccion.astro';
import { rutaFicha, rutas, textos, type Idioma } from '../../i18n/ui';
import { formatearRango } from '../../lib/catalogo/formato';

interface Props {
  idioma: Idioma;
  titulo: string;
  texto: string;
  especies: CollectionEntry<'catalogo'>[];
}

const { idioma, titulo, texto, especies } = Astro.props;
const t = textos[idioma];
const locale = idioma === 'es' ? 'es-ES' : 'en-GB';
const formato = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
const alturaMaxima = Math.max(2, Math.ceil(Math.max(0, ...especies.map((e) => e.data.alturaMax))));
// Rango inicial: los ejemplares más grandes, que son los que diferencian al vivero.
const desde = Math.round(alturaMaxima * 0.6);
const hasta = alturaMaxima;
const marcas = Array.from({ length: alturaMaxima + 1 }, (_, i) => i);
const ordenadas = [...especies].sort((a, b) => a.data.alturaMin - b.data.alturaMin);
const textosScript = {
  locale,
  ver: t.verEspeciesAltura,
  verUna: t.verEspeciesAlturaUna,
  catalogo: rutas.catalogo[idioma],
};
---

{
  especies.length > 0 && (
    <Seccion tono="medio" class="overflow-hidden">
      <Contenedor class="grid gap-x-16 gap-y-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <div>
          <p class="antetitulo text-salvia">{t.lamina} 02 — {t.eligePorTamano}</p>
          <h2 class="titular-grande mt-5">{titulo}</h2>
          <p class="mt-6 max-w-md texto-entrada text-salvia">{texto}</p>
        </div>

        <buscador-altura
          class="block min-w-0"
          data-altura-maxima={alturaMaxima}
          data-textos={JSON.stringify(textosScript)}
          style={`--desde-n: ${desde / alturaMaxima}; --hasta-n: ${hasta / alturaMaxima}`}
        >
          <div class="solo-js">
            <p class="titular-gigante text-lima tabular-nums" aria-hidden="true">
              <span data-desde>{formato.format(desde)}</span>
              <span class="text-salvia">—</span>
              <span data-hasta>{formato.format(hasta)}</span>
              <span class="text-[0.4em] text-salvia">m</span>
            </p>
            <div class="regla-pista relative mt-8 h-10">
              <div class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-salvia/60" />
              <div class="banda absolute top-1/2 h-1 -translate-y-1/2 bg-lima" />
              <label for="buscador-altura-min" class="sr-only">{t.alturaMinima}</label>
              <input id="buscador-altura-min" type="range" min="0" max={alturaMaxima} step="0.5" value={desde} aria-valuetext={`${formato.format(desde)} m`} />
              <label for="buscador-altura-max" class="sr-only">{t.alturaMaxima}</label>
              <input id="buscador-altura-max" type="range" min="0" max={alturaMaxima} step="0.5" value={hasta} aria-valuetext={`${formato.format(hasta)} m`} />
            </div>
            <div class="relative mx-3.5 mt-2 h-8" aria-hidden="true">
              {marcas.map((m) => (
                <span class="absolute top-0 flex -translate-x-1/2 flex-col items-center" style={`left: ${(m / alturaMaxima) * 100}%`}>
                  <span class:list={['w-px bg-salvia', m % 2 ? 'h-1.5' : 'h-2.5']} />
                  {m % 2 === 0 && <span class="rotulo mt-1 text-salvia">{m}</span>}
                </span>
              ))}
            </div>
          </div>

          <h3 class="antetitulo mt-10 text-salvia">{t.especiesEnRango}</h3>
          <ul class="mt-4 flex flex-wrap gap-2" role="list" data-lista>
            {ordenadas.map((e) => (
              <li data-min={e.data.alturaMin} data-max={e.data.alturaMax}>
                <a
                  href={rutaFicha(idioma, e.data.slug)}
                  class="inline-flex min-h-11 items-center gap-3 rounded-tarjeta border border-linea-oscura px-3.5 transition-colors hover:border-lima"
                >
                  <span class="font-semibold">{e.data.nombre[idioma]}</span>
                  <span class="rotulo text-salvia">{formatearRango(e.data.alturaMin, e.data.alturaMax, 'm', idioma)}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-4 max-w-lg text-salvia" data-vacio hidden>{t.ningunaEnRango}</p>
          <p class="mt-8">
            <span class="solo-js">
              <Boton href={rutas.catalogo[idioma]} flecha data-ver><span data-ver-texto>{t.verCatalogo}</span></Boton>
            </span>
            <span class="solo-sin-js">
              <Boton href={rutas.catalogo[idioma]} flecha>{t.buscadorSinJs}</Boton>
            </span>
          </p>
        </buscador-altura>
      </Contenedor>
    </Seccion>
  )
}

<script>
  import { cumpleFiltros, escribirFiltros, SIN_FILTROS } from '../../lib/catalogo/filtros';
  import type { Familia } from '../../lib/catalogo/tipos';

  class BuscadorAltura extends HTMLElement {
    connectedCallback() {
      const maxima = Number(this.dataset.alturaMaxima);
      const textos = JSON.parse(this.dataset.textos ?? '{}') as Record<string, string>;
      const [min, max] = [...this.querySelectorAll<HTMLInputElement>('input[type="range"]')];
      const desde = this.querySelector('[data-desde]');
      const hasta = this.querySelector('[data-hasta]');
      const ver = this.querySelector<HTMLAnchorElement>('[data-ver]');
      const vacio = this.querySelector<HTMLElement>('[data-vacio]');
      const items = [...this.querySelectorAll<HTMLElement>('[data-lista] > li')];
      if (!min || !max || !desde || !hasta || !ver || !vacio) return;
      const numero = new Intl.NumberFormat(textos.locale, { maximumFractionDigits: 1 });

      const pintar = (movido?: HTMLInputElement) => {
        // Los tiradores no se cruzan: el que se mueve empuja al otro.
        if (Number(min.value) > Number(max.value)) {
          if (movido === min) max.value = min.value;
          else min.value = max.value;
        }
        const a = Number(min.value);
        const b = Number(max.value);
        this.style.setProperty('--desde-n', String(a / maxima));
        this.style.setProperty('--hasta-n', String(b / maxima));
        desde.textContent = numero.format(a);
        hasta.textContent = numero.format(b);
        min.setAttribute('aria-valuetext', `${numero.format(a)} m`);
        max.setAttribute('aria-valuetext', `${numero.format(b)} m`);

        const estado = { ...SIN_FILTROS, altura: a === 0 && b === maxima ? null : ([a, b] as [number, number]) };
        let visibles = 0;
        for (const li of items) {
          const cumple = cumpleFiltros(
            { familia: 'palmeras' as Familia, alturaMin: Number(li.dataset.min), alturaMax: Number(li.dataset.max), formatos: [] },
            estado,
          );
          li.hidden = !cumple;
          if (cumple) visibles++;
        }
        vacio.hidden = visibles > 0;
        const parametros = escribirFiltros(estado).toString();
        ver.href = `${textos.catalogo}${parametros ? `?${parametros}` : ''}`;
        const etiqueta = visibles === 1 ? textos.verUna! : textos.ver!.replace('{n}', String(visibles));
        const contenido = ver.querySelector('[data-ver-texto]');
        if (contenido) contenido.textContent = etiqueta;
        ver.hidden = visibles === 0;
      };

      min.addEventListener('input', () => pintar(min));
      max.addEventListener('input', () => pintar(max));
      pintar();
    }
  }
  customElements.define('buscador-altura', BuscadorAltura);
</script>
