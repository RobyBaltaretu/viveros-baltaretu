---
import IconoConfianza from './IconoConfianza.astro';
import Contenedor from '../ui/Contenedor.astro';
import Seccion from '../ui/Seccion.astro';
import { textos, type Idioma } from '../../i18n/ui';
import type { Portada } from '../../lib/portada/schema';

interface Props {
  idioma: Idioma;
  puntos: Portada['confianza'];
}

const { idioma, puntos } = Astro.props;
const t = textos[idioma];
---

{
  puntos.length > 0 && (
    <Seccion tono="claro" bordeOrganico>
      <Contenedor>
        <h2 class="titular-grande max-w-3xl">{t.tituloConfianza}</h2>
        <ul class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {puntos.map((p) => (
            <li class="aparecer border-t-2 border-bosque pt-6">
              <IconoConfianza icono={p.icono} class="text-bosque" />
              <h3 class="titular-medio mt-4">{p.titulo[idioma]}</h3>
              <p class="mt-3 text-musgo">{p.texto[idioma]}</p>
            </li>
          ))}
        </ul>
      </Contenedor>
    </Seccion>
  )
}
