---
/** Por qué comprarnos: tres puntos con icono (textos del panel). */
import IconoConfianza from './IconoConfianza.astro';
import Contenedor from '../ui/Contenedor.astro';
import Seccion from '../ui/Seccion.astro';
import type { Idioma } from '../../i18n/ui';
import type { Portada } from '../../lib/portada/schema';

interface Props {
  idioma: Idioma;
  titulo: string;
  puntos: Portada['confianza'];
}

const { idioma, titulo, puntos } = Astro.props;
---

{
  puntos.length > 0 && (
    <Seccion tono="papel">
      <Contenedor>
        <h2 class="titular-grande">{titulo}</h2>
        <ul class="mt-12 grid gap-10 md:grid-cols-3" role="list">
          {puntos.map((p) => (
            <li>
              <span class="flex size-12 items-center justify-center rounded-full bg-verdor text-oliva" aria-hidden="true">
                <IconoConfianza icono={p.icono} class="size-6" />
              </span>
              <h3 class="titular-medio mt-5">{p.titulo[idioma]}</h3>
              <p class="mt-2 text-gris">{p.texto[idioma]}</p>
            </li>
          ))}
        </ul>
      </Contenedor>
    </Seccion>
  )
}
