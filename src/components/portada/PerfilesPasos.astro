---
/** Para quién trabaja el vivero y cómo se pide, paso a paso (textos del panel). */
import Contenedor from '../ui/Contenedor.astro';
import Seccion from '../ui/Seccion.astro';
import { textos, type Idioma } from '../../i18n/ui';
import type { Portada } from '../../lib/portada/schema';

interface Props {
  idioma: Idioma;
  portada: Portada;
}

const { idioma, portada } = Astro.props;
const t = textos[idioma];
const numero = (i: number) => String(i + 1).padStart(2, '0');
---

<Seccion tono="claro">
  <Contenedor>
    {
      portada.perfiles.length > 0 && (
        <div class="grid gap-x-16 gap-y-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <div>
            <p class="antetitulo text-musgo">{t.lamina} 03</p>
            <h2 class="titular-grande mt-5">{portada.perfilesTitulo[idioma]}</h2>
          </div>
          <ul class="grid border-t border-bosque sm:grid-cols-2" role="list">
            {portada.perfiles.map((p, i) => (
              <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-3 border-b border-linea-clara py-7 sm:odd:pr-8 sm:even:border-l sm:even:pl-8">
                <span class="rotulo pt-1.5 text-musgo">{numero(i)}</span>
                <div>
                  <h3 class="titular-medio">{p.titulo[idioma]}</h3>
                  <p class="mt-3 text-musgo">{p.texto[idioma]}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      portada.pasos.length > 0 && (
        <div class="mt-24 sm:mt-32">
          <p class="antetitulo text-musgo">{t.lamina} 04</p>
          <h2 class="titular-grande mt-5 max-w-3xl">{portada.pasosTitulo[idioma]}</h2>
          <ol class="mt-12 grid gap-px overflow-hidden rounded-panel border border-bosque bg-bosque md:grid-cols-3" role="list">
            {portada.pasos.map((p, i) => (
              <li class="flex flex-col bg-claro p-7 sm:p-9">
                <p class="titular-gigante text-[clamp(4rem,3rem+3vw,6rem)] leading-none">
                  <span class="sr-only">{t.paso} </span>
                  {numero(i)}
                </p>
                <h3 class="titular-medio mt-6">{p.titulo[idioma]}</h3>
                <p class="mt-3 text-musgo">{p.texto[idioma]}</p>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </Contenedor>
</Seccion>
