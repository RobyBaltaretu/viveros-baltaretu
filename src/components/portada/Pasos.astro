---
/**
 * Cómo se pide, en tres pasos cortos (textos del panel), dibujados como un
 * camino: semilla, brote y planta. La línea se traza al hacer scroll.
 */
import Contenedor from '../ui/Contenedor.astro';
import Seccion from '../ui/Seccion.astro';
import type { Idioma } from '../../i18n/ui';
import type { Portada } from '../../lib/portada/schema';

interface Props {
  idioma: Idioma;
  portada: Portada;
}

const { idioma, portada } = Astro.props;

// Un dibujo por fase de crecimiento; si hay más pasos se repite la planta.
const FASES = [
  '<path d="M4 27h24"/><path d="M16 27c-3.4 0-5.4-2.1-5.4-4.8 0-3.1 2.6-5.9 5.4-7.3 2.8 1.4 5.4 4.2 5.4 7.3 0 2.7-2 4.8-5.4 4.8Z"/>',
  '<path d="M4 27h24"/><path d="M16 27V15"/><path class="hoja" style="--origen-hoja:100% 100%" d="M16 18c-1-3.4-4-5-8-4.6.4 3.6 3.6 5.4 8 4.6Z"/><path class="hoja" style="--origen-hoja:0% 100%;--retraso-hoja:-3s" d="M16 15c.8-3.6 3.8-5.6 8-5.4-.2 3.8-3.4 5.8-8 5.4Z"/>',
  '<path d="M4 27h24"/><path d="M16 27V12"/><path d="M16 20l-4-3M16 17l4-3"/><path class="hoja" style="--origen-hoja:50% 100%" d="M16 4c-5 0-8.5 3.2-8.5 7.2 0 3.3 3 5.3 8.5 5.3s8.5-2 8.5-5.3C24.5 7.2 21 4 16 4Z"/>',
];
---

{
  portada.pasos.length > 0 && (
    <Seccion tono="verde">
      <Contenedor>
        <h2 class="titular-grande max-w-2xl">{portada.pasosTitulo[idioma]}</h2>
        <ol class="camino relative mt-14 grid gap-12 md:grid-cols-3 md:gap-10" role="list">
          <span class="camino-linea" aria-hidden="true" />
          {portada.pasos.map((p, i) => (
            <li class="relative grid grid-cols-[3.5rem_minmax(0,1fr)] gap-x-5 md:block">
              <span
                class="relative z-10 flex size-14 items-center justify-center rounded-full bg-papel text-oliva shadow-[0_6px_18px_-10px_rgb(47_74_44/0.45)] ring-1 ring-linea"
                aria-hidden="true"
              >
                <svg
                  class="size-8"
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                  set:html={FASES[Math.min(i, FASES.length - 1)]}
                />
              </span>
              <div class="min-w-0 md:mt-6">
                <h3 class="titular-medio">{p.titulo[idioma]}</h3>
                <p class="mt-2 max-w-[34ch] text-gris">{p.texto[idioma]}</p>
              </div>
            </li>
          ))}
        </ol>
      </Contenedor>
    </Seccion>
  )
}

<style>
  /* Línea del camino: vertical en móvil, horizontal desde md. Pasa por el centro de los círculos. */
  .camino-linea {
    position: absolute;
    top: 1.75rem;
    bottom: 1.75rem;
    left: calc(1.75rem - 1px);
    width: 2px;
    border-radius: 1px;
    background: var(--color-oliva);
    opacity: 0.35;
    transform-origin: top;
  }
  @media (min-width: 48rem) {
    .camino-linea {
      top: calc(1.75rem - 1px);
      bottom: auto;
      left: 1.75rem;
      right: calc((100% - 5rem) / 3 - 1.75rem);
      width: auto;
      height: 2px;
      transform-origin: left;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .camino-linea {
        animation: trazar-y linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 45%;
      }
      @media (min-width: 48rem) {
        .camino-linea {
          animation-name: trazar-x;
        }
      }
    }
  }
  @keyframes trazar-y {
    from {
      scale: 1 0;
    }
  }
  @keyframes trazar-x {
    from {
      scale: 0 1;
    }
  }
</style>
