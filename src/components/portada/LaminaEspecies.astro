---
/**
 * Lámina 01: una especie por familia, dibujadas a escala entre sí junto a una
 * persona de 1,80 m, y el índice de familias con su número de especies y su rango
 * de alturas (todo sale del catálogo publicado).
 */
import type { CollectionEntry } from 'astro:content';
import EscenaEscala, { type ElementoEscena } from '../ilustraciones/EscenaEscala.astro';
import { siluetaDe } from '../ilustraciones/siluetas';
import Boton from '../ui/Boton.astro';
import Contenedor from '../ui/Contenedor.astro';
import Seccion from '../ui/Seccion.astro';
import { familias, rutaFamilia, rutaFicha, rutas, textos, type Idioma } from '../../i18n/ui';
import { FAMILIAS } from '../../lib/catalogo/schema';
import { formatearRango } from '../../lib/catalogo/formato';
import { representantesPorFamilia } from '../../lib/portada/seleccion';

interface Props {
  idioma: Idioma;
  titulo: string;
  texto: string;
  especies: CollectionEntry<'catalogo'>[];
}

const { idioma, titulo, texto, especies } = Astro.props;
const t = textos[idioma];
const metros = new Intl.NumberFormat(idioma === 'es' ? 'es-ES' : 'en-GB', { maximumFractionDigits: 1 });

const representantes = representantesPorFamilia(especies)
  .slice(0, 4)
  .sort((a, b) => b.data.alturaMax - a.data.alturaMax);
const elementos: ElementoEscena[] = [
  { tipo: 'persona', altura: 1.8, etiqueta: t.persona, detalle: t.alturaPersona },
  ...representantes.map((e) => ({
    tipo: siluetaDe(e.data),
    altura: e.data.alturaMax,
    etiqueta: e.data.nombre[idioma],
    detalle: `${t.hastaAltura} ${metros.format(e.data.alturaMax)} m`,
    href: rutaFicha(idioma, e.data.slug),
  })),
];

const indice = FAMILIAS.map((familia) => {
  const deFamilia = especies.filter((e) => e.data.familia === familia);
  return {
    familia,
    cantidad: deFamilia.length,
    rango: deFamilia.length
      ? formatearRango(
          Math.min(...deFamilia.map((e) => e.data.alturaMin)),
          Math.max(...deFamilia.map((e) => e.data.alturaMax)),
          'm',
          idioma,
        )
      : '',
  };
}).filter((f) => f.cantidad > 0);
---

{
  especies.length > 0 && (
<Seccion tono="claro" class="overflow-hidden">
  <Contenedor>
    <div class="grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end">
      <div>
        <p class="antetitulo text-musgo">{t.lamina} 01 — {t.alzadoComparativo}</p>
        <h2 class="titular-grande mt-5">{titulo}</h2>
      </div>
      <p class="max-w-xl texto-entrada text-musgo lg:justify-self-end">{texto}</p>
    </div>

    <div class="-mx-4 mt-14 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0" tabindex="0" role="region" aria-label={t.alzadoComparativo}>
          <EscenaEscala
            elementos={elementos}
            idioma={idioma}
            alto="clamp(18rem, 52vh, 32rem)"
            class="min-w-max [--color-planta:var(--color-bosque)] [--color-persona:var(--color-musgo)]"
          />
    </div>

    <div class="mt-16 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div>
        <h3 class="antetitulo text-musgo">{t.indiceFamilias}</h3>
        <p class="mt-6"><Boton href={rutas.catalogo[idioma]} flecha>{t.verCatalogoCompleto}</Boton></p>
      </div>
      <ul class="border-t border-linea-clara" role="list">
        {
          indice.map((f, i) => (
            <li class="border-b border-linea-clara">
              <a
                href={rutaFamilia(idioma, f.familia)}
                class="group grid grid-cols-[2.5rem_minmax(0,1fr)_auto] items-baseline gap-x-4 py-5 transition-colors hover:bg-bosque/4 sm:grid-cols-[3rem_minmax(0,1fr)_10rem_6rem]"
              >
                <span class="rotulo text-musgo">{String(i + 1).padStart(2, '0')}</span>
                <span class="titular-medio subrayado-hover">{familias[f.familia][idioma]}</span>
                <span class="rotulo text-musgo max-sm:col-start-2 max-sm:row-start-2 max-sm:mt-1">
                  {f.cantidad === 1 ? t.resultadosUno : t.resultados.replace('{n}', String(f.cantidad))}
                </span>
                <span class="rotulo text-right tabular-nums max-sm:row-span-2">{f.rango}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Contenedor>
</Seccion>
  )
}
