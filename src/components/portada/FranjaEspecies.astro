---
/**
 * Franja de especies en movimiento continuo (CSS). Se pausa al pasar el ratón o al
 * recibir el foco; con "reducir movimiento" queda quieta y se desplaza a mano.
 * La segunda copia de la lista solo existe para el bucle y no es accesible.
 */
import type { CollectionEntry } from 'astro:content';
import Silueta from '../ilustraciones/Silueta.astro';
import { siluetaDe } from '../ilustraciones/siluetas';
import Contenedor from '../ui/Contenedor.astro';
import Seccion from '../ui/Seccion.astro';
import { familias, rutaFicha, rutas, textos, type Idioma } from '../../i18n/ui';
import { formatearPrecio } from '../../lib/catalogo/formato';

interface Props {
  idioma: Idioma;
  titulo: string;
  especies: CollectionEntry<'catalogo'>[];
}

const { idioma, titulo, especies } = Astro.props;
const t = textos[idioma];
---

{
  especies.length > 0 && (
    <Seccion tono="medio" bordeOrganico espacio="ninguno" class="py-16 sm:py-24">
      <Contenedor class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="titular-grande">{titulo}</h2>
        <a href={rutas.catalogo[idioma]} class="font-semibold underline underline-offset-4 hover:text-lima">{t.verCatalogo}</a>
      </Contenedor>
      <div class="franja mt-10 overflow-x-auto">
        <div class="pista flex w-max">
          {[0, 1].map((copia) => (
            <ul class="flex gap-4 pr-4" aria-hidden={copia === 1 ? 'true' : undefined} inert={copia === 1}>
              {especies.map(({ data }) => (
                <li class="w-64 shrink-0">
                  <a
                    href={rutaFicha(idioma, data.slug)}
                    class="group flex h-full flex-col rounded-(--radius-organico) border border-linea-oscura bg-bosque p-5 transition-colors hover:border-lima"
                  >
                    <Silueta tipo={siluetaDe(data)} quieta class="h-32 w-auto self-center text-lima" style="--tono-tronco: var(--color-salvia)" />
                    <span class="mt-5 text-sm text-salvia">{familias[data.familia][idioma]}</span>
                    <span class="titular-medio mt-1 text-xl! group-hover:text-lima">{data.nombre[idioma]}</span>
                    <span class="mt-auto pt-3 font-semibold">{formatearPrecio(data.precioDesde, data.unidadPrecio, idioma)}</span>
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </Seccion>
  )
}

<style>
  .franja {
    scrollbar-width: thin;
    padding-inline: max(1rem, calc((100vw - 90rem) / 2 + 3rem));
  }
  @media (prefers-reduced-motion: no-preference) {
    .franja {
      overflow: hidden;
      padding-inline: 0;
      mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    }
    .pista {
      animation: desplazar var(--duracion-franja, 60s) linear infinite;
    }
    .franja:hover .pista,
    .franja:focus-within .pista {
      animation-play-state: paused;
    }
    @keyframes desplazar {
      to {
        translate: -50% 0;
      }
    }
  }
</style>
