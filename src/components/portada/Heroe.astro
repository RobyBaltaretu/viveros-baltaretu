---
/**
 * Primera pantalla: qué vendemos, a quién y cómo se compra, en una sola frase,
 * con dos botones. A la derecha, un dibujo sencillo de las plantas del vivero.
 */
import Silueta from '../ilustraciones/Silueta.astro';
import Boton from '../ui/Boton.astro';
import Contenedor from '../ui/Contenedor.astro';
import { rutas, textos, type Idioma } from '../../i18n/ui';
import type { Portada } from '../../lib/portada/schema';

interface Props {
  idioma: Idioma;
  portada: Portada;
}

const { idioma, portada } = Astro.props;
const t = textos[idioma];
const ventajas = [t.ventajaMayor, t.ventajaUnidad, t.datoReparto];
---

<section class="superficie-crema">
  <Contenedor class="grid items-center gap-x-16 gap-y-12 py-14 sm:py-20 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:py-24">
    <div class="min-w-0">
      <p class="antetitulo text-oliva">{t.antetituloPortada}</p>
      <h1 class="titular-gigante mt-5">
        {portada.titular[idioma]} <span class="text-oliva">{portada.titularDestacado[idioma]}</span>
      </h1>
      <p class="mt-6 max-w-xl texto-entrada text-gris">{portada.entradilla[idioma]}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Boton href={rutas.catalogo[idioma]} tamano="grande" flecha>{t.verCatalogo}</Boton>
        <Boton href={rutas.presupuesto[idioma]} tamano="grande" variante="secundario">{t.pedirPresupuesto}</Boton>
      </div>
      <ul class="mt-10 grid gap-3 sm:grid-cols-3" role="list">
        {
          ventajas.map((v) => (
            <li class="flex items-start gap-2 font-medium">
              <svg class="mt-1 size-5 shrink-0 text-oliva" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" />
              </svg>
              {v}
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="superficie-verde relative flex aspect-[5/4] items-end justify-center gap-[5%] overflow-hidden rounded-panel px-[6%] pt-[6%] text-oliva"
      aria-hidden="true"
    >
      <Silueta tipo="olivo" class="h-[52%] w-auto" />
      <Silueta tipo="palmera" class="h-[90%] w-auto" />
      <div class="absolute inset-x-0 bottom-0 h-[3%] bg-oliva/15"></div>
    </div>
  </Contenedor>
</section>
