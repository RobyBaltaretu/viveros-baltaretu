---
/**
 * Llamada final a presupuesto: el único bloque con fondo lima de la web, con una
 * palmera dibujada a escala sobre la cuadrícula.
 */
import Silueta from '../ilustraciones/Silueta.astro';
import Boton from '../ui/Boton.astro';
import Contenedor from '../ui/Contenedor.astro';
import { rutas, textos, type Idioma } from '../../i18n/ui';
import { esPlaceholder, obtenerEmpresa } from '../../lib/empresa';

interface Props {
  idioma: Idioma;
  titulo: string;
  texto: string;
}

const { idioma, titulo, texto } = Astro.props;
const t = textos[idioma];
const { whatsapp } = await obtenerEmpresa();
const enlaceWhatsapp = esPlaceholder(whatsapp)
  ? null
  : `https://wa.me/${whatsapp}?text=${encodeURIComponent(t.whatsappGeneral)}`;
---

<section class="superficie-lima cuadricula relative overflow-hidden [--paso-cuadricula:clamp(2.5rem,5vw,4.5rem)]">
  <Contenedor class="relative grid min-h-[min(44rem,90svh)] items-end gap-10 py-20 sm:py-28 md:grid-cols-[minmax(0,1fr)_auto]">
    <div class="min-w-0">
      <h2 class="titular-gigante max-w-5xl text-[clamp(3.4rem,1rem+7vw,9rem)]">{titulo}</h2>
      <p class="mt-8 max-w-xl texto-entrada">{texto}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <Boton href={rutas.presupuesto[idioma]} tamano="grande" flecha>{t.pedirPresupuesto}</Boton>
        {
          enlaceWhatsapp ? (
            <Boton href={enlaceWhatsapp} tamano="grande" variante="secundario" target="_blank" rel="noopener">
              {t.escribirWhatsapp}
            </Boton>
          ) : (
            <Boton href={rutas.catalogo[idioma]} tamano="grande" variante="secundario">
              {t.verCatalogo}
            </Boton>
          )
        }
      </div>
    </div>
    <Silueta tipo="palmera" class="pointer-events-none hidden h-[clamp(20rem,60svh,36rem)] w-auto text-bosque md:block" />
  </Contenedor>
</section>
