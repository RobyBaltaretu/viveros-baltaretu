---
import type { ICONOS_CONFIANZA } from '../../lib/portada/schema';

interface Props {
  icono: (typeof ICONOS_CONFIANZA)[number];
  class?: string;
}

const { icono, class: clase } = Astro.props;
// Trazos simples a 1,75 px sobre una rejilla de 24.
const trazos: Record<Props['icono'], string> = {
  origen: 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z M12 7.5c-1.6 1.2-2.2 2.6-1.8 4.3 1.7.3 3.1-.3 4.1-1.8-.6-1.4-1.3-2.1-2.3-2.5Z',
  documentacion: 'M7 3h7l4 4v14H7Z M14 3v4h4 M9.5 11.5h6 M9.5 14.5h6 M9.5 17.5h3.5',
  reparto: 'M2.5 6.5h11v9h-11Z M13.5 9.5h4l3 3v3h-7 M6.5 18.5a1.75 1.75 0 1 0 0-.01 M17 18.5a1.75 1.75 0 1 0 0-.01',
  calidad: 'M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9Z',
};
---

<svg viewBox="0 0 24 24" class:list={['size-7', clase]} aria-hidden="true" focusable="false">
