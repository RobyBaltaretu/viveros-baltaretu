---
// Provisional: los textos legales completos (editables en el panel) llegan en el bloque 6.
import BaseLayout from '../layouts/BaseLayout.astro';
import Contenedor from './ui/Contenedor.astro';
import Seccion from './ui/Seccion.astro';
import { rutas, textos, type Idioma } from '../i18n/ui';
import { obtenerEmpresa } from '../lib/empresa';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const empresa = await obtenerEmpresa();
---

<BaseLayout idioma={idioma} titulo={`${t.privacidadTitulo} | ${empresa.nombre}`} descripcion={t.privacidadTitulo} alternativas={rutas.privacidad}>
  <Seccion espacio="amplio">
    <Contenedor ancho="estrecho">
      <h1 class="titular-grande">{t.privacidadTitulo}</h1>
      <p class="mt-8 rounded-2xl border border-lima p-4 text-lima">{t.textoLegalPendiente}</p>
      <p class="mt-8 texto-entrada">[PLACEHOLDER: {t.privacidadTitulo.toLowerCase()}]</p>
    </Contenedor>
  </Seccion>
</BaseLayout>
