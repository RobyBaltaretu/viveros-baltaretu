---
/**
 * Panel lateral de la lista de presupuesto (<dialog> modal: foco atrapado y Esc
 * nativos). Se pinta en el navegador a partir de localStorage y del índice
 * estático de especies (/indice-especies.json, cargado al abrir).
 */
import Boton from '../ui/Boton.astro';
import { rutas, textos, type Idioma } from '../../i18n/ui';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const textosScript = {
  cantidadDe: t.cantidadDe,
  restarUna: t.restarUna,
  sumarUna: t.sumarUna,
  quitar: t.quitarDeLista,
  total: t.totalUnidades,
};
---

<panel-lista class="solo-js" data-idioma={idioma} data-indice="/indice-especies.json" data-textos={JSON.stringify(textosScript)}>
  <dialog
    id="panel-lista"
    aria-labelledby="panel-lista-titulo"
    class="superficie-media m-0 ml-auto h-dvh max-h-dvh w-[min(30rem,100vw)] max-w-none border-l border-linea-oscura p-0 backdrop:bg-bosque/70 backdrop:backdrop-blur-sm"
  >
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between gap-4 border-b border-linea-oscura px-6 py-5">
        <h2 id="panel-lista-titulo" class="titular-medio">{t.listaTitulo}</h2>
        <button
          type="button"
          data-cerrar
          class="inline-flex size-11 items-center justify-center rounded-full border border-linea-oscura hover:border-lima"
          aria-label={t.cerrarLista}
        >
          <svg class="size-5" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M5.3 5.3a1 1 0 0 1 1.4 0L10 8.6l3.3-3.3a1 1 0 1 1 1.4 1.4L11.4 10l3.3 3.3a1 1 0 0 1-1.4 1.4L10 11.4l-3.3 3.3a1 1 0 0 1-1.4-1.4L8.6 10 5.3 6.7a1 1 0 0 1 0-1.4Z" />
          </svg>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto px-6 py-6">
        <p data-vacia class="text-salvia">{t.listaVacia}</p>
        <ul data-lineas class="grid gap-4"></ul>
      </div>
      <div class="border-t border-linea-oscura px-6 py-5" data-pie>
        <p data-total class="font-semibold"></p>
        <div class="mt-4 flex flex-wrap gap-3">
          <Boton href={rutas.presupuesto[idioma]} flecha>{t.continuarPresupuesto}</Boton>
          <Boton href={rutas.catalogo[idioma]} variante="secundario">{t.verCatalogo}</Boton>
        </div>
      </div>
    </div>
  </dialog>
</panel-lista>

<style>
  dialog[open] {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    dialog[open] {
      animation: entrar-panel 0.35s var(--ease-suave);
    }
    @keyframes entrar-panel {
      from {
        translate: 100% 0;
      }
    }
  }
</style>

<script>
  import { almacen, cambiarCantidad, quitar, totalUnidades, type LineaLista } from '../../lib/presupuesto/lista';

  type Indice = Record<string, { nombre: Record<string, string>; cientifico: string; url: Record<string, string> }>;

  class PanelLista extends HTMLElement {
    indice: Indice | null = null;

    connectedCallback() {
      const dialogo = this.querySelector('dialog');
      if (!dialogo) return;
      dialogo.querySelector('[data-cerrar]')?.addEventListener('click', () => dialogo.close());
      // Clic en el fondo (fuera del contenido) cierra el panel.
      dialogo.addEventListener('click', (e) => e.target === dialogo && dialogo.close());
      document.addEventListener('click', (e) => {
        const disparador = (e.target as Element).closest('[data-abrir-lista]');
        if (!disparador) return;
        e.preventDefault();
        void this.abrir(dialogo);
      });
      almacen.alCambiar(() => dialogo.open && this.pintar());
    }

    async abrir(dialogo: HTMLDialogElement) {
      if (!this.indice) {
        try {
          const respuesta = await fetch(this.dataset.indice ?? '/indice-especies.json');
          this.indice = (await respuesta.json()) as Indice;
        } catch {
          this.indice = {};
        }
      }
      this.pintar();
      dialogo.showModal();
    }

    pintar() {
      const idioma = this.dataset.idioma ?? 'es';
      const textos = JSON.parse(this.dataset.textos ?? '{}') as Record<string, string>;
      const indice = this.indice ?? {};
      // Solo especies que siguen publicadas.
      const lista = almacen.leer().filter((l) => indice[l.slug]);
      const ul = this.querySelector('[data-lineas]')!;
      this.querySelector<HTMLElement>('[data-vacia]')!.hidden = lista.length > 0;
      this.querySelector<HTMLElement>('[data-pie]')!.hidden = lista.length === 0;
      this.querySelector('[data-total]')!.textContent = textos.total!.replace('{n}', String(totalUnidades(lista)));
      // Al repintar, el foco vuelve al mismo control (p. ej. al pulsar "+" con el teclado).
      const enfocado = document.activeElement?.getAttribute('aria-label');
      ul.replaceChildren(...lista.map((l) => this.linea(l, indice, idioma, textos)));
      if (enfocado) {
        const mismo = [...ul.querySelectorAll<HTMLElement>('[aria-label]')].find((e) => e.getAttribute('aria-label') === enfocado);
        (mismo ?? this.querySelector<HTMLElement>('[data-cerrar]'))?.focus();
      }
    }

    linea(l: LineaLista, indice: Indice, idioma: string, textos: Record<string, string>) {
      const especie = indice[l.slug]!;
      const nombre = especie.nombre[idioma] ?? l.slug;
      const t = (clave: string) => textos[clave]!.replace('{nombre}', nombre);
      const guardar = (cantidad: number) => almacen.guardar(cambiarCantidad(almacen.leer(), l.slug, cantidad));

      const li = document.createElement('li');
      li.className = 'grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-3 rounded-3xl border border-linea-oscura bg-bosque p-4';
      const enlace = document.createElement('a');
      enlace.href = especie.url[idioma] ?? '#';
      enlace.className = 'min-w-0 font-semibold hover:text-lima';
      enlace.textContent = nombre;
      const cientifico = document.createElement('span');
      cientifico.className = 'block text-sm font-normal italic text-salvia';
      cientifico.textContent = especie.cientifico;
      enlace.append(cientifico);

      const botonQuitar = this.boton(t('quitar'), 'M6 7h8l-.7 9H6.7Zm2-3h4l1 2H7Z', () => almacen.guardar(quitar(almacen.leer(), l.slug)));

      const controles = document.createElement('div');
      controles.className = 'col-span-2 flex items-center gap-2';
      const cantidad = document.createElement('input');
      cantidad.type = 'number';
      cantidad.min = '1';
      cantidad.max = '10000';
      cantidad.inputMode = 'numeric';
      cantidad.value = String(l.cantidad);
      cantidad.setAttribute('aria-label', t('cantidadDe'));
      cantidad.className = 'h-11 w-24 rounded-full border border-linea-oscura bg-superficie px-4 text-center font-semibold tabular-nums';
      cantidad.addEventListener('change', () => guardar(Number(cantidad.value)));
      controles.append(
        this.boton(t('restarUna'), 'M5 9h10v2H5Z', () => guardar(l.cantidad - 1)),
        cantidad,
        this.boton(t('sumarUna'), 'M9 5h2v4h4v2h-4v4H9v-4H5V9h4Z', () => guardar(l.cantidad + 1)),
      );
      li.append(enlace, botonQuitar, controles);
      return li;
    }

    boton(etiqueta: string, trazo: string, accion: () => void) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-linea-oscura hover:border-lima';
      b.setAttribute('aria-label', etiqueta);
      b.innerHTML = `<svg class="size-5" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="${trazo}"/></svg>`;
      b.addEventListener('click', accion);
      return b;
    }
  }
  customElements.define('panel-lista', PanelLista);
</script>
