---
import { PROVINCIAS } from '../../lib/presupuesto/provincias';
/**
 * Página de presupuesto: resumen de la lista y formulario. Se envía a
 * /api/presupuesto (Worker) con Turnstile. Con JavaScript, por fetch y mensajes
 * en la misma página; sin JavaScript se muestran los contactos directos.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Boton from '../ui/Boton.astro';
import Contenedor from '../ui/Contenedor.astro';
import Seccion from '../ui/Seccion.astro';
import { rutas, textos, type Idioma } from '../../i18n/ui';
import { obtenerCondiciones } from '../../lib/condiciones';
import { esPlaceholder, obtenerEmpresa } from '../../lib/empresa';
import { CAMPO_TRAMPA } from '../../lib/presupuesto/esquema';
import { TURNSTILE_PRUEBA } from '../../lib/presupuesto/turnstile';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos[idioma];
const [empresa, condiciones] = await Promise.all([obtenerEmpresa(), obtenerCondiciones()]);
const claveTurnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? TURNSTILE_PRUEBA.claveSitio : '');
const contactos = [
  { etiqueta: t.email, valor: empresa.email, enlace: esPlaceholder(empresa.email) ? undefined : `mailto:${empresa.email}` },
  {
    etiqueta: t.telefono,
    valor: empresa.telefono,
    enlace: esPlaceholder(empresa.telefono) ? undefined : `tel:${empresa.telefono.replace(/[^\d+]/g, '')}`,
  },
].filter((c) => c.valor);
const campo = 'mt-2 block w-full rounded-tarjeta border-2 border-linea bg-white px-4 py-3 text-oliva aria-[invalid=true]:border-[#9b2c1d]';
const etiqueta = 'font-semibold';
const textosScript = {
  enviando: t.enviando,
  enviar: t.enviarPeticion,
  errorCampos: t.errorCampos,
  errorAntispam: t.errorAntispam,
  errorEnvio: t.errorEnvio,
  errorConfiguracion: t.errorConfiguracion,
  total: t.totalUnidades,
};
---

<BaseLayout
  idioma={idioma}
  titulo={`${t.presupuestoTitulo} | ${empresa.nombre}`}
  descripcion={t.presupuestoEntradilla}
  alternativas={rutas.presupuesto}
>
  <Seccion espacio="ninguno" class="pt-12 pb-16 sm:pt-16">
    <Contenedor>
      <h1 class="titular-gigante">{t.presupuestoTitulo}</h1>
      <p class="mt-6 max-w-2xl texto-entrada text-gris">{t.presupuestoEntradilla}</p>
    </Contenedor>
  </Seccion>

  <Seccion tono="papel">
    <Contenedor class="grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:gap-x-16">
      <section class="min-w-0 lg:col-start-2 lg:row-start-1" aria-labelledby="resumen-lista">
        <div class="rounded-panel superficie-verde p-6 sm:p-8">
          <h2 id="resumen-lista" class="titular-medio">{t.resumenLista}</h2>
          <ul data-resumen class="mt-6 grid gap-3"></ul>
          <p data-resumen-vacio class="mt-6 text-gris">{t.sinEspeciesFormulario}</p>
          <p data-resumen-total class="mt-6 font-semibold" hidden></p>
          <p class="solo-js mt-6">
            <Boton type="button" variante="secundario" data-abrir-lista>{t.editarLista}</Boton>
          </p>
        </div>
      </section>
      <formulario-presupuesto
        class="min-w-0 lg:col-start-1 lg:row-span-2 lg:row-start-1"
        data-enviado={rutas.presupuestoEnviado[idioma]}
        data-indice="/indice-especies.json"
        data-idioma={idioma}
        data-textos={JSON.stringify(textosScript)}
      >
        <noscript>
          <div class="rounded-panel border-2 border-oliva p-6">
            <p>{t.sinJsFormulario}</p>
            <ul class="mt-3">{contactos.map((c) => <li><strong>{c.etiqueta}:</strong> {c.valor}</li>)}</ul>
          </div>
        </noscript>

        <form method="post" action="/api/presupuesto" class="solo-js grid gap-6" novalidate>
          <div role="alert" data-error class="rounded-tarjeta border-2 border-[#9b2c1d] bg-white p-4 font-semibold text-[#9b2c1d]" hidden></div>

          <fieldset>
            <legend class={etiqueta}>{t.campoTipoPedido}</legend>
            <div class="mt-3 flex flex-wrap gap-3">
              {
                [
                  ['mayor', t.tipoPedidoMayor],
                  ['unidad', t.tipoPedidoUnidad],
                ].map(([valor, texto]) => (
                  <label class="inline-flex min-h-12 cursor-pointer items-center gap-3 rounded-tarjeta border-2 border-linea bg-white px-4 has-[:checked]:border-oliva has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-oliva">
                    <input type="radio" name="tipoPedido" value={valor} checked={valor === 'mayor'} class="size-4 accent-oliva" />
                    {texto}
                  </label>
                ))
              }
            </div>
          </fieldset>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="campo-nombre" class={etiqueta}>{t.campoNombre} <span class="font-normal text-gris">({t.obligatorio})</span></label>
              <input id="campo-nombre" name="nombre" type="text" required minlength="2" maxlength="100" autocomplete="name" class={campo} />
            </div>
            <div>
              <label for="campo-empresa" class={etiqueta}>{t.campoEmpresa}</label>
              <input id="campo-empresa" name="empresa" type="text" maxlength="120" autocomplete="organization" class={campo} />
            </div>
            <div>
              <label for="campo-email" class={etiqueta}>{t.campoEmail} <span class="font-normal text-gris">({t.obligatorio})</span></label>
              <input id="campo-email" name="email" type="email" required maxlength="254" autocomplete="email" class={campo} />
            </div>
            <div>
              <label for="campo-telefono" class={etiqueta}>{t.campoTelefono}</label>
              <input id="campo-telefono" name="telefono" type="tel" maxlength="30" autocomplete="tel" class={campo} />
            </div>
          </div>
          <div>
            <label for="campo-provincia" class={etiqueta}>{t.campoProvincia}</label>
            <select id="campo-provincia" name="provincia" autocomplete="address-level1" class={campo}>
              <option value="">{t.eligeProvincia}</option>
              {PROVINCIAS.map((p) => <option value={p}>{p}</option>)}
              <option value={t.fueraDeEspana}>{t.fueraDeEspana}</option>
            </select>
          </div>
          <div>
            <label for="campo-mensaje" class={etiqueta}>{t.campoMensaje}</label>
            <p id="ayuda-mensaje" class="mt-1 text-sm text-gris">{t.ayudaMensaje}</p>
            <textarea id="campo-mensaje" name="mensaje" rows="5" maxlength="3000" aria-describedby="ayuda-mensaje" class={campo}></textarea>
          </div>

          <!-- Campo trampa: oculto para personas, los bots suelen rellenarlo. -->
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for="campo-trampa">{t.campoTrampa}</label>
            <input id="campo-trampa" name={CAMPO_TRAMPA} type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="idioma" value={idioma} />
          <input type="hidden" name="lineas" value="[]" />

          <div class="flex items-start gap-3">
            <input id="campo-consentimiento" name="consentimiento" type="checkbox" required class="mt-0.5 size-6 shrink-0 accent-oliva" />
            <label for="campo-consentimiento" class="cursor-pointer">
              {t.campoConsentimiento.split(t.politicaPrivacidad)[0]}<a href={rutas.privacidad[idioma]} class="font-semibold underline underline-offset-4">{t.politicaPrivacidad}</a>{t.campoConsentimiento.split(t.politicaPrivacidad)[1]}
            </label>
          </div>

          {
            claveTurnstile && <div class="cf-turnstile" data-sitekey={claveTurnstile} data-language={idioma} data-theme="light" />
          }

          <div>
            <Boton type="submit" tamano="grande" flecha data-enviar>{t.enviarPeticion}</Boton>
          </div>
        </form>
      </formulario-presupuesto>

      <aside class="min-w-0 lg:col-start-2 lg:row-start-2" aria-label={t.condicionesVenta}>
        {
          contactos.length > 0 && (
            <dl class="mt-8 grid gap-4">
              {contactos.map((c) => (
                <div>
                  <dt class="antetitulo text-gris">{c.etiqueta}</dt>
                  <dd class="mt-1 font-semibold break-words">
                    {c.enlace ? <a href={c.enlace} class="underline underline-offset-4">{c.valor}</a> : c.valor}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
        <h2 class="antetitulo mt-10 text-gris">{t.condicionesVenta}</h2>
        <dl class="mt-3 border-t border-linea">
          {
            [
              [t.pedidoMinimo, condiciones.pedidoMinimo[idioma]],
              [t.plazosMayor, condiciones.plazosMayor[idioma]],
              [t.envioUnidad, condiciones.envioUnidad[idioma]],
            ].map(([etiqueta, valor]) => (
              <div class="border-b border-linea py-3">
                <dt class="rotulo text-gris">{etiqueta}</dt>
                <dd class="mt-1 text-sm">{valor}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </Contenedor>
  </Seccion>

  {claveTurnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}
</BaseLayout>

<script>
  import { almacen, totalUnidades } from '../../lib/presupuesto/lista';

  type Indice = Record<string, { nombre: Record<string, string>; cientifico: string; url: Record<string, string> }>;

  class FormularioPresupuesto extends HTMLElement {
    async connectedCallback() {
      const form = this.querySelector('form');
      const resumen = document.querySelector('[data-resumen]');
      const vacio = document.querySelector<HTMLElement>('[data-resumen-vacio]');
      const total = document.querySelector<HTMLElement>('[data-resumen-total]');
      if (!form || !resumen || !vacio || !total) return;
      const textos = JSON.parse(this.dataset.textos ?? '{}') as Record<string, string>;
      const idioma = this.dataset.idioma ?? 'es';
      const caja = form.querySelector<HTMLElement>('[data-error]')!;
      const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

      let indice: Indice = {};
      try {
        indice = (await (await fetch(this.dataset.indice ?? '/indice-especies.json')).json()) as Indice;
      } catch {
        // Sin índice se muestran los identificadores.
      }
      const pintarResumen = () => {
        const lista = almacen.leer().filter((l) => indice[l.slug]);
        vacio.hidden = lista.length > 0;
        total.hidden = lista.length === 0;
        total.textContent = (textos.total ?? '').replace('{n}', String(totalUnidades(lista)));
        resumen.replaceChildren(
          ...lista.map((l) => {
            const li = document.createElement('li');
            li.className = 'flex justify-between gap-4 border-b border-linea pb-3';
            const nombre = document.createElement('span');
            nombre.textContent = indice[l.slug]?.nombre[idioma] ?? l.slug;
            const cantidad = document.createElement('span');
            cantidad.className = 'font-semibold tabular-nums';
            cantidad.textContent = `× ${l.cantidad}`;
            li.append(nombre, cantidad);
            return li;
          }),
        );
      };
      almacen.alCambiar(pintarResumen);
      pintarResumen();

      const mostrarError = (mensaje: string) => {
        caja.textContent = mensaje;
        caja.hidden = false;
        caja.scrollIntoView({ block: 'center' });
      };

      form.addEventListener('submit', async (evento) => {
        evento.preventDefault();
        caja.hidden = true;
        for (const c of form.querySelectorAll('[aria-invalid]')) c.removeAttribute('aria-invalid');
        if (!form.checkValidity()) {
          const invalidos = [...form.querySelectorAll<HTMLInputElement>(':invalid')];
          for (const c of invalidos) c.setAttribute('aria-invalid', 'true');
          mostrarError(textos.errorCampos ?? '');
          invalidos[0]?.focus();
          return;
        }
        const datos = Object.fromEntries(new FormData(form).entries()) as Record<string, unknown>;
        datos.consentimiento = true;
        datos.lineas = almacen.leer().filter((l) => indice[l.slug]);
        boton.disabled = true;
        const textoBoton = boton.firstChild;
        if (textoBoton) textoBoton.textContent = textos.enviando ?? '';
        try {
          const respuesta = await fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(datos),
          });
          const resultado = (await respuesta.json().catch(() => ({}))) as { ok?: boolean; codigo?: string; campos?: string[] };
          if (resultado.ok) {
            almacen.guardar([]);
            location.href = this.dataset.enviado ?? '/';
            return;
          }
          if (resultado.codigo === 'datos-invalidos' && resultado.campos?.length) {
            for (const nombre of resultado.campos) form.querySelector(`[name="${nombre}"]`)?.setAttribute('aria-invalid', 'true');
            mostrarError(textos.errorCampos ?? '');
          } else if (resultado.codigo === 'antispam') {
            mostrarError(textos.errorAntispam ?? '');
          } else if (resultado.codigo === 'configuracion') {
            mostrarError(textos.errorConfiguracion ?? '');
          } else {
            mostrarError(textos.errorEnvio ?? '');
          }
        } catch {
          mostrarError(textos.errorEnvio ?? '');
        } finally {
          boton.disabled = false;
          if (textoBoton) textoBoton.textContent = textos.enviar ?? '';
          (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
        }
      });
    }
  }
  customElements.define('formulario-presupuesto', FormularioPresupuesto);
</script>
