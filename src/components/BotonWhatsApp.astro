---
/**
 * Botón flotante de WhatsApp con un mensaje prellenado según la página o la
 * especie. Solo aparece si el panel tiene un número de WhatsApp de la empresa.
 */
import { textos, type Idioma } from '../i18n/ui';
import { esPlaceholder, obtenerEmpresa } from '../lib/empresa';

interface Props {
  idioma: Idioma;
  mensaje: string;
}

const { idioma, mensaje } = Astro.props;
const { whatsapp } = await obtenerEmpresa();
const t = textos[idioma];
const enlace = esPlaceholder(whatsapp) ? null : `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensaje)}`;
---

{
  enlace && (
    <a
      href={enlace}
      target="_blank"
      rel="noopener"
      class="fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 inline-flex size-14 items-center justify-center rounded-full bg-oliva text-crema shadow-[0_12px_30px_-10px_rgb(31_42_28/0.5)] transition-transform duration-300 ease-(--ease-suave) hover:-translate-y-1 sm:right-6 sm:bottom-6"
      aria-label={t.escribirWhatsapp}
    >
      <svg class="size-7" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"
        />
      </svg>
    </a>
  )
}
