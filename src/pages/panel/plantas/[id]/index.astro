---
import PaginaPanel from '../../../../components/panel/PaginaPanel.astro';
import { formatearPrecio } from '../../../../lib/catalogo/formato';
import Icono from '../../../../components/panel/ui/Icono.astro';
import { campo, sesionCon } from '../../../../server/panel/pagina.ts';
import { puede } from '../../../../server/panel/permisos.ts';
import { plantaActual } from '../../../../server/panel/planta-actual.ts';
import { ACCIONES_RAPIDAS, accionRapida, avisosPublicacion, esAccionRapida } from '../../../../server/panel/plantas.ts';

export const prerender = false;

const s = sesionCon(Astro.locals, 'editar');
// Cambios de un toque (revisada, hay o no hay, destacada) sin entrar en cada pantalla.
if (s && Astro.request.method === 'POST' && Astro.params.id) {
  const accion = campo(await Astro.request.formData(), 'rapida');
  const r = esAccionRapida(accion) ? await accionRapida(s.repos, [Astro.params.id], accion, { email: s.usuario.email }) : { hechas: 0, errores: ['Acción desconocida.'] };
  return Astro.redirect(`/panel/plantas/${Astro.params.id}?${r.hechas ? 'hecho=1' : `error=${encodeURIComponent(r.errores.join(' '))}`}`, 303);
}
const planta = await plantaActual(s, Astro.params.id);
if (s && !planta) return Astro.redirect('/panel/plantas', 303);
const d = planta?.datos;
const base = `/panel/plantas/${Astro.params.id}`;
const hecho = Astro.url.searchParams.get('hecho');
const existencias = s && puede(s.usuario.rol, 'inventario') && Astro.params.id ? ((await s.repos.inventario.existencias())[Astro.params.id] ?? { disponible: 0, desperdicio: 0 }) : null;
---

<PaginaPanel titulo={d?.nombre?.es ?? 'Planta'} permiso="editar" volver="/panel/plantas">
  {
    d && (
      <>
        <h1 class="titular-grande">{d.nombre?.es}</h1>
        {hecho && <p role="status" class="mt-4 rounded-tarjeta bg-verdor p-3 font-semibold">{hecho === 'archivada' ? 'Planta archivada.' : 'Guardado. Saldrá en la web cuando publiques los cambios.'}</p>}
        {Astro.url.searchParams.get('error') && <p role="alert" class="mt-4 rounded-tarjeta bg-arena-prueba p-3 font-semibold">{Astro.url.searchParams.get('error')}</p>}
        {avisosPublicacion(d).map((a) => <p class="mt-3 font-semibold text-terracota">{a}</p>)}
        <form method="post" class="ajustes-planta mt-6 caja-panel">
          <div class="fila-ajuste">
            <div>
              <p class="font-semibold">Precio</p>
              <p class="text-gris">
                {formatearPrecio(d.precioDesde ?? null, 'unidad', 'es')}
                {d.ventaUnitaria ? ` · por unidad ${d.precioUnidad ? formatearPrecio(d.precioUnidad, 'unidad', 'es') : 'sí'}` : ''}
              </p>
            </div>
            <a class="boton-panel boton-panel-secundario" href={`${base}/precio`}>Cambiar<span class="sr-only"> el precio</span></a>
          </div>
          <fieldset class="fila-ajuste">
            <legend class="sr-only">¿Hay ahora?</legend>
            <p class="font-semibold" aria-hidden="true">¿Hay ahora?</p>
            <div class="flex flex-wrap gap-2">
              {(['disponible', 'bajo-pedido', 'agotado'] as const).map((v) => (
                <button class:list={['boton-panel', d.disponibilidad !== v && 'boton-panel-secundario']} name="rapida" value={v} aria-pressed={d.disponibilidad === v ? 'true' : 'false'}>{ACCIONES_RAPIDAS[v]}</button>
              ))}
            </div>
          </fieldset>
          <div class="fila-ajuste">
            <div>
              <p class="font-semibold">Fotos</p>
              <p class="text-gris">{Array.isArray(d.fotos) && d.fotos.length ? `${d.fotos.length} ${d.fotos.length === 1 ? 'foto' : 'fotos'}` : 'Sin fotos'}</p>
            </div>
            <a class="boton-panel boton-panel-secundario" href={`${base}/fotos`}>{Array.isArray(d.fotos) && d.fotos.length ? 'Ver' : 'Añadir'}<span class="sr-only"> fotos</span></a>
          </div>
          <div class="fila-ajuste">
            <div>
              <p class="font-semibold">En la web</p>
              <p class="text-gris">{d.revisado ? 'Revisada: sale al publicar' : 'Sin revisar: todavía no sale'}</p>
            </div>
            {d.revisado ? (
              <button class="boton-panel boton-panel-secundario" name="rapida" value="no-revisar">Quitar «revisada»</button>
            ) : (
              <button class="boton-panel" name="rapida" value="revisar"><Icono nombre="hecho" clase="size-5" />Marcar revisada</button>
            )}
          </div>
          {existencias && (
            <div class="fila-ajuste">
              <div>
                <p class="font-semibold">En el vivero</p>
                <p class="text-gris">{existencias.disponible} {existencias.disponible === 1 ? 'planta' : 'plantas'}</p>
              </div>
              <a class="boton-panel boton-panel-secundario" href={`/panel/inventario/${Astro.params.id}`}>Inventario</a>
            </div>
          )}
        </form>

        <details class="mt-4 caja-panel mas-opciones">
          <summary>Más opciones</summary>
          <ul class="grid gap-2 px-4 pb-4" role="list">
            <li>
              <form method="post">
                <button class="boton-panel boton-panel-secundario w-full" name="rapida" value={d.destacada ? 'no-destacar' : 'destacar'}>{d.destacada ? 'Dejar de destacar en la portada' : 'Destacar en la portada'}</button>
              </form>
            </li>
            <li><a class="boton-panel boton-panel-secundario w-full" href={`${base}/datos`}>Nombre, textos y medidas</a></li>
            <li><a class="boton-panel boton-panel-secundario w-full" href={`${base}/vista`}>Así se verá en la web</a></li>
            <li><a class="boton-panel boton-panel-secundario w-full" href={`${base}/archivar`}>Quitar de la web</a></li>
          </ul>
        </details>
      </>
    )
  }
</PaginaPanel>

<style>
  .ajustes-planta {
    display: grid;
  }
  .fila-ajuste {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border: 0;
    border-bottom: 1px solid var(--color-linea);
    margin: 0;
    padding: 1rem;
  }
  .fila-ajuste:last-child {
    border-bottom: 0;
  }
  .mas-opciones summary {
    display: flex;
    min-height: 3rem;
    cursor: pointer;
    align-items: center;
    padding: 0 1rem;
    font-weight: 600;
  }
</style>
