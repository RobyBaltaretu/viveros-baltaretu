---
import GestorFotos from '../../../../components/panel/GestorFotos.astro';
import Mensajes from '../../../../components/panel/Mensajes.astro';
import PaginaPanel from '../../../../components/panel/PaginaPanel.astro';
import type { ErrorCampo } from '../../../../server/contenido/validacion.ts';
import { fotosDeFicha, formularioFotos, MENSAJES_FOTOS } from '../../../../server/panel/fotos.ts';
import { sesionCon } from '../../../../server/panel/pagina.ts';
import { plantaActual } from '../../../../server/panel/planta-actual.ts';

export const prerender = false;

const s = sesionCon(Astro.locals, 'editar');
const planta = await plantaActual(s, Astro.params.id);
if (s && !planta) return Astro.redirect('/panel/plantas', 303);
const base = `/panel/plantas/${Astro.params.id}/fotos`;
let errores: ErrorCampo[] = [];
if (s && planta && Astro.request.method === 'POST') {
  const { accion, r } = await formularioFotos(s.repos, 'catalogo', planta.entrada.id, planta.datos, await Astro.request.formData(), s.usuario.email);
  if (r.ok) return Astro.redirect(`${base}?hecho=${accion}`, 303);
  errores = r.errores;
}
const actual = s && planta ? await plantaActual(s, Astro.params.id) : null;
const hecho = Astro.url.searchParams.get('hecho');
---

<PaginaPanel titulo="Fotos" permiso="editar" volver={`/panel/plantas/${Astro.params.id}`}>
  <h1 class="titular-grande">Fotos de {actual?.datos.nombre?.es}</h1>
  <Mensajes hecho={hecho ? MENSAJES_FOTOS[hecho] : undefined} errores={errores} />
  <GestorFotos fotos={actual ? fotosDeFicha(actual.datos) : []} vacio="Esta planta todavía no tiene fotos. En la web se ve un dibujo hasta que añadas una." />
</PaginaPanel>
