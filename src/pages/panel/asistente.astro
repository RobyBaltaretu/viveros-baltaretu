---
import { env } from 'cloudflare:workers';
import PaginaPanel from '../../components/panel/PaginaPanel.astro';
import Icono from '../../components/panel/ui/Icono.astro';
import type { Propuesta } from '../../server/data/tipos.ts';
import { borrarConversacion, conversar, enviarFotos, modelosDe, responderPropuesta, usoDeHoy } from '../../server/asistente/agente.ts';
import { HERRAMIENTA_FOTOS, MAXIMO_FOTOS_CHAT, miniaturas } from '../../server/asistente/fotos.ts';
import { SUGERENCIAS, textoSeguro } from '../../server/asistente/formato.ts';
import { MAXIMO_TEXTO, type BindingAI } from '../../server/asistente/interprete.ts';
import { hoy } from '../../server/gastos/gastos.ts';
import { campo, sesionCon } from '../../server/panel/pagina.ts';
import { puede } from '../../server/panel/permisos.ts';
import type { EntornoPublicar } from '../../server/panel/publicar.ts';
import { clienteActual } from '../../plataforma/actual.ts';
import { processCarpentryAssistantMessage } from '../../services/aiAssistantService.ts';

export const prerender = false;

const cliente = clienteActual();
const esCarpinteria = cliente.sector === 'carpinteria';
const NOMBRE = esCarpinteria ? 'Asistente Operativo' : 'AgricolAI';

const s = sesionCon(Astro.locals, 'asistente');
const entorno = env as EntornoPublicar & { AI?: BindingAI; GROQ_API_KEY?: string };
const ctx = s ? { repos: s.repos, usuario: s.usuario, hoy: hoy(), env: entorno } : null;
const conFotos = !esCarpinteria && !!s && puede(s.usuario.rol, 'editar');

if (s && ctx && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = campo(form, 'accion');
  if (accion === 'nueva') await s.repos.conversaciones.nueva(s.usuario.email);
  else if (accion === 'abrir') await s.repos.conversaciones.abrir(s.usuario.email, campo(form, 'conversacion'));
  else if (accion === 'borrar') await borrarConversacion(ctx, campo(form, 'conversacion'));
  else if (accion === 'si' || accion === 'no') await responderPropuesta(ctx, campo(form, 'propuesta'), accion === 'si');
  else {
    const textoMensaje = campo(form, 'texto');
    if (esCarpinteria) {
      if (textoMensaje) {
        const conversacionId = await s.repos.conversaciones.actual(s.usuario.email);
        await s.repos.conversaciones.anadir({ conversacion: conversacionId, rol: 'usuario', texto: textoMensaje, propuestas: [] });

        const result = await processCarpentryAssistantMessage(textoMensaje, {
          repos: s.repos,
          email: s.usuario.email,
        });

        let extraText = result.text;
        if (result.actionExecuted) {
          extraText += `\n\n[Acción «${result.actionExecuted.title}»: ${result.actionExecuted.summary}]`;
        }

        await s.repos.conversaciones.anadir({
          conversacion: conversacionId,
          rol: 'asistente',
          texto: extraText,
          propuestas: [],
        });
      }
    } else {
      // Viveros Baltaretu
      const archivos = form.getAll('foto').filter((f): f is File => f instanceof File && f.size > 0);
      if (archivos.length && conFotos) {
        const plantas = form.getAll('fotoPlanta').map(String);
        const fotos = await Promise.all(archivos.map(async (f, i) => ({ bytes: new Uint8Array(await f.arrayBuffer()), planta: plantas.length === 1 ? plantas[0] : (plantas[i] ?? '') })));
        await enviarFotos(ctx, fotos);
      }
      if (textoMensaje) await conversar(ctx, textoMensaje, await modelosDe(entorno));
    }
  }
  return Astro.redirect('/panel/asistente#final', 303);
}

const conversacion = s ? await s.repos.conversaciones.actual(s.usuario.email) : '';
const mensajes = s ? await s.repos.conversaciones.mensajes(conversacion, 60) : [];
const propuestas = new Map<string, Propuesta>(s ? (await s.repos.conversaciones.propuestas(mensajes.flatMap((m) => m.propuestas))).map((p) => [p.id, p]) : []);
const uso = s ? await usoDeHoy(s.repos, s.usuario.email) : null;
const anteriores = s ? await s.repos.conversaciones.listar(s.usuario.email, 50) : [];
const diaDe = (iso: string) => new Date(iso).toLocaleDateString('sv-SE', { timeZone: 'Europe/Madrid' });
const cuando = (iso: string) => {
  const d = diaDe(iso);
  const hoyEs = diaDe(new Date().toISOString());
  const ayer = diaDe(new Date(Date.now() - 86_400_000).toISOString());
  const h = new Date(iso).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' });
  if (d === hoyEs) return `Hoy, ${h}`;
  if (d === ayer) return `Ayer, ${h}`;
  return new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: d.slice(0, 4) === hoyEs.slice(0, 4) ? undefined : 'numeric', timeZone: 'Europe/Madrid' });
};
const plantas = conFotos && s ? (await s.repos.contenido.listar('catalogo')).map((e) => ({ id: e.id, nombre: String((e.borrador.datos.nombre as { es?: string } | undefined)?.es ?? e.id) })).sort((a, b) => a.nombre.localeCompare(b.nombre, 'es')) : [];

const ESTADO: Record<Propuesta['estado'], string> = { pendiente: '', aplicada: 'Hecho', rechazada: 'No aplicado', fallida: 'No se pudo' };
const nombre = s?.usuario.nombre || s?.usuario.email.split('@')[0] || '';
const primerNombre = nombre.split(' ')[0];
const iniciales =
  nombre
    .split(/[\s._-]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase())
    .join('') || 'Tú';
const hora = (iso: string) => new Date(iso.includes('T') ? iso : `${iso.replace(' ', 'T')}Z`).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' });
const conIA = esCarpinteria ? true : Boolean(entorno.AI || entorno.GROQ_API_KEY);
const pct = (a: number, b: number) => Math.min(100, Math.round((a / Math.max(1, b)) * 100));
const quedanMensajes = uso ? Math.max(0, uso.limiteMensajes - uso.mensajes) : 0;
const iaGastada = uso ? pct(uso.neuronas, uso.limiteNeuronas) : 0;
const miles = (n: number) => new Intl.NumberFormat('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions).format(n);
const sinCupo = !esCarpinteria && !!uso && (quedanMensajes === 0 || iaGastada >= 100);

const SUGERENCIAS_CARPINTERIA = [
  'Crear borrador de factura de 580€ para Cliente Taller',
  'Dar de alta tablero Roble Maya 19mm a 48.50€',
  'Consultar inventario de tableros en almacén',
  'Calcular presupuesto reforma cocina 12m2 calidad premium',
];
---

<PaginaPanel titulo={NOMBRE} permiso="asistente">
  <div class="chat-agricolai space-y-4">
    <!-- Diálogo Ajustes Token HF (Carpintería) -->
    {
      esCarpinteria && (
        <dialog id="dialogo-ajustes-hf" class="m-auto w-full max-w-md rounded-2xl border border-linea bg-papel p-6 shadow-2xl backdrop:bg-tinta/50">
          <div class="space-y-4">
            <div class="flex items-center justify-between border-b border-linea pb-3">
              <h3 class="font-titular text-lg font-bold text-tinta">Configuración Token Hugging Face</h3>
              <button type="button" id="btn-cerrar-ajustes-hf" class="rounded-lg p-1 text-gris hover:bg-crema">
                <Icono nombre="cerrar" clase="size-5" />
              </button>
            </div>
            <p class="text-xs text-gris">
              El asistente funciona con Llama 3.3 70B / Qwen 2.5 mediante la API de Hugging Face. Puedes introducir tu token gratuito <code>VITE_HF_TOKEN</code> aquí:
            </p>
            <div>
              <label for="hf-token-chat" class="block text-xs font-bold text-tinta mb-1">
                Token Gratuito (hf_...)
              </label>
              <input
                type="password"
                id="hf-token-chat"
                placeholder="hf_..."
                class="w-full rounded-xl border border-linea px-3 py-2 text-sm text-tinta focus:border-terracota focus:outline-hidden"
              />
              <span class="text-[11px] text-gris">Consíguelo gratis sin tarjeta en <a href="https://huggingface.co/settings/tokens" target="_blank" rel="noopener" class="underline text-terracota">huggingface.co/settings/tokens</a>.</span>
            </div>
            <div class="flex justify-end gap-2 pt-2">
              <button type="button" id="btn-guardar-ajustes-hf" class="rounded-xl bg-terracota px-4 py-2 text-sm font-semibold text-papel hover:opacity-90">
                Guardar
              </button>
            </div>
          </div>
        </dialog>
      )
    }

    <header class="cabecera-chat caja-panel">
      <div class="flex min-w-0 items-center gap-3">
        <span class="avatar avatar-ia avatar-grande" aria-hidden="true"><Icono nombre="asistente" clase="size-6" /></span>
        <div class="min-w-0">
          <h1 class="titular-medio leading-tight">{NOMBRE}</h1>
          <p class="flex items-center gap-1.5 text-base text-gris">
            <span class:list={['punto-estado', conIA && !sinCupo ? 'punto-activo' : 'punto-basico']} aria-hidden="true"></span>
            {
              esCarpinteria
                ? 'Modelo Open Source (Llama 3.3 70B / Qwen 2.5)'
                : conIA && !sinCupo
                ? 'Tu asistente del vivero'
                : 'Modo básico (sin IA)'
            }
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        {
          esCarpinteria && (
            <button
              type="button"
              id="btn-abrir-ajustes-hf"
              class="boton-panel boton-panel-secundario !p-2.5"
              title="Configurar Token Hugging Face (⚙️)"
            >
              <Icono nombre="personas" clase="size-5 text-terracota" />
              <span class="sr-only sm:not-sr-only">Token ⚙️</span>
            </button>
          )
        }
        <form method="post">
          <input type="hidden" name="accion" value="nueva" />
          <button class="boton-panel boton-panel-secundario">
            <Icono nombre="conversacion" clase="size-5" />
            Nueva<span class="sr-only sm:not-sr-only">&nbsp;conversación</span>
          </button>
        </form>
      </div>

      {
        anteriores.length > 0 && (
          <details class="historial" open={mensajes.length === 0 ? true : undefined}>
            <summary>
              <Icono nombre="cambios" clase="size-5" />
              Conversaciones anteriores <span class="tabular text-gris">({anteriores.length})</span>
            </summary>
            <ul class="lista-historial" role="list">
              {anteriores.map((c) => (
                <li class:list={['conversacion-anterior', c.id === conversacion && 'conversacion-abierta']}>
                  <form method="post" class="min-w-0 flex-1">
                    <input type="hidden" name="accion" value="abrir" />
                    <input type="hidden" name="conversacion" value={c.id} />
                    <button class="abrir-conversacion" aria-current={c.id === conversacion ? 'true' : undefined} aria-label={`${c.id === conversacion ? 'Abierta ahora' : 'Abrir'}: ${c.titulo}, ${cuando(c.usada)}`}>
                      <span class="titulo-conversacion">{c.titulo}</span>
                      <span class="text-sm text-gris">
                        {cuando(c.usada)} · {c.mensajes} {c.mensajes === 1 ? 'mensaje' : 'mensajes'}
                        {c.id === conversacion ? ' · abierta ahora' : ''}
                      </span>
                    </button>
                  </form>
                  <form method="post" data-confirmar="¿Borrar esta conversación? Lo que ya se aplicó no se deshace.">
                    <input type="hidden" name="accion" value="borrar" />
                    <input type="hidden" name="conversacion" value={c.id} />
                    <button class="boton-icono" aria-label={`Borrar la conversación «${c.titulo}»`} title="Borrar">
                      <Icono nombre="borrar" clase="size-5" />
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          </details>
        )
      }
      {
        !esCarpinteria && uso && (
          <details id="uso" class="uso">
            <summary>
              <span class="ficha-uso">
                <Icono nombre="enviar" clase="size-4" />
                <span class="tabular">{quedanMensajes}</span>&nbsp;mensajes te quedan hoy
              </span>
              <span class="ficha-uso">
                <Icono nombre="asistente" clase="size-4" />
                IA&nbsp;<span class="tabular">{100 - iaGastada} %</span>&nbsp;libre
              </span>
              <span class="ver-uso">Ver uso</span>
            </summary>
            <div class="grid gap-2 pt-3">
              <div class="uso-fila">
                <p>
                  <span class="font-semibold">Tus mensajes hoy:</span> <span class="tabular">{uso.mensajes}</span> de <span class="tabular">{uso.limiteMensajes}</span>
                  <span class="text-gris"> · te quedan {quedanMensajes}</span>
                </p>
                <span class="barra" aria-hidden="true">
                  <span class:list={['relleno', pct(uso.mensajes, uso.limiteMensajes) >= 90 && 'relleno-alto']} style={`width: ${pct(uso.mensajes, uso.limiteMensajes)}%`} />
                </span>
              </div>
              <div class="uso-fila">
                <p>
                  <span class="font-semibold">IA gratuita del vivero hoy (para todos):</span> <span class="tabular">{iaGastada} %</span> usado
                  <span class="text-gris">
                    {' '}
                    ({miles(uso.neuronas)} de {miles(uso.limiteNeuronas)} neuronas)
                  </span>
                </p>
                <span class="barra" aria-hidden="true">
                  <span class:list={['relleno', iaGastada >= 90 && 'relleno-alto']} style={`width: ${iaGastada}%`} />
                </span>
              </div>
              <p class="text-sm text-gris">
                Se renueva cada día a las {uso.renueva}. Sin cupo, {NOMBRE} sigue en modo básico. Las fotos y los botones «Sí» y «No» no gastan.
              </p>
            </div>
          </details>
        )
      }
    </header>

    <section id="conversacion" class="conversacion mt-6 grid gap-5" aria-label={`Conversación con ${NOMBRE}`} aria-live="polite">
      {
        mensajes.length === 0 && (
          <div class="vacio grid justify-items-center gap-3 px-2 py-6 text-center">
            <span class="avatar avatar-ia avatar-enorme" aria-hidden="true">
              <Icono nombre="asistente" clase="size-9" />
            </span>
            <h2 class="titular-medio">{primerNombre ? `Hola, ${primerNombre}. Soy ${NOMBRE}.` : `Hola, soy ${NOMBRE}.`}</h2>
            <p class="max-w-md text-gris">
              {
                esCarpinteria
                  ? 'Pregúntame para crear facturas o albaranes, registrar materiales en el catálogo, consultar stock del taller o calcular un presupuesto de reforma.'
                  : `Pregúntame por ventas, facturas, gastos o plantas. ${conFotos ? 'Puedes enviarme fotos para tus plantas. ' : ''}Nada se cambia hasta que pulses «Sí».`
              }
            </p>
            <ul class="mt-2 flex flex-wrap justify-center gap-2" role="list" aria-label="Sugerencias">
              {(esCarpinteria ? SUGERENCIAS_CARPINTERIA : SUGERENCIAS).map((t) => (
                <li>
                  <button type="button" class="sugerencia" data-sugerencia={t}>
                    {t}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        mensajes.map((m) => {
          const suyas = m.propuestas.map((id) => propuestas.get(id)).filter((p): p is Propuesta => !!p);
          const usuario = m.rol === 'usuario';
          return (
            <article class:list={['fila', usuario ? 'fila-usuario' : 'fila-ia']} aria-label={`${usuario ? 'Tú' : NOMBRE}, ${hora(m.fecha)}`}>
              <span class:list={['avatar', usuario ? 'avatar-usuario' : 'avatar-ia']} aria-hidden="true">
                {usuario ? iniciales : <Icono nombre="asistente" clase="size-5" />}
              </span>
              <div class="grid min-w-0 gap-1">
                <p class="autor" aria-hidden="true">
                  {usuario ? 'Tú' : NOMBRE} · <time datetime={m.fecha}>{hora(m.fecha)}</time>
                </p>
                <div class:list={['burbuja', usuario ? 'burbuja-usuario' : 'burbuja-ia']}>
                  {usuario ? <p class="whitespace-pre-line">{m.texto}</p> : <div class="texto-ia" set:html={textoSeguro(m.texto)} />}
                  {usuario &&
                    suyas.flatMap(miniaturas).length > 0 && (
                      <div class="miniaturas mt-2">
                        {suyas.flatMap(miniaturas).map((src) => (
                          <img src={src} alt="Foto enviada" loading="lazy" />
                        ))}
                      </div>
                    )}
                  {!usuario &&
                    suyas.map((p) => (
                      <div class:list={['propuesta', `propuesta-${p.estado}`]}>
                        <p class="flex items-start gap-2 font-semibold">
                          <Icono nombre={p.estado === 'aplicada' ? 'hecho' : p.estado === 'pendiente' ? (p.herramienta === HERRAMIENTA_FOTOS ? 'fotos' : 'asistente') : 'aviso'} clase="mt-0.5 size-5 text-oliva" />
                          <span>{p.resumen}</span>
                        </p>
                        {p.herramienta === HERRAMIENTA_FOTOS && p.estado === 'pendiente' && (
                          <div class="miniaturas mt-3">
                            {miniaturas(p).map((src) => (
                              <img src={src} alt="Foto para añadir" loading="lazy" />
                            ))}
                          </div>
                        )}
                        {p.estado === 'pendiente' ? (
                          <form method="post" class="mt-3 flex flex-wrap gap-2">
                            <input type="hidden" name="propuesta" value={p.id} />
                            <button name="accion" value="si" class="boton-panel">
                              <Icono nombre="hecho" clase="size-5" />
                              Sí, hazlo
                            </button>
                            <button name="accion" value="no" class="boton-panel boton-panel-secundario">
                              No
                            </button>
                          </form>
                        ) : (
                          <p class="mt-2 text-base text-gris">
                            {ESTADO[p.estado]}
                            {p.resultado && p.estado !== 'rechazada' ? `: ${p.resultado}` : ''}
                          </p>
                        )}
                      </div>
                    ))}
                </div>
              </div>
            </article>
          );
        })
      }
      <div id="final"></div>
    </section>

    <form method="post" enctype="multipart/form-data" class="redactor caja-panel mt-6 grid gap-2 p-2 sm:p-3" data-redactor data-es-carpinteria={esCarpinteria ? '1' : '0'}>
      {
        conFotos && (
          <div class="bandeja" data-bandeja hidden>
            <ul class="grid gap-2" role="list" aria-label="Fotos para enviar" data-lista-fotos />
            <p class="text-sm text-gris">Elige de qué planta es cada foto. Al enviar, te pediré que lo confirmes.</p>
          </div>
        )
      }
      {
        conFotos && (
          <div class="planta-todas" data-sin-js>
            <label for="foto-planta" class="text-base font-semibold">
              Planta de las fotos
            </label>
            <select id="foto-planta" name="fotoPlanta" class="campo-panel">
              <option value="">Elige la planta…</option>
              {plantas.map((p) => (
                <option value={p.id}>{p.nombre}</option>
              ))}
            </select>
          </div>
        )
      }
      <label for="texto" class="sr-only">Escribe a {NOMBRE}</label>
      <div class="flex items-end gap-2">
        <button type="submit" form="form-nueva" class="boton-icono" aria-label="Nueva conversación" title="Nueva conversación">
          <Icono nombre="conversacion" clase="size-5" />
        </button>
        {
          conFotos && (
            <span class="boton-icono boton-foto" title="Añadir fotos para las plantas">
              <Icono nombre="anadirFoto" clase="size-5" />
              <input type="file" name="foto" accept="image/jpeg,image/png,image/webp" multiple data-maximo={MAXIMO_FOTOS_CHAT} aria-label="Añadir fotos para las plantas" data-fotos />
            </span>
          )
        }
        <textarea id="texto" name="texto" rows="1" maxlength={MAXIMO_TEXTO} placeholder="Escribe aquí…" class="campo-panel max-h-40 min-h-12 flex-1 resize-none" autocomplete="off" aria-describedby="ayuda-redactor"></textarea>
        <button class="boton-panel !px-4" aria-label="Enviar" data-enviar>
          <Icono nombre="enviar" clase="size-5" />
          <span class="hidden sm:inline">Enviar</span>
        </button>
      </div>
      <p id="ayuda-redactor" class="ayuda-redactor">
        <span class="hidden sm:inline">Intro para enviar · Mayúsculas + Intro para otra línea</span>
        <span data-contador hidden></span>
      </p>
    </form>
    <form method="post" id="form-nueva" hidden>
      <input type="hidden" name="accion" value="nueva" />
    </form>
    {
      conFotos && (
        <template id="opciones-plantas">
          <option value="">Elige la planta…</option>
          {plantas.map((p) => (
            <option value={p.id}>{p.nombre}</option>
          ))}
        </template>
      )
    }
  </div>
</PaginaPanel>

<style is:global>
  /* Global a propósito: el script también pinta mensajes y tienen que verse igual. */
  .chat-agricolai .cabecera-chat {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
  }
  .chat-agricolai .uso {
    grid-column: 1 / -1;
    border-top: 1px solid var(--color-linea);
    padding-top: 0.5rem;
    font-size: 0.9375rem;
  }
  .chat-agricolai .historial {
    grid-column: 1 / -1;
    border-top: 1px solid var(--color-linea);
    padding-top: 0.25rem;
  }
  .chat-agricolai .historial summary {
    display: flex;
    min-height: 3rem;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-weight: 600;
    color: var(--color-oliva);
  }
  .chat-agricolai .lista-historial {
    display: grid;
    max-height: 22rem;
    gap: 0.25rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: 0.25rem;
  }
  .chat-agricolai .conversacion-anterior {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    border-radius: 0.875rem;
  }
  .chat-agricolai .conversacion-abierta {
    background: var(--color-verdor);
  }
  .chat-agricolai .abrir-conversacion {
    display: grid;
    width: 100%;
    min-height: 3rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.875rem;
    text-align: left;
    transition: background-color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
