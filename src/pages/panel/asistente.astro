---
import { env } from 'cloudflare:workers';
import PaginaPanel from '../../components/panel/PaginaPanel.astro';
import PasoAsistente from '../../components/panel/PasoAsistente.astro';
import { aplicarAccion, PERMISO, prepararAccion, type Preparada } from '../../server/asistente/acciones.ts';
import { accionDesdeFormulario, OPCIONES_GUIADO } from '../../server/asistente/formulario.ts';
import { atenderMensaje } from '../../server/asistente/conversacion.ts';
import { MAXIMO_TEXTO, type BindingAI } from '../../server/asistente/interprete.ts';
import { campo, sesionCon } from '../../server/panel/pagina.ts';
import { puede } from '../../server/panel/permisos.ts';
import type { DatosPlanta } from '../../server/panel/plantas.ts';

export const prerender = false;

const s = sesionCon(Astro.locals, 'asistente');
let paso: Preparada | null = null;
let escrito = '';
let aviso = '';
if (s && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const que = campo(form, 'paso');
  const accion = accionDesdeFormulario(form);
  if (que === 'texto') {
    escrito = campo(form, 'texto').slice(0, MAXIMO_TEXTO);
    const r = await atenderMensaje(s.repos, s.usuario, escrito, { ai: (env as { AI?: BindingAI }).AI });
    paso = r.paso;
    aviso = r.aviso ?? '';
  } else if (!accion) paso = { estado: 'no-puedo', texto: 'Eso no lo sé hacer.' };
  else if (que === 'cancelar') paso = { estado: 'respuesta', texto: 'Vale, no he cambiado nada.' };
  else if (que === 'confirmar') {
    const r = await aplicarAccion(s.repos, s.usuario.rol, s.usuario.email, accion);
    paso = { estado: r.ok ? 'respuesta' : 'no-puedo', texto: r.texto };
  } else paso = await prepararAccion(s.repos, s.usuario.rol, accion);
}
const plantas = s
  ? (await s.repos.contenido.listar('catalogo'))
      .map((e) => ({ id: e.id, nombre: String((e.borrador.datos as DatosPlanta).nombre?.es ?? e.id) }))
      .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'))
  : [];
const opciones = s ? OPCIONES_GUIADO.filter((o) => puede(s.usuario.rol, PERMISO[o.tipo])) : [];
const terminado = paso && (paso.estado === 'respuesta' || paso.estado === 'no-puedo');
---

<PaginaPanel titulo="Asistente" permiso="asistente">
  <h1 class="titular-grande">Asistente</h1>
  <p class="mt-4">Te ayudo con lo más habitual, paso a paso. Nada se cambia sin que digas «Sí».</p>
  <form method="post" class="mt-6 grid gap-3">
    <input type="hidden" name="paso" value="texto" />
    <label for="texto" class="font-semibold">Escribe lo que quieres hacer</label>
    <p id="texto-ayuda" class="text-base text-gris">Por ejemplo: «sube la Washingtonia a 20», «no quedan yucas» o «¿hay presupuestos nuevos?».</p>
    <input id="texto" name="texto" value={escrito} maxlength={MAXIMO_TEXTO} autocomplete="off" class="campo-panel" aria-describedby="texto-ayuda" />
    <p><button class="boton-panel">Enviar</button></p>
  </form>
  {aviso && <p class="mt-6 rounded-tarjeta bg-verdor p-3">{aviso}</p>}
  {paso && <div class="mt-6"><PasoAsistente paso={paso} plantas={plantas} /></div>}
  {
    (!paso || terminado) && (
      <form method="post" class="mt-6 grid gap-3">
        <h2 class="titular-medio">{terminado ? '¿Algo más?' : '¿Qué quieres hacer?'}</h2>
        <input type="hidden" name="paso" value="preparar" />
        <div class="grid gap-3 sm:grid-cols-2">
          {opciones.map((o) => (
            <button class="boton-panel boton-panel-secundario" name="tipo" value={o.tipo}>
              {o.texto}
            </button>
          ))}
        </div>
      </form>
    )
  }
</PaginaPanel>
