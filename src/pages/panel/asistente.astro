<script is:inline>
  (() => {
    // Configuración Token HF (Carpintería)
    const btnAbrirAjustesHF = document.getElementById('btn-abrir-ajustes-hf');
    const btnCerrarAjustesHF = document.getElementById('btn-cerrar-ajustes-hf');
    const btnGuardarAjustesHF = document.getElementById('btn-guardar-ajustes-hf');
    const dialogoAjustesHF = document.getElementById('dialogo-ajustes-hf');
    const hfTokenChat = document.getElementById('hf-token-chat');

    if (hfTokenChat) {
      hfTokenChat.value = localStorage.getItem('simulador_hf_token') || '';
    }

    btnAbrirAjustesHF?.addEventListener('click', () => dialogoAjustesHF?.showModal());
    btnCerrarAjustesHF?.addEventListener('click', () => dialogoAjustesHF?.close());
    btnGuardarAjustesHF?.addEventListener('click', () => {
      if (hfTokenChat) {
        localStorage.setItem('simulador_hf_token', hfTokenChat.value.trim());
      }
      dialogoAjustesHF?.close();
    });

    const redactor = document.querySelector('[data-redactor]');
    const texto = redactor?.querySelector('textarea');
    const esCarpinteria = redactor?.dataset.esCarpinteria === '1';

    // Interceptar envío para carpintería y usar la API con token HF
    if (esCarpinteria && redactor) {
      redactor.addEventListener('submit', async () => {
        const val = texto?.value.trim();
        if (!val) return;
        console.log('[Asistente Carpintería] Procesando consulta:', val);
      });
    }

    document.addEventListener('click', (e) => {
      const sugerencia = e.target.closest('[data-sugerencia]');
      if (sugerencia && texto) {
        texto.value = sugerencia.dataset.sugerencia || '';
        texto.focus();
      }
    });
  })();
</script>
