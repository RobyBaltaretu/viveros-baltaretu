---
import { env } from 'cloudflare:workers';
import PaginaPanel from '../../components/panel/PaginaPanel.astro';
import Icono from '../../components/panel/ui/Icono.astro';
import type { Propuesta } from '../../server/data/tipos.ts';
import { borrarConversacion, conversar, enviarFotos, modelosDe, responderPropuesta, usoDeHoy } from '../../server/asistente/agente.ts';
import { HERRAMIENTA_FOTOS, MAXIMO_FOTOS_CHAT, miniaturas } from '../../server/asistente/fotos.ts';
import { SUGERENCIAS, textoSeguro } from '../../server/asistente/formato.ts';
import { MAXIMO_TEXTO, type BindingAI } from '../../server/asistente/interprete.ts';
import { hoy } from '../../server/gastos/gastos.ts';
import { campo, sesionCon } from '../../server/panel/pagina.ts';
import { puede } from '../../server/panel/permisos.ts';
import type { EntornoPublicar } from '../../server/panel/publicar.ts';

export const prerender = false;

const NOMBRE = 'AgricolAI';
const s = sesionCon(Astro.locals, 'asistente');
const entorno = env as EntornoPublicar & { AI?: BindingAI; GROQ_API_KEY?: string };
const ctx = s ? { repos: s.repos, usuario: s.usuario, hoy: hoy(), env: entorno } : null;
const conFotos = !!s && puede(s.usuario.rol, 'editar');
if (s && ctx && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = campo(form, 'accion');
  if (accion === 'nueva') await s.repos.conversaciones.nueva(s.usuario.email);
  else if (accion === 'abrir') await s.repos.conversaciones.abrir(s.usuario.email, campo(form, 'conversacion'));
  else if (accion === 'borrar') await borrarConversacion(ctx, campo(form, 'conversacion'));
  else if (accion === 'si' || accion === 'no') await responderPropuesta(ctx, campo(form, 'propuesta'), accion === 'si');
  else {
    // Fotos (cada una con su planta; sin JavaScript, una planta para todas) y después el texto.
    const archivos = form.getAll('foto').filter((f): f is File => f instanceof File && f.size > 0);
    if (archivos.length && conFotos) {
      const plantas = form.getAll('fotoPlanta').map(String);
      const fotos = await Promise.all(archivos.map(async (f, i) => ({ bytes: new Uint8Array(await f.arrayBuffer()), planta: plantas.length === 1 ? plantas[0] : (plantas[i] ?? '') })));
      await enviarFotos(ctx, fotos);
    }
    if (campo(form, 'texto')) await conversar(ctx, campo(form, 'texto'), await modelosDe(entorno));
  }
  // Siempre se vuelve a la conversación (recargar no repite el mensaje).
  return Astro.redirect('/panel/asistente#final', 303);
}
const conversacion = s ? await s.repos.conversaciones.actual(s.usuario.email) : '';
const mensajes = s ? await s.repos.conversaciones.mensajes(conversacion, 60) : [];
const propuestas = new Map<string, Propuesta>(s ? (await s.repos.conversaciones.propuestas(mensajes.flatMap((m) => m.propuestas))).map((p) => [p.id, p]) : []);
const uso = s ? await usoDeHoy(s.repos, s.usuario.email) : null;
const anteriores = s ? await s.repos.conversaciones.listar(s.usuario.email, 50) : [];
const diaDe = (iso: string) => new Date(iso).toLocaleDateString('sv-SE', { timeZone: 'Europe/Madrid' });
const cuando = (iso: string) => {
  const d = diaDe(iso);
  const hoyEs = diaDe(new Date().toISOString());
  const ayer = diaDe(new Date(Date.now() - 86_400_000).toISOString());
  const h = new Date(iso).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' });
  if (d === hoyEs) return `Hoy, ${h}`;
  if (d === ayer) return `Ayer, ${h}`;
  return new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: d.slice(0, 4) === hoyEs.slice(0, 4) ? undefined : 'numeric', timeZone: 'Europe/Madrid' });
};
const plantas = conFotos && s ? (await s.repos.contenido.listar('catalogo')).map((e) => ({ id: e.id, nombre: String((e.borrador.datos.nombre as { es?: string } | undefined)?.es ?? e.id) })).sort((a, b) => a.nombre.localeCompare(b.nombre, 'es')) : [];

const ESTADO: Record<Propuesta['estado'], string> = { pendiente: '', aplicada: 'Hecho', rechazada: 'No aplicado', fallida: 'No se pudo' };
const nombre = s?.usuario.nombre || s?.usuario.email.split('@')[0] || '';
const primerNombre = nombre.split(' ')[0];
const iniciales =
  nombre
    .split(/[\s._-]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase())
    .join('') || 'Tú';
const hora = (iso: string) => new Date(iso.includes('T') ? iso : `${iso.replace(' ', 'T')}Z`).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' });
const conIA = Boolean(entorno.AI || entorno.GROQ_API_KEY);
const pct = (a: number, b: number) => Math.min(100, Math.round((a / Math.max(1, b)) * 100));
const quedanMensajes = uso ? Math.max(0, uso.limiteMensajes - uso.mensajes) : 0;
const iaGastada = uso ? pct(uso.neuronas, uso.limiteNeuronas) : 0;
const miles = (n: number) => new Intl.NumberFormat('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions).format(n);
const sinCupo = !!uso && (quedanMensajes === 0 || iaGastada >= 100);
---

<PaginaPanel titulo={NOMBRE} permiso="asistente">
  <div class="chat-agricolai">
    <header class="cabecera-chat caja-panel">
      <div class="flex min-w-0 items-center gap-3">
        <span class="avatar avatar-ia avatar-grande" aria-hidden="true"><Icono nombre="asistente" clase="size-6" /></span>
        <div class="min-w-0">
          <h1 class="titular-medio leading-tight">{NOMBRE}</h1>
          <p class="flex items-center gap-1.5 text-base text-gris">
            <span class:list={['punto-estado', conIA && !sinCupo ? 'punto-activo' : 'punto-basico']} aria-hidden="true"></span>
            {conIA && !sinCupo ? 'Tu asistente del vivero' : 'Modo básico (sin IA)'}
          </p>
        </div>
      </div>
      <form method="post">
        <input type="hidden" name="accion" value="nueva" />
        <button class="boton-panel boton-panel-secundario">
          <Icono nombre="conversacion" clase="size-5" />
          Nueva<span class="sr-only sm:not-sr-only">&nbsp;conversación</span>
        </button>
      </form>
      {
        anteriores.length > 0 && (
          <details class="historial" open={mensajes.length === 0 ? true : undefined}>
            <summary>
              <Icono nombre="cambios" clase="size-5" />
              Conversaciones anteriores <span class="tabular text-gris">({anteriores.length})</span>
            </summary>
            <ul class="lista-historial" role="list">
              {anteriores.map((c) => (
                <li class:list={['conversacion-anterior', c.id === conversacion && 'conversacion-abierta']}>
                  <form method="post" class="min-w-0 flex-1">
                    <input type="hidden" name="accion" value="abrir" />
                    <input type="hidden" name="conversacion" value={c.id} />
                    <button class="abrir-conversacion" aria-current={c.id === conversacion ? 'true' : undefined} aria-label={`${c.id === conversacion ? 'Abierta ahora' : 'Abrir'}: ${c.titulo}, ${cuando(c.usada)}`}>
                      <span class="titulo-conversacion">{c.titulo}</span>
                      <span class="text-sm text-gris">
                        {cuando(c.usada)} · {c.mensajes} {c.mensajes === 1 ? 'mensaje' : 'mensajes'}
                        {c.id === conversacion ? ' · abierta ahora' : ''}
                      </span>
                    </button>
                  </form>
                  <form method="post" data-confirmar="¿Borrar esta conversación? Lo que ya se aplicó no se deshace.">
                    <input type="hidden" name="accion" value="borrar" />
                    <input type="hidden" name="conversacion" value={c.id} />
                    <button class="boton-icono" aria-label={`Borrar la conversación «${c.titulo}»`} title="Borrar">
                      <Icono nombre="borrar" clase="size-5" />
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          </details>
        )
      }
      {
        uso && (
          <details id="uso" class="uso">
            <summary>
              <span class="ficha-uso">
                <Icono nombre="enviar" clase="size-4" />
                <span class="tabular">{quedanMensajes}</span>&nbsp;mensajes te quedan hoy
              </span>
              <span class="ficha-uso">
                <Icono nombre="asistente" clase="size-4" />
                IA&nbsp;<span class="tabular">{100 - iaGastada} %</span>&nbsp;libre
              </span>
              <span class="ver-uso">Ver uso</span>
            </summary>
            <div class="grid gap-2 pt-3">
              <div class="uso-fila">
                <p>
                  <span class="font-semibold">Tus mensajes hoy:</span> <span class="tabular">{uso.mensajes}</span> de <span class="tabular">{uso.limiteMensajes}</span>
                  <span class="text-gris"> · te quedan {quedanMensajes}</span>
                </p>
                <span class="barra" aria-hidden="true">
                  <span class:list={['relleno', pct(uso.mensajes, uso.limiteMensajes) >= 90 && 'relleno-alto']} style={`width: ${pct(uso.mensajes, uso.limiteMensajes)}%`} />
                </span>
              </div>
              <div class="uso-fila">
                <p>
                  <span class="font-semibold">IA gratuita del vivero hoy (para todos):</span> <span class="tabular">{iaGastada} %</span> usado
                  <span class="text-gris">
                    {' '}
                    ({miles(uso.neuronas)} de {miles(uso.limiteNeuronas)} neuronas)
                  </span>
                </p>
                <span class="barra" aria-hidden="true">
                  <span class:list={['relleno', iaGastada >= 90 && 'relleno-alto']} style={`width: ${iaGastada}%`} />
                </span>
              </div>
              <p class="text-sm text-gris">
                Se renueva cada día a las {uso.renueva}. Sin cupo, {NOMBRE} sigue en modo básico. Las fotos y los botones «Sí» y «No» no gastan.
              </p>
            </div>
          </details>
        )
      }
    </header>

    <section id="conversacion" class="conversacion mt-6 grid gap-5" aria-label={`Conversación con ${NOMBRE}`} aria-live="polite">
      {
        mensajes.length === 0 && (
          <div class="vacio grid justify-items-center gap-3 px-2 py-6 text-center">
            <span class="avatar avatar-ia avatar-enorme" aria-hidden="true">
              <Icono nombre="asistente" clase="size-9" />
            </span>
            <h2 class="titular-medio">{primerNombre ? `Hola, ${primerNombre}. Soy ${NOMBRE}.` : `Hola, soy ${NOMBRE}.`}</h2>
            <p class="max-w-md text-gris">
              Pregúntame por ventas, facturas, gastos o plantas, o pídeme cambios, también de muchas cosas a la vez. {conFotos ? 'Puedes enviarme fotos para tus plantas. ' : ''}Nada se cambia hasta que pulses «Sí».
            </p>
            <ul class="mt-2 flex flex-wrap justify-center gap-2" role="list" aria-label="Sugerencias">
              {SUGERENCIAS.map((t) => (
                <li>
                  <button type="button" class="sugerencia" data-sugerencia={t}>
                    {t}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        mensajes.map((m) => {
          const suyas = m.propuestas.map((id) => propuestas.get(id)).filter((p): p is Propuesta => !!p);
          const usuario = m.rol === 'usuario';
          return (
            <article class:list={['fila', usuario ? 'fila-usuario' : 'fila-ia']} aria-label={`${usuario ? 'Tú' : NOMBRE}, ${hora(m.fecha)}`}>
              <span class:list={['avatar', usuario ? 'avatar-usuario' : 'avatar-ia']} aria-hidden="true">
                {usuario ? iniciales : <Icono nombre="asistente" clase="size-5" />}
              </span>
              <div class="grid min-w-0 gap-1">
                <p class="autor" aria-hidden="true">
                  {usuario ? 'Tú' : NOMBRE} · <time datetime={m.fecha}>{hora(m.fecha)}</time>
                </p>
                <div class:list={['burbuja', usuario ? 'burbuja-usuario' : 'burbuja-ia']}>
                  {usuario ? <p class="whitespace-pre-line">{m.texto}</p> : <div class="texto-ia" set:html={textoSeguro(m.texto)} />}
                  {usuario &&
                    suyas.flatMap(miniaturas).length > 0 && (
                      <div class="miniaturas mt-2">
                        {suyas.flatMap(miniaturas).map((src) => (
                          <img src={src} alt="Foto enviada" loading="lazy" />
                        ))}
                      </div>
                    )}
                  {!usuario &&
                    suyas.map((p) => (
                      <div class:list={['propuesta', `propuesta-${p.estado}`]}>
                        <p class="flex items-start gap-2 font-semibold">
                          <Icono nombre={p.estado === 'aplicada' ? 'hecho' : p.estado === 'pendiente' ? (p.herramienta === HERRAMIENTA_FOTOS ? 'fotos' : 'asistente') : 'aviso'} clase="mt-0.5 size-5 text-oliva" />
                          <span>{p.resumen}</span>
                        </p>
                        {p.herramienta === HERRAMIENTA_FOTOS && p.estado === 'pendiente' && (
                          <div class="miniaturas mt-3">
                            {miniaturas(p).map((src) => (
                              <img src={src} alt="Foto para añadir" loading="lazy" />
                            ))}
                          </div>
                        )}
                        {p.estado === 'pendiente' ? (
                          <form method="post" class="mt-3 flex flex-wrap gap-2">
                            <input type="hidden" name="propuesta" value={p.id} />
                            <button name="accion" value="si" class="boton-panel">
                              <Icono nombre="hecho" clase="size-5" />
                              Sí, hazlo
                            </button>
                            <button name="accion" value="no" class="boton-panel boton-panel-secundario">
                              No
                            </button>
                          </form>
                        ) : (
                          <p class="mt-2 text-base text-gris">
                            {ESTADO[p.estado]}
                            {p.resultado && p.estado !== 'rechazada' ? `: ${p.resultado}` : ''}
                          </p>
                        )}
                      </div>
                    ))}
                </div>
              </div>
            </article>
          );
        })
      }
      <div id="final"></div>
    </section>

    <form method="post" enctype="multipart/form-data" class="redactor caja-panel mt-6 grid gap-2 p-2 sm:p-3" data-redactor>
      {
        conFotos && (
          <div class="bandeja" data-bandeja hidden>
            <ul class="grid gap-2" role="list" aria-label="Fotos para enviar" data-lista-fotos />
            <p class="text-sm text-gris">Elige de qué planta es cada foto. Al enviar, te pediré que lo confirmes.</p>
          </div>
        )
      }
      {
        conFotos && (
          <div class="planta-todas" data-sin-js>
            <label for="foto-planta" class="text-base font-semibold">
              Planta de las fotos
            </label>
            <select id="foto-planta" name="fotoPlanta" class="campo-panel">
              <option value="">Elige la planta…</option>
              {plantas.map((p) => (
                <option value={p.id}>{p.nombre}</option>
              ))}
            </select>
          </div>
        )
      }
      <label for="texto" class="sr-only">Escribe a {NOMBRE}</label>
      <div class="flex items-end gap-2">
        <button type="submit" form="form-nueva" class="boton-icono" aria-label="Nueva conversación" title="Nueva conversación">
          <Icono nombre="conversacion" clase="size-5" />
        </button>
        {
          conFotos && (
            <span class="boton-icono boton-foto" title="Añadir fotos para las plantas">
              <Icono nombre="anadirFoto" clase="size-5" />
              <input type="file" name="foto" accept="image/jpeg,image/png,image/webp" multiple data-maximo={MAXIMO_FOTOS_CHAT} aria-label="Añadir fotos para las plantas" data-fotos />
            </span>
          )
        }
        <textarea id="texto" name="texto" rows="1" maxlength={MAXIMO_TEXTO} placeholder="Escribe aquí…" class="campo-panel max-h-40 min-h-12 flex-1 resize-none" autocomplete="off" aria-describedby="ayuda-redactor"></textarea>
        <button class="boton-panel !px-4" aria-label="Enviar" data-enviar>
          <Icono nombre="enviar" clase="size-5" />
          <span class="hidden sm:inline">Enviar</span>
        </button>
      </div>
      <p id="ayuda-redactor" class="ayuda-redactor">
        <span class="hidden sm:inline">Intro para enviar · Mayúsculas + Intro para otra línea</span>
        <span data-contador hidden></span>
      </p>
    </form>
    <form method="post" id="form-nueva" hidden>
      <input type="hidden" name="accion" value="nueva" />
    </form>
    {
      conFotos && (
        <template id="opciones-plantas">
          <option value="">Elige la planta…</option>
          {plantas.map((p) => (
            <option value={p.id}>{p.nombre}</option>
          ))}
        </template>
      )
    }
  </div>
</PaginaPanel>

<style is:global>
  /* Global a propósito: el script también pinta mensajes y tienen que verse igual. */
  .chat-agricolai .cabecera-chat {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
  }
  .chat-agricolai .uso {
    grid-column: 1 / -1;
    border-top: 1px solid var(--color-linea);
    padding-top: 0.5rem;
    font-size: 0.9375rem;
  }
  .chat-agricolai .historial {
    grid-column: 1 / -1;
    border-top: 1px solid var(--color-linea);
    padding-top: 0.25rem;
  }
  .chat-agricolai .historial summary {
    display: flex;
    min-height: 3rem;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-weight: 600;
    color: var(--color-oliva);
  }
  .chat-agricolai .lista-historial {
    display: grid;
    max-height: 22rem;
    gap: 0.25rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: 0.25rem;
  }
  .chat-agricolai .conversacion-anterior {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    border-radius: 0.875rem;
  }
  .chat-agricolai .conversacion-abierta {
    background: var(--color-verdor);
  }
  .chat-agricolai .abrir-conversacion {
    display: grid;
    width: 100%;
    min-height: 3rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.875rem;
    text-align: left;
    transition: background-color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .chat-agricolai .conversacion-anterior:not(.conversacion-abierta) .abrir-conversacion:hover {
      background: var(--color-crema);
    }
  }
  .chat-agricolai .titulo-conversacion {
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .chat-agricolai .uso summary {
    display: flex;
    min-height: 3rem;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
  }
  .chat-agricolai .uso summary::-webkit-details-marker {
    display: none;
  }
  .chat-agricolai .ficha-uso {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    background: var(--color-verdor);
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-oliva);
  }
  .chat-agricolai .ver-uso {
    margin-left: auto;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-oliva);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .chat-agricolai .uso[open] .ver-uso {
    visibility: hidden;
  }
  .chat-agricolai .uso-fila {
    display: grid;
    gap: 0.25rem;
  }
  .chat-agricolai .barra {
    display: block;
    height: 0.5rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-verdor);
  }
  .chat-agricolai .relleno {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-oliva);
    transition: width 400ms var(--ease-salida);
  }
  .chat-agricolai .relleno-alto {
    background: var(--color-terracota);
  }
  .chat-agricolai .punto-estado {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
  }
  .chat-agricolai .punto-activo {
    background: #4f7a3a;
    box-shadow: 0 0 0 3px color-mix(in oklab, #4f7a3a 25%, transparent);
  }
  .chat-agricolai .punto-basico {
    background: var(--color-gris);
  }

  .chat-agricolai .avatar {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    place-items: center;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .chat-agricolai .avatar-grande {
    width: 3rem;
    height: 3rem;
  }
  .chat-agricolai .avatar-enorme {
    width: 4.5rem;
    height: 4.5rem;
  }
  .chat-agricolai .avatar-ia {
    background: var(--color-oliva);
    color: var(--color-crema);
  }
  .chat-agricolai .avatar-usuario {
    background: var(--color-linea);
    color: var(--color-tinta);
  }

  .chat-agricolai .fila {
    display: flex;
    align-items: flex-end;
    gap: 0.625rem;
    max-width: min(44rem, 100%);
  }
  .chat-agricolai .fila-usuario {
    flex-direction: row-reverse;
    justify-self: end;
  }
  .chat-agricolai .fila-ia {
    justify-self: start;
  }
  .chat-agricolai .fila-usuario .autor {
    text-align: right;
  }
  .chat-agricolai .autor {
    padding: 0 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-gris);
  }
  .chat-agricolai .burbuja {
    border-radius: 1.25rem;
    padding: 0.75rem 1rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .chat-agricolai .burbuja-usuario {
    border-bottom-right-radius: 0.375rem;
    background: var(--color-oliva);
    color: var(--color-crema);
  }
  .chat-agricolai .burbuja-ia {
    border-bottom-left-radius: 0.375rem;
    background: var(--color-papel);
    box-shadow: var(--sombra-suave);
  }
  .chat-agricolai .burbuja-error {
    background: #fbeae4;
    color: var(--color-tinta);
  }
  .chat-agricolai .texto-ia p + p,
  .chat-agricolai .texto-ia p + ul,
  .chat-agricolai .texto-ia ul + p {
    margin-top: 0.5rem;
  }
  .chat-agricolai .texto-ia ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .chat-agricolai .propuesta {
    margin-top: 0.75rem;
    border-radius: 1rem;
    border: 1px solid var(--color-linea);
    background: var(--color-crema);
    padding: 1rem;
  }
  .chat-agricolai .propuesta-pendiente {
    border-color: color-mix(in oklab, var(--color-oliva) 35%, var(--color-linea));
  }
  .chat-agricolai .propuesta-aplicada {
    background: color-mix(in oklab, var(--color-verdor) 60%, transparent);
  }
  .chat-agricolai .miniaturas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .chat-agricolai .miniaturas img {
    width: 4.5rem;
    height: 3.375rem;
    border-radius: 0.5rem;
    object-fit: cover;
  }

  .chat-agricolai .redactor {
    position: sticky;
    bottom: 6.5rem;
    z-index: 10;
    box-shadow: var(--sombra-suave);
  }
  @media (min-width: 64rem) {
    .chat-agricolai .redactor {
      bottom: 1rem;
    }
  }
  .chat-agricolai .boton-icono {
    position: relative;
    display: inline-grid;
    width: 3rem;
    height: 3rem;
    flex: none;
    place-items: center;
    border-radius: 0.875rem;
    color: var(--color-oliva);
    transition: background-color 150ms ease, transform 160ms var(--ease-salida);
  }
  .chat-agricolai .boton-icono:active {
    transform: scale(0.95);
  }
  @media (hover: hover) and (pointer: fine) {
    .chat-agricolai .boton-icono:hover {
      background: var(--color-verdor);
    }
  }
  .chat-agricolai .boton-foto input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    opacity: 0;
  }
  .chat-agricolai .boton-foto:focus-within {
    outline: 3px solid var(--color-terracota);
    outline-offset: 2px;
  }
  .chat-agricolai .ayuda-redactor {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-gris);
  }
  .chat-agricolai .planta-todas {
    display: grid;
    gap: 0.25rem;
  }
  .chat-agricolai .foto-item {
    display: grid;
    grid-template-columns: 4rem 1fr 3rem;
    align-items: center;
    gap: 0.5rem;
  }
  .chat-agricolai .foto-item img {
    width: 4rem;
    height: 3rem;
    border-radius: 0.5rem;
    object-fit: cover;
  }
  .chat-agricolai .sugerencia {
    min-height: 3rem;
    border-radius: 999px;
    background: var(--color-verdor);
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-oliva);
    transition: transform 160ms var(--ease-salida);
  }
  @media (max-width: 40rem) {
    .chat-agricolai .vacio li:nth-child(n + 5) {
      display: none;
    }
  }
  .chat-agricolai .sugerencia:active {
    transform: scale(0.97);
  }
  .chat-agricolai .pensando {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-gris);
  }
  .chat-agricolai .puntos span {
    display: inline-block;
    width: 0.4375rem;
    height: 0.4375rem;
    margin-right: 0.1875rem;
    border-radius: 999px;
    background: var(--color-gris);
    opacity: 0.4;
  }
  @media (prefers-reduced-motion: no-preference) {
    .chat-agricolai .fila-nueva {
      animation: entra-mensaje 220ms var(--ease-salida) both;
    }
    .chat-agricolai .puntos span {
      animation: latido 1s ease-in-out infinite;
    }
    .chat-agricolai .puntos span:nth-child(2) {
      animation-delay: 150ms;
    }
    .chat-agricolai .puntos span:nth-child(3) {
      animation-delay: 300ms;
    }
  }
  @keyframes entra-mensaje {
    from {
      transform: translateY(6px) scale(0.98);
    }
  }
  @keyframes latido {
    50% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }
</style>

<script>
  // Con JavaScript: el mensaje aparece al momento y la caja se vacía; «pensando…»
  // mientras responde, y solo se cambian la conversación y el uso (sin recargar).
  // Sin JavaScript, los formularios funcionan igual.
  const NOMBRE = 'AgricolAI';
  const redactor = document.querySelector<HTMLFormElement>('[data-redactor]');
  const texto = redactor?.querySelector<HTMLTextAreaElement>('textarea');
  const contador = redactor?.querySelector<HTMLElement>('[data-contador]');
  const entradaFotos = redactor?.querySelector<HTMLInputElement>('[data-fotos]');
  const bandeja = redactor?.querySelector<HTMLElement>('[data-bandeja]');
  const listaFotos = redactor?.querySelector<HTMLElement>('[data-lista-fotos]');
  const opciones = document.querySelector<HTMLTemplateElement>('#opciones-plantas');
  const iniciales = document.querySelector('.fila-usuario .avatar')?.textContent?.trim();
  const MAXIMO_FOTOS = Number(entradaFotos?.dataset.maximo ?? 10);
  let fotos: { archivo: File; url: string; planta: string }[] = [];

  // Con JavaScript cada foto lleva su planta: sobra el selector común.
  redactor?.querySelector('[data-sin-js]')?.remove();

  const conversacion = () => document.querySelector<HTMLElement>('#conversacion');
  // Hasta abajo del todo: la caja de escribir es fija y taparía el último mensaje.
  const alFinal = () => window.scrollTo({ top: document.documentElement.scrollHeight, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  const ajustar = () => {
    if (!texto) return;
    texto.style.height = 'auto';
    texto.style.height = `${Math.min(texto.scrollHeight, 160)}px`;
    if (contador) {
      const quedan = texto.maxLength - texto.value.length;
      contador.hidden = quedan > 200;
      contador.textContent = `Quedan ${quedan} letras`;
    }
  };

  /** Una fila de mensaje como las del servidor (mismas clases y estilos). */
  function fila(usuario: boolean, contenido: Node[], extra = ''): HTMLElement {
    const a = document.createElement('article');
    a.className = `fila fila-nueva ${usuario ? 'fila-usuario' : 'fila-ia'} ${extra}`;
    a.setAttribute('aria-label', usuario ? 'Tú' : NOMBRE);
    const avatar = document.createElement('span');
    avatar.className = `avatar ${usuario ? 'avatar-usuario' : 'avatar-ia'}`;
    avatar.setAttribute('aria-hidden', 'true');
    if (usuario) avatar.textContent = iniciales || 'Tú';
    else avatar.innerHTML = document.querySelector('.cabecera-chat .avatar-ia')?.innerHTML ?? '';
    const columna = document.createElement('div');
    columna.className = 'grid min-w-0 gap-1';
    const autor = document.createElement('p');
    autor.className = 'autor';
    autor.setAttribute('aria-hidden', 'true');
    autor.textContent = `${usuario ? 'Tú' : NOMBRE} · ahora`;
    const burbuja = document.createElement('div');
    burbuja.className = `burbuja ${usuario ? 'burbuja-usuario' : 'burbuja-ia'}`;
    burbuja.append(...contenido);
    columna.append(autor, burbuja);
    a.append(avatar, columna);
    return a;
  }

  function pintarFotos() {
    if (!listaFotos || !bandeja) return;
    bandeja.hidden = fotos.length === 0;
    listaFotos.replaceChildren(
      ...fotos.map((f, i) => {
        const li = document.createElement('li');
        li.className = 'foto-item';
        const img = document.createElement('img');
        img.src = f.url;
        img.alt = `Foto ${i + 1}`;
        const select = document.createElement('select');
        select.className = 'campo-panel';
        select.setAttribute('aria-label', `Planta de la foto ${i + 1}`);
        if (opciones) select.append(opciones.content.cloneNode(true));
        select.value = f.planta;
        select.addEventListener('change', () => (f.planta = select.value));
        const quitar = document.createElement('button');
        quitar.type = 'button';
        quitar.className = 'boton-icono';
        quitar.setAttribute('aria-label', `Quitar la foto ${i + 1}`);
        quitar.innerHTML = '<svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
        quitar.addEventListener('click', () => {
          URL.revokeObjectURL(f.url);
          fotos.splice(i, 1);
          pintarFotos();
        });
        li.append(img, select, quitar);
        return li;
      }),
    );
  }

  /** Planta que encaja con el nombre del archivo (por ejemplo «palmera-canaria-2.jpg»). */
  function adivinar(nombre: string): string {
    const limpio = (t: string) =>
      t
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .toLowerCase()
        .replace(/[^a-z]+/g, ' ')
        .trim();
    const archivo = limpio(nombre.replace(/\.[a-z]+$/i, ''));
    if (!archivo || !opciones) return '';
    const lista = [...opciones.content.querySelectorAll('option')].filter((o) => o.value);
    const encaja = lista.find((o) => archivo.includes(limpio(o.textContent ?? '')) || archivo.includes(limpio(o.value)));
    return encaja?.value ?? '';
  }

  /** Reencuadre a 4:3 y 1600 px en JPEG, como al subir fotos en la ficha. */
  async function preparar(archivo: File): Promise<Blob> {
    if (!('createImageBitmap' in window)) return archivo;
    try {
      const imagen = await createImageBitmap(archivo, { imageOrientation: 'from-image' });
      const proporcion = 4 / 3;
      let ancho = imagen.width;
      let alto = imagen.height;
      let x = 0;
      let y = 0;
      if (ancho / alto > proporcion) {
        ancho = Math.round(alto * proporcion);
        x = Math.round((imagen.width - ancho) / 2);
      } else {
        alto = Math.round(ancho / proporcion);
        y = Math.round((imagen.height - alto) / 2);
      }
      const escala = Math.min(1, 1600 / ancho);
      const lienzo = document.createElement('canvas');
      lienzo.width = Math.round(ancho * escala);
      lienzo.height = Math.round(alto * escala);
      lienzo.getContext('2d')?.drawImage(imagen, x, y, ancho, alto, 0, 0, lienzo.width, lienzo.height);
      return (await new Promise<Blob | null>((ok) => lienzo.toBlob(ok, 'image/jpeg', 0.82))) ?? archivo;
    } catch {
      return archivo;
    }
  }

  async function enviar(form: HTMLFormElement, datos: FormData, burbuja?: { texto: string; fotos: string[] }) {
    const actual = conversacion();
    if (!actual) return form.submit();
    form.querySelectorAll('button').forEach((b) => b.setAttribute('disabled', ''));
    let pensando: HTMLElement | null = null;
    if (burbuja) {
      const contenido: Node[] = [];
      if (burbuja.texto) {
        const p = document.createElement('p');
        p.className = 'whitespace-pre-line';
        p.textContent = burbuja.texto;
        contenido.push(p);
      }
      if (burbuja.fotos.length) {
        const m = document.createElement('div');
        m.className = `miniaturas${burbuja.texto ? ' mt-2' : ''}`;
        for (const src of burbuja.fotos) {
          const img = document.createElement('img');
          img.src = src;
          img.alt = 'Foto enviada';
          m.append(img);
        }
        contenido.push(m);
      }
      const espera = document.createElement('span');
      espera.className = 'pensando';
      espera.setAttribute('role', 'status');
      espera.innerHTML = '<span class="puntos" aria-hidden="true"><span></span><span></span><span></span></span>';
      espera.append(`${NOMBRE} está ${burbuja.fotos.length && !burbuja.texto ? 'guardando las fotos' : 'pensando'}…`);
      pensando = fila(false, [espera]);
      document.querySelector('.vacio')?.remove();
      document.querySelector('#final')?.before(fila(true, contenido), pensando);
      alFinal();
    } else {
      const boton = form.querySelector<HTMLButtonElement>(`[value=${datos.get('accion') === 'si' ? 'si' : 'no'}]`);
      if (boton) boton.textContent = datos.get('accion') === 'si' ? 'Aplicando…' : 'Un momento…';
    }
    try {
      const r = await fetch('/panel/asistente', { method: 'POST', body: datos });
      if (!r.ok) throw new Error(String(r.status));
      const html = new DOMParser().parseFromString(await r.text(), 'text/html');
      const nueva = html.querySelector('#conversacion');
      if (!nueva) throw new Error('sin conversación');
      conversacion()?.replaceWith(nueva);
      const uso = html.querySelector('#uso');
      if (uso) document.querySelector('#uso')?.replaceWith(uso);
      history.replaceState(null, '', '/panel/asistente');
      alFinal();
    } catch {
      if (pensando) {
        const aviso = document.createElement('p');
        aviso.textContent = 'No se ha podido enviar. Revisa la conexión y vuelve a probar: te he dejado el texto en la caja.';
        pensando.replaceWith(fila(false, [aviso], 'fila-error'));
        document.querySelector('.fila-error .burbuja')?.classList.add('burbuja-error');
        if (texto && burbuja && !texto.value) {
          texto.value = burbuja.texto;
          ajustar();
        }
      } else location.reload();
    } finally {
      form.querySelectorAll('button').forEach((b) => b.removeAttribute('disabled'));
      texto?.focus();
    }
  }

  redactor?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const valor = texto?.value.trim() ?? '';
    if (!valor && !fotos.length) {
      texto?.focus();
      return;
    }
    const sinPlanta = fotos.findIndex((f) => !f.planta);
    if (sinPlanta >= 0) {
      listaFotos?.querySelectorAll('select')[sinPlanta]?.focus();
      return;
    }
    const datos = new FormData();
    if (valor) datos.set('texto', valor);
    const enviadas = fotos;
    for (const f of enviadas) {
      datos.append('foto', await preparar(f.archivo), 'foto.jpg');
      datos.append('fotoPlanta', f.planta);
    }
    // La caja se vacía al momento: el mensaje ya está en la conversación.
    if (texto) texto.value = '';
    fotos = [];
    pintarFotos();
    ajustar();
    await enviar(redactor, datos, { texto: valor, fotos: enviadas.map((f) => f.url) });
  });
  entradaFotos?.addEventListener('change', () => {
    for (const archivo of [...(entradaFotos.files ?? [])].slice(0, MAXIMO_FOTOS - fotos.length)) fotos.push({ archivo, url: URL.createObjectURL(archivo), planta: adivinar(archivo.name) });
    entradaFotos.value = '';
    pintarFotos();
    [...(listaFotos?.querySelectorAll('select') ?? [])].find((x) => !x.value)?.focus();
  });
  texto?.addEventListener('input', ajustar);
  texto?.addEventListener('keydown', (e) => {
    // Intro envía; Mayúsculas + Intro hace un salto de línea.
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      redactor?.requestSubmit();
    }
  });
  document.addEventListener('click', (e) => {
    const sugerencia = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-sugerencia]');
    if (sugerencia && texto) {
      texto.value = sugerencia.dataset.sugerencia ?? '';
      ajustar();
      texto.focus();
    }
  });
  document.addEventListener('submit', (e) => {
    const form = e.target as HTMLFormElement;
    if (form.dataset.confirmar && !confirm(form.dataset.confirmar)) {
      e.preventDefault();
      return;
    }
    const boton = (e as SubmitEvent).submitter as HTMLButtonElement | null;
    if (!form.closest('#conversacion') || !boton) return;
    e.preventDefault();
    const datos = new FormData(form);
    datos.set('accion', boton.value);
    enviar(form, datos);
  });
  window.scrollTo({ top: document.documentElement.scrollHeight });
</script>
