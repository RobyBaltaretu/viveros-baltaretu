---
import { campoCsv } from '../../server/informes/csv';
import { clienteActual } from '../../plataforma/actual.ts';
import InformesTuria from '../../panel-nuevo/InformesTuria.astro';
import Barras from '../../components/panel/graficos/Barras.astro';
import Reparto from '../../components/panel/graficos/Reparto.astro';
import PaginaPanel from '../../components/panel/PaginaPanel.astro';
import { fechaValida } from '../../server/facturas/facturas.ts';
import { dinero } from '../../server/facturas/importes.ts';
import { hoy } from '../../server/gastos/gastos.ts';
import {
  cifras,
  cobros,
  conclusiones,
  conversion,
  evolucionMensual,
  evolucionPeriodo,
  gastosPorCategoria,
  masVendido,
  mejoresClientes,
  periodoAnterior,
  periodoDe,
  periodoSiguiente,
  variacion,
  type TipoPeriodo,
} from '../../server/informes/informes.ts';
import { sesionCon } from '../../server/panel/pagina.ts';

export const prerender = false;

const s = sesionCon(Astro.locals, 'informes');
const dia = hoy();
const esTuria = clienteActual().sector === 'carpinteria';
const pedidoTipo = Astro.url.searchParams.get('periodo') ?? (esTuria ? '12meses' : null);
const ultimos12=esTuria && pedidoTipo==='12meses';
const tipo: TipoPeriodo = pedidoTipo === 'trimestre' || pedidoTipo === 'anio' ? pedidoTipo : 'mes';
const pedidaFecha = Astro.url.searchParams.get('fecha') ?? '';
const fechaBase = fechaValida(pedidaFecha) && pedidaFecha >= '1900-01-01' && pedidaFecha <= dia ? pedidaFecha : dia;
const desdePedido=Astro.url.searchParams.get('desde')??'';
const hastaPedido=Astro.url.searchParams.get('hasta')??'';
const personalizado=pedidoTipo==='personalizado' && fechaValida(desdePedido) && fechaValida(hastaPedido) && desdePedido >= '1900-01-01' && desdePedido<=hastaPedido && hastaPedido<=dia;
const inicio12=new Date(`${fechaBase.slice(0,7)}-01T12:00:00Z`);inicio12.setUTCMonth(inicio12.getUTCMonth()-11);
const periodo=personalizado ? {tipo,desde:desdePedido,hasta:hastaPedido,etiqueta:`${desdePedido.split('-').reverse().join('/')} – ${hastaPedido.split('-').reverse().join('/')}`} : ultimos12 ? {tipo,desde:inicio12.toISOString().slice(0,10),hasta:fechaBase,etiqueta:'Últimos 12 meses'} : periodoDe(tipo,fechaBase);
if (pedidoTipo==='personalizado'&&!personalizado) return new Response('Rango no válido: revisa las fechas.',{status:400});
const taller = esTuria && s ? await s.repos.presupuestosCliente.indicadores(periodo.desde, periodo.hasta, dia) : null;
const anterior = periodoAnterior(periodo);
const siguiente = periodoSiguiente(periodo);

// Un año y medio hacia atrás basta para el periodo, el anterior y los 12 meses del gráfico.
const desde = new Date(`${periodo.hasta}T12:00:00Z`);
desde.setUTCMonth(desde.getUTCMonth() - 24);
const rango = { desde: desde.toISOString().slice(0, 10) };
const [facturas, gastos, presupuestos, porRevisar] = s
  ? await Promise.all([
      s.repos.facturas.listar({ ...(esTuria ? {} : {desde: rango.desde}), limite: 20000 }),
      s.repos.gastos.listar({ estado: 'confirmado', ...(esTuria ? {} : {desde:rango.desde}), limite: 20000 }),
      esTuria ? [] : s.repos.presupuestos.listar({ limite: 5000 }),
      s.repos.gastos.listar({ estado: 'revisar' }),
    ])
  : [[], [], [], []];
// Lo pendiente de cobro se mira en todas las facturas, no solo en las del rango.
const todasPendientes = s ? await s.repos.facturas.listar({ estado: 'emitida', limite: 20000 }) : [];

const a = cifras(facturas, gastos, presupuestos, periodo);
const incluyeHoy=periodo.desde<=dia && periodo.hasta>=dia;
const gastosConIva=Math.round(gastos.filter(g=>g.fecha>=periodo.desde&&g.fecha<=periodo.hasta).reduce((n,g)=>n+g.total,0)*100)/100;
if(Astro.url.searchParams.get('exportar')==='csv' && s){
 const filas=[['Indicador','Valor','Criterio'],['Periodo',`${periodo.desde} a ${periodo.hasta}`,''],['Facturación sin IVA',a.ingresos,'Facturas emitidas y cobradas, rectificativas incluidas'],['Facturado con IVA',a.facturado,''],['Gastos confirmados sin IVA',a.gastos,'Sin IVA desglosado se usa el total'],['Gastos confirmados con IVA',gastosConIva,''],['Resultado registrado sin IVA',a.resultado,'Facturación menos gastos registrados'],['Cobrado con IVA',a.cobrado,'Fecha de cobro'],['Pendiente de cobro',incluyeHoy?cobros(todasPendientes,dia).pendiente:'Sin datos suficientes',incluyeHoy?'Situación actual':'No se puede reconstruir el saldo histórico'],['IVA repercutido y recargo',a.ivaRepercutido,''],['IVA soportado registrado',a.ivaSoportado,'']];
 const evolucionCsv=evolucionPeriodo(facturas,gastos,periodo.desde,periodo.hasta);
 for(const p of evolucionCsv){filas.push([`Ingresos ${p.mes}`,p.ingresos,'Sin IVA'],[`Gastos ${p.mes}`,p.gastos,'Sin IVA']);}
 for(const x of gastosPorCategoria(gastos,periodo))filas.push([`Gastos: ${x.nombre}`,x.valor,'Sin IVA']);
 for(const x of mejoresClientes(facturas,periodo))filas.push([`Cliente: ${x.nombre}`,x.valor,'Facturación sin IVA']);
 for(const x of masVendido(facturas,periodo))filas.push([`Producto: ${x.nombre}`,x.valor,'Facturación sin IVA']);
 const pendientes=cobros(todasPendientes,dia);filas.push(['Cobros en plazo',incluyeHoy?pendientes.enPlazo:'Sin datos suficientes',incluyeHoy?'Situación actual':'Sin histórico fiable'],['Vencidos hasta 30 días',incluyeHoy?pendientes.vencido30:'Sin datos suficientes',incluyeHoy?'Situación actual':'Sin histórico fiable'],['Vencidos más de 30 días',incluyeHoy?pendientes.vencidoMas30:'Sin datos suficientes',incluyeHoy?'Situación actual':'Sin histórico fiable']);
 if(taller)filas.push(['Presupuestos aceptados',taller.aceptados,'Del periodo'],['Presupuestos rechazados',taller.decididos-taller.aceptados,'Del periodo'],['Tasa de aceptación',taller.decididos?`${Math.round(100*taller.aceptados/taller.decididos)} %`:'Sin datos suficientes','Sobre aceptados y rechazados'],['Cartera pendiente',incluyeHoy?taller.cartera:'Sin datos suficientes','IVA incluido'],['Caducan en 7 días',incluyeHoy?taller.valorCaduca:'Sin datos suficientes','IVA incluido']);
 const csv=filas.map(f=>f.map(campoCsv).join(';')).join('\r\n');
 return new Response('\ufeff'+csv,{headers:{'Content-Type':'text/csv; charset=utf-8','Content-Disposition':'attachment; filename="informe.csv"','Cache-Control':'no-store'}});
}
const b = cifras(facturas, gastos, presupuestos, anterior);
const c = cobros(todasPendientes, dia);
const evolucion = esTuria ? evolucionPeriodo(facturas,gastos,periodo.desde,periodo.hasta) : evolucionMensual(facturas,gastos,periodo.hasta);
const categorias = gastosPorCategoria(gastos, periodo);
const clientes = mejoresClientes(facturas, periodo);
const productos = masVendido(facturas, periodo);
const conv = conversion(facturas, presupuestos, periodo);
const frases = conclusiones({ actual: a, anterior: b, periodo, cobros: c, categorias, categoriasAntes: gastosPorCategoria(gastos, anterior), clientes, evolucion, conversion: conv, porRevisar: porRevisar.length });

const cambio = (ahora: number, antes: number) => {
  const v = variacion(ahora, antes);
  if (v === null) return antes === 0 && ahora === 0 ? 'Sin datos todavía' : `Antes: ${dinero(antes)}`;
  // Con una base muy pequeña el tanto por ciento no dice nada (p. ej. «▲ 1741 %»): mejor la cifra de antes.
  if (Math.abs(v) > 300) return `Antes: ${dinero(antes)}`;
  return `${v > 0 ? '▲' : v < 0 ? '▼' : '='} ${String(Math.abs(v)).replace('.', ',')} % frente a ${anterior.etiqueta}`;
};
const PESTANAS: [TipoPeriodo, string][] = [
  ['mes', 'Mes'],
  ['trimestre', 'Trimestre'],
  ['anio', 'Año'],
];
const enlace = (t: TipoPeriodo, fecha: string) => `/panel/informes?periodo=${t}&fecha=${fecha}`;
const mayus = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const KPIS = [
  { nombre: 'Ingresos (sin IVA)', valor: dinero(a.ingresos), nota: cambio(a.ingresos, b.ingresos) },
  { nombre: 'Gastos (sin IVA)', valor: dinero(a.gastos), nota: cambio(a.gastos, b.gastos) },
  { nombre: 'Resultado', valor: dinero(a.resultado), nota: a.margen !== null ? `Margen del ${String(a.margen).replace('.', ',')} %` : cambio(a.resultado, b.resultado) },
  { nombre: 'Por cobrar hoy', valor: dinero(c.pendiente), nota: c.vencidas ? `${dinero(c.vencido)} con la fecha pasada` : `${c.facturas} ${c.facturas === 1 ? 'factura' : 'facturas'}, ninguna vencida` },
];
const DATOS = [
  { nombre: 'Facturas emitidas', valor: String(a.facturas), nota: `Antes: ${b.facturas}` },
  { nombre: 'Factura media', valor: a.ticketMedio !== null ? dinero(a.ticketMedio) : '—', nota: b.ticketMedio !== null ? `Antes: ${dinero(b.ticketMedio)}` : '' },
  { nombre: 'Clientes con factura', valor: String(a.clientes), nota: `Antes: ${b.clientes}` },
  { nombre: 'Cobrado en el periodo', valor: dinero(a.cobrado), nota: `Antes: ${dinero(b.cobrado)}` },
  ...(taller ? [
    { nombre: 'Presupuestos aceptados', valor: String(taller.aceptados), nota: 'De los presupuestos fechados en este periodo' },
    { nombre: 'Tasa de aceptación', valor: taller.decididos ? `${Math.round(100 * taller.aceptados / taller.decididos)} %` : '—', nota: `${taller.decididos} presupuestos aceptados o rechazados del periodo` },
    { nombre: 'Caducan en los próximos 7 días', valor: dinero(taller.valorCaduca), nota: `${taller.caducan} presupuestos por responder, contando hoy. IVA incluido.` },
    { nombre: 'Pendiente de respuesta hoy', valor: dinero(taller.cartera), nota: `${taller.pendientes} presupuestos enviados y vigentes, IVA incluido` },
  ] : [{ nombre: 'Presupuestos recibidos', valor: String(conv.recibidos), nota: conv.tasa !== null ? `${conv.tasa} % ya facturados` : '' }]),
  { nombre: 'IVA cobrado − IVA pagado', valor: dinero(a.ivaRepercutido - a.ivaSoportado), nota: `${dinero(a.ivaRepercutido)} − ${dinero(a.ivaSoportado)}` },
];
---

<PaginaPanel titulo="Informes" permiso="informes" ancho={esTuria ? 'amplio' : 'normal'}>
  {esTuria ? <InformesTuria {periodo} {anterior} {siguiente} {tipo} {dia} {a} {b} {c} {evolucion} {categorias} {clientes} {productos} {taller} {porRevisar} {gastosConIva} {personalizado} {ultimos12} {incluyeHoy} /> : <Fragment>
  <div class="informes">
    <h1 class="titular-grande">Informes</h1>
    <nav aria-label="Periodo" class="mt-6 grid gap-3">
      <ul class="flex flex-wrap gap-2" role="list">
        {
          PESTANAS.map(([t, texto]) => (
            <li>
              <a href={enlace(t, periodo.hasta > dia ? dia : periodo.hasta)} class:list={['boton-panel', t !== tipo && 'boton-panel-secundario']} aria-current={t === tipo ? 'page' : undefined}>
                {texto}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <a class="boton-panel boton-panel-secundario" href={enlace(tipo, anterior.desde)}>← Anterior</a>
        <h2 class="titular-medio">{mayus(periodo.etiqueta)}</h2>
        {siguiente.desde <= dia ? <a class="boton-panel boton-panel-secundario" href={enlace(tipo, siguiente.desde)}>Siguiente →</a> : <span />}
      </div>
    </nav>

    <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2" role="list">
      {
        KPIS.map((k) => (
          <li class="grid gap-1 caja-panel p-4">
            <span class="text-gris">{k.nombre}</span>
            <span class="font-titular text-3xl font-bold">{k.valor}</span>
            <span class="text-base text-gris">{k.nota}</span>
          </li>
        ))
      }
    </ul>

    {
      frases.length > 0 && (
        <section class="mt-8 rounded-panel bg-verdor p-5" aria-labelledby="claves">
          <h2 id="claves" class="titular-medio">
            Lo más importante
          </h2>
          <ul class="mt-3 grid list-disc gap-2 pl-6">
            {frases.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="mt-10">
      <Barras
        titulo="Ingresos y gastos de los últimos 12 meses"
        categorias={evolucion.map((p) => p.etiqueta)}
        nombres={evolucion.map((p) => p.nombre)}
        series={[
          { nombre: 'Ingresos (sin IVA)', color: 'var(--color-serie-1)', valores: evolucion.map((p) => p.ingresos) },
          { nombre: 'Gastos (sin IVA)', color: 'var(--color-serie-2)', valores: evolucion.map((p) => p.gastos) },
        ]}
      />
    </div>

    <h2 class="titular-medio mt-10">Más datos de {periodo.etiqueta}</h2>
    <ul class="mt-4 grid grid-cols-2 gap-3" role="list">
      {
        DATOS.map((k) => (
          <li class="grid gap-1 caja-panel p-3">
            <span class="text-gris">{k.nombre}</span>
            <span class="text-xl font-bold">{k.valor}</span>
            {k.nota && <span class="text-base text-gris">{k.nota}</span>}
          </li>
        ))
      }
    </ul>
    <p class="mt-2 text-base text-gris">El IVA es orientativo: la declaración la hace la gestoría.</p>

    <div class="mt-10 grid gap-10">
      <Reparto titulo="En qué se ha gastado" partes={categorias} vacio="No hay gastos revisados en este periodo." color="var(--color-serie-2-texto)" />
      <Reparto titulo="Mejores clientes" partes={clientes} vacio="No hay facturas emitidas en este periodo." />
      <Reparto titulo="Lo más vendido" partes={productos} vacio="No hay ventas en este periodo." />
    </div>

    <p class="mt-10 text-base text-gris">
      Ingresos: base de las facturas emitidas en el periodo (las rectificativas restan). Gastos: tickets revisados, sin IVA cuando el ticket lo indica. Los borradores y los tickets por revisar no cuentan.
    </p>
  </div>
  </Fragment>}
</PaginaPanel>

<style>
  /* Colores de las series, comprobados con el validador de paleta (daltonismo y contraste).
     El ocre no llega a 3:1 con el fondo: por eso hay leyenda, valores escritos y tabla. */
  .informes {
    --color-serie-1: #2f6e3a;
    --color-serie-2: #d99a2b;
    --color-serie-2-texto: #b27a17;
  }
</style>
