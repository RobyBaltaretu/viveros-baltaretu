---
import PaginaPanel from '../../components/panel/PaginaPanel.astro';
import Tarjeta from '../../components/panel/Tarjeta.astro';
import type { Escena } from '../../components/panel/ui/Ilustracion.astro';
import { zonasDe } from '../../server/panel/navegacion.ts';
import { sesionCon } from '../../server/panel/pagina.ts';
import Icono from '../../components/panel/ui/Icono.astro';
import { tp } from '../../i18n/panel';

export const prerender = false;

/** «Más» en el móvil: todas las secciones del panel, agrupadas. */
const s = sesionCon(Astro.locals);
const grupos = s ? zonasDe(s.usuario.rol).filter((z) => z.zona !== 'inicio').map((z) => ({ ...z, grupo: z.zona, titulo: z.texto })) : [];
---

<PaginaPanel titulo="Todo el panel" volver={false} ancho="amplio">
  <h1 class="titular-grande">Todo el panel</h1>
  {
    grupos
      .filter((g) => g.secciones.length)
      .map((g) => (
        <section class="mt-8" aria-labelledby={`grupo-${g.grupo}`}>
          <h2 id={`grupo-${g.grupo}`} class="titular-medio">
            {g.titulo}
          </h2>
          <ul class="escalonado mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
            {g.secciones.map((x) => (
              <Tarjeta href={x.href} titulo={x.texto} texto={x.descripcion} escena={x.escena as Escena | undefined} />
            ))}
          </ul>
        </section>
      ))
  }
  {
    s && (
      <section class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-linea pt-6" aria-label="Tu sesión">
        <p class="text-gris">{s.usuario.email}</p>
        <a href="/cdn-cgi/access/logout" class="boton-panel boton-panel-secundario">
          <Icono nombre="salir" clase="size-5" />
          {tp.salir}
        </a>
      </section>
    )
  }
</PaginaPanel>
