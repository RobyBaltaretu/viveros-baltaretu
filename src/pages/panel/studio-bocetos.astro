---
import PaginaPanel from '../../components/panel/PaginaPanel.astro';
import { sesionCon } from '../../server/panel/pagina.ts';
import { clienteActual } from '../../plataforma/actual.ts';
export const prerender = false;
const permitido=clienteActual().id==='turia' && !!sesionCon(Astro.locals,'editar');
---
<PaginaPanel titulo="Turia Studio — Bocetos" permiso="editar" ancho="amplio">
  {permitido ? (
    <main class="mx-auto max-w-4xl space-y-6 p-4">
      <header><h1 class="text-2xl font-bold">Diseñar desde boceto</h1><p class="text-sm">Flujo experimental: guarda el proyecto y sube las fotografías. La interpretación y el render están en fase experimental; confirma cada medida y material antes de generar.</p></header>
      <form id="nuevo-boceto" class="space-y-3 rounded-xl border p-4">
        <label for="titulo-boceto" class="block font-semibold">Nombre del proyecto</label>
        <input id="titulo-boceto" required maxlength="120" class="w-full rounded border p-2" placeholder="Lavadero del cliente"/>
        <button class="rounded bg-neutral-900 px-4 py-2 text-white" type="submit">Crear borrador</button>
      </form>
      <section id="editor-boceto" hidden class="space-y-4 rounded-xl border p-4">
        <h2 class="font-bold">Fotografías y medidas</h2>
        <p id="identificador-boceto" class="text-xs"></p>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block">Fotografía del espacio vacío <input id="foto-espacio" type="file" accept="image/jpeg,image/png,image/webp" class="block w-full"/></label>
          <label class="block">Fotografía del boceto en papel <input id="foto-dibujo" type="file" accept="image/jpeg,image/png,image/webp" class="block w-full"/></label>
        </div>
        <p class="text-sm">Confirma las cotas en milímetros. No se deducirán medidas de la fotografía.</p>
        <label class="block">Anchura total (mm, opcional) <input id="ancho-boceto" type="number" min="1" max="100000" class="block w-full rounded border p-2" placeholder="Ej. 2330"/></label>
        <label class="block">Precisión de la medida <select id="precision-boceto" class="block w-full rounded border p-2"><option value="aproximada">Aproximada</option><option value="exacta">Exacta</option></select></label>
        <button id="guardar-boceto" type="button" class="rounded bg-neutral-900 px-4 py-2 text-white">Guardar interpretación manual</button>
        <button id="interpretar-boceto" type="button" class="rounded border px-4 py-2">Interpretar dibujo con IA</button>

        <section id="resultado-boceto" class="space-y-2" aria-label="Interpretación del dibujo"></section>
        <button id="confirmar-boceto" type="button" class="rounded border px-4 py-2">Confirmar boceto revisado</button>
        <button id="duplicar-boceto" type="button" class="rounded border px-4 py-2">Nueva revisión editable</button>
        <button id="consultar-despiece" type="button" class="rounded border px-4 py-2">Revisar despiece</button>
        <section id="resultado-despiece" class="text-sm" aria-live="polite"></section>
        <button id="generar-boceto" type="button" class="rounded bg-neutral-900 px-4 py-2 text-white">Generar imagen fotorrealista</button>
        <section id="comparador-boceto" hidden class="space-y-2" aria-label="Comparación de antes y después">
          <label class="block">Antes / después <input id="deslizador-boceto" type="range" min="0" max="100" value="50" class="w-full"/></label>
          <div id="comparador-marco" class="relative overflow-hidden rounded-lg"><img id="imagen-antes" alt="Espacio original" class="block w-full"/><div id="recorte-despues" class="absolute inset-0 overflow-hidden" style="clip-path:inset(0 50% 0 0)"><img id="imagen-despues" alt="Resultado fotorrealista" class="block h-full w-full object-cover"/></div></div>
        </section>
        <p class="text-xs">Comprueba módulos y cotas antes de validar. El render de IA todavía no está habilitado en este flujo.</p>
      </section>
      <p id="estado-boceto" role="status" aria-live="polite"></p>
      <section><h2 class="font-bold">Borradores recientes</h2><ul id="lista-bocetos" class="space-y-2"></ul></section>
    </main>
  ) : <p>Esta herramienta solo está disponible para Creaciones Turia.</p>}
</PaginaPanel>
{permitido && <script>
  import { calcularPlano, svgPlano } from '../../server/simulador/geometria-boceto.ts';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  let id='',revision=1;
  let claveGeneracion='';
  let espacio='',dibujo='';
  let interpretacion: any=null;
  let materiales: Array<{id:string;nombre:string;referencia:string;acabado:string;colorHex:string|null}> = [];
  async function cargarMateriales(){
    const r=await fetch('/api/panel/studio-materiales');if(!r.ok)throw Error('No se ha podido cargar el catálogo');
    const j=await r.json();materiales=j.variantes||[];
  }
  function mostrar(){
    const zona=$('resultado-boceto');zona.replaceChildren();if(!interpretacion)return;
    const soloLectura=interpretacion.estado==='validada';
    for(const nombre of ['guardar-boceto','interpretar-boceto','confirmar-boceto','ancho-boceto','precision-boceto','foto-espacio','foto-dibujo']){
      const control=$(nombre) as HTMLInputElement|HTMLButtonElement|null;if(control)control.disabled=soloLectura;
    }
    const titulo=document.createElement('h3');titulo.textContent='Distribución: '+interpretacion.modulos.length+' módulos';zona.append(titulo);
    const plano=calcularPlano(interpretacion);
    const visor=document.createElement('div');visor.className='overflow-x-auto rounded border bg-white p-2';visor.innerHTML=svgPlano(plano);zona.append(visor);
    const aviso=document.createElement('p');aviso.className='text-sm';aviso.textContent=plano.advertencias.length?'Alzado provisional: '+plano.advertencias.join('; '):'Alzado basado en las cotas disponibles';zona.append(aviso);
    for(const m of interpretacion.modulos){
      const seccion=document.createElement('fieldset');seccion.className='rounded border p-3';seccion.disabled=soloLectura;
      const leyenda=document.createElement('legend');leyenda.textContent=m.tipo+' · '+m.id;seccion.append(leyenda);
      for(const dimension of ['ancho','alto','fondo'] as const){
        const etiqueta=document.createElement('label');etiqueta.className='block text-sm';
        etiqueta.textContent=dimension+' (mm)';
        const input=document.createElement('input');input.type='number';input.min='1';input.max='100000';input.className='block w-full rounded border p-2';
        input.value=m[dimension].valorMm===null?'':String(m[dimension].valorMm);
        input.addEventListener('change',()=>{
          const n=input.value.trim()?Number(input.value):null;
          m[dimension]={valorMm:n,precision:n===null?'desconocida':'exacta',origen:'usuario',confirmada:n!==null};
        });
        etiqueta.append(input);seccion.append(etiqueta);
      }
      for(const pieza of m.piezas){
        const etiqueta=document.createElement('label');etiqueta.className='block text-sm';
        etiqueta.textContent='Acabado de '+pieza.tipo+' ('+pieza.id+')';
        const select=document.createElement('select');select.className='block w-full rounded border p-2';
        const vacia=document.createElement('option');vacia.value='';vacia.textContent='Sin asignar';select.append(vacia);
        for(const mat of materiales){const option=document.createElement('option');option.value=mat.id;
          option.textContent=[mat.nombre,mat.referencia,mat.acabado].filter(Boolean).join(' · ');select.append(option);}
        select.value=pieza.catalogoVarianteId||'';
        select.addEventListener('change',()=>{pieza.catalogoVarianteId=select.value||null;pieza.acabadoId=select.value||null;});
        etiqueta.append(select);seccion.append(etiqueta);
        const tituloCorte=document.createElement('p');tituloCorte.className='mt-2 text-sm font-semibold';tituloCorte.textContent='Medidas de corte verificadas · '+pieza.tipo;seccion.append(tituloCorte);
        for(const dimension of ['ancho','alto'] as const){
          const etiquetaCorte=document.createElement('label');etiquetaCorte.className='block text-sm';
          etiquetaCorte.textContent='Corte '+dimension+' (mm)';
          const campo=document.createElement('input');campo.type='number';campo.min='1';campo.max='100000';campo.className='block w-full rounded border p-2';
          campo.value=pieza.corte?.[dimension]?.valorMm==null?'':String(pieza.corte[dimension].valorMm);
          campo.addEventListener('change',()=>{
            const n=campo.value.trim()?Number(campo.value):null;
            pieza.corte??={ancho:desconocida(),alto:desconocida(),cantidad:1};
            pieza.corte[dimension]={valorMm:n,precision:n===null?'desconocida':'exacta',origen:'medicion',confirmada:n!==null};
          });
          etiquetaCorte.append(campo);seccion.append(etiquetaCorte);
        }
        const cantidadLabel=document.createElement('label');cantidadLabel.className='block text-sm';cantidadLabel.textContent='Cantidad de piezas';
        const cantidadInput=document.createElement('input');cantidadInput.type='number';cantidadInput.min='1';cantidadInput.max='1000';cantidadInput.step='1';cantidadInput.className='block w-full rounded border p-2';
        cantidadInput.value=String(pieza.corte?.cantidad??1);
        cantidadInput.addEventListener('change',()=>{
          pieza.corte??={ancho:desconocida(),alto:desconocida(),cantidad:1};
          pieza.corte.cantidad=Number(cantidadInput.value);
        });
        cantidadLabel.append(cantidadInput);seccion.append(cantidadLabel);
      }
      zona.append(seccion);
    }
    for(const q of interpretacion.preguntas||[]){const p=document.createElement('p');p.textContent='Pendiente: '+q;zona.append(p);}
  }
  async function abrir(bid:string){const r=await fetch('/api/panel/studio-bocetos?id='+encodeURIComponent(bid));const j=await r.json();if(!r.ok)throw Error('No se pudo abrir el boceto');
    id=j.boceto.id;revision=j.boceto.revision;interpretacion=j.boceto.interpretacion;claveGeneracion='';
    espacio=interpretacion.fotoEspacioId;dibujo=interpretacion.fotoBocetoId;
    $('editor-boceto').hidden=false;$('identificador-boceto').textContent='Borrador '+id;
    const ancho=interpretacion.modulos?.[0]?.ancho;
    ($('ancho-boceto') as HTMLInputElement).value=ancho?.valorMm?String(ancho.valorMm):'';
    mostrar();await cargarGeneraciones();}

  const estado=(s:string)=>{$('estado-boceto').textContent=s;};
  const desconocida=()=>({valorMm:null,precision:'desconocida',origen:'usuario',confirmada:false});
  function modelo(){
    const ancho=Number(($('ancho-boceto') as HTMLInputElement).value);
    const precision=($('precision-boceto') as HTMLSelectElement).value;
    return {version:1,estado:'pendiente',categoria:'lavadero',fotoEspacioId:espacio,fotoBocetoId:dibujo,
      obstaculos:[],preguntas:['Confirmar distribución y obstáculos antes de generar'],
      modulos:[{id:'modulo-principal',tipo:'otro',orden:0,
        ancho:ancho>0?{valorMm:ancho,precision,origen:'usuario',confirmada:precision==='exacta'}:desconocida(),
        alto:desconocida(),fondo:desconocida(),piezas:[]}]};
  }
  async function cargar(){
    const r=await fetch('/api/panel/studio-bocetos');if(!r.ok)return;
    const j=await r.json();const ul=$('lista-bocetos');ul.replaceChildren();
    for(const b of j.bocetos||[]){const li=document.createElement('li');const boton=document.createElement('button');boton.type='button';boton.className='rounded border p-2 text-left';boton.textContent=b.titulo+' · '+b.estado+' · revisión '+b.revision;boton.addEventListener('click',()=>{void abrir(b.id).catch(e=>estado(String(e)));});li.append(boton);ul.append(li);}
  }
  $('nuevo-boceto')?.addEventListener('submit',async ev=>{
    ev.preventDefault();estado('Creando borrador…');
    const titulo=($('titulo-boceto') as HTMLInputElement).value;
    // IDs de archivo pendientes se asignan tras subir las imágenes; se usan marcadores internos válidos.
    espacio='pendiente-espacio';dibujo='pendiente-boceto';
    const r=await fetch('/api/panel/studio-bocetos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({titulo,interpretacion:modelo()})});
    const j=await r.json();if(!r.ok){estado(j.error||JSON.stringify(j.errores));return;}
    id=j.id;revision=j.revision;interpretacion=modelo();$('editor-boceto').hidden=false;$('identificador-boceto').textContent='Borrador '+id;
    await cargarMateriales().catch(e=>estado(String(e)));mostrar();estado('Borrador creado. Sube ambas fotografías y guarda los cambios.');void cargar();
  });
  async function subir(inputId:string,clase:'espacio'|'boceto'){
    const input=$(inputId) as HTMLInputElement;const archivo=input.files?.[0];
    if(!archivo)throw Error('Falta fotografía de '+clase);
    if(archivo.size>6_000_000)throw Error('La imagen supera los 6 MB; comprímela antes de subirla.');
    const r=await fetch('/api/panel/studio-archivos?bocetoId='+encodeURIComponent(id)+'&clase='+clase,{
      method:'POST',headers:{'Content-Type':archivo.type},body:archivo
    });
    const j=await r.json();if(!r.ok)throw Error(j.error||'Error al subir imagen');
    return j.id as string;
  }
  $('guardar-boceto')?.addEventListener('click',async()=>{
    if(!id)return;const boton=$('guardar-boceto') as HTMLButtonElement;boton.disabled=true;
    try{
      estado('Guardando imágenes…');
      if(espacio.startsWith('pendiente-'))espacio=await subir('foto-espacio','espacio');
      if(dibujo.startsWith('pendiente-'))dibujo=await subir('foto-dibujo','boceto');
      const nueva=interpretacion?{...interpretacion,fotoEspacioId:espacio,fotoBocetoId:dibujo}:modelo();
      const r=await fetch('/api/panel/studio-bocetos',{method:'PATCH',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({id,revision,interpretacion:nueva})});
      const j=await r.json();if(!r.ok)throw Error(j.error||JSON.stringify(j.errores));
      revision=j.revision;interpretacion=nueva;mostrar();estado('Fotografías e interpretación guardadas.');void cargar();
    }catch(e){estado(e instanceof Error?e.message:String(e));}finally{boton.disabled=false;}
  });
  $('interpretar-boceto')?.addEventListener('click',async()=>{if(!id)return;estado('Interpretando fotografías…');const boton=$('interpretar-boceto') as HTMLButtonElement;boton.disabled=true;
    try{const r=await fetch('/api/panel/studio-interpretar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id})});const j=await r.json();if(!r.ok)throw Error(j.error||'Error de interpretación');revision=j.revision;interpretacion=j.interpretacion;mostrar();estado('Interpretación recibida. Revisa las medidas y los módulos.');}
    catch(e){estado(e instanceof Error?e.message:String(e));}finally{boton.disabled=false;}
  });
  $('confirmar-boceto')?.addEventListener('click',async()=>{
    if(!id||!interpretacion)return;
    if(!window.confirm('¿Has revisado cada módulo y sus medidas? Las cotas desconocidas no son válidas para fabricación.'))return;
    const boton=$('confirmar-boceto') as HTMLButtonElement;boton.disabled=true;
    try{
      const validada={...interpretacion,estado:'validada'};
      const r=await fetch('/api/panel/studio-bocetos',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,revision,interpretacion:validada})});
      const j=await r.json();if(!r.ok)throw Error(j.error||JSON.stringify(j.errores));
      revision=j.revision;interpretacion={...validada,confirmadaPor:'usuario',confirmadaEn:new Date().toISOString()};mostrar();estado('Distribución confirmada. Las medidas desconocidas siguen pendientes de medir.');void cargar();
    }catch(e){estado(e instanceof Error?e.message:String(e));}finally{boton.disabled=false;}
  });
  async function cargarGeneraciones(){
    if(!id)return;
    const r=await fetch('/api/panel/studio-generar?id='+encodeURIComponent(id));
    if(!r.ok)return;
    const j=await r.json();
    const ultima=(j.generaciones||[]).find((g:any)=>g.estado==='completada'&&g.resultado_archivo_id);
    if(!ultima)return;
    const marco=$('comparador-boceto');marco.hidden=false;
    ($('imagen-antes') as HTMLImageElement).src='/api/panel/studio-archivos?id='+encodeURIComponent(espacio);
    ($('imagen-despues') as HTMLImageElement).src='/api/panel/studio-archivos?id='+encodeURIComponent(ultima.resultado_archivo_id);
  }
  $('deslizador-boceto')?.addEventListener('input',()=>{
    const v=Number(($('deslizador-boceto') as HTMLInputElement).value);
    ($('recorte-despues') as HTMLElement).style.clipPath='inset(0 '+(100-v)+'% 0 0)';
  });
  $('duplicar-boceto')?.addEventListener('click',async()=>{
    if(!id||interpretacion?.estado!=='validada'){estado('Solo se puede crear una nueva revisión de un diseño aprobado.');return;}
    if(!window.confirm('Se creará un borrador independiente. Deberás subir las fotografías otra vez.'))return;
    try{
      const r=await fetch('/api/panel/studio-duplicar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id})});
      const j=await r.json();if(!r.ok)throw Error(j.error||'No se pudo crear la revisión');
      await abrir(j.id);await cargar();estado('Nueva revisión editable creada. Vuelve a subir las dos fotografías.');
    }catch(e){estado(e instanceof Error?e.message:String(e));}
  });
  $('consultar-despiece')?.addEventListener('click',async()=>{
    if(!id)return;
    try{
      const r=await fetch('/api/panel/studio-despiece?id='+encodeURIComponent(id));
      const j=await r.json();if(!r.ok)throw Error('No se pudo consultar el despiece');
      const d=j.despiece;const zona=$('resultado-despiece');zona.replaceChildren();
      const titulo=document.createElement('p');titulo.textContent='Piezas: '+d.partidas.length+' · '+(d.despieceCompleto?'Despiece medido; falta valorar presupuesto':'Pendiente de mediciones');zona.append(titulo);
      for(const p of d.partidas){
        const linea=document.createElement('p');linea.textContent=p.tipo+' · '+p.varianteId+' · '+p.cantidad+' ud · '+(p.metrosCuadrados===null?'Superficie sin confirmar':p.metrosCuadrados.toFixed(3)+' m²');zona.append(linea);
      }
      for(const bloqueo of d.bloqueos){const linea=document.createElement('p');linea.textContent='Pendiente: '+bloqueo;zona.append(linea);}
    }catch(e){estado(e instanceof Error?e.message:String(e));}
  });
  $('generar-boceto')?.addEventListener('click',async()=>{
    if(!id||!interpretacion||interpretacion.estado!=='validada'){estado('Valida primero el boceto y los materiales.');return;}
    const boton=$('generar-boceto') as HTMLButtonElement;boton.disabled=true;estado('Generando imagen…');
    try{
      claveGeneracion ||= crypto.randomUUID();
      const r=await fetch('/api/panel/studio-generar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,clave:claveGeneracion})});
      const j=await r.json();
      if(j.estado==='fallida'){claveGeneracion='';throw Error(j.error||'La generación anterior falló; vuelve a intentarlo.');}
      if(!r.ok)throw Error(j.error||'Error al generar');
      if(j.estado==='procesando'||r.status===202){estado('La generación sigue procesándose. Consulta el historial antes de reintentar.');return;}
      if(j.estado==='fallida'){claveGeneracion='';throw Error('La generación anterior falló; vuelve a intentarlo.');}
      await cargarGeneraciones();claveGeneracion='';estado('Imagen guardada en R2 privado.');
    }catch(e){estado(e instanceof Error?e.message:String(e));}finally{boton.disabled=false;}
  });
  void cargarMateriales().catch(e=>estado(String(e)));
  void cargar();
</script>}
