---
import PaginaPanel from '../../../components/panel/PaginaPanel.astro';
import { TIPOS_MOVIMIENTO, type TipoMovimiento } from '../../../server/data/tipos.ts';
import { campo, sesionCon } from '../../../server/panel/pagina.ts';
import { MAXIMO_MOVIMIENTO, MOTIVOS, moverInventario, NOMBRE_TIPO } from '../../../server/panel/inventario.ts';
import type { DatosPlanta } from '../../../server/panel/plantas.ts';

export const prerender = false;

const s = sesionCon(Astro.locals, 'inventario');
const id = Astro.params.id ?? '';
const entrada = s ? await s.repos.contenido.obtener('catalogo', id) : null;
if (s && !entrada) return Astro.redirect('/panel/inventario', 303);
const nombre = String((entrada?.borrador.datos as DatosPlanta | undefined)?.nombre?.es ?? id);

let error = '';
let crudo: FormData | null = null;
if (s && Astro.request.method === 'POST') {
  crudo = await Astro.request.formData();
  const r = await moverInventario(
    s.repos,
    id,
    { tipo: campo(crudo, 'tipo') as TipoMovimiento, cantidad: Number(campo(crudo, 'cantidad')), motivo: campo(crudo, 'motivo'), nota: campo(crudo, 'nota') },
    s.usuario.email,
  );
  if (r.ok) return Astro.redirect(`/panel/inventario/${id}?mensaje=${encodeURIComponent(r.texto)}`, 303);
  error = r.error;
}
const existencias = s ? ((await s.repos.inventario.existencias())[id] ?? { disponible: 0, desperdicio: 0, ultimo: '' }) : null;
const movimientos = s ? await s.repos.inventario.movimientos({ planta: id, limite: 100 }) : [];
const tipoElegido = (crudo && campo(crudo, 'tipo')) || 'entrada';
const fecha = (iso: string) => new Date(iso).toLocaleString('es-ES', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Madrid' });
const AYUDA: Record<TipoMovimiento, string> = { entrada: 'Suman: producción, compras, devoluciones…', salida: 'Restan: ventas sin factura, regalos, traslados…', baja: 'Restan y se cuentan como desperdicio: muertas, dañadas…' };
---

<PaginaPanel titulo={`Inventario: ${nombre}`} permiso="inventario" volver="/panel/inventario">
  <h1 class="titular-grande">{nombre}</h1>
  {Astro.url.searchParams.get('mensaje') && <p role="status" class="mt-4 rounded-tarjeta bg-verdor p-3 font-semibold">{Astro.url.searchParams.get('mensaje')}</p>}
  {
    existencias && (
      <dl class="mt-6 grid grid-cols-2 gap-3">
        <div class="caja-panel p-4">
          <dt class="text-gris">Disponibles</dt>
          <dd class:list={['font-titular text-4xl font-bold tabular', existencias.disponible <= 0 && 'text-terracota']}>{existencias.disponible}</dd>
        </div>
        <div class="caja-panel p-4">
          <dt class="text-gris">De baja (desperdicio)</dt>
          <dd class="font-titular text-4xl font-bold tabular">{existencias.desperdicio}</dd>
        </div>
      </dl>
    )
  }
  <p class="mt-3"><a href={`/panel/plantas/${id}`} class="enlace-panel">Ver la ficha de la planta</a></p>

  <form method="post" class="mt-8 grid gap-5 caja-panel p-5" data-movimiento>
    <h2 class="titular-medio">Apuntar un movimiento</h2>
    {error && <p role="alert" class="rounded-tarjeta bg-arena-prueba p-3 font-semibold">{error}</p>}
    <fieldset class="grid gap-2">
      <legend class="mb-1 font-semibold">¿Qué pasa?</legend>
      {
        TIPOS_MOVIMIENTO.map((t) => (
          <label class="flex min-h-12 items-center gap-3 rounded-tarjeta px-2 hover:bg-verdor">
            <input type="radio" name="tipo" value={t} checked={t === tipoElegido} class="size-6 shrink-0" />
            <span>
              <span class="font-semibold">{NOMBRE_TIPO[t]}</span>
              <span class="block text-sm text-gris">{AYUDA[t]}</span>
            </span>
          </label>
        ))
      }
    </fieldset>
    <div class="grid gap-1">
      <label for="cantidad" class="font-semibold">Cuántas plantas</label>
      <input id="cantidad" name="cantidad" type="number" inputmode="numeric" min="1" max={MAXIMO_MOVIMIENTO} step="1" required class="campo-panel max-w-48" value={crudo ? campo(crudo, 'cantidad') : ''} />
    </div>
    <div class="grid gap-1">
      <label for="motivo" class="font-semibold">Motivo</label>
      <select id="motivo" name="motivo" required class="campo-panel">
        {
          TIPOS_MOVIMIENTO.map((t) => (
            <optgroup label={NOMBRE_TIPO[t]} data-tipo={t}>
              {MOTIVOS[t].map((m) => (
                <option value={m} selected={crudo ? campo(crudo, 'motivo') === m && campo(crudo, 'tipo') === t : undefined}>
                  {m}
                </option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </div>
    <div class="grid gap-1">
      <label for="nota" class="font-semibold">Nota <span class="font-normal text-gris">(opcional; obligatoria con «Otro motivo»)</span></label>
      <input id="nota" name="nota" maxlength="300" class="campo-panel" value={crudo ? campo(crudo, 'nota') : ''} placeholder="Por ejemplo: bancal 3, helada del martes" />
    </div>
    <p><button class="boton-panel">Guardar el movimiento</button></p>
  </form>

  <section class="mt-10" aria-labelledby="historial">
    <h2 id="historial" class="titular-medio">Historial</h2>
    {movimientos.length === 0 && <p class="mt-3 text-gris">Todavía no hay movimientos. Empieza apuntando las plantas que hay ahora como «Entrada».</p>}
    <ul class="mt-3 grid gap-2" role="list">
      {
        movimientos.map((m) => (
          <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-linea py-2">
            <span class="min-w-0">
              <strong>{NOMBRE_TIPO[m.tipo]}</strong> · {m.motivo}
              {m.nota && <span class="text-gris"> · {m.nota}</span>}
              <span class="block text-sm text-gris">
                {fecha(m.fecha)} · {m.email}
              </span>
            </span>
            <strong class:list={['tabular', m.cantidad < 0 ? 'text-terracota' : 'text-oliva']}>{m.cantidad > 0 ? `+${m.cantidad}` : m.cantidad}</strong>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-sm text-gris">Los movimientos no se borran: si te equivocas, apunta otro que lo compense.</p>
  </section>
</PaginaPanel>

<script>
  // Con JavaScript, el motivo solo ofrece los del tipo elegido.
  const form = document.querySelector<HTMLFormElement>('[data-movimiento]');
  const motivo = form?.querySelector<HTMLSelectElement>('#motivo');
  const filtrar = () => {
    const tipo = form?.querySelector<HTMLInputElement>('input[name=tipo]:checked')?.value;
    let primera: HTMLOptionElement | null = null;
    for (const g of motivo?.querySelectorAll<HTMLOptGroupElement>('optgroup') ?? []) {
      const vale = g.dataset.tipo === tipo;
      g.hidden = !vale;
      g.disabled = !vale;
      if (vale) primera ??= g.querySelector('option');
    }
    if (motivo && primera && motivo.selectedOptions[0]?.parentElement !== primera.parentElement) primera.selected = true;
  };
  form?.addEventListener('change', (e) => (e.target as HTMLElement).matches('input[name=tipo]') && filtrar());
  filtrar();
</script>
