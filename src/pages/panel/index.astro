---
import PaginaPanel from '../../components/panel/PaginaPanel.astro';
import Tarjeta from '../../components/panel/Tarjeta.astro';
import { tp } from '../../i18n/panel';
import { sesionCon } from '../../server/panel/pagina.ts';
import { puede } from '../../server/panel/permisos.ts';

export const prerender = false;

const s = sesionCon(Astro.locals);
const rol = s?.usuario.rol ?? 'editor';
const nuevos = s && puede(rol, 'presupuestos') ? await s.repos.presupuestos.contar('nuevo') : 0;
const porCobrar = s && puede(rol, 'facturas') ? (await s.repos.facturas.listar({ estado: 'emitida' })).length : 0;
const pendientes = s ? (await s.repos.contenido.pendientes()).length : 0;
const t = tp.tarjetas;
---

<PaginaPanel titulo={tp.inicio} volver={false}>
  <h1 class="titular-grande">
    {tp.hola(s?.usuario.nombre ?? '')}
    <span class="mt-2 block text-lg font-normal text-gris">{s && tp.roles[s.usuario.rol]}</span>
  </h1>
  <ul class="mt-8 grid gap-4" role="list">
    {
      puede(rol, 'publicar') && (
        <Tarjeta href="/panel/publicar" titulo="Publicar cambios" texto={pendientes ? 'Hay cambios guardados que aún no están en la web' : 'La web está al día'} aviso={pendientes ? `${pendientes}` : undefined} />
      )
    }
    <Tarjeta href="/panel/asistente" titulo="Asistente" texto="Cambiar precios y más, paso a paso" />
    <Tarjeta href="/panel/plantas" titulo={t.plantas[0]} texto={t.plantas[1]} />
    {puede(rol, 'presupuestos') && <Tarjeta href="/panel/presupuestos" titulo={t.presupuestos[0]} texto={t.presupuestos[1]} aviso={nuevos ? tp.nuevos(nuevos) : undefined} />}
 {puede(rol, 'facturas') && <Tarjeta href="/panel/facturas" titulo="Facturas" texto="Hacer facturas y ver lo que falta por cobrar" aviso={porCobrar ? `${porCobrar} por cobrar` : undefined} />}
    <Tarjeta href="/panel/fotos" titulo={t.fotos[0]} texto={t.fotos[1]} />
    <Tarjeta href="/panel/textos" titulo={t.textos[0]} texto={t.textos[1]} />
    <Tarjeta href="/panel/ayuda" titulo={t.ayuda[0]} texto={t.ayuda[1]} />
    <Tarjeta href="/panel/cambios" titulo="Cambios recientes" texto="Ver lo que se ha cambiado y deshacer" />
    {puede(rol, 'personas') && <Tarjeta href="/panel/personas" titulo={t.personas[0]} texto={t.personas[1]} />}
  </ul>
</PaginaPanel>
