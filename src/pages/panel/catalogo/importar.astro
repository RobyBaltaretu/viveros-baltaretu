---
import PaginaPanel from '../../../components/panel/PaginaPanel.astro';
import { clienteActual } from '../../../plataforma/actual.ts';
import { sesionCon } from '../../../server/panel/pagina.ts';
export const prerender = false;
if (clienteActual().id !== 'turia') return new Response('No disponible', {status:404});
const sesion = sesionCon(Astro.locals, 'facturas');
---
<PaginaPanel titulo="Importar catálogo con Gubia" permiso="facturas" ancho="amplio">
  <div class="nv-titulo">
    <div>
      <a href="/panel/catalogo" class="gubia-volver">← Volver al catálogo</a>
      <h1>Importar catálogo con Gubia</h1>
      <p>El PDF se lee en tu navegador con PDF.js. Groq Free interpreta las tablas y, si lo necesitas, revisa muestras visuales. Gemini no se utiliza.</p>
    </div>
  </div>
  {sesion && <div class="gubia-importador">
    <section class="nv-tarjeta nv-seccion" aria-labelledby="gubia-paso1">
      <h2 id="gubia-paso1">1. Selecciona el documento</h2>
      <form id="gubia-pdf-form" class="gubia-formulario">
        <label>Proveedor <input required id="gubia-proveedor" name="proveedor" maxlength="80" placeholder="Ej. ONESTA" autocomplete="organization" /></label>
        <label>PDF del catálogo <input id="gubia-pdf" name="archivo" type="file" accept=".pdf,application/pdf" required /></label>
        <label>Empezar desde la página <input id="gubia-inicio" type="number" min="1" max="160" value="1" aria-describedby="gubia-continuar-ayuda" /></label>
        <p class="gubia-nota" id="gubia-continuar-ayuda">Si Groq Free se queda sin cuota, podrás continuar desde la siguiente página otro día sin duplicar artículos.</p>
        <p class="gubia-nota">Máximo 25 MB y 160 páginas. El PDF permanece en tu dispositivo: solo enviamos texto extraído y, si tú lo solicitas, una imagen de la página a Groq Free. No se llama a Gemini. Se utilizan las cuotas gratuitas de Groq.</p>
        <label><span><input style="width:auto;min-height:0" id="gubia-vision-auto" type="checkbox" /> Revisar con Groq Vision hasta 8 páginas sin texto o sin propuestas</span></label>
        <p class="gubia-nota">Si lo activas, se enviará la imagen de esas páginas a Groq. Puedes revisar las demás a mano.</p>
        <button class="nv-boton" id="gubia-analizar" type="submit">Analizar PDF con Gubia</button>
      </form>
    </section>
    <section class="nv-tarjeta nv-seccion" aria-label="Progreso de lectura y análisis" id="gubia-seguimiento" hidden>
      <h2>Procesamiento del catálogo</h2>
      <progress id="gubia-progreso" aria-label="Progreso de análisis del PDF" max="100" value="0" style="width:100%;height:13px;accent-color:#526b39"></progress>
      <p id="gubia-fase" class="gubia-nota">Leyendo PDF localmente…</p>
    </section>
    <div class="gubia-estado nv-caja-aviso" id="gubia-estado" role="status" aria-live="polite">Elige un PDF para comenzar. No se realizará ninguna importación sin tu confirmación.</div>
    <section class="nv-tarjeta nv-seccion" id="gubia-resultado" hidden aria-labelledby="gubia-paso2">
      <div class="gubia-cabecera">
        <div><h2 id="gubia-paso2">2. Revisa los materiales</h2><p>Los datos son propuestas de IA, no están todavía en el catálogo. Desmarca las fichas que no quieras crear.</p></div>
        <span class="nv-chip" id="gubia-total" aria-live="polite">0 candidatos</span>
      </div>
      <div class="gubia-resumen">
        <label><input type="checkbox" id="gubia-todos" checked /> Seleccionar todos</label>
        <label>Filtrar <input type="search" id="gubia-buscar" placeholder="Nombre, referencia, acabado…" /></label>
      </div>
      <p class="gubia-nota">Las texturas se recortan del PDF del proveedor. El color HEX es aproximado y no sustituye a la muestra física oficial. La importación no crea precios ni modifica artículos existentes. Revisa las fichas antes de confirmar.</p>
      <div id="gubia-lista" class="gubia-lista"></div>
      <button type="button" id="gubia-mas" class="nv-boton nv-boton-secundario" hidden>Mostrar otras 20 fichas</button>
      <section class="gubia-vision" aria-labelledby="gubia-titulo-vision">
        <h3 id="gubia-titulo-vision">Comprobar una página visual</h3>
        <p class="gubia-nota">Si un material está en una carta de colores o no tiene texto seleccionable, pide a Groq que lea esa página. Solo se envía una imagen JPEG de esa página y el texto disponible. Esta función consume cuota gratuita de Groq.</p>
        <div class="gubia-vision-controles">
          <label> Página del catálogo <input id="gubia-numero-pagina" type="number" min="1" max="160" value="1" /></label>
          <button type="button" id="gubia-ver-pagina" class="nv-boton nv-boton-secundario">Ver página</button>
          <button type="button" id="gubia-analizar-vision" class="nv-boton nv-boton-secundario">Analizar imagen con Groq</button>
          <label>Asociar muestra a <select id="gubia-muestra-destino" aria-label="Artículo al que asignar una muestra"></select></label>
        </div>
        <div id="gubia-vista-pagina" class="gubia-vista-pagina" hidden>
          <img id="gubia-preview-pagina" role="button" tabindex="0" alt="Seleccionar muestra de la página del PDF. Pulsa Intro para recortar el centro; toca el punto exacto con el ratón o el dedo." />
          <p class="gubia-nota">Selecciona un artículo arriba y toca sobre su muestra en la página. Guardaremos un pequeño recorte WebP privado para ese material.</p>
        </div>
      </section>
      <button type="button" id="gubia-crear-manual" class="nv-boton nv-boton-secundario">Añadir ficha manualmente</button>
      <div class="gubia-final">
        <button class="nv-boton nv-boton-secundario" id="gubia-cancelar" type="button">Descartar revisión</button>
        <button class="nv-boton" id="gubia-confirmar" type="button">Crear artículos seleccionados</button>
      </div>
    </section>
  </div>}
</PaginaPanel>
<style is:inline>
.gubia-importador{display:grid;gap:18px}.gubia-volver{color:#536b36;font-size:.87rem}.gubia-formulario{display:grid;gap:14px;max-width:690px}
.gubia-formulario label{display:grid;gap:7px;font-weight:700;font-size:.87rem}.gubia-formulario input{width:100%;min-height:47px;padding:10px 12px;border:1px solid #d7d9d0;border-radius:11px;background:#fff;color:#272a24;font:inherit}
.gubia-formulario button{justify-self:start}.gubia-nota{color:#5a6058;font-size:.86rem;line-height:1.5}
.gubia-cabecera,.gubia-resumen,.gubia-final{display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;align-items:center}
.gubia-resumen{padding:12px 0;border-block:1px solid #e5e4de}.gubia-resumen label{display:flex;align-items:center;gap:8px}
.gubia-resumen input[type=search]{min-height:44px;padding:8px 12px;border:1px solid #d7d9d0;border-radius:10px;background:white}
.gubia-lista{display:grid;gap:12px;margin:16px 0;align-items:start}
.gubia-item{border:1px solid #e0e4db;border-radius:13px;padding:13px;background:#fff;display:grid;grid-template-columns:56px minmax(0,1fr);gap:12px}
.gubia-item:not([data-activo=true]){opacity:.64}.gubia-muestra{width:54px;height:54px;border-radius:10px;border:1px solid #ddd9d0;background:#e6e1d8}
.gubia-item-contenido{min-width:0}.gubia-item-cabecera{display:flex;gap:10px;align-items:center;margin-bottom:8px}.gubia-item-cabecera label{display:flex;gap:8px;align-items:center;font-weight:700}
.gubia-item-campos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.gubia-item-campos label{display:grid;gap:4px;font-size:.75rem;font-weight:600;color:#53594e;min-width:0}
.gubia-item-campos input,.gubia-item-campos select{width:100%;min-width:0;min-height:40px;background:#fff;border:1px solid #d8ded2;border-radius:8px;padding:7px;font:inherit;font-size:.86rem;color:#232823}
.gubia-item strong{display:block;font-size:1.06rem;overflow-wrap:anywhere}.gubia-item summary{min-height:48px;line-height:1.5;padding:12px 0;cursor:pointer;font-weight:650;color:#435638}.gubia-origen{font-size:.75rem;color:#626960;margin:8px 0 0}
.gubia-vision{margin:1.3rem 0;padding:1.2rem;border:1px solid #dbe3d5;background:#f9fbf7;border-radius:14px}
.gubia-vision h3{font-size:1.05rem;font-weight:750}
.gubia-vision-controles{display:flex;align-items:end;flex-wrap:wrap;gap:.65rem}
.gubia-vision-controles label{display:grid;gap:.3rem;font-size:.82rem;font-weight:700}
.gubia-vision-controles input{max-width:100px;min-height:43px;padding:7px;border:1px solid #cbd4c3;border-radius:8px}
.gubia-vision-controles select{max-width:240px;min-height:43px;padding:7px;border:1px solid #cbd4c3;border-radius:8px;background:#fff}
#gubia-preview-pagina{cursor:crosshair;touch-action:manipulation}
.gubia-vista-pagina{max-height:360px;overflow:auto;margin-top:1rem;display:grid;place-items:start center}
.gubia-vista-pagina[hidden]{display:none}
.gubia-vista-pagina img{display:block;max-width:100%;max-height:350px;object-fit:contain;border:1px solid #e3e1dd;border-radius:8px}
.gubia-final{border-top:1px solid #e6e7de;padding-top:16px}.gubia-estado{margin-top:4px}
.gubia-importador button:focus-visible,.gubia-importador input:focus-visible,.gubia-importador select:focus-visible{outline:3px solid #526939;outline-offset:2px}
@media(max-width:600px){.gubia-item{grid-template-columns:42px minmax(0,1fr);gap:9px;padding:10px}.gubia-muestra{width:42px;height:42px}.gubia-item-campos{grid-template-columns:minmax(0,1fr)}.gubia-resumen label{width:100%}.gubia-resumen input[type=search]{flex:1;min-width:0}.gubia-final button{flex:1;min-height:48px}}
</style>
<script src="../../../panel-nuevo/gubia-pdf.ts"></script>
<script is:inline>
(() => {
  const form = document.getElementById('gubia-pdf-form');
  if (!form) return;
  const $ = id => document.getElementById(id);
  const estado = $('gubia-estado'), boton = $('gubia-analizar');
  const lista = $('gubia-lista'), resultado = $('gubia-resultado');
  const categorias = ['tableros','macizos','chapas','cantos','encimeras','cristal','herrajes','tiradores','accesorios','iluminacion','consumibles','acabados'];
  let articulos = [], trabajando = false, nombreArchivo = '';
  const mensaje = (s) => {estado.textContent = s;};
  const normal = s => String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
  const field = (tag, key, value, etiqueta, opts) => {
    const label = document.createElement('label'); label.textContent = etiqueta;
    const input = document.createElement(tag);
    if(tag==='select'){
      opts.forEach(opt => {const o=document.createElement('option');o.value=opt;o.textContent=opt;input.append(o);});
    } else {input.type=(key==='espesorMm'||key==='unidadesPaquete')?'number':'text';input.maxLength=key==='nombre'?120:100;if(key==='espesorMm'){input.min='0.01';input.max='1000';input.step='0.1';}if(key==='unidadesPaquete'){input.min='1';input.max='10000';input.step='1';}}
    input.value=value ?? '';
    input.addEventListener('change', () => { const index = Number(label.closest('[data-index]').dataset.index); articulos[index].data[key]=(key==='espesorMm'||key==='unidadesPaquete') ? (input.value===''?null:Number(input.value)) : key==='colorHex' ? (input.value.trim()||null) : input.value; if(key==='colorHex'){const muestra=label.closest('.gubia-item').querySelector('.gubia-muestra');if(/^#[0-9a-fA-F]{6}$/.test(input.value))muestra.style.backgroundColor=input.value;}});
    label.append(input);return label;
  };
  let maxVisibles=20;
  function pintar(){
    lista.replaceChildren();
    const filtro = normal($('gubia-buscar').value);
    let visibles=0;
    articulos.forEach((a, i) => {
      if(filtro && !normal(a.data.nombre+' '+a.data.referencia+' '+a.data.acabado+' '+a.data.codigoDecor).includes(filtro))return;
      if (++visibles>maxVisibles) return;
      const article=document.createElement('article');article.className='gubia-item';article.dataset.index=String(i);article.dataset.activo=String(a.activo);
      const muestra=document.createElement('span');muestra.className='gubia-muestra';
      if(/^#[0-9a-fA-F]{6}$/.test(a.data.colorHex||''))muestra.style.backgroundColor=a.data.colorHex;
      if(a.muestra){muestra.style.backgroundImage='url('+a.muestra+')';muestra.style.backgroundSize='cover';muestra.title='Textura recortada del PDF';}
      const inner=document.createElement('div');inner.className='gubia-item-contenido';
      const head=document.createElement('div');head.className='gubia-item-cabecera';
      const checkLabel=document.createElement('label'),check=document.createElement('input');
      check.type='checkbox';check.checked=a.activo;
      check.addEventListener('change',()=>{a.activo=check.checked;article.dataset.activo=String(check.checked);contar();guardarBorrador();});
      checkLabel.append(check,document.createTextNode('Añadir al catálogo'));head.append(checkLabel);
      const fields=document.createElement('div');fields.className='gubia-item-campos';
      for(const [key,label] of [['nombre','Nombre'],['referencia','Referencia'],['acabado','Acabado / calidad'],['codigoDecor','Código de decor'],['soporte','Soporte'],['formato','Formato']]){
        fields.append(field('input',key,a.data[key],label));
      }
      fields.append(field('select','categoria',a.data.categoria,'Categoría',categorias));
      fields.append(field('input','espesorMm',a.data.espesorMm,'Espesor (mm)'));
      fields.append(field('input','unidadesPaquete',a.data.unidadesPaquete,'Unidades por paquete'));
      fields.append(field('input','colorHex',a.data.colorHex,'Color digital (#RRGGBB)'));
      const span = document.createElement('p');span.className='gubia-origen';
      span.textContent='Página original '+a.data.pagina+' · '+(a.data.espesorMm === null ? 'Espesor no especificado' : a.data.espesorMm+' mm')+' · Precio pendiente de validar';
      const title=document.createElement('strong');title.textContent=a.data.nombre;
      const editor=document.createElement('details'),summary=document.createElement('summary');
      summary.textContent='Editar ficha'+(a.data.referencia?' · '+a.data.referencia:'');
      editor.open=visibles===1;editor.append(summary,fields);
      fields.addEventListener('change',()=>{title.textContent=a.data.nombre;guardarBorrador();});
      inner.append(title,span,head,editor);article.append(muestra,inner);lista.append(article);
    });
    $('gubia-mas').hidden=visibles<=maxVisibles;
    if(!visibles){const p=document.createElement('p');p.textContent='No hay resultados para esta búsqueda.';lista.append(p);}
    const selector=$('gubia-muestra-destino');
    if(selector){
      const previous=selector.value;selector.replaceChildren();
      articulos.forEach((a,i)=>{const opt=document.createElement('option');opt.value=String(i);opt.textContent=a.data.nombre+' · '+(a.data.referencia||'Sin ref.');selector.append(opt);});
      if(articulos[Number(previous)])selector.value=previous;
    }
    contar();
  }
  function contar(){ $('gubia-total').textContent=articulos.filter(a=>a.activo).length+' seleccionados de '+articulos.length; }
  function detener(value){trabajando=value;boton.disabled=value;$('gubia-confirmar').disabled=value;}
  $('gubia-mas').onclick=()=>{maxVisibles+=20;pintar();};
  $('gubia-buscar').addEventListener('input',()=>{maxVisibles=20;pintar();});
  $('gubia-todos').addEventListener('change',e=>{articulos.forEach(a=>a.activo=e.target.checked);pintar();});
  $('gubia-cancelar').addEventListener('click',()=>{
    articulos=[];sessionStorage.removeItem(BORRADOR);resultado.hidden=true;mensaje('Revisión descartada. Los artículos existentes no se han modificado.');});
  let documento = null;
  let siguientePagina = 1;
  const textosPagina = new Map();
  const BORRADOR = 'gubia-turia-importacion-local-v1';
  function guardarBorrador() {
    try {
      sessionStorage.setItem(BORRADOR,JSON.stringify({proveedor:$('gubia-proveedor').value,nombreArchivo,articulos,siguientePagina}));
    } catch { /* Memoria de sesión agotada: continúa en la pestaña. */ }
  }
  function juntarCandidatos(nuevos) {
    const clave=window.gubiaPDF.identidadProveedor;
    const vistos=new Set(articulos.map(x=>clave(x.data)));
    for(const item of nuevos||[]) {
      const k=clave(item);
      if(!vistos.has(k)){articulos.push({activo:true,data:item});vistos.add(k);}
    }
    guardarBorrador();
    pintar();
  }
  const esperar = ms => new Promise(resolve=>setTimeout(resolve,ms));
  const jsonPost = async body => {
    const res=await fetch('/api/panel/catalogo-importar',{
      method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)
    });
    const r=await res.json().catch(()=>({}));
    if(!res.ok||!r.ok){
      const error=Error(r.error||'Gubia no ha podido interpretar el material.');
      error.estado=res.status;
      error.reintentarEnMs=Number(r.reintentarEnMs)||Number(res.headers.get('Retry-After'))*1000||0;
      throw error;
    }
    return r;
  };
  const mostrarRevision = () => {
    resultado.hidden=false;
    pintar();
    resultado.scrollIntoView({behavior:'smooth',block:'start'});
  };
  const actualizarProgreso = (actual,total,descripcion) => {
    $('gubia-seguimiento').hidden=false;
    $('gubia-progreso').value=Math.round(actual/Math.max(total,1)*100);
    $('gubia-fase').textContent=descripcion;
    mensaje(descripcion+' · '+articulos.length+' fichas propuestas');
  };
  form.addEventListener('submit',async e=>{
    e.preventDefault();if(trabajando)return;
    const file=$('gubia-pdf').files?.[0],proveedor=$('gubia-proveedor').value.trim();
    if(!file||!proveedor){mensaje('Selecciona el PDF e indica el proveedor.');return;}
    if(!window.gubiaPDF){mensaje('Todavía no se ha cargado PDF.js. Comprueba la conexión y vuelve a intentarlo.');return;}
    const comenzar=Number($('gubia-inicio').value)||1;
    if(!Number.isInteger(comenzar)||comenzar<1||comenzar>160){mensaje('La página de inicio debe estar entre 1 y 160.');return;}
    const continuar=comenzar>1 && nombreArchivo===file.name;
    if(!continuar){articulos=[];sessionStorage.removeItem(BORRADOR);}
    nombreArchivo=file.name;siguientePagina=comenzar;textosPagina.clear();
    resultado.hidden=true;detener(true);
    let fase='abrir PDF';
    try{
      if(documento){await documento.cerrar();documento=null;}
      documento=await window.gubiaPDF.abrirPDFLocal(file);
      $('gubia-numero-pagina').max=String(documento.paginas);
      if(comenzar>documento.paginas)throw Error('La página de inicio supera las páginas del documento.');
      const paginasFallidas=[];
      const muestrasDetectadas=[];
      let bloque=[],longitud=0;
      let groqDisponible=true;
      let errorGroq='';
      let fichasLocales=0;
      const paginasLocales=new Set();
      const sinTexto=[];
      const revisar=[];
      const enviar=async () => {
        if(!bloque.length)return;
        const hasta=bloque[bloque.length-1].pagina;
        actualizarProgreso(hasta,documento.paginas,'Groq Free interpreta hasta la página '+hasta+' de '+documento.paginas);
        fase='interpretar lote hasta página '+hasta;
        let interpretados=[];
        if (groqDisponible) {
          try {
            const response=await jsonPost({accion:'interpretar',proveedor,paginas:bloque});
            interpretados=response.articulos.filter(c=> !(c.espesorMm == null && !c.formato && articulos.some(a=>a.data.pagina===c.pagina && a.data.espesorMm != null && normal(a.data.nombre).startsWith(normal(c.nombre)))));
            juntarCandidatos(interpretados);
            const espera=Math.min(25_000,Math.max(0,Number(response.limites?.esperarMs)||0));
            if(espera){
              actualizarProgreso(hasta,documento.paginas,'Pausa breve para respetar el límite de tokens de Groq Free');
              await esperar(espera);
            }
          } catch(err) {
            groqDisponible=false;
            errorGroq=err?.message||'No se ha podido procesar el lote en Groq';
          }
        }
        {
          // No consumir de nuevo cuotas Groq con 404/429 o fallos de red.
          // Se generan únicamente propuestas verificables desde el texto local.
          fase='generar propuestas locales hasta página '+hasta;
          const sugeridos=window.gubiaPDF.sugerirMaterialesLocales(bloque.filter(p=>!paginasLocales.has(p.pagina)).map(p=>({...p,texto:textosPagina.get(p.pagina)||p.texto}))).filter(local =>
            !interpretados.some(ia => ia.pagina===local.pagina && local.referencia && ia.referencia===local.referencia &&
              (!local.acabado || local.acabado===ia.acabado) && ia.categoria===local.categoria &&
              (!local.soporte || normal(local.soporte)===normal(ia.soporte)) &&
              (!/hidrófug|ignífug/i.test(local.nombre) || normal(local.nombre)===normal(ia.nombre))));
          for (const p of bloque) if (![...interpretados,...sugeridos].some(a=>a.pagina===p.pagina)) revisar.push(p.pagina);
          bloque.forEach(p=>paginasLocales.add(p.pagina));
          fichasLocales+=sugeridos.length;
          juntarCandidatos(sugeridos);
        }
        siguientePagina=hasta+1;
        $('gubia-inicio').value=String(Math.min(siguientePagina,documento.paginas));
        guardarBorrador();
        bloque=[];longitud=0;
      };
      for(let numero=comenzar;numero<=documento.paginas;numero++){
        actualizarProgreso(numero-1,documento.paginas,'PDF.js leyendo página '+numero+' de '+documento.paginas+' en este dispositivo');
        let pagina;
        fase='extraer texto de página '+numero;
        try {
          pagina=await documento.pagina(numero);
        } catch(error) {
          paginasFallidas.push({pagina:numero,detalle:error instanceof Error?error.message:String(error)});
          console.error('[Gubia Importador] No se pudo extraer la página '+numero,error);
          siguientePagina=numero+1;
          continue;
        }
        textosPagina.set(numero,pagina.texto);
        if(pagina.muestras?.length)muestrasDetectadas.push(...pagina.muestras);
        if(pagina.variantes?.length){
          // La matriz estructurada ya contiene las combinaciones verificables:
          // no duplicar con sugerencias genéricas de Groq ni gastar su cuota.
          await enviar();
          juntarCandidatos(pagina.variantes);
          paginasLocales.add(numero);
          siguientePagina=numero+1;
          actualizarProgreso(numero,documento.paginas,'Matriz técnica: '+pagina.variantes.length+' variantes comprobadas en página '+numero);
          continue;
        }
        // El resto de páginas (escaneos, páginas sin texto) se revisa visualmente cuando el usuario lo solicite.
        if(!pagina.texto.trim()){sinTexto.push(numero);continue;}
        // Conserva todo el texto local. Los trozos de una página se envían por separado
        // porque la API no admite números de página repetidos en un lote.
        const trozos=pagina.texto.match(/[\s\S]{1,4000}(?:\n|$)|[\s\S]{1,4000}/g) || [];
        for (const texto of trozos) {
          if(bloque.some(p=>p.pagina===numero) || bloque.length>=3 || longitud+texto.length>9000) await enviar();
          bloque.push({pagina:numero,texto});
          longitud+=texto.length;
          if(bloque.length===3)await enviar();
        }
      }
      await enviar();
      if(paginasFallidas.length && !articulos.length && paginasFallidas.length===documento.paginas-comenzar+1)
        throw Error('No se ha podido leer ninguna página. Primer error: '+paginasFallidas[0].detalle);
      let avisoVision='';
      if ($('gubia-vision-auto').checked) {
        const prioridades=[...new Set([...sinTexto,...revisar])].filter(p=>!articulos.some(a=>a.data.pagina===p)).slice(0,8);
        for (const pagina of prioridades) {
          actualizarProgreso(pagina,documento.paginas,'Interpretando imagen de la página '+pagina);
          try {
            const r=await jsonPost({accion:'vision',proveedor,pagina,imagen:await documento.imagen(pagina),texto:(textosPagina.get(pagina)||'').slice(0,2500)});
            juntarCandidatos(r.articulos);
          } catch(e) { avisoVision=' · Revisión visual detenida: '+e.message;break; }
        }
      }
      // Asociar muestras oficiales del PDF por código decorativo, nunca por
      // similitud visual o nombre. Preferir la página más cercana para no
      // confundir el mismo código entre melamina, HPL y compacto.
      let muestrasAsignadas=0;
      for(const articulo of articulos){
        const codigo=String(articulo.data.codigoDecor||articulo.data.referencia||'').toUpperCase().trim();
        if(!codigo||articulo.muestra)continue;
        const compatibles=muestrasDetectadas.filter(m=>(m.codigo===codigo||(
          /^\d{3,4}$/.test(codigo)&&m.codigo===codigo.padStart(4,'0')))&&(
          !m.acabado||!articulo.data.acabado||m.acabado===String(articulo.data.acabado).trim().toUpperCase()
        ));
        const elegida=compatibles.sort((a,b)=>Math.abs(a.pagina-articulo.data.pagina)-Math.abs(b.pagina-articulo.data.pagina))[0];
        if(!elegida||Math.abs(elegida.pagina-articulo.data.pagina)>2)continue;
        articulo.muestra=elegida.muestra;
        if(!articulo.data.colorHex)articulo.data.colorHex=elegida.colorHex;
        muestrasAsignadas++;
      }
      if(muestrasAsignadas){guardarBorrador();pintar();}
      siguientePagina=documento.paginas+1;guardarBorrador();
      actualizarProgreso(documento.paginas,documento.paginas,'Análisis finalizado');
      mostrarRevision();
      mensaje(errorGroq
        ? 'PDF leído: '+documento.paginas+' páginas. Groq no ha podido analizar el documento: '+errorGroq+'. Se han recuperado '+fichasLocales+' posibles fichas mediante lectura local; REVISA sus datos antes de crearlas. Puedes consultar el PDF, añadir fichas manualmente o reintentar mañana.'
        : 'PDF procesado localmente: '+documento.paginas+' páginas, '+articulos.length+' materiales; '+muestrasAsignadas+' fichas con muestra visual del PDF. Puedes utilizar la revisión visual para las páginas con muestras.');
      if (avisoVision) mensaje(estado.textContent+avisoVision);
      const pendientes=[...new Set([...sinTexto,...revisar])].filter(p=>!articulos.some(a=>a.data.pagina===p));
      if (pendientes.length) mensaje(estado.textContent+' · Páginas sin propuestas, disponibles en revisión visual: '+pendientes.join(', ')+'.');
      if (paginasFallidas.length) mensaje(estado.textContent+' · Páginas con errores de extracción: '+paginasFallidas.map(p=>p.pagina).join(', ')+'. Primer error: '+paginasFallidas[0].detalle+'.');

    }catch(err){
      const detalle=err?.message||String(err)||'Error desconocido';
      actualizarProgreso(0,1,'Análisis interrumpido');
      $('gubia-inicio').value=String(siguientePagina);
      mensaje('Análisis interrumpido durante «'+fase+'», página '+siguientePagina+': '+detalle+'. Puedes revisar lo encontrado y reanudar con el mismo PDF.');
      console.error('[Gubia Importador] Error durante el análisis',err);
      if(articulos.length)mostrarRevision();
      estado.scrollIntoView({behavior:'smooth',block:'center'});
    }finally{detener(false);}
  });
  async function vistaPagina(){
    if(!documento){mensaje('Primero abre el PDF desde esta pantalla. Los borradores recuperados requieren seleccionar de nuevo el documento para ver las páginas.');return null;}
    const numero=Number($('gubia-numero-pagina').value);
    if(!Number.isInteger(numero)||numero<1||numero>documento.paginas){mensaje('Elige un número de página entre 1 y '+documento.paginas);return null;}
    const image=await documento.imagen(numero);
    $('gubia-preview-pagina').src=image;
    $('gubia-vista-pagina').hidden=false;
    return {numero,image};
  }
  $('gubia-preview-pagina').addEventListener('keydown',e=>{
    if(e.key!=='Enter'&&e.key!==' ')return;
    e.preventDefault();const r=e.currentTarget.getBoundingClientRect();
    e.currentTarget.dispatchEvent(new MouseEvent('click',{clientX:r.left+r.width/2,clientY:r.top+r.height/2}));
  });
  $('gubia-preview-pagina').addEventListener('click',e=>{
    const img=e.currentTarget,indice=Number($('gubia-muestra-destino').value);
    if(!articulos[indice]){mensaje('Selecciona primero un material en la lista para asociarle una textura.');return;}
    const rect=img.getBoundingClientRect();
    if(!rect.width||!rect.height||!img.naturalWidth)return;
    const x=(e.clientX-rect.left)/rect.width*img.naturalWidth;
    const y=(e.clientY-rect.top)/rect.height*img.naturalHeight;
    const dimension=Math.min(155,img.naturalWidth,img.naturalHeight);
    const sx=Math.max(0,Math.min(img.naturalWidth-dimension,x-dimension/2));
    const sy=Math.max(0,Math.min(img.naturalHeight-dimension,y-dimension/2));
    const canvas=document.createElement('canvas');canvas.width=112;canvas.height=112;
    const ctx=canvas.getContext('2d');if(!ctx)return;
    ctx.drawImage(img,sx,sy,dimension,dimension,0,0,112,112);
    const muestra=canvas.toDataURL('image/webp',.65);
    if(!muestra.startsWith('data:image/webp;')||muestra.length>35000){mensaje('No se puede recortar esa muestra. Prueba con otro punto.');return;}
    articulos[indice].muestra=muestra;
    guardarBorrador();pintar();
    mensaje('Muestra visual asociada a «'+articulos[indice].data.nombre+'». Se guardará de forma privada cuando confirmes la importación.');
  });
  $('gubia-ver-pagina').addEventListener('click',async()=>{
    if(trabajando)return;
    try{await vistaPagina();}catch(err){mensaje('No se ha podido mostrar esa página: '+(err?.message||'Error'));}
  });
  $('gubia-analizar-vision').addEventListener('click',async()=>{
    if(trabajando)return;
    detener(true);
    try{
      const vista=await vistaPagina();if(!vista)return;
      if(vista.image.length>800000){mensaje('La página supera 800 KB. Prueba con otra página más sencilla.');return;}
      mensaje('Groq está interpretando visualmente la página '+vista.numero+'…');
      const response=await jsonPost({accion:'vision',proveedor:$('gubia-proveedor').value.trim(),pagina:vista.numero,
        imagen:vista.image,texto:(textosPagina.get(vista.numero)||'').slice(0,2500)});
      juntarCandidatos(response.articulos);
      mensaje('Groq ha revisado la página '+vista.numero+'. Revisa nombres, colores y códigos antes de guardar.');
    }catch(err){mensaje('Revisión visual no disponible: '+(err?.message||'Error')+'. Puedes continuar con los materiales detectados.');}
    finally{detener(false);}
  });
  $('gubia-crear-manual')?.addEventListener('click',()=>{
    articulos.push({activo:true,data:{categoria:'tableros',nombre:'Material por revisar',referencia:'',codigoDecor:'',
      acabado:'',soporte:'',espesorMm:null,formato:'',unidad:'m²',colorHex:null,veta:null,brillo:null,unidadesPaquete:null,pagina:Math.max(1,Number($('gubia-numero-pagina').value)||1)}});
    guardarBorrador();pintar();
  });
  try{
    const borrador=JSON.parse(sessionStorage.getItem(BORRADOR)||'null');
    if(borrador&&Array.isArray(borrador.articulos)){
      articulos=borrador.articulos;nombreArchivo=borrador.nombreArchivo||'catalogo.pdf';
      siguientePagina=Math.max(1,Math.min(160,Number(borrador.siguientePagina)||1));
      $('gubia-inicio').value=String(siguientePagina);
      $('gubia-proveedor').value=borrador.proveedor||'';
      resultado.hidden=false;pintar();
      mensaje('Borrador local recuperado: '+articulos.length+' materiales. Puedes confirmarlos o volver a subir el PDF.');
    }
  }catch{/* Borrador inválido: no impedir la carga normal */}
  $('gubia-confirmar').addEventListener('click',async()=>{
    if(trabajando)return;
    const seleccion=articulos.filter(a=>a.activo);
    if(!seleccion.length){mensaje('Selecciona al menos un material.');return;}
    if(!confirm('Crear '+seleccion.length+' artículos nuevos del proveedor '+$('gubia-proveedor').value+' sin precios confirmados?'))return;
    detener(true);
    const totales={creados:0,duplicados:0,rechazados:0};
    try{
      // Pequeños lotes para limitar carga de Worker/D1 y las muestras privadas.
      const tamanoLote=seleccion.some(a=>a.muestra)?4:20;
      for(let inicio=0;inicio<seleccion.length;inicio+=tamanoLote){
        const lote=seleccion.slice(inicio,inicio+tamanoLote);
        mensaje('Guardando artículos '+(inicio+1)+'–'+Math.min(inicio+tamanoLote,seleccion.length)+' de '+seleccion.length+'…');
        const response=await fetch('/api/panel/catalogo-importar',{
          method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({accion:'confirmar',proveedor:$('gubia-proveedor').value,
            archivo:nombreArchivo,articulos:lote.map(a=>a.data),muestras:lote.map(a=>a.muestra||null)}),
        });
        const body=await response.json().catch(()=>({}));
        if(!response.ok||!body.ok)throw Error(body.error||'No se ha podido importar el bloque.');
        for(const clave of Object.keys(totales))totales[clave]+=Number(body[clave]||0);
      }
      mensaje('Importación completada: '+totales.creados+' nuevos, '+totales.duplicados+' duplicados omitidos, '+totales.rechazados+' rechazados. Revisa los artículos y completa sus precios.');
      articulos=[];sessionStorage.removeItem(BORRADOR);resultado.hidden=true;
    }catch(err){
      guardarBorrador();
      mensaje('Importación parcial: '+totales.creados+' nuevos confirmados; '+(err?.message||'Error')+'. Puedes reintentar: los artículos existentes se omiten automáticamente.');
    }finally{detener(false);}
  });
})();
</script>
