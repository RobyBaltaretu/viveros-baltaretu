---
import Mensajes from '../../../../components/panel/Mensajes.astro';
import PaginaPanel from '../../../../components/panel/PaginaPanel.astro';
import FormProyecto from '../../../../components/panel/portafolio/FormProyecto.astro';
import { sesionCon } from '../../../../server/panel/pagina.ts';
import { leerFormularioProyecto } from '../../../../server/portafolio/formulario.ts';
import { categorias, guardarProyecto } from '../../../../server/portafolio/portafolio.ts';

export const prerender = false;

const s = sesionCon(Astro.locals, 'inventario');
const id = Astro.params.id ?? '';
let p = s ? await s.repos.portafolio.obtener(id) : null;
if (s && !p) return new Response(null, { status: 404 });
let error = '';
if (s && p && Astro.request.method === 'POST') {
  const datos = leerFormularioProyecto(await Astro.request.formData());
  const r = await guardarProyecto(s.repos, { ...datos, id }, s.usuario.email);
  if (r.ok) return Astro.redirect(`/panel/portafolio/${id}?hecho=datos`, 303);
  error = r.error;
  p = { ...p, ...datos, anio: datos.anio ?? null } as typeof p;
  Astro.response.status = 400;
}
const grupos = s ? categorias(await s.repos.portafolio.listar({ incluirArchivados: true })) : [];
---

<PaginaPanel titulo="Cambiar los datos" permiso="inventario" volver={`/panel/portafolio/${id}`}>
  <h1 class="titular-grande">Cambiar los datos</h1>
  <p class="mt-2 text-gris">{p?.titulo}</p>
  <Mensajes errores={error ? [{ campo: 'titulo', mensaje: error }] : []} />
  {p && <FormProyecto proyecto={p} categorias={grupos} boton="Guardar los datos" />}
</PaginaPanel>
