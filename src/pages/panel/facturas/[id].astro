---
import EditorFactura from '../../../components/panel/EditorFactura.astro';
import Mensajes from '../../../components/panel/Mensajes.astro';
import PaginaPanel from '../../../components/panel/PaginaPanel.astro';
import VistaFactura from '../../../components/panel/VistaFactura.astro';
import type { DatosEmisor, Factura } from '../../../server/data/tipos.ts';
import { calcularTotales, dinero } from '../../../server/facturas/importes.ts';
import { CAMPOS_EMISOR, codigoDe, hoy, huellaDe, leerBorrador, nuevaFactura, rectificativaDe, serieDe, validarEmision, type Error } from '../../../server/facturas/facturas.ts';
import { ajustesFacturacion, plantasParaFacturar } from '../../../server/panel/facturacion.ts';
import { campo, sesionCon } from '../../../server/panel/pagina.ts';

export const prerender = false;

const s = sesionCon(Astro.locals, 'facturas');
const id = Astro.params.id ?? '';
let f = s ? await s.repos.facturas.obtener(id) : null;
if (s && !f) return Astro.redirect('/panel/facturas', 303);
const ajustes = s ? await ajustesFacturacion(s.repos) : null;
const plantas = s && f?.estado === 'borrador' ? await plantasParaFacturar(s.repos) : [];
// En los borradores manda la ficha actual del cliente (en las emitidas, la copia de ese día).
if (s && f && f.estado === 'borrador') {
  const actual = await s.repos.clientes.obtener(f.clienteId);
  if (actual) f = { ...f, cliente: actual, totales: calcularTotales(f.lineas.filter((l) => l.concepto), actual.recargo) };
}
const emisorDe = (a: typeof ajustes): DatosEmisor => Object.fromEntries(CAMPOS_EMISOR.map((c) => [c.campo, a?.[c.campo] ?? ''])) as unknown as DatosEmisor;
const comprobar = async (fa: Factura) => {
  const ultima = await s!.repos.facturas.ultimaEmitida(serieDe(fa.tipo, fa.fecha));
  return validarEmision(fa, emisorDe(ajustes), fa.cliente, ultima?.fecha ?? null);
};

let errores: Error[] = [];
let crudo: FormData | null = null;
if (s && f && ajustes && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = campo(form, 'accion');
  if (accion === 'duplicar') {
    const copia = { ...nuevaFactura(f.cliente, s.usuario.email, ajustes), clienteId: f.clienteId, lineas: f.lineas, totales: f.totales, formaPago: f.formaPago, exencion: f.exencion, notas: f.notas };
    await s.repos.facturas.guardarBorrador(copia);
    return Astro.redirect(`/panel/facturas/${copia.id}`, 303);
  }
  if (f.estado === 'borrador') {
    if (accion === 'borrar') {
      await s.repos.facturas.borrarBorrador(f.id);
      return Astro.redirect('/panel/facturas?hecho=borrada', 303);
    }
    if (accion === 'confirmar-emision') {
      errores = await comprobar(f);
      if (!errores.length) {
        const fa = f;
        await s.repos.facturas.guardarBorrador(fa);
        const serie = serieDe(fa.tipo, fa.fecha);
        const anterior = await s.repos.facturas.ultimaHuella();
        const emitida = await s.repos.facturas.emitir(fa.id, {
          serie,
          fecha: fa.fecha,
          emisor: emisorDe(ajustes),
          cliente: fa.cliente,
          huellaAnterior: anterior,
          codigo: (n) => codigoDe(serie, n),
          huella: (_n, codigo) => huellaDe({ codigo, fecha: fa.fecha, total: fa.totales.total, nifEmisor: ajustes.nif, nifCliente: fa.cliente.nif }, anterior),
        });
        if (emitida) await s.repos.auditoria.registrar(s.usuario.email, 'factura emitida', `${emitida.codigo} · ${dinero(emitida.totales.total)}`);
        return Astro.redirect(`/panel/facturas/${fa.id}?hecho=emitida`, 303);
      }
    } else {
      const r = leerBorrador(form, f, plantas);
      errores = r.errores;
      if (errores.length) crudo = form;
      else {
        await s.repos.facturas.guardarBorrador(r.factura);
        if (r.accion.tipo === 'emitir') {
          errores = await comprobar(r.factura);
          if (!errores.length) return Astro.redirect(`/panel/facturas/${f.id}?confirmar=1`, 303);
        } else if (r.accion.tipo === 'guardar') return Astro.redirect(`/panel/facturas/${f.id}?hecho=guardada`, 303);
        else return Astro.redirect(`/panel/facturas/${f.id}#lineas`, 303);
        f = r.factura;
      }
    }
  } else {
    if (accion === 'cobrada') await s.repos.facturas.marcarCobrada(f.id, campo(form, 'fechaCobro') || hoy());
    if (accion === 'pendiente') await s.repos.facturas.marcarCobrada(f.id, null);
    if (accion === 'rectificar') {
      const r = rectificativaDe(f, s.usuario.email, ajustes);
      await s.repos.facturas.guardarBorrador(r);
      return Astro.redirect(`/panel/facturas/${r.id}`, 303);
    }
    if (accion === 'cobrada' || accion === 'pendiente') await s.repos.auditoria.registrar(s.usuario.email, `factura ${accion}`, f.codigo ?? f.id);
    return Astro.redirect(`/panel/facturas/${f.id}?hecho=${accion}`, 303);
  }
}
const hecho = Astro.url.searchParams.get('hecho');
const MENSAJES: Record<string, string> = {
  guardada: 'Borrador guardado.',
  emitida: 'Factura emitida. Ya puedes descargarla o enviarla.',
  cobrada: 'Marcada como cobrada.',
  pendiente: 'Vuelve a estar pendiente de cobro.',
};
const confirmar = f?.estado === 'borrador' && Astro.url.searchParams.has('confirmar') && !errores.length;
const titulo = !f ? 'Factura' : f.estado === 'borrador' ? (f.tipo === 'rectificativa' ? 'Rectificativa (borrador)' : 'Factura (borrador)') : `Factura ${f.codigo}`;
---

<PaginaPanel titulo={titulo} permiso="facturas" volver="/panel/facturas">
  {
    f && (
      <>
        <h1 class="titular-grande">{titulo}</h1>
        {f.estado !== "borrador" && <p class="mt-1 text-gris">{f.cliente.nombre}</p>}
        <Mensajes hecho={hecho ? MENSAJES[hecho] : undefined} errores={errores} />
        {confirmar ? (
          <section class="mt-6 grid gap-4 rounded-panel border-2 border-oliva bg-papel p-5" aria-labelledby="confirmar-titulo">
            <h2 id="confirmar-titulo" class="titular-medio">¿Emitir la factura?</h2>
            <p>
              Se le dará el número siguiente de la serie {serieDe(f.tipo, f.fecha)} y el total será de <strong>{dinero(f.totales.total)}</strong>. Una vez emitida no se puede cambiar ni borrar: si hay un error, se corrige con una factura rectificativa.
            </p>
            <div class="flex flex-wrap gap-3">
              <form method="post">
                <input type="hidden" name="accion" value="confirmar-emision" />
                <button class="boton-panel">Sí, emitir</button>
              </form>
              <a href={`/panel/facturas/${f.id}`} class="boton-panel boton-panel-secundario">No, seguir editando</a>
            </div>
          </section>
        ) : f.estado === 'borrador' ? (
          <EditorFactura factura={f} plantas={plantas} errores={errores} crudo={crudo} />
        ) : (
          <VistaFactura factura={f} />
        )}
      </>
    )
  }
</PaginaPanel>
