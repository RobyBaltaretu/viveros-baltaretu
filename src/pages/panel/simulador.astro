---
import PaginaPanel from '../../components/panel/PaginaPanel.astro';
import Icono from '../../components/panel/ui/Icono.astro';
import {
  ESTILOS_MUEBLE,
  MATERIALES_ENCIMERA,
  MATERIALES_MUEBLE,
  MATERIALES_SUELO,
  TIPOS_ESTANCIA,
} from '../../server/simulador/materiales.ts';

export const prerender = false;
---

<PaginaPanel titulo="Simulador de Reformas en Vivo (IA)" permiso="editar">
  <div class="simulador-wrapper space-y-6">
    <!-- Cabecera de la Herramienta -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-linea pb-4">
      <div>
        <h1 class="font-titular text-2xl font-bold text-tinta sm:text-3xl">Simulador de Reformas en Vivo con IA</h1>
        <p class="text-sm text-gris">
          Sube la foto real de la estancia del cliente y aplica materiales fotorrealistas manteniendo intactas la geometría, iluminación y perspectiva.
        </p>
      </div>
      <button
        type="button"
        id="btn-abrir-ajustes"
        class="inline-flex items-center gap-2 rounded-xl border border-linea bg-papel px-4 py-2.5 text-sm font-semibold text-tinta shadow-xs hover:bg-crema"
        title="Configurar Claves de IA Gratuita"
      >
        <Icono nombre="personas" clase="size-5 text-terracota" />
        <span>Configuración IA (⚙️)</span>
      </button>
    </div>

    <!-- Banner de Alerta de Error Visual -->
    <!-- Mismos estilos que los errores del panel (Mensajes.astro): sin clases nuevas que cambien el CSS de Baltaretu. -->
    <div id="error-banner" role="alert" class="hidden rounded-2xl border-2 border-terracota bg-papel p-4 text-tinta">
      <div class="flex items-start gap-3">
        <Icono nombre="aviso" clase="size-5 text-terracota shrink-0 mt-0.5" />
        <div class="space-y-1">
          <strong class="font-bold text-sm">Error en la Generación de IA</strong>
          <p id="error-message" class="text-xs text-gris"></p>
        </div>
      </div>
    </div>

    <!-- Modal / Panel de Configuración de Claves IA -->
    <dialog id="dialogo-ajustes" class="m-auto w-full max-w-md rounded-2xl border border-linea bg-papel p-6 shadow-2xl backdrop:bg-tinta/50">
      <div class="space-y-4">
        <div class="flex items-center justify-between border-b border-linea pb-3">
          <h3 class="font-titular text-lg font-bold text-tinta">Configuración de Proveedores IA</h3>
          <button type="button" id="btn-cerrar-ajustes" class="rounded-lg p-1 text-gris hover:bg-crema">
            <Icono nombre="cerrar" clase="size-5" />
          </button>
        </div>
        <p class="text-xs text-gris">
          El simulador funciona automáticamente. Si deseas usar tu propio token gratuito de <strong>Hugging Face</strong> (código abierto) o <strong>Google Gemini</strong>, introdúcelo aquí:
        </p>
        <div>
          <label for="hf-token-input" class="block text-xs font-bold text-tinta mb-1">
            Token Gratuito de Hugging Face (VITE_HF_TOKEN)
          </label>
          <input
            type="password"
            id="hf-token-input"
            placeholder="hf_..."
            class="w-full rounded-xl border border-linea px-3 py-2 text-sm text-tinta focus:border-terracota focus:outline-hidden"
          />
          <span class="text-[11px] text-gris">Consíguelo gratis sin tarjeta en <a href="https://huggingface.co/settings/tokens" target="_blank" rel="noopener" class="underline text-terracota">huggingface.co/settings/tokens</a>.</span>
        </div>
        <div>
          <label for="gemini-key-input" class="block text-xs font-bold text-tinta mb-1">
            Google Gemini API Key (Opcional)
          </label>
          <input
            type="password"
            id="gemini-key-input"
            placeholder="AIzaSy..."
            class="w-full rounded-xl border border-linea px-3 py-2 text-sm text-tinta focus:border-terracota focus:outline-hidden"
          />
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <button type="button" id="btn-guardar-ajustes" class="rounded-xl bg-terracota px-4 py-2 text-sm font-semibold text-papel hover:opacity-90">
            Guardar
          </button>
        </div>
      </div>
    </dialog>

    <!-- Layout Principal: Formulario y Vista Previa -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Columna Izquierda: Configuración de la Reforma -->
      <form id="simulador-form" class="space-y-6 lg:col-span-5">
        <!-- 1. Cargar Foto -->
        <div class="rounded-2xl border border-linea bg-papel p-5 shadow-xs">
          <h2 class="font-titular text-base font-bold text-tinta mb-2 flex items-center gap-2">
            <span class="flex size-6 items-center justify-center rounded-full bg-verdor text-xs text-terracota">1</span>
            Foto Actual del Cliente
          </h2>
          <div
            id="drop-zone"
            class="group relative flex flex-col items-center justify-center rounded-xl border-2 border-dashed border-linea bg-crema/50 p-6 text-center transition-colors hover:border-terracota hover:bg-crema"
          >
            <input type="file" id="foto-input" accept="image/*" class="absolute inset-0 z-10 cursor-pointer opacity-0" required />
            <div id="drop-zone-prompt" class="space-y-2">
              <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-papel shadow-xs">
                <Icono nombre="camara" clase="size-6 text-terracota" />
              </div>
              <p class="text-sm font-semibold text-tinta">Arrastra la foto o pulsa para elegir</p>
              <p class="text-xs text-gris">Compatible con cámara de iPad/móvil y archivos JPEG/PNG</p>
            </div>
            <!-- Miniatura previa de carga -->
            <div id="preview-thumb-container" class="hidden w-full space-y-2">
              <img id="preview-thumb" src="" alt="Vista previa de la foto actual" class="max-h-48 mx-auto rounded-lg object-contain shadow-xs" />
              <p class="text-xs font-semibold text-terracota">Foto cargada y procesada (1536px max)</p>
            </div>
          </div>
        </div>

        <!-- 2. Tipo de Estancia -->
        <div class="rounded-2xl border border-linea bg-papel p-5 shadow-xs">
          <h2 class="font-titular text-base font-bold text-tinta mb-3 flex items-center gap-2">
            <span class="flex size-6 items-center justify-center rounded-full bg-verdor text-xs text-terracota">2</span>
            Tipo de Estancia
          </h2>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
            {
              TIPOS_ESTANCIA.map((e, idx) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="spaceType"
                    value={e.nombre}
                    checked={idx === 0}
                    class="peer sr-only"
                  />
                  <div class="flex items-center justify-center rounded-xl border border-linea bg-papel p-2.5 text-center text-xs font-semibold text-tinta peer-checked:border-terracota peer-checked:bg-verdor/40 peer-checked:text-terracota">
                    {e.nombre}
                  </div>
                </label>
              ))
            }
          </div>
        </div>

        <!-- 3. Zonas y Materiales -->
        <div class="rounded-2xl border border-linea bg-papel p-5 shadow-xs space-y-5">
          <h2 class="font-titular text-base font-bold text-tinta flex items-center gap-2">
            <span class="flex size-6 items-center justify-center rounded-full bg-verdor text-xs text-terracota">3</span>
            Zonas y Materiales del Catálogo
          </h2>

          <!-- Zona: Muebles -->
          <div class="space-y-3 border-b border-linea pb-4">
            <label class="flex items-center justify-between font-bold text-sm text-tinta cursor-pointer">
              <span>Mobiliario / Muebles</span>
              <input type="checkbox" id="zone-cabinets" checked class="size-4 rounded-xs border-linea text-terracota focus:ring-terracota" />
            </label>
            <div id="sec-cabinets" class="space-y-3 pt-1">
              <div>
                <span class="block text-xs font-semibold text-gris mb-1">Estilo & Apertura:</span>
                <select id="cabinet-style" class="w-full rounded-xl border border-linea bg-papel p-2 text-xs text-tinta">
                  {ESTILOS_MUEBLE.map((s) => <option value={s.nombre}>{s.nombre} - {s.descripcion}</option>)}
                </select>
              </div>
              <label class="flex items-center gap-2 text-xs text-tinta cursor-pointer">
                <input type="checkbox" id="floor-to-ceiling" class="size-4 rounded-xs border-linea text-terracota" />
                <span>Extender muebles superiores hasta el techo</span>
              </label>

              <div>
                <span class="block text-xs font-semibold text-gris mb-2">Material Muebles Superiores / Columnas:</span>
                <div class="grid grid-cols-1 gap-2">
                  {
                    MATERIALES_MUEBLE.map((m, idx) => (
                      <label class="cursor-pointer">
                        <input type="radio" name="upperMaterial" value={m.id} checked={idx === 0} class="peer sr-only" />
                        <div class="flex items-center gap-3 rounded-xl border border-linea p-2 text-xs peer-checked:border-terracota peer-checked:bg-verdor/30">
                          <span class="size-6 rounded-full border border-linea/50 shadow-xs shrink-0" style={`background-color: ${m.previewColor};`}></span>
                          <div class="min-w-0">
                            <strong class="block font-semibold text-tinta">{m.nombre}</strong>
                            <small class="text-gris truncate block">{m.descripcion}</small>
                          </div>
                        </div>
                      </label>
                    ))
                  }
                </div>
              </div>

              <div>
                <span class="block text-xs font-semibold text-gris mb-2">Material Muebles Inferiores / Isla:</span>
                <div class="grid grid-cols-1 gap-2">
                  {
                    MATERIALES_MUEBLE.map((m, idx) => (
                      <label class="cursor-pointer">
                        <input type="radio" name="lowerMaterial" value={m.id} checked={idx === 0} class="peer sr-only" />
                        <div class="flex items-center gap-3 rounded-xl border border-linea p-2 text-xs peer-checked:border-terracota peer-checked:bg-verdor/30">
                          <span class="size-6 rounded-full border border-linea/50 shadow-xs shrink-0" style={`background-color: ${m.previewColor};`}></span>
                          <div class="min-w-0">
                            <strong class="block font-semibold text-tinta">{m.nombre}</strong>
                            <small class="text-gris truncate block">{m.descripcion}</small>
                          </div>
                        </div>
                      </label>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <!-- Zona: Encimera -->
          <div class="space-y-3 border-b border-linea pb-4">
            <label class="flex items-center justify-between font-bold text-sm text-tinta cursor-pointer">
              <span>Encimera & Frontal</span>
              <input type="checkbox" id="zone-countertop" checked class="size-4 rounded-xs border-linea text-terracota" />
            </label>
            <div id="sec-countertop" class="space-y-3 pt-1">
              <label class="flex items-center gap-2 text-xs text-tinta cursor-pointer">
                <input type="checkbox" id="include-backsplash" checked class="size-4 rounded-xs border-linea text-terracota" />
                <span>Aplicar el mismo material en la pared / aplacado</span>
              </label>
              <div class="grid grid-cols-1 gap-2">
                {
                  MATERIALES_ENCIMERA.map((m, idx) => (
                    <label class="cursor-pointer">
                      <input type="radio" name="countertopMaterial" value={m.id} checked={idx === 0} class="peer sr-only" />
                      <div class="flex items-center gap-3 rounded-xl border border-linea p-2 text-xs peer-checked:border-terracota peer-checked:bg-verdor/30">
                        <span class="size-6 rounded-full border border-linea/50 shadow-xs shrink-0" style={`background-color: ${m.previewColor};`}></span>
                        <div class="min-w-0">
                          <strong class="block font-semibold text-tinta">{m.nombre}</strong>
                          <small class="text-gris truncate block">{m.descripcion}</small>
                        </div>
                      </div>
                    </label>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Zona: Suelo -->
          <div class="space-y-3 border-b border-linea pb-4">
            <label class="flex items-center justify-between font-bold text-sm text-tinta cursor-pointer">
              <span>Suelo / Pavimento</span>
              <input type="checkbox" id="zone-flooring" checked class="size-4 rounded-xs border-linea text-terracota" />
            </label>
            <div id="sec-flooring" class="space-y-3 pt-1">
              <div class="grid grid-cols-1 gap-2">
                {
                  MATERIALES_SUELO.map((m, idx) => (
                    <label class="cursor-pointer">
                      <input type="radio" name="flooringMaterial" value={m.id} checked={idx === 0} class="peer sr-only" />
                      <div class="flex items-center gap-3 rounded-xl border border-linea p-2 text-xs peer-checked:border-terracota peer-checked:bg-verdor/30">
                        <span class="size-6 rounded-full border border-linea/50 shadow-xs shrink-0" style={`background-color: ${m.previewColor};`}></span>
                        <div class="min-w-0">
                          <strong class="block font-semibold text-tinta">{m.nombre}</strong>
                          <small class="text-gris truncate block">{m.descripcion}</small>
                        </div>
                      </div>
                    </label>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Zona: Iluminación -->
          <div class="space-y-3">
            <label class="flex items-center justify-between font-bold text-sm text-tinta cursor-pointer">
              <span>Iluminación LED Integrada</span>
              <input type="checkbox" id="zone-lighting" checked class="size-4 rounded-xs border-linea text-terracota" />
            </label>
            <div id="sec-lighting" class="flex items-center gap-4 text-xs text-tinta pt-1">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="under-cabinet-led" checked class="size-4 rounded-xs border-linea text-terracota" />
                <span>Tira LED bajo muebles altos</span>
              </label>
              <select id="led-temp" class="rounded-lg border border-linea bg-papel px-2 py-1 text-xs">
                <option value="2700K warm white">2700K Cálida</option>
                <option value="3000K neutral white" selected>3000K Neutra</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Botón de Acción -->
        <button
          type="submit"
          id="btn-generar"
          class="w-full rounded-2xl bg-terracota py-4 text-center font-titular text-lg font-bold text-papel shadow-lg hover:opacity-95 disabled:opacity-50"
        >
          Generar Reforma en Vivo
        </button>
      </form>

      <!-- Columna Derecha: Comparador Antes / Después -->
      <div class="space-y-4 lg:col-span-7">
        <div class="flex items-center justify-between">
          <h2 class="font-titular text-lg font-bold text-tinta">Resultado de la Reforma</h2>
          <div id="acciones-resultado" class="hidden items-center gap-2">
            <button
              type="button"
              id="btn-descargar"
              class="inline-flex items-center gap-1.5 rounded-xl border border-linea bg-papel px-3 py-1.5 text-xs font-semibold text-tinta hover:bg-crema"
            >
              <Icono nombre="descargar" clase="size-4 text-terracota" />
              <span>Guardar Imagen</span>
            </button>
          </div>
        </div>

        <!-- Estado Inicial: Marcador Vacío -->
        <div id="vacio-container" class="flex min-h-[420px] flex-col items-center justify-center rounded-2xl border-2 border-dashed border-linea bg-papel p-8 text-center">
          <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-verdor/50">
            <Icono nombre="camara" clase="size-8 text-terracota" />
          </div>
          <h3 class="mt-4 font-titular text-lg font-bold text-tinta">Ninguna reforma simulada aún</h3>
          <p class="mt-1 max-w-sm text-xs text-gris">
            Sube una foto a la izquierda y pulsa «Generar Reforma en Vivo» para visualizar la transformación con el comparador interactivo.
          </p>
        </div>

        <!-- Estado Cargando / Generando -->
        <div id="loading-container" class="hidden min-h-[420px] flex-col items-center justify-center rounded-2xl border border-linea bg-papel p-8 text-center space-y-4">
          <div class="relative size-16">
            <div class="absolute inset-0 rounded-full border-4 border-verdor"></div>
            <div class="absolute inset-0 animate-spin rounded-full border-4 border-terracota border-t-transparent"></div>
          </div>
          <div>
            <h3 class="font-titular text-lg font-bold text-tinta">Transformando Estancia...</h3>
            <p id="loading-status" class="mt-1 text-xs font-semibold text-terracota">Analizando geometría 3D de la habitación...</p>
          </div>
        </div>

        <!-- Estado Comparador Antes / Después -->
        <div id="slider-wrapper" class="hidden space-y-3">
          <!-- Aspect ratio dinámico forzado por JS -->
          <div
            id="comparator-container"
            class="relative w-full overflow-hidden rounded-2xl border border-linea shadow-lg select-none"
            style="touch-action: none;"
          >
            <!-- Foto DESPUÉS (fondo completo) -->
            <img id="img-after" src="" alt="Después de la reforma" class="absolute inset-0 size-full object-cover" />

            <!-- Foto ANTES (capa recortada encima) -->
            <div id="before-clip-layer" class="absolute inset-0 overflow-hidden w-1/2">
              <img id="img-before" src="" alt="Antes de la reforma" class="absolute inset-0 max-w-none object-cover" />
            </div>

            <!-- Línea Deslizante y Tirador -->
            <div id="slider-handle" class="absolute top-0 bottom-0 left-1/2 z-20 -ml-0.5 w-1 bg-papel shadow-xl cursor-ew-resize">
              <div class="absolute top-1/2 left-1/2 flex size-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-linea bg-papel shadow-md text-terracota font-bold text-xs">
                ↔
              </div>
            </div>

            <!-- Etiquetas Antes / Después -->
            <span class="absolute top-3 left-3 z-10 rounded-lg bg-tinta/75 px-2.5 py-1 text-[11px] font-bold text-papel backdrop-blur-xs">
              ANTES
            </span>
            <span class="absolute top-3 right-3 z-10 rounded-lg bg-terracota/90 px-2.5 py-1 text-[11px] font-bold text-papel backdrop-blur-xs">
              DESPUÉS
            </span>
          </div>

          <p class="text-center text-xs text-gris">
            Arrastra el separador central hacia la izquierda o derecha para comparar el espacio antes y después.
          </p>
        </div>
      </div>
    </div>
  </div>
</PaginaPanel>

<script is:inline>
  (() => {
    // Referencias a elementos del DOM
    const form = document.getElementById('simulador-form');
    const fotoInput = document.getElementById('foto-input');
    const previewThumbContainer = document.getElementById('preview-thumb-container');
    const previewThumb = document.getElementById('preview-thumb');
    const dropZonePrompt = document.getElementById('drop-zone-prompt');

    const vacioContainer = document.getElementById('vacio-container');
    const loadingContainer = document.getElementById('loading-container');
    const loadingStatus = document.getElementById('loading-status');
    const sliderWrapper = document.getElementById('slider-wrapper');
    const accionesResultado = document.getElementById('acciones-resultado');
    const errorBanner = document.getElementById('error-banner');
    const errorMessage = document.getElementById('error-message');

    const comparatorContainer = document.getElementById('comparator-container');
    const imgBefore = document.getElementById('img-before');
    const imgAfter = document.getElementById('img-after');
    const beforeClipLayer = document.getElementById('before-clip-layer');
    const sliderHandle = document.getElementById('slider-handle');
    const btnDescargar = document.getElementById('btn-descargar');

    // Modal Ajustes
    const btnAbrirAjustes = document.getElementById('btn-abrir-ajustes');
    const btnCerrarAjustes = document.getElementById('btn-cerrar-ajustes');
    const btnGuardarAjustes = document.getElementById('btn-guardar-ajustes');
    const dialogoAjustes = document.getElementById('dialogo-ajustes');
    const hfTokenInput = document.getElementById('hf-token-input');
    const geminiKeyInput = document.getElementById('gemini-key-input');

    // Cargar claves guardadas en localStorage
    if (hfTokenInput && geminiKeyInput) {
      hfTokenInput.value = localStorage.getItem('simulador_hf_token') || '';
      geminiKeyInput.value = localStorage.getItem('simulador_gemini_key') || '';
    }

    btnAbrirAjustes?.addEventListener('click', () => dialogoAjustes?.showModal());
    btnCerrarAjustes?.addEventListener('click', () => dialogoAjustes?.close());
    btnGuardarAjustes?.addEventListener('click', () => {
      localStorage.setItem('simulador_hf_token', hfTokenInput.value.trim());
      localStorage.setItem('simulador_gemini_key', geminiKeyInput.value.trim());
      dialogoAjustes?.close();
    });

    // Estado de imagen comprimida cliente
    let currentProcessedBase64 = '';
    let imageAspectRatio = 1.33; // Por defecto 4:3

    // Preprocesado de imagen cliente (canvas max 1536px, JPEG 0.85)
    fotoInput?.addEventListener('change', async () => {
      const file = fotoInput.files?.[0];
      if (!file) return;

      try {
        console.log('[Simulador UI] Preprocesando foto del cliente...');
        const bitmap = await createImageBitmap(file);
        const maxDim = 1536;
        let width = bitmap.width;
        let height = bitmap.height;

        imageAspectRatio = width / height;

        if (width > maxDim || height > maxDim) {
          if (width > height) {
            height = Math.round((height * maxDim) / width);
            width = maxDim;
          } else {
            width = Math.round((width * maxDim) / height);
            height = maxDim;
          }
        }

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx?.drawImage(bitmap, 0, 0, width, height);

        currentProcessedBase64 = canvas.toDataURL('image/jpeg', 0.85);

        if (previewThumb) previewThumb.src = currentProcessedBase64;
        dropZonePrompt?.classList.add('hidden');
        previewThumbContainer?.classList.remove('hidden');
        errorBanner?.classList.add('hidden');
        console.log('[Simulador UI] Foto comprimida exitosamente.');
      } catch {
        console.error('[Simulador UI] Error preprocesando imagen');
      }
    });

    // Animación de estado de carga
    const loadingSteps = [
      'Analizando geometría 3D y perspectiva de la habitación...',
      'Aplicando texturas del catálogo...',
      'Ajustando iluminación fotorrealista y sombras...',
      'Generando resultado fotorrealista final...',
    ];

    function startLoadingAnimation() {
      vacioContainer?.classList.add('hidden');
      sliderWrapper?.classList.add('hidden');
      errorBanner?.classList.add('hidden');
      loadingContainer?.classList.remove('hidden');
      loadingContainer?.classList.add('flex');

      let stepIdx = 0;
      if (loadingStatus) loadingStatus.textContent = loadingSteps[0] || 'Procesando...';
      const interval = setInterval(() => {
        stepIdx = (stepIdx + 1) % loadingSteps.length;
        if (loadingStatus) loadingStatus.textContent = loadingSteps[stepIdx] || 'Procesando...';
      }, 2500);

      return () => clearInterval(interval);
    }

    function showError(msg) {
      console.error('[Simulador UI] Error en IA:', msg);
      if (errorMessage) errorMessage.textContent = msg;
      errorBanner?.classList.remove('hidden');
      vacioContainer?.classList.remove('hidden');
    }

    // Envío del Formulario
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentProcessedBase64) {
        alert('Por favor, sube primero una foto de la estancia.');
        return;
      }

      const formData = new FormData(form);

      const spaceType = formData.get('spaceType');
      const cabinetStyle = document.getElementById('cabinet-style')?.value;
      const floorToCeiling = document.getElementById('floor-to-ceiling')?.checked;

      const zoneCabinets = document.getElementById('zone-cabinets')?.checked;
      const zoneCountertop = document.getElementById('zone-countertop')?.checked;
      const zoneFlooring = document.getElementById('zone-flooring')?.checked;
      const zoneLighting = document.getElementById('zone-lighting')?.checked;

      const upperMaterialId = formData.get('upperMaterial');
      const lowerMaterialId = formData.get('lowerMaterial');
      const countertopMaterialId = formData.get('countertopMaterial');
      const flooringMaterialId = formData.get('flooringMaterial');

      const includeBacksplash = document.getElementById('include-backsplash')?.checked;
      const underCabinetLed = document.getElementById('under-cabinet-led')?.checked;
      const ledTemp = document.getElementById('led-temp')?.value;

      const payload = {
        spaceType,
        cabinetStyle,
        floorToCeiling,
        zones: {
          cabinets: zoneCabinets,
          countertop: zoneCountertop,
          flooring: zoneFlooring,
          lighting: zoneLighting,
        },
        upperMaterialId,
        lowerMaterialId,
        countertopMaterialId,
        includeBacksplash,
        flooringMaterialId,
        lighting: {
          underCabinetLed,
          colorTemp: ledTemp,
        },
      };

      const stopAnimation = startLoadingAnimation();
      console.log('[Simulador UI] Enviando petición a la API con la configuración seleccionada...');

      try {
        const response = await fetch('/api/panel/simulador', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            image: currentProcessedBase64,
            config: payload,
            options: {
              hfToken: localStorage.getItem('simulador_hf_token') || undefined,
              geminiApiKey: localStorage.getItem('simulador_gemini_key') || undefined,
            },
          }),
        });

        const resData = await response.json();
        console.log('[Simulador UI] Respuesta recibida:', resData);

        stopAnimation();
        loadingContainer?.classList.add('hidden');
        loadingContainer?.classList.remove('flex');

        if (resData.ok && resData.afterImage) {
          showComparator(currentProcessedBase64, resData.afterImage);
        } else {
          showError(resData.error || 'Error al generar la reforma con la IA. Revisa tus tokens configurados (⚙️).');
        }
      } catch {
        stopAnimation();
        loadingContainer?.classList.add('hidden');
        loadingContainer?.classList.remove('flex');
        showError('Error de red o conexión al comunicarse con el servidor.');
      }
    });

    // Renderizado y control del Slider Comparador
    function showComparator(beforeBase64, afterBase64) {
      if (imgBefore) imgBefore.src = beforeBase64;
      if (imgAfter) imgAfter.src = afterBase64;

      if (comparatorContainer) comparatorContainer.style.aspectRatio = `${imageAspectRatio}`;

      sliderWrapper?.classList.remove('hidden');
      accionesResultado?.classList.remove('hidden');
      accionesResultado?.classList.add('flex');

      setSliderPosition(50);
    }

    function setSliderPosition(percentage) {
      const clamped = Math.max(0, Math.min(100, percentage));
      if (beforeClipLayer) beforeClipLayer.style.width = `${clamped}%`;
      if (sliderHandle) sliderHandle.style.left = `${clamped}%`;

      if (comparatorContainer && imgBefore) {
        const rect = comparatorContainer.getBoundingClientRect();
        imgBefore.style.width = `${rect.width}px`;
        imgBefore.style.height = `${rect.height}px`;
      }
    }

    // Eventos de arrastre para el Slider
    let isDragging = false;

    function handleMove(clientX) {
      if (!isDragging || !comparatorContainer) return;
      const rect = comparatorContainer.getBoundingClientRect();
      const x = clientX - rect.left;
      const pct = (x / rect.width) * 100;
      setSliderPosition(pct);
    }

    comparatorContainer?.addEventListener('pointerdown', (e) => {
      isDragging = true;
      handleMove(e.clientX);
    });

    window.addEventListener('pointermove', (e) => {
      if (isDragging) handleMove(e.clientX);
    });

    window.addEventListener('pointerup', () => {
      isDragging = false;
    });

    window.addEventListener('resize', () => {
      if (sliderWrapper && !sliderWrapper.classList.contains('hidden') && beforeClipLayer) {
        const currentPct = parseFloat(beforeClipLayer.style.width) || 50;
        setSliderPosition(currentPct);
      }
    });

    // Descarga de Imagen
    btnDescargar?.addEventListener('click', () => {
      if (!imgAfter || !imgAfter.src) return;
      const link = document.createElement('a');
      link.download = `reforma-simulada-turia-${Date.now()}.png`;
      link.href = imgAfter.src;
      link.click();
    });
  })();
</script>
