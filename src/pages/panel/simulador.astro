---
import PaginaPanel from '../../components/panel/PaginaPanel.astro';
import Icono from '../../components/panel/ui/Icono.astro';
import SelectorMaterial from '../../panel-nuevo/SelectorMaterial.astro';
import {
  ESTILOS_MUEBLE,
  TIPOS_ESTANCIA,
} from '../../server/simulador/materiales.ts';
// CSS propio, en línea (scripts/generar-css-simulador.mjs): el simulador está fuera del Tailwind de la web para que Baltaretu no cambie.
import studioCss from '../../panel-nuevo/studio.css?raw';
import estilosSimulador from '../../panel-nuevo/simulador.css?raw';
import { clienteActual, rutaDisponible } from '../../plataforma/actual.ts';
import { iaDe } from '../../plataforma/configuracion.ts';
import { sesionCon } from '../../server/panel/pagina.ts';
import { AVISO_AGOTADA, estadoCuota, limitePresupuestado, mesDe } from '../../server/simulador/cuota.ts';

import { materialesDelTaller } from '../../server/simulador/catalogo';
import {PERFILES} from '../../server/simulador/perfiles';
export const prerender = false;

const s = sesionCon(Astro.locals, 'editar');
const materiales = materialesDelTaller(s ? await s.repos.catalogo.articulos() : []);
const MATERIALES_MUEBLE = materiales.filter(m=>m.categoria==='mueble');
const MATERIALES_ENCIMERA = materiales.filter(m=>m.categoria==='encimera');
const MATERIALES_SUELO = materiales.filter(m=>m.categoria==='suelo');
const cliente = clienteActual();
const ia = iaDe(cliente);
const cuota = estadoCuota(s ? await s.repos.usoSimulador.usos(cliente.id, mesDe()) : 0, limitePresupuestado(ia.simulacionesMes));
const textoCuota = (c: typeof cuota) => `${c.usos} de ${c.limite} usadas · quedan ${c.quedan}`;
---

<PaginaPanel titulo="Simulador de Reformas en Vivo (IA)" permiso="editar" ancho="amplio">
  <style is:inline set:html={estilosSimulador + studioCss}></style>
  <div class="simulador-wrapper studio space-y-6">
    <header class="studio-bar"><div><h1>Turia Studio</h1><p>Diseña, visualiza y prepara tu reforma.</p></div><div class="studio-actions"><button type="button" id="studio-save" class="studio-button">Guardar borrador</button><button type="button" id="studio-reset" class="studio-button">Nueva simulación</button></div><p id="studio-status" role="status"></p></header>
    <nav class="studio-steps" aria-label="Pasos del diseño">{['Espacio','Materiales','Revisar'].map((t,i)=><button type="button" data-studio-step={i} aria-current={i===0?'step':undefined}>{i+1} · {t}</button>)}</nav>
    <!-- Simulaciones del mes: tope duro en D1 (aviso desde el 80 %, bloqueo al 100 %) -->
    <section
      id="cuota"
      aria-labelledby="cuota-titulo"
      data-aviso-agotada={AVISO_AGOTADA}
      class:list={['rounded-2xl border bg-papel p-4', cuota.aviso ? 'border-[#b45309]' : 'border-linea']}
    >
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="cuota-titulo" class="font-titular text-sm font-bold text-tinta">Simulaciones de este mes</h2>
        <p id="cuota-texto" class="text-sm font-semibold text-tinta">{textoCuota(cuota)}</p>
      </div>
      <div
        id="cuota-barra"
        role="progressbar"
        aria-labelledby="cuota-titulo"
        aria-valuemin="0"
        aria-valuemax={cuota.limite}
        aria-valuenow={Math.min(cuota.usos, cuota.limite)}
        aria-valuetext={textoCuota(cuota)}
        class="mt-2 h-3 overflow-hidden rounded-full border border-gris bg-crema"
      >
        <div id="cuota-relleno" class:list={['h-full rounded-full', cuota.aviso ? 'bg-[#b45309]' : 'bg-oliva']} style={`width: ${cuota.porcentaje}%`}></div>
      </div>
      <p id="cuota-aviso" role="status" class:list={['mt-2 text-sm font-semibold text-[#92400e]', !cuota.aviso && 'hidden']}>
        {cuota.agotada ? AVISO_AGOTADA : cuota.aviso ? `Te quedan ${cuota.quedan} simulaciones este mes.` : ''}
      </p>
    </section>

    <!-- Banner de Alerta de Error Visual -->
    <!-- Mismos estilos que los errores del panel (Mensajes.astro): sin clases nuevas que cambien el CSS de Baltaretu. -->
    <div id="error-banner" role="alert" class="hidden rounded-2xl border-2 border-terracota bg-papel p-4 text-tinta">
      <div class="flex items-start gap-3">
        <Icono nombre="aviso" clase="size-5 text-terracota shrink-0 mt-0.5" />
        <div class="grid gap-1">
          <strong class="font-bold text-sm">Error en la Generación de IA</strong>
          <p id="error-message" class="text-xs text-gris"></p>
        </div>
      </div>
    </div>

    <!-- Layout Principal: Formulario y Vista Previa -->
    <div class="studio-layout">
      <!-- Columna Izquierda: Configuración de la Reforma -->
      <form id="simulador-form" data-presupuestar={!!sesionCon(Astro.locals, 'facturas') && cliente.modulos.presupuestosCliente} class="space-y-6">
        <!-- 1. Cargar Foto -->
        <div class="rounded-2xl border border-linea bg-papel p-5 shadow-xs">
          <h2 class="font-titular text-base font-bold text-tinta mb-2 flex items-center gap-2">
            <span class="flex size-6 items-center justify-center rounded-full bg-verdor text-xs text-terracota">1</span>
            Foto Actual del Cliente
          </h2>
          <div
            id="drop-zone"
            class="group relative flex flex-col items-center justify-center rounded-xl border-2 border-dashed border-linea bg-crema/50 p-6 text-center transition-colors hover:border-terracota hover:bg-crema"
          >
            <input type="file" id="foto-input" accept="image/*" aria-label="Foto actual de la estancia" class="absolute inset-0 z-10 cursor-pointer opacity-0" required />
            <div id="drop-zone-prompt" class="space-y-2">
              <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-papel shadow-xs">
                <Icono nombre="camara" clase="size-6 text-terracota" />
              </div>
              <p class="text-sm font-semibold text-tinta">Arrastra la foto o pulsa para elegir</p>
              <p class="text-xs text-gris">Compatible con cámara de iPad/móvil y archivos JPEG/PNG</p>
            </div>
            <p id="foto-cargada" class="hidden text-xs font-semibold text-terracota">Foto cargada (1024 px como mucho). Pulsa otra vez para cambiarla.</p>
          </div>
          <!-- Zona a cambiar (opcional): pincel o rectángulo sobre la foto -->
          <div id="editor-mascara" class="mt-4 hidden space-y-3">
            <p id="ayuda-mascara" class="text-xs text-gris">
              Opcional: pinta o enmarca lo que quieres cambiar (los muebles, el suelo…). Solo esa zona se sustituye en la foto; el resto queda como está. Sin marcar nada, la IA trabaja sobre toda la foto.
            </p>
            <div class="relative overflow-hidden rounded-xl border border-linea">
              <img id="preview-thumb" alt="Foto actual de la estancia" class="block w-full" />
              <canvas id="lienzo-mascara" class="absolute inset-0 size-full cursor-crosshair opacity-50" style="touch-action: none;" aria-describedby="ayuda-mascara" role="img" aria-label="Zona marcada para cambiar"></canvas>
            </div>
            <div class="flex flex-wrap items-end gap-3">
              <fieldset class="flex gap-2">
                <legend class="mb-1 text-xs font-semibold text-gris">Herramienta</legend>
                <label class="cursor-pointer">
                  <input type="radio" name="herramienta" value="pincel" checked class="peer sr-only" />
                  <span class="inline-flex min-h-12 items-center rounded-xl border border-linea px-4 text-sm font-semibold text-tinta peer-checked:border-terracota peer-checked:bg-verdor peer-focus-visible:outline-2 peer-focus-visible:outline-terracota">Pincel</span>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="herramienta" value="rectangulo" class="peer sr-only" />
                  <span class="inline-flex min-h-12 items-center rounded-xl border border-linea px-4 text-sm font-semibold text-tinta peer-checked:border-terracota peer-checked:bg-verdor peer-focus-visible:outline-2 peer-focus-visible:outline-terracota">Rectángulo</span>
                </label>
              </fieldset>
              <label class="grid gap-1 text-xs font-semibold text-gris">
                Grosor del pincel
                <input type="range" id="grosor-pincel" min="10" max="120" value="40" class="min-h-12 accent-terracota" />
              </label>
              <details>
                <summary class="min-h-12 cursor-pointer">Marcar un rectángulo sin dibujar</summary>
                <div class="grid gap-2">
                  {['Izquierda', 'Arriba', 'Derecha', 'Abajo'].map((nombre, i) => (
                    <label>{nombre} (%) <input id={`limite-${i}`} type="number" min="0" max="100" value={i < 2 ? 25 : 75} class="min-h-12" /></label>
                  ))}
                  <button type="button" id="marcar-rectangulo" class="min-h-12">Marcar esta zona</button>
                  <p id="estado-rectangulo" role="status"></p>
                </div>
              </details>
              <button type="button" id="btn-borrar-mascara" class="inline-flex min-h-12 items-center rounded-xl border border-linea bg-papel px-4 text-sm font-semibold text-tinta hover:bg-crema">
                Borrar lo marcado
              </button>
            </div>
          </div>
        </div>

        <details id="studio-perfil" data-perfiles={JSON.stringify(PERFILES)}>
          <summary>Opciones de la reforma</summary>
          <div id="studio-perfil-campos"></div><p id="studio-perfil-revision"></p>
        </details>
<!-- 2. Tipo de Estancia -->
        <div class="rounded-2xl border border-linea bg-papel p-5 shadow-xs">
          <h2 class="font-titular text-base font-bold text-tinta mb-3 flex items-center gap-2">
            <span class="flex size-6 items-center justify-center rounded-full bg-verdor text-xs text-terracota">2</span>
            Tipo de Estancia
          </h2>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
            {
              TIPOS_ESTANCIA.map((e, idx) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="spaceType"
                    value={e.id}
                    checked={idx === 0}
                    class="peer sr-only"
                  />
                  <div class="flex items-center justify-center rounded-xl border border-linea bg-papel p-2.5 text-center text-xs font-semibold text-tinta peer-checked:border-terracota peer-checked:bg-verdor/40 peer-checked:text-terracota">
                    {e.nombre}
                  </div>
                </label>
              ))
            }
          </div>
        </div>

        <!-- 3. Zonas y Materiales -->
        <div class="rounded-2xl border border-linea bg-papel p-5 shadow-xs space-y-5">
          <h2 class="font-titular text-base font-bold text-tinta flex items-center gap-2">
            <span class="flex size-6 items-center justify-center rounded-full bg-verdor text-xs text-terracota">3</span>
            Zonas y Materiales del Catálogo
          </h2>

          <!-- Zona: Muebles -->
          <div class="space-y-3 border-b border-linea pb-4">
            <label class="flex items-center justify-between font-bold text-sm text-tinta cursor-pointer">
              <span>Mobiliario / Muebles</span>
              <input type="checkbox" id="zone-cabinets" checked={MATERIALES_MUEBLE.length > 0} class="size-4 rounded-xs border-linea text-terracota focus:ring-terracota" />
            </label>
            <div id="sec-cabinets" class="space-y-3 pt-1">
              <div>
                <label for="cabinet-style" class="block text-xs font-semibold text-gris mb-1">Estilo & Apertura:</label>
                <select id="cabinet-style" class="w-full rounded-xl border border-linea bg-papel p-2 text-xs text-tinta">
                  {ESTILOS_MUEBLE.map((s) => <option value={s.nombre}>{s.nombre} - {s.descripcion}</option>)}
                </select>
              </div>
              <label class="flex items-center gap-2 text-xs text-tinta cursor-pointer">
                <input type="checkbox" id="floor-to-ceiling" class="size-4 rounded-xs border-linea text-terracota" />
                <span>Extender muebles superiores hasta el techo</span>
              </label>

              <SelectorMaterial nombre="upperMaterial" titulo="Material Muebles Superiores / Columnas" opciones={MATERIALES_MUEBLE} />

              <SelectorMaterial nombre="lowerMaterial" titulo="Material Muebles Inferiores / Isla" opciones={MATERIALES_MUEBLE} />
            </div>
          </div>

          <!-- Zona: Encimera -->
          <div class="space-y-3 border-b border-linea pb-4">
            <label class="flex items-center justify-between font-bold text-sm text-tinta cursor-pointer">
              <span>Encimera & Frontal</span>
              <input type="checkbox" id="zone-countertop" checked={MATERIALES_ENCIMERA.length > 0} class="size-4 rounded-xs border-linea text-terracota" />
            </label>
            <div id="sec-countertop" class="space-y-3 pt-1">
              <label class="flex items-center gap-2 text-xs text-tinta cursor-pointer">
                <input type="checkbox" id="include-backsplash" checked class="size-4 rounded-xs border-linea text-terracota" />
                <span>Aplicar el mismo material en la pared / aplacado</span>
              </label>
              <SelectorMaterial nombre="countertopMaterial" titulo="Encimera" opciones={MATERIALES_ENCIMERA} />
            </div>
          </div>

          <!-- Zona: Suelo -->
          <div class="space-y-3 border-b border-linea pb-4">
            <label class="flex items-center justify-between font-bold text-sm text-tinta cursor-pointer">
              <span>Suelo / Pavimento</span>
              <input type="checkbox" id="zone-flooring" checked={MATERIALES_SUELO.length > 0} class="size-4 rounded-xs border-linea text-terracota" />
            </label>
            <div id="sec-flooring" class="space-y-3 pt-1">
              <SelectorMaterial nombre="flooringMaterial" titulo="Suelo" opciones={MATERIALES_SUELO} />
            </div>
          </div>

          <!-- Zona: Iluminación -->
          <div class="space-y-3">
            <label class="flex items-center justify-between font-bold text-sm text-tinta cursor-pointer">
              <span>Iluminación LED Integrada</span>
              <input type="checkbox" id="zone-lighting" checked class="size-4 rounded-xs border-linea text-terracota" />
            </label>
            <div id="sec-lighting" class="flex items-center gap-4 text-xs text-tinta pt-1">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="under-cabinet-led" checked class="size-4 rounded-xs border-linea text-terracota" />
                <span>Tira LED bajo muebles altos</span>
              </label>
              <select id="led-temp" aria-label="Temperatura de la luz LED" class="min-h-12 rounded-lg border border-linea bg-papel px-2 py-1 text-xs">
                <option value="2700K warm white">2700K Cálida</option>
                <option value="3000K neutral white" selected>3000K Neutra</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Botón de Acción -->
        <button
          type="submit"
          id="btn-generar"
          disabled={cuota.agotada}
          aria-describedby="cuota-aviso"
          class="w-full rounded-2xl bg-terracota py-4 text-center font-titular text-lg font-bold text-papel shadow-lg hover:opacity-95 disabled:opacity-50"
        >
          Generar Reforma en Vivo
        </button>
      </form>

      <!-- Columna Derecha: Comparador Antes / Después -->
      <div class="studio-preview space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="font-titular text-lg font-bold text-tinta">Resultado de la Reforma</h2>
          <div id="acciones-resultado" class="hidden items-center gap-2">
            <button
              type="button"
              id="btn-descargar"
              class="min-h-12 inline-flex items-center gap-1.5 rounded-xl border border-linea bg-papel px-3 py-1.5 text-xs font-semibold text-tinta hover:bg-crema"
            >
              <Icono nombre="descargar" clase="size-4 text-terracota" />
              <span>Guardar Imagen</span>
            </button>
          </div>
        </div>

        <!-- Estado Inicial: Marcador Vacío -->
        <div id="vacio-container" class="flex min-h-[420px] flex-col items-center justify-center rounded-2xl border-2 border-dashed border-linea bg-papel p-8 text-center">
          <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-verdor/50">
            <Icono nombre="camara" clase="size-8 text-terracota" />
          </div>
          <h3 class="mt-4 font-titular text-lg font-bold text-tinta">Ninguna reforma simulada aún</h3>
          <p class="mt-1 max-w-sm text-xs text-gris">
            Sube una foto de la estancia y pulsa «Generar Reforma en Vivo» para visualizar la transformación con el comparador interactivo.
          </p>
        </div>

        <!-- Estado Cargando / Generando -->
        <div id="loading-container" class="hidden min-h-[420px] flex-col items-center justify-center rounded-2xl border border-linea bg-papel p-8 text-center space-y-4">
          <div class="relative size-16">
            <div class="absolute inset-0 rounded-full border-4 border-verdor"></div>
            <div class="absolute inset-0 animate-spin rounded-full border-4 border-terracota border-t-transparent"></div>
          </div>
          <div>
            <h3 class="font-titular text-lg font-bold text-tinta">Transformando Estancia...</h3>
            <p id="loading-status" class="mt-1 text-xs font-semibold text-terracota">Preparando la propuesta visual...</p>
          </div>
        </div>

        <!-- Estado Comparador Antes / Después -->
        <div id="slider-wrapper" class="hidden space-y-3">
          <!-- Aspect ratio dinámico forzado por JS -->
          <div
            id="comparator-container"
            class="relative w-full overflow-hidden rounded-2xl border border-linea shadow-lg select-none"
            style="touch-action: none;"
          >
            <!-- Foto DESPUÉS (fondo completo) -->
            <img id="img-after" src="" alt="Después de la reforma" class="absolute inset-0 size-full object-cover" />

            <!-- Foto ANTES (capa recortada encima) -->
            <div id="before-clip-layer" class="absolute inset-0" style="clip-path:inset(0 50% 0 0)">
              <img id="img-before" src="" alt="Antes de la reforma" class="absolute inset-0 size-full object-cover" />
            </div>

            <!-- Línea Deslizante y Tirador -->
            <div id="slider-handle" class="absolute top-0 bottom-0 left-1/2 z-20 -ml-0.5 w-1 bg-papel shadow-xl cursor-ew-resize">
              <div class="absolute top-1/2 left-1/2 flex size-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-linea bg-papel shadow-md text-terracota font-bold text-xs">
                ↔
              </div>
            </div>

            <!-- Etiquetas Antes / Después -->
            <span class="absolute top-3 left-3 z-10 rounded-lg bg-tinta/75 px-2.5 py-1 text-[11px] font-bold text-papel backdrop-blur-xs">
              ANTES
            </span>
            <span class="absolute top-3 right-3 z-10 rounded-lg bg-terracota/90 px-2.5 py-1 text-[11px] font-bold text-papel backdrop-blur-xs">
              DESPUÉS
            </span>
          </div>

          {sesionCon(Astro.locals,'inventario') && sesionCon(Astro.locals,'facturas') && rutaDisponible('/panel/proyectos') && rutaDisponible('/panel/portafolio') && (
            <form id="guardar-simulacion" class="studio-guardar">
              <label>Nombre del proyecto<input name="titulo" class="campo-panel" maxlength="120" placeholder="Ej. Cocina de roble" required /></label>
              <button class="studio-button">Guardar como proyecto borrador</button>
              <p role="status"></p><a hidden href="/panel/proyectos?ver=simulaciones">Ver simulaciones guardadas</a>
            </form>
          )}
          <label class="grid gap-2 text-center text-sm text-gris">Comparar antes y después
            <input type="range" id="comparacion" min="0" max="100" value="50" class="min-h-12 w-full" />
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Única biblioteca visual; el catálogo original sigue siendo la fuente de verdad. -->
  <div id="studio-material-library" hidden>
    {materiales.map((m) => (
      <button type="button" class="studio-material-card" data-material-option data-kind={m.categoria} data-id={m.id} data-name={m.nombre} data-description={m.descripcion} data-texture={m.previewTexture ?? ''} data-color={m.previewColor ?? '#ebe4da'}>
        <span class="studio-material-card-image" style={`background-color: ${m.previewColor ?? '#ebe4da'}`}>
          {m.previewTexture && <img src={m.previewTexture} alt="" loading="lazy" referrerpolicy="no-referrer" />}
          <span class="studio-material-selected-icon" aria-hidden="true">✓</span>
        </span>
        <strong>{m.nombre}</strong>
        <small>{m.descripcion}</small>
        <small>{m.previewTexture ? 'Textura del catálogo' : m.colorRegistrado ? 'Color de catálogo' : 'Color orientativo'}</small>
      </button>
    ))}
  </div>

  <dialog id="studio-material-dialog" class="studio-material-dialog" aria-labelledby="studio-material-dialog-title">
    <div class="studio-dialog-shell">
      <header class="studio-dialog-heading">
        <div>
          <p class="studio-dialog-eyebrow">CATÁLOGO DE CREACIONES TURIA</p>
          <h2 id="studio-material-dialog-title">Elige el acabado</h2>
          <p id="studio-material-dialog-subtitle">Selecciona un material de tu catálogo.</p>
        </div>
        <button type="button" id="studio-material-close" class="studio-dialog-close" aria-label="Cerrar selector de materiales">✕</button>
      </header>
      <div class="studio-dialog-search">
        <label for="studio-material-query">Buscar por nombre, referencia o acabado</label>
        <input type="search" id="studio-material-query" autocomplete="off" placeholder="Ej. roble, nogal, mate, referencia…" />
        <div class="studio-dialog-filters" aria-label="Filtrar materiales">
          <button type="button" data-material-filter="todos" aria-pressed="true">Todos</button>
          <button type="button" data-material-filter="madera" aria-pressed="false">Madera</button>
          <button type="button" data-material-filter="lacado" aria-pressed="false">Lacados</button>
          <button type="button" data-material-filter="piedra" aria-pressed="false">Piedra</button>
        </div>
      </div>
      <p id="studio-material-count" class="studio-material-count" role="status"></p>
      <div class="studio-material-grid" id="studio-material-results" aria-label="Resultados del catálogo"></div>
      <p id="studio-material-empty" class="studio-material-empty" hidden>No hay artículos compatibles con estos filtros. Prueba otra búsqueda o revisa el catálogo.</p>
      <button type="button" id="studio-material-more" class="studio-dialog-more" hidden>Mostrar más materiales</button>
      <footer class="studio-dialog-footer">
        <button type="button" id="studio-material-cancel" class="studio-button">Cancelar</button>
        <button type="button" id="studio-material-apply" class="studio-dialog-apply" disabled>Aplicar material</button>
      </footer>
    </div>
  </dialog>
</PaginaPanel>

<script is:inline>
  (() => {
    const $ = (id) => document.getElementById(id);
    const form = $('simulador-form');
    const fotoInput = $('foto-input');
    const fotoCargada = $('foto-cargada');
    const previewThumb = $('preview-thumb');
    const editorMascara = $('editor-mascara');
    const lienzo = $('lienzo-mascara');
    const grosor = $('grosor-pincel');
    const btnGenerar = $('btn-generar');

    const vacioContainer = $('vacio-container');
    const loadingContainer = $('loading-container');
    const loadingStatus = $('loading-status');
    const sliderWrapper = $('slider-wrapper');
    const accionesResultado = $('acciones-resultado');
    const errorBanner = $('error-banner');
    const errorMessage = $('error-message');

    const comparatorContainer = $('comparator-container');
    const imgBefore = $('img-before');
    const imgAfter = $('img-after');
    const beforeClipLayer = $('before-clip-layer');
    const sliderHandle = $('slider-handle');
    const btnDescargar = $('btn-descargar');

    // Antes se guardaba aquí un token de IA: ya no se envía ninguna clave desde el navegador.
    try {
      localStorage.removeItem('simulador_hf_token');
      localStorage.removeItem('simulador_gemini_key');
    } catch {
      // Sin almacenamiento (modo privado): no hay nada que borrar.
    }

    // ---- Simulaciones del mes ----
    const cuota = $('cuota');
    function pintarCuota(c) {
      if (!c || !cuota) return;
      const texto = `${c.usos} de ${c.limite} usadas · quedan ${c.quedan}`;
      $('cuota-texto').textContent = texto;
      const barra = $('cuota-barra');
      barra.setAttribute('aria-valuemax', String(c.limite));
      barra.setAttribute('aria-valuenow', String(Math.min(c.usos, c.limite)));
      barra.setAttribute('aria-valuetext', texto);
      const relleno = $('cuota-relleno');
      relleno.style.width = `${c.porcentaje}%`;
      relleno.classList.toggle('bg-[#b45309]', c.aviso);
      relleno.classList.toggle('bg-oliva', !c.aviso);
      cuota.classList.toggle('border-[#b45309]', c.aviso);
      cuota.classList.toggle('border-linea', !c.aviso);
      const aviso = $('cuota-aviso');
      aviso.textContent = c.agotada ? cuota.dataset.avisoAgotada : c.aviso ? `Te quedan ${c.quedan} simulaciones este mes.` : '';
      aviso.classList.toggle('hidden', !c.aviso);
      if (btnGenerar) btnGenerar.disabled = c.agotada;
    }

    // ---- Foto: a 1024 px como mucho por el lado largo ----
    const MAXIMO = 1024;
    let foto = ''; // data URL JPEG de la foto ya reducida
    let ancho = 0;
    let alto = 0;

    fotoInput?.addEventListener('change', async () => {
      const file = fotoInput.files?.[0];
      if (!file) return;
      try {
        const bitmap = await createImageBitmap(file);
        const escala = Math.min(1, MAXIMO / Math.max(bitmap.width, bitmap.height));
        ancho = Math.round(bitmap.width * escala);
        alto = Math.round(bitmap.height * escala);
        const canvas = document.createElement('canvas');
        canvas.width = ancho;
        canvas.height = alto;
        canvas.getContext('2d').drawImage(bitmap, 0, 0, ancho, alto);
        bitmap.close?.();
        foto = canvas.toDataURL('image/jpeg', 0.9);
        previewThumb.src = foto;
        lienzo.width = ancho;
        lienzo.height = alto;
        hayMascara = false;
        fotoCargada?.classList.remove('hidden');
        editorMascara?.classList.remove('hidden');
        errorBanner?.classList.add('hidden');
      } catch {
        showError('No se ha podido abrir la foto. Prueba con otra (JPEG, PNG o HEIC del móvil).');
      }
    });

    // ---- Zona a cambiar: pincel o rectángulo ----
    const pincel = lienzo?.getContext('2d');
    const COLOR = '#0e6b87';
    let hayMascara = false;
    let pintando = false;
    let inicio = null;
    let antes = null;

    const herramienta = () => form?.querySelector('input[name="herramienta"]:checked')?.value || 'pincel';
    const punto = (e) => {
      const r = lienzo.getBoundingClientRect();
      return { x: ((e.clientX - r.left) / r.width) * lienzo.width, y: ((e.clientY - r.top) / r.height) * lienzo.height };
    };
    const escalaLienzo = () => lienzo.width / Math.max(1, lienzo.getBoundingClientRect().width);

    lienzo?.addEventListener('pointerdown', (e) => {
      if (!foto) return;
      e.preventDefault();
      lienzo.setPointerCapture(e.pointerId);
      pintando = true;
      inicio = punto(e);
      pincel.fillStyle = COLOR;
      pincel.strokeStyle = COLOR;
      if (herramienta() === 'rectangulo') antes = pincel.getImageData(0, 0, lienzo.width, lienzo.height);
      else {
        pincel.lineWidth = Number(grosor?.value || 40) * escalaLienzo();
        pincel.lineCap = 'round';
        pincel.lineJoin = 'round';
        pincel.beginPath();
        pincel.moveTo(inicio.x, inicio.y);
        pincel.lineTo(inicio.x + 0.1, inicio.y);
        pincel.stroke();
      }
      hayMascara = true;
    });
    lienzo?.addEventListener('pointermove', (e) => {
      if (!pintando) return;
      const p = punto(e);
      if (herramienta() === 'rectangulo') {
        pincel.putImageData(antes, 0, 0);
        pincel.fillRect(Math.min(inicio.x, p.x), Math.min(inicio.y, p.y), Math.abs(p.x - inicio.x), Math.abs(p.y - inicio.y));
      } else {
        pincel.lineTo(p.x, p.y);
        pincel.stroke();
      }
    });
    $('marcar-rectangulo')?.addEventListener('click', () => {
      const [x, y, derecha, abajo] = [0,1,2,3].map(i => $('limite-' + i).valueAsNumber);
      const valido = [x,y,derecha,abajo].every(n => Number.isFinite(n) && n >= 0 && n <= 100) && x < derecha && y < abajo;
      $('estado-rectangulo').textContent = valido ? 'Zona marcada.' : 'Revisa los límites. El rectángulo debe tener ancho y alto.';
      if (!valido) return;
      pincel.clearRect(0, 0, ancho, alto);
      pincel.fillStyle = COLOR;
      pincel.fillRect(ancho*x/100, alto*y/100, ancho*(derecha-x)/100, alto*(abajo-y)/100);
      hayMascara = true;
    });
    const soltar = () => {
      pintando = false;
      antes = null;
    };
    lienzo?.addEventListener('pointerup', soltar);
    lienzo?.addEventListener('pointercancel', soltar);
    $('btn-borrar-mascara')?.addEventListener('click', () => {
      pincel?.clearRect(0, 0, lienzo.width, lienzo.height);
      hayMascara = false;
    });

    const lienzoDe = (w, h) => {
      const c = document.createElement('canvas');
      c.width = w;
      c.height = h;
      return c;
    };

    /** Máscara para la IA: blanco lo marcado, negro el resto (PNG del mismo tamaño que la foto). */
    function mascaraPng() {
      const c = lienzoDe(ancho, alto);
      const k = c.getContext('2d');
      k.drawImage(lienzo, 0, 0);
      k.globalCompositeOperation = 'source-in';
      k.fillStyle = '#fff';
      k.fillRect(0, 0, ancho, alto);
      k.globalCompositeOperation = 'destination-over';
      k.fillStyle = '#000';
      k.fillRect(0, 0, ancho, alto);
      return c.toDataURL('image/png');
    }

    /** Lo marcado con los bordes difuminados (se reduce y se vuelve a ampliar: funciona en todos los navegadores). */
    function mascaraSuave() {
      const pequeno = lienzoDe(Math.max(1, Math.round(ancho / 16)), Math.max(1, Math.round(alto / 16)));
      const p = pequeno.getContext('2d');
      p.imageSmoothingEnabled = true;
      p.imageSmoothingQuality = 'high';
      p.drawImage(lienzo, 0, 0, pequeno.width, pequeno.height);
      const suave = lienzoDe(ancho, alto);
      const k = suave.getContext('2d');
      k.imageSmoothingEnabled = true;
      k.imageSmoothingQuality = 'high';
      // Lo pintado, nítido, y encima el halo difuminado: el centro queda entero y el borde se funde.
      k.drawImage(pequeno, 0, 0, ancho, alto);
      k.drawImage(lienzo, 0, 0);
      return suave;
    }

    const cargar = (src) =>
      new Promise((ok, mal) => {
        const img = new Image();
        img.onload = () => ok(img);
        img.onerror = mal;
        img.src = src;
      });

    /**
     * Cosido: sobre la foto original solo se ponen los píxeles de la zona
     * marcada del resultado, con el borde difuminado. Sin zona, el resultado
     * entero al tamaño de la foto.
     */
    async function coser(resultado) {
      const [original, nueva] = await Promise.all([cargar(foto), cargar(resultado)]);
      const salida = lienzoDe(ancho, alto);
      const k = salida.getContext('2d');
      if (!hayMascara) {
        k.drawImage(nueva, 0, 0, ancho, alto);
        return salida.toDataURL('image/jpeg', 0.92);
      }
      k.drawImage(original, 0, 0, ancho, alto);
      const capa = lienzoDe(ancho, alto);
      const c = capa.getContext('2d');
      c.drawImage(mascaraSuave(), 0, 0);
      c.globalCompositeOperation = 'source-in';
      c.drawImage(nueva, 0, 0, ancho, alto);
      k.drawImage(capa, 0, 0);
      return salida.toDataURL('image/jpeg', 0.92);
    }

    // ---- Estados ----
    const loadingSteps = ['Analizando la geometría y la perspectiva...', 'Aplicando los materiales del catálogo...', 'Ajustando la luz y las sombras...', 'Preparando el resultado...'];

    function startLoadingAnimation() {
      vacioContainer?.classList.add('hidden');
      sliderWrapper?.classList.add('hidden');
      errorBanner?.classList.add('hidden');
      loadingContainer?.classList.remove('hidden');
      loadingContainer?.classList.add('flex');
      let paso = 0;
      if (loadingStatus) loadingStatus.textContent = loadingSteps[0];
      const intervalo = setInterval(() => {
        paso = (paso + 1) % loadingSteps.length;
        if (loadingStatus) loadingStatus.textContent = loadingSteps[paso];
      }, 2500);
      return () => {
        clearInterval(intervalo);
        loadingContainer?.classList.add('hidden');
        loadingContainer?.classList.remove('flex');
      };
    }

    function showError(msg) {
      if (errorMessage) errorMessage.textContent = msg;
      errorBanner?.classList.remove('hidden');
      vacioContainer?.classList.remove('hidden');
    }

    const marcado = (id) => document.getElementById(id)?.checked === true;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!foto) {
        showError('Sube primero una foto de la estancia.');
        fotoInput?.focus();
        return;
      }
      if (btnGenerar?.disabled) return;
      const datos = new FormData(form);
      const config = {
        spaceType: datos.get('spaceType'),
        perfil: {opciones:Object.fromEntries([...form.querySelectorAll('[data-perfil-campo]')].map(e=>[e.dataset.perfilCampo,e.value]))},
        cabinetStyle: $('cabinet-style')?.value,
        floorToCeiling: marcado('floor-to-ceiling'),
        zones: { cabinets: marcado('zone-cabinets'), countertop: marcado('zone-countertop'), flooring: marcado('zone-flooring'), lighting: marcado('zone-lighting') },
        upperMaterialId: datos.get('upperMaterial'),
        lowerMaterialId: datos.get('lowerMaterial'),
        countertopMaterialId: datos.get('countertopMaterial'),
        includeBacksplash: marcado('include-backsplash'),
        flooringMaterialId: datos.get('flooringMaterial'),
        lighting: { underCabinetLed: marcado('under-cabinet-led'), colorTemp: $('led-temp')?.value },
      };

      form.inert = true;
      const parar = startLoadingAnimation();
      if (btnGenerar) btnGenerar.disabled = true;
      try {
        const respuesta = await fetch('/api/panel/simulador', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ image: foto, mask: hayMascara ? mascaraPng() : undefined, config }),
        });
        const r = await respuesta.json().catch(() => ({ ok: false }));
        parar();
        if (btnGenerar) btnGenerar.disabled = false;
        pintarCuota(r.cuota);
        if (r.ok && r.afterImage) showComparator(foto, await coser(r.afterImage));
        else showError(r.error || 'La IA no ha podido generar la reforma. Vuelve a intentarlo en un rato.');
      } catch {
        parar();
        if (btnGenerar) btnGenerar.disabled = cuota?.querySelector('#cuota-aviso')?.textContent === cuota?.dataset.avisoAgotada;
        showError('Error de red o de conexión con el servidor.');
      } finally {
        form.inert = false;
      }
    });

    // ---- Comparador antes / después ----
    const guardar = $('guardar-simulacion');
    let resultadoId;
    guardar?.addEventListener('submit', async e => {
      e.preventDefault();
      const boton = guardar.querySelector('button');
      if (boton.disabled) return;
      boton.disabled = true;
      const estado = guardar.querySelector('[role=status]');
      estado.textContent = 'Guardando las dos imágenes…';
      try {
        const datos = new FormData(guardar);
        datos.set('resultado', resultadoId);
        const urls = [imgBefore.src, imgAfter.src];
        for (const [i,lado] of ['antes','despues'].entries()) {
          const imagen = await (await fetch(urls[i])).blob();
          datos.set(lado, imagen, lado + '.jpg');
        }
        const respuesta = await fetch('/panel/proyectos?ver=simulaciones',{method:'POST',body:datos});
        if (!respuesta.ok || !respuesta.headers.get('content-type')?.includes('application/json')) throw Error();
        await respuesta.json();
        estado.textContent = 'Proyecto guardado con su antes y después.';
        guardar.querySelector('a').hidden = false;
      } catch {
        boton.disabled = false;
        estado.textContent = 'No se pudo guardar. Puedes volver a intentarlo.';
      }
    });

    function showComparator(antesUrl, despuesUrl) {
      resultadoId = crypto.randomUUID();
      if (guardar) {
        guardar.querySelector('button').disabled = false;
        guardar.querySelector('a').hidden = true;
        guardar.querySelector('[role=status]').textContent = '';
      }
      imgBefore.src = antesUrl;
      imgAfter.src = despuesUrl;
      if (comparatorContainer) comparatorContainer.style.aspectRatio = `${ancho / alto}`;
      sliderWrapper?.classList.remove('hidden');
      accionesResultado?.classList.remove('hidden');
      accionesResultado?.classList.add('flex');
      setSliderPosition(50);
    }

    const comparacion = $('comparacion');
    comparacion?.addEventListener('input', () => setSliderPosition(Number(comparacion.value)));
    function setSliderPosition(pct) {
      const v = Math.max(0, Math.min(100, pct));
      if (comparacion) comparacion.value = String(v);
      if (beforeClipLayer) beforeClipLayer.style.clipPath = `inset(0 ${100 - v}% 0 0)`;
      if (sliderHandle) sliderHandle.style.left = `${v}%`;
    }

    function revelar(event) {
      const rect = comparatorContainer.getBoundingClientRect();
      if (rect.width) setSliderPosition((event.clientX - rect.left) * 100 / rect.width);
    }
    comparatorContainer?.addEventListener('pointerdown', event => {
      if (!event.isPrimary) return;
      comparatorContainer.setPointerCapture(event.pointerId);
      revelar(event);
    });
    comparatorContainer?.addEventListener('pointermove', event => {
      if (comparatorContainer.hasPointerCapture(event.pointerId)) revelar(event);
    });

    btnDescargar?.addEventListener('click', () => {
      if (!imgAfter?.src) return;
      const a = document.createElement('a');
      a.download = `reforma-simulada-${Date.now()}.jpg`;
      a.href = imgAfter.src;
      a.click();
    });
  })();
</script>

