---
import type { GetStaticPaths } from 'astro';
import DetalleEntrada from '../../../components/paginas/DetalleEntrada.astro';
import { obtenerProyectos } from '../../../lib/paginas';

export const getStaticPaths = (async () => {
  const entradas = await obtenerProyectos();
  return entradas.map((entrada) => ({ params: { slug: entrada.data.slug }, props: { entrada } }));
}) satisfies GetStaticPaths;

const { entrada } = Astro.props;
---

<DetalleEntrada idioma="en" entrada={entrada} />
