---
/**
 * El catálogo en los editores de presupuestos y facturas, de dos maneras:
 * - En la propia línea: al escribir en «Concepto» salen los trabajos y
 *   materiales que coinciden; con Intro o un toque se rellena esa línea.
 * - «Añadir del catálogo»: una ventana con todo, por categorías. Cada toque en
 *   un material lo añade (otro toque suma uno más); un trabajo pide sus medidas
 *   y materiales, enseña lo que lleva y su precio (/api/panel/catalogo-trabajo),
 *   y se añade en una línea, por partes o material a material.
 * Salen todos los materiales: los que aún no tienen precio se añaden con el
 * precio en blanco, para escribirlo en la línea.
 * Avisa al formulario con el evento `catalogo:anadir` (detail.lineas:
 * concepto, material, cantidad, precio o null, clave; detail.fila: la línea
 * que se rellena, si se eligió desde ella) y `catalogo:listo` al cerrar la
 * ventana. Nunca muestra costes ni márgenes. Va fuera del formulario (no se
 * anidan formularios); el editor pone su botón `data-abrir-catalogo` (oculto
 * sin JavaScript: entonces las líneas se escriben a mano).
 */
import Icono from '../components/panel/ui/Icono.astro';
import { CATEGORIAS, precioVenta, sinPrecio } from '../server/catalogo/catalogo.ts';
import type { ArticuloCatalogo, PlantillaCatalogo } from '../server/data/tipos.ts';

interface Props {
  articulos: ArticuloCatalogo[];
  plantillas: PlantillaCatalogo[];
  /** «presupuesto» o «factura», para los textos. */
  destino: 'presupuesto' | 'factura';
}
const { articulos, plantillas, destino } = Astro.props;
const nombreCat = (id: string) => CATEGORIAS.find((c) => c.id === id)?.nombre ?? id;
const orden = (id: string) => CATEGORIAS.findIndex((c) => c.id === id);
const datos = {
  articulos: [...articulos]
    .sort((a, b) => orden(a.categoria) - orden(b.categoria) || a.nombre.localeCompare(b.nombre, 'es'))
    .map((a) => ({ id: a.id, nombre: a.nombre, acabado: a.acabado, unidad: a.unidad, precio: sinPrecio(a) ? null : precioVenta(a), categoria: nombreCat(a.categoria) })),
  trabajos: plantillas.map((p) => ({
    id: p.id,
    nombre: p.nombre,
    tipo: p.tipoTrabajo,
    descripcion: p.descripcion,
    parametros: p.parametros.map((x) => ({ id: x.id, nombre: x.nombre, unidad: x.tipo === 'medida' ? 'cm' : 'ud', defecto: x.defecto })),
    opciones: p.opciones.map((o) => ({ id: o.id, nombre: o.nombre, defecto: o.defecto, articulos: articulos.filter((a) => o.categorias.includes(a.categoria)).map((a) => ({ id: a.id, nombre: a.nombre })) })),
  })),
};
const grupos = [...(datos.trabajos.length ? [{ nombre: 'Trabajos', n: datos.trabajos.length }] : []), ...[...new Set(datos.articulos.map((a) => a.categoria))].map((c) => ({ nombre: c, n: datos.articulos.filter((a) => a.categoria === c).length }))];
const hay = grupos.length > 0;
const faltan = datos.articulos.filter((a) => a.precio === null).length;
---

{
  hay && (
    <>
      <dialog class="nv-dialogo" id="dialogo-catalogo" aria-labelledby="dialogo-catalogo-titulo" data-destino={destino}>
        <div class="nv-dialogo-cabeza">
          <h2 id="dialogo-catalogo-titulo">Añadir del catálogo</h2>
          <button type="button" class="boton-icono" data-cerrar aria-label="Cerrar">
            <Icono nombre="cerrar" clase="size-5" />
          </button>
        </div>
        <div class="nv-dialogo-cuerpo" data-paso="lista">
          <label class="nv-campo">
            <span class="sr-only">Buscar en el catálogo</span>
            <input type="search" class="campo-panel" placeholder="Buscar: armario, bisagra, hora de montaje…" data-buscar autocomplete="off" />
          </label>
          <div class="nv-toques nv-filtro-catalogo" role="group" aria-label="Qué ver">
            <button type="button" class="nv-toque" data-grupo="" aria-pressed="true">
              Todo
            </button>
            {
              grupos.map((g) => (
                <button type="button" class="nv-toque" data-grupo={g.nombre} aria-pressed="false">
                  {g.nombre} <span class="nv-gris-suave">{g.n}</span>
                </button>
              ))
            }
          </div>
          {
            faltan > 0 && (
              <p class="nv-nota nv-sin-margen">
                {faltan === 1 ? 'Un material aún no tiene precio' : `${faltan} materiales aún no tienen precio`}: se añaden con el precio en blanco para que lo escribas. <a href="/panel/catalogo/precios" class="enlace-panel">Poner los precios</a>
              </p>
            )
          }
          <ul class="nv-lista-catalogo" data-lista aria-label="Catálogo" />
          <p class="nv-gris" data-vacio hidden>
            Nada con esa búsqueda. Puedes escribir la línea a mano.
          </p>
          <div class="nv-dialogo-pie">
            <p class="nv-estado-catalogo" role="status" data-anadido>
              Toca lo que quieras añadir. Puedes añadir varios.
            </p>
            <button type="button" class="nv-boton" data-listo>
              Listo
            </button>
          </div>
        </div>
        <div class="nv-dialogo-cuerpo" data-paso="trabajo" hidden>
          <button type="button" class="enlace-panel nv-enlace-boton" data-volver>
            <Icono nombre="volver" clase="size-4" />
            Volver al catálogo
          </button>
          <h3 data-trabajo-nombre />
          <div class="nv-rejilla nv-rejilla-2" data-trabajo-form />
          <ul class="nv-avisos" data-trabajo-avisos hidden />
          <details class="nv-lleva" data-lleva hidden>
            <summary>
              Qué lleva <span class="nv-gris" data-lleva-n />
            </summary>
            <ul data-lleva-lista />
          </details>
          <fieldset class="nv-modo">
            <legend>Cómo ponerlo en el {destino}</legend>
            <label class="nv-opcion">
              <input type="radio" name="modo-catalogo" value="una" checked />
              En una línea, con sus medidas
            </label>
            <label class="nv-opcion">
              <input type="radio" name="modo-catalogo" value="partes" />
              Por partes: materiales, herrajes, mano de obra
            </label>
            <label class="nv-opcion">
              <input type="radio" name="modo-catalogo" value="detalle" />
              Material a material, con sus cantidades
            </label>
          </fieldset>
          <div class="nv-dialogo-pie">
            <div class="nv-precio-trabajo" aria-live="polite">
              <span>Precio sin IVA</span>
              <strong data-trabajo-precio>—</strong>
            </div>
            <button type="button" class="nv-boton" data-anadir-trabajo disabled>
              Añadir al {destino}
            </button>
          </div>
        </div>
      </dialog>
      <ul class="nv-sugerencias" id="sugerencias-catalogo" role="listbox" aria-label="Del catálogo" hidden />
      <script type="application/json" id="datos-catalogo" set:html={JSON.stringify(datos).replace(/</g, '\\u003c')} />
    </>
  )
}

<script is:inline>
  (() => {
    const d = document.getElementById('dialogo-catalogo');
    const fuente = document.getElementById('datos-catalogo');
    const sug = document.getElementById('sugerencias-catalogo');
    if (!d || !fuente || !sug || !d.showModal) return;
    const datos = JSON.parse(fuente.textContent);
    const abrir = document.querySelector('[data-abrir-catalogo]');
    if (!abrir) return;
    const form = abrir.closest('form');
    abrir.hidden = false;
    const $ = (s) => d.querySelector(s);
    const eur = (n) => n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2, useGrouping: true }) + ' €';
    const cifra = (n) => n.toLocaleString('es-ES', { maximumFractionDigits: 2 });
    const normal = (t) => String(t).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const el = (tag, props = {}, ...hijos) => {
      const e = document.createElement(tag);
      Object.assign(e, props);
      hijos.forEach((h) => e.append(h));
      return e;
    };
    const precioDe = (a) => (a.precio === null ? 'Sin precio' : `${eur(a.precio)}/${a.unidad}`);
    const lineaDe = (a) => ({ concepto: a.nombre, material: a.acabado || '', cantidad: 1, precio: a.precio, clave: `a:${a.id}` });
    // Un precio 0 del catálogo es un precio que falta: la línea va en blanco.
    const anadir = (lineas, fila = null) => document.dispatchEvent(new CustomEvent('catalogo:anadir', { detail: { lineas: lineas.map((l) => ({ ...l, precio: l.precio > 0 ? l.precio : null })), fila } }));
    // Coincide si están todas las palabras; primero lo que empieza por la búsqueda.
    const buscar = (q, texto) => {
      const t = normal(texto);
      const palabras = normal(q).split(/\s+/).filter(Boolean);
      if (!palabras.every((p) => t.includes(p))) return -1;
      return t.startsWith(palabras[0] ?? '') ? 0 : 1;
    };

    // ---------- La ventana ----------
    let grupo = '';
    let fila = null;
    const veces = new Map();
    const anunciar = (t) => ($('[data-anadido]').textContent = t);
    const pintar = () => {
      const q = $('[data-buscar]').value.trim();
      const ok = (texto) => !q || buscar(q, texto) >= 0;
      const lista = $('[data-lista]');
      lista.replaceChildren();
      let n = 0;
      const cabeza = (t) => lista.append(el('li', { className: 'nv-lista-grupo', textContent: t, ariaHidden: 'true' }));
      if (!grupo || grupo === 'Trabajos') {
        const tra = datos.trabajos.filter((x) => ok(`${x.nombre} ${x.tipo} ${x.descripcion}`));
        if (tra.length) cabeza('Trabajos');
        for (const t of tra) {
          const b = el('button', { type: 'button', className: 'nv-item-catalogo' }, el('span', {}, el('strong', { textContent: t.nombre }), el('small', { textContent: t.tipo || 'Con medidas' })), el('span', { className: 'nv-item-accion', textContent: 'Medidas →' }));
          b.setAttribute('aria-label', `${t.nombre}: poner medidas y materiales`);
          b.addEventListener('click', () => abrirTrabajo(t));
          lista.append(el('li', {}, b));
          n++;
        }
      }
      let actual = '';
      for (const a of datos.articulos) {
        if ((grupo && grupo !== a.categoria) || !ok(`${a.nombre} ${a.acabado} ${a.categoria}`)) continue;
        if (a.categoria !== actual) cabeza((actual = a.categoria));
        const cuantos = veces.get(a.id) ?? 0;
        const marca = el('span', { className: 'nv-item-veces', textContent: cuantos ? `× ${cuantos}` : '', ariaHidden: 'true' });
        const b = el(
          'button',
          { type: 'button', className: 'nv-item-catalogo' },
          el('span', {}, el('strong', { textContent: a.nombre }), a.acabado ? el('small', { textContent: a.acabado }) : ''),
          el('span', { className: 'nv-item-derecha' }, el('span', { className: a.precio === null ? 'nv-item-sin-precio' : 'nv-cifra', textContent: precioDe(a) }), marca, el('span', { className: 'nv-item-mas', textContent: '+', ariaHidden: 'true' })),
        );
        b.setAttribute('aria-label', `Añadir ${a.nombre}, ${a.precio === null ? 'sin precio' : `${eur(a.precio)} por ${a.unidad}`}${cuantos ? `, ya añadido ${cuantos}` : ''}`);
        b.addEventListener('click', () => {
          anadir([lineaDe(a)]);
          const v = (veces.get(a.id) ?? 0) + 1;
          veces.set(a.id, v);
          marca.textContent = `× ${v}`;
          b.setAttribute('aria-label', `Añadir ${a.nombre}, ${a.precio === null ? 'sin precio' : `${eur(a.precio)} por ${a.unidad}`}, ya añadido ${v}`);
          anunciar(`${a.nombre} añadido${v > 1 ? ` (van ${v})` : ''}.${a.precio === null ? ' Escribe su precio en la línea.' : ''}`);
        });
        lista.append(el('li', {}, b));
        n++;
      }
      $('[data-vacio]').hidden = n > 0;
    };
    const elegirGrupo = (g) => {
      grupo = g;
      d.querySelectorAll('[data-grupo]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.grupo === g)));
      pintar();
    };

    // ---------- Un trabajo: medidas, materiales y precio ----------
    let trabajo = null;
    let reloj = 0;
    let pedido = 0;
    let lineas = null;
    const calcular = async () => {
      const n = ++pedido;
      const q = new URLSearchParams({ id: trabajo.id });
      $('[data-trabajo-form]').querySelectorAll('input, select').forEach((c) => q.set(c.name, c.value));
      $('[data-anadir-trabajo]').disabled = true;
      try {
        const r = await fetch(`/api/panel/catalogo-trabajo?${q}`);
        if (!r.ok || n !== pedido) return;
        const j = await r.json();
        lineas = j.lineas;
        $('[data-trabajo-precio]').textContent = j.precio > 0 ? eur(j.precio) : 'Sin precio';
        const avisos = [...j.avisos];
        if (j.faltanPrecios) avisos.push(`${j.faltanPrecios === 1 ? 'Un material' : `${j.faltanPrecios} materiales`} sin precio en el catálogo: puedes añadirlo igual y escribir el precio en la línea.`);
        const av = $('[data-trabajo-avisos]');
        av.replaceChildren(...avisos.map((a) => el('li', { textContent: a })));
        av.hidden = avisos.length === 0;
        const lleva = $('[data-lleva]');
        lleva.hidden = j.lleva.length === 0;
        $('[data-lleva-n]').textContent = `(${j.lleva.length})`;
        $('[data-lleva-lista]').replaceChildren(...j.lleva.map((x) => el('li', {}, el('span', { textContent: x.articulo }), el('span', { className: x.sinPrecio ? 'nv-item-sin-precio' : 'nv-cifra', textContent: `${cifra(x.cantidad)} ${x.unidad}${x.sinPrecio ? ' · sin precio' : ''}` }))));
        $('[data-anadir-trabajo]').disabled = j.lineas.una.length === 0;
      } catch {
        $('[data-trabajo-precio]').textContent = 'Sin conexión';
      }
    };
    const abrirTrabajo = (t) => {
      trabajo = t;
      $('[data-paso="lista"]').hidden = true;
      $('[data-paso="trabajo"]').hidden = false;
      $('[data-trabajo-nombre]').textContent = t.nombre;
      const f = $('[data-trabajo-form]');
      f.replaceChildren();
      for (const x of t.parametros) {
        const i = el('input', { className: 'campo-panel', name: `m.${x.id}`, value: String(x.defecto).replace('.', ','), inputMode: 'decimal', autocomplete: 'off' });
        f.append(el('label', { className: 'nv-campo' }, x.nombre, el('span', { className: 'nv-con-unidad' }, i, el('span', { textContent: x.unidad, ariaHidden: 'true' }))));
      }
      for (const o of t.opciones) {
        const s = el('select', { className: 'campo-panel', name: `o.${o.id}` });
        for (const a of o.articulos) s.append(el('option', { value: a.id, textContent: a.nombre, selected: a.id === o.defecto }));
        f.append(el('label', { className: 'nv-campo nv-ancho-todo' }, o.nombre, s));
      }
      $('[data-trabajo-avisos]').hidden = true;
      $('[data-lleva]').hidden = true;
      $('[data-trabajo-precio]').textContent = '…';
      calcular();
      f.querySelector('input, select')?.focus();
    };
    const verLista = () => {
      trabajo = null;
      $('[data-paso="trabajo"]').hidden = true;
      $('[data-paso="lista"]').hidden = false;
    };
    $('[data-trabajo-form]').addEventListener('input', () => {
      // Hasta tener el precio de las medidas nuevas, no se puede añadir. Una
      // respuesta que llegue ahora es de las medidas de antes: se descarta.
      pedido++;
      lineas = null;
      $('[data-anadir-trabajo]').disabled = true;
      $('[data-trabajo-precio]').textContent = '…';
      clearTimeout(reloj);
      reloj = setTimeout(calcular, 250);
    });
    $('[data-volver]').addEventListener('click', () => {
      verLista();
      $('[data-buscar]').focus();
    });
    $('[data-anadir-trabajo]').addEventListener('click', () => {
      if (!lineas) return;
      const modo = d.querySelector('input[name="modo-catalogo"]:checked').value;
      anadir(lineas[modo], fila);
      d.close();
    });
    d.querySelectorAll('[data-grupo]').forEach((b) => b.addEventListener('click', () => elegirGrupo(b.dataset.grupo)));
    $('[data-buscar]').addEventListener('input', pintar);
    $('[data-cerrar]').addEventListener('click', () => d.close());
    $('[data-listo]').addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => {
      if (e.target === d) d.close();
    });
    d.addEventListener('close', () => {
      const habia = fila;
      fila = null;
      document.dispatchEvent(new CustomEvent('catalogo:listo', { detail: { fila: habia } }));
    });
    const abrirVentana = (q = '', t = null, desde = null) => {
      fila = desde;
      veces.clear();
      $('[data-buscar]').value = q;
      anunciar('Toca lo que quieras añadir. Puedes añadir varios.');
      elegirGrupo('');
      verLista();
      d.showModal();
      if (t) abrirTrabajo(t);
      else $('[data-buscar]').focus();
    };
    abrir.addEventListener('click', () => abrirVentana());

    // ---------- En la propia línea: sugerencias al escribir el concepto ----------
    const conceptos = () => form.querySelectorAll('input[name$=".concepto"]');
    const preparar = (i) => {
      i.setAttribute('role', 'combobox');
      i.setAttribute('aria-autocomplete', 'list');
      i.setAttribute('aria-expanded', 'false');
      i.setAttribute('aria-controls', 'sugerencias-catalogo');
    };
    conceptos().forEach(preparar);
    let campo = null;
    let opciones = [];
    let activa = -1;
    const cerrar = () => {
      sug.hidden = true;
      sug.replaceChildren();
      opciones = [];
      activa = -1;
      if (campo) {
        campo.setAttribute('aria-expanded', 'false');
        campo.removeAttribute('aria-activedescendant');
      }
    };
    const colocar = () => {
      if (!campo || sug.hidden) return;
      const r = campo.getBoundingClientRect();
      const ancho = Math.min(Math.max(r.width, 320), window.innerWidth - 16);
      sug.style.left = `${Math.max(8, Math.min(r.left, window.innerWidth - ancho - 8))}px`;
      sug.style.width = `${ancho}px`;
      const abajo = window.innerHeight - r.bottom;
      if (abajo < 240 && r.top > abajo) {
        sug.style.top = '';
        sug.style.bottom = `${window.innerHeight - r.top + 4}px`;
      } else {
        sug.style.bottom = '';
        sug.style.top = `${r.bottom + 4}px`;
      }
    };
    const marcar = (k) => {
      activa = k;
      sug.querySelectorAll('[role="option"]').forEach((o, j) => o.setAttribute('aria-selected', String(j === k)));
      if (k >= 0) {
        campo.setAttribute('aria-activedescendant', `sug-catalogo-${k}`);
        sug.querySelector(`#sug-catalogo-${k}`)?.scrollIntoView({ block: 'nearest' });
      } else campo.removeAttribute('aria-activedescendant');
    };
    const sugerir = () => {
      const q = campo.value.trim();
      if (q.length < 2) return cerrar();
      const tra = datos.trabajos.map((t) => ({ t, p: buscar(q, `${t.nombre} ${t.tipo}`) })).filter((x) => x.p >= 0);
      const art = datos.articulos.map((a) => ({ a, p: buscar(q, `${a.nombre} ${a.acabado} ${a.categoria}`) })).filter((x) => x.p >= 0);
      const todas = [...tra, ...art].sort((x, y) => x.p - y.p).slice(0, 7);
      opciones = todas.map((x) => (x.t ? { tipo: 'trabajo', t: x.t } : { tipo: 'articulo', a: x.a }));
      if (todas.length) opciones.push({ tipo: 'todo', q });
      sug.replaceChildren(
        ...opciones.map((o, k) => {
          const li = el('li', { id: `sug-catalogo-${k}`, className: 'nv-sugerencia' });
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', 'false');
          if (o.tipo === 'trabajo') li.append(el('span', {}, el('strong', { textContent: o.t.nombre }), el('small', { textContent: 'Trabajo · con medidas' })), el('span', { className: 'nv-item-accion', textContent: 'Medidas →' }));
          else if (o.tipo === 'articulo') li.append(el('span', {}, el('strong', { textContent: o.a.nombre }), el('small', { textContent: [o.a.acabado, o.a.categoria].filter(Boolean).join(' · ') })), el('span', { className: o.a.precio === null ? 'nv-item-sin-precio' : 'nv-cifra', textContent: precioDe(o.a) }));
          else {
            li.classList.add('nv-sugerencia-todo');
            li.textContent = `Ver todo el catálogo con «${o.q}»`;
          }
          li.addEventListener('mousedown', (e) => e.preventDefault());
          li.addEventListener('click', () => elegir(k));
          return li;
        }),
      );
      if (!todas.length) return cerrar();
      sug.hidden = false;
      campo.setAttribute('aria-expanded', 'true');
      marcar(-1);
      colocar();
    };
    const elegir = (k) => {
      const o = opciones[k];
      const i = campo;
      const tr = i?.closest('[data-linea]');
      cerrar();
      if (!o || !tr) return;
      if (o.tipo === 'articulo') anadir([{ ...lineaDe(o.a), cantidad: null }], tr);
      else if (o.tipo === 'trabajo') abrirVentana('', o.t, tr);
      else abrirVentana(o.q, null, null);
    };
    form.addEventListener('focusin', (e) => {
      if (e.target.matches?.('input[name$=".concepto"]')) {
        if (!e.target.hasAttribute('role')) preparar(e.target);
        campo = e.target;
      }
    });
    form.addEventListener('input', (e) => {
      if (e.target === campo) sugerir();
    });
    form.addEventListener('keydown', (e) => {
      if (e.target !== campo || sug.hidden) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const n = opciones.length;
        marcar(e.key === 'ArrowDown' ? (activa + 1) % n : (activa - 1 + n) % n);
      } else if (e.key === 'Enter' && activa >= 0) {
        e.preventDefault();
        elegir(activa);
      } else if (e.key === 'Escape') {
        e.preventDefault();
        cerrar();
      }
    });
    form.addEventListener('focusout', (e) => {
      if (e.target === campo) cerrar();
    });
    window.addEventListener('resize', colocar);
    document.addEventListener('scroll', colocar, true);
  })();
</script>
