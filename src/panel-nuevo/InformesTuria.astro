---
import {dinero} from '../server/facturas/importes';
import type {Gasto} from '../server/data/tipos';
import type {Periodo, TipoPeriodo, Cifras, PuntoMes, Parte} from '../server/informes/informes';
import type {cobros} from '../server/informes/informes';
interface Props {periodo:Periodo;anterior:Periodo;siguiente:Periodo;tipo:TipoPeriodo;dia:string;a:Cifras;b:Cifras;c:ReturnType<typeof cobros>;evolucion:PuntoMes[];categorias:Parte[];clientes:Parte[];productos:Parte[];taller:{aceptados:number;decididos:number;pendientes:number;cartera:number;caducan:number;valorCaduca:number}|null;porRevisar:Gasto[];gastos:Gasto[]}
import {variacion} from '../server/informes/informes';
import Barras from '../components/panel/graficos/Barras.astro';
import Reparto from '../components/panel/graficos/Reparto.astro';
const {periodo,anterior,siguiente,tipo,dia,a,b,c,evolucion,categorias,clientes,productos,taller,porRevisar,gastos}=Astro.props;
const enlace=(t:string,f:string)=>`/panel/informes?periodo=${t}&fecha=${f}`;
const gastoTotal=gastos.filter((g)=>g.fecha>=periodo.desde&&g.fecha<=periodo.hasta).reduce((n,g)=>n+g.total,0);
const cambio=(actual:number,previo:number)=>{const n=variacion(actual,previo);return n===null?'Sin periodo anterior':`${n>0?'+':''}${n.toLocaleString('es-ES')} % respecto al periodo anterior`;};
const kpis=[{titulo:'Facturado',valor:a.ingresos,extra:`${dinero(a.facturado)} con IVA`,nota:cambio(a.ingresos,b.ingresos),href:'/panel/facturas'}, {titulo:'Gastos confirmados',valor:a.gastos,extra:`${dinero(gastoTotal)} con IVA`,nota:cambio(a.gastos,b.gastos),href:'/panel/gastos'}, {titulo:'Resultado',valor:a.resultado,extra:'Ingresos menos gastos, sin IVA',nota:a.margen===null?'Sin margen calculable':`Margen ${a.margen} %`,href:'/panel/facturas'}, {titulo:'Por cobrar hoy',valor:c.pendiente,extra:'IVA incluido · todas las fechas',nota:c.vencidas?`${c.vencidas} vencidas · ${dinero(c.vencido)}`:'Sin facturas vencidas',href:'/panel/facturas?estado=emitida'}];
---
<div class="rep">
<header class="rep-header"><div><p class="rep-eyebrow">TU NEGOCIO, EN CIFRAS</p><h1>Informes</h1><p>Consulta la evolución de tu taller y el detalle de cada periodo.</p></div><a class="rep-link" href="/panel/facturas">Ver facturas →</a></header>
<nav aria-label="Periodo de informes" class="rep-filtros"><div class="rep-tipos">{[['mes','Mes'],['trimestre','Trimestre'],['anio','Año']].map(([t,n])=><a href={enlace(t,periodo.hasta>dia?dia:periodo.hasta)} aria-current={tipo===t?'page':undefined}>{n}</a>)}</div><div class="rep-periodo"><a href={enlace(tipo,anterior.desde)} aria-label={`Periodo anterior: ${anterior.etiqueta}`}>← <span>Anterior</span></a><h2>{periodo.etiqueta}</h2>{siguiente.desde<=dia?<a href={enlace(tipo,siguiente.desde)} aria-label={`Periodo siguiente: ${siguiente.etiqueta}`}><span>Siguiente</span> →</a>:<span class="rep-disabled" aria-disabled="true"><span>Siguiente</span> →</span>}</div></nav>
<ul class="rep-kpis" role="list">{kpis.map(k=><li><a href={k.href}><span>{k.titulo}</span><strong>{dinero(k.valor)}</strong><span class="rep-extra">{k.extra}</span><small>{k.nota}</small></a></li>)}</ul>
<div class="rep-grid"><section class="rep-card rep-chart" aria-label="Evolución"><Barras titulo="Ingresos y gastos · últimos 12 meses" categorias={evolucion.map((p)=>p.etiqueta)} nombres={evolucion.map((p)=>p.nombre)} series={[{nombre:'Ingresos sin IVA',color:'#52764a',valores:evolucion.map((p)=>p.ingresos)},{nombre:'Gastos sin IVA',color:'#b7895c',valores:evolucion.map((p)=>p.gastos)}]}/></section><section class="rep-card rep-cobros"><h2>Movimiento del periodo</h2><dl><div><dt>Facturado con IVA</dt><dd>{dinero(a.facturado)}</dd></div><div><dt>Cobrado con IVA</dt><dd>{dinero(a.cobrado)}</dd></div><div><dt>Gastos con IVA</dt><dd>{dinero(gastoTotal)}</dd></div><div><dt>IVA repercutido y recargo</dt><dd>{dinero(a.ivaRepercutido)}</dd></div><div><dt>IVA soportado registrado</dt><dd>{dinero(a.ivaSoportado)}</dd></div></dl><p>Los cobros se cuentan en su fecha de cobro. Gastos sin IVA desglosado: se usa su total como base.</p>{porRevisar.length>0&&<a href="/panel/gastos">{porRevisar.length} gastos pendientes de revisión →</a>}</section></div>
{taller&&<section class="rep-card rep-comercial"><div class="rep-heading"><div><h2>Actividad comercial</h2><p>Presupuestos del periodo y oportunidades vigentes hoy</p></div><a href="/panel/presupuestos-cliente">Ver presupuestos →</a></div><ul role="list"><li><span>Aceptados</span><strong>{taller.aceptados}</strong></li><li><span>Tasa de aceptación</span><strong>{taller.decididos?`${Math.round(100*taller.aceptados/taller.decididos)} %`:'—'}</strong><small>Sobre aceptados y rechazados</small></li><li><span>Pendientes hoy</span><strong>{dinero(taller.cartera)}</strong><small>{taller.pendientes} presupuestos · IVA incluido</small></li><li><span>Caducan en 7 días</span><strong>{dinero(taller.valorCaduca)}</strong><small>{taller.caducan} presupuestos · IVA incluido</small></li></ul></section>}
<div class="rep-desglose"><section class="rep-card"><Reparto titulo="Gastos por categoría" partes={categorias} vacio="No hay gastos confirmados en este periodo." color="#a36d3e"/></section><section class="rep-card"><Reparto titulo="Clientes con mayor facturación" partes={clientes} vacio="No hay facturas emitidas en este periodo." color="#52764a"/></section><section class="rep-card"><Reparto titulo="Productos y servicios más vendidos" partes={productos} vacio="No hay ventas en este periodo." color="#52764a"/></section></div>
<p class="rep-nota">Las facturas borrador y los gastos pendientes de revisión no se incluyen. Las rectificativas restan. El IVA es orientativo; consulta la declaración con tu gestoría.</p>
</div>
<style is:inline>
.rep{--color-serie-1:#52764a;--color-serie-2:#b7895c;--color-serie-2-texto:#8b5e32;color:#282520}.rep *{box-sizing:border-box}.rep-header,.rep-heading{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}.rep h1{font-size:2rem;line-height:1.15;letter-spacing:-.04em;margin:0}.rep h2{font-size:1.1rem;margin:0}.rep-header p,.rep-heading p{color:#68615a;margin:.4rem 0 0;font-size:.9rem}.rep-header .rep-eyebrow{font-size:.72rem;font-weight:700;letter-spacing:.1em;color:#795331;margin:0 0 .4rem}.rep a{color:#604022}.rep-link,.rep-heading a{display:inline-flex;align-items:center;min-height:48px;font-weight:600;font-size:.88rem}.rep-filtros{margin:24px 0 18px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}.rep-tipos{display:flex;background:#eeeae4;border-radius:13px;padding:4px}.rep-tipos a{display:grid;place-items:center;min-height:48px;min-width:90px;border-radius:10px;text-decoration:none;font-weight:600;color:#68615a}.rep-tipos a[aria-current=page]{background:white;color:#604022;box-shadow:0 1px 5px #00000014}.rep-periodo{display:grid;grid-template-columns:112px minmax(150px,210px) 112px;align-items:center;text-align:center}.rep-periodo h2{font-size:1rem}.rep-periodo h2::first-letter{text-transform:uppercase}.rep-periodo>a,.rep-disabled{display:flex;align-items:center;justify-content:center;gap:5px;min-height:48px;border:1px solid #ddd6cc;border-radius:10px;text-decoration:none;font-size:.85rem;font-weight:600}.rep-disabled{color:#888;border-color:#ece8e2}.rep-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;list-style:none;padding:0;margin:0 0 20px}.rep-kpis a,.rep-card{background:#fffefd;border:1px solid #e9e5df;border-radius:18px;box-shadow:0 2px 9px #422d180a}.rep-kpis a{display:flex;flex-direction:column;gap:6px;min-height:166px;padding:18px;color:inherit;text-decoration:none}.rep-kpis a:hover{border-color:#9e8568}.rep-kpis a>span:first-child,.rep-comercial li>span{color:#68615a;font-size:.82rem}.rep-kpis strong,.rep-comercial strong{font-size:1.55rem;letter-spacing:-.04em;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.rep-extra{font-size:.84rem;font-weight:600;color:#4d633d}.rep-kpis small,.rep-comercial small{font-size:.75rem;color:#68615a;margin-top:auto}.rep-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,1fr);gap:18px}.rep-card{padding:20px;min-width:0}.rep-chart svg{display:block;width:100%;max-width:650px;height:auto}.rep-chart figure{margin:0}.rep-chart figcaption{font-size:1.1rem;font-weight:700}.rep-cobros dl{margin:16px 0}.rep-cobros dl div{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #eeeae5;font-size:.85rem}.rep-cobros dd{font-weight:700;text-align:right;margin:0}.rep-cobros p,.rep-nota{font-size:.78rem;color:#68615a}.rep-cobros a{display:inline-flex;align-items:center;min-height:48px}.rep-comercial{margin-top:18px}.rep-comercial ul{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;list-style:none;padding:0;margin:18px 0 0}.rep-comercial li{display:flex;flex-direction:column;gap:6px;padding:14px;background:#f8f6f2;border-radius:12px}.rep-desglose{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:18px}.rep-desglose h3{font-size:1rem}.rep-desglose ol{padding:0;list-style:none}.rep-desglose .h-2\.5{height:10px}.rep-nota{margin-top:20px}.rep :focus-visible{outline:3px solid #795331;outline-offset:2px}@media(max-width:1000px){.rep-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.rep-grid{grid-template-columns:1fr}.rep-desglose{grid-template-columns:1fr 1fr}}@media(max-width:600px){.rep h1{font-size:1.65rem}.rep-header p{max-width:27ch}.rep-filtros{display:grid}.rep-tipos a{min-width:0;flex:1}.rep-periodo{grid-template-columns:76px minmax(0,1fr) 76px}.rep-periodo h2::first-letter{text-transform:uppercase}.rep-periodo>a,.rep-disabled{font-size:.72rem}.rep-periodo h2{font-size:.87rem}.rep-kpis{gap:9px}.rep-kpis a{padding:13px;min-height:150px}.rep-kpis strong,.rep-comercial strong{font-size:1.25rem}.rep-card{padding:16px}.rep-comercial ul,.rep-desglose{grid-template-columns:repeat(2,minmax(0,1fr))}.rep-desglose{grid-template-columns:1fr}}
</style>
