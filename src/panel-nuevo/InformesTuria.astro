---
import {dinero} from '../server/facturas/importes';
import type {Gasto} from '../server/data/tipos';
import type {Periodo, TipoPeriodo, Cifras, PuntoMes, Parte} from '../server/informes/informes';
import type {cobros} from '../server/informes/informes';
interface Props {periodo:Periodo;anterior:Periodo;siguiente:Periodo;tipo:TipoPeriodo;dia:string;a:Cifras;b:Cifras;c:ReturnType<typeof cobros>;evolucion:PuntoMes[];categorias:Parte[];clientes:Parte[];productos:Parte[];taller:{aceptados:number;decididos:number;pendientes:number;cartera:number;caducan:number;valorCaduca:number}|null;porRevisar:Gasto[];gastosConIva:number;personalizado:boolean;ultimos12:boolean;incluyeHoy:boolean}
import {variacion} from '../server/informes/informes';
import Barras from '../components/panel/graficos/Barras.astro';
import Reparto from '../components/panel/graficos/Reparto.astro';
const {periodo,anterior,siguiente,tipo,dia,a,b,c,evolucion,categorias,clientes,productos,taller,porRevisar,gastosConIva,personalizado,ultimos12,incluyeHoy}=Astro.props;
const enlace=(t:string,f:string)=>`/panel/informes?periodo=${t}&fecha=${f}`;
const moverRango=(paso:number)=>{const inicio=new Date(`${periodo.desde}T12:00:00Z`);const fin=new Date(`${periodo.hasta}T12:00:00Z`);const dias=Math.round((fin.getTime()-inicio.getTime())/86400000)+1;inicio.setUTCDate(inicio.getUTCDate()+paso*dias);fin.setUTCDate(fin.getUTCDate()+paso*dias);const hasta=fin.toISOString().slice(0,10)>dia?dia:fin.toISOString().slice(0,10);return `/panel/informes?periodo=personalizado&desde=${inicio.toISOString().slice(0,10)}&hasta=${hasta}`;};
const hrefAnterior=(personalizado||ultimos12)?moverRango(-1):enlace(tipo,anterior.desde);
const hrefSiguiente=(personalizado||ultimos12)?moverRango(1):enlace(tipo,siguiente.desde);
const haySiguiente=(personalizado||ultimos12)?periodo.hasta<dia:siguiente.desde<=dia;
const gastoTotal=gastosConIva;
const cambio=(actual:number,previo:number)=>{if(personalizado||ultimos12)return 'Periodo seleccionado';const n=variacion(actual,previo);return n===null?'Sin periodo anterior':`${n>0?'+':''}${n.toLocaleString('es-ES')} % respecto al periodo anterior`;};
const detalle=(tipo:string)=>`/panel/informes/detalle?tipo=${tipo}&desde=${periodo.desde}&hasta=${periodo.hasta}`;
const kpis=[{titulo:'Facturación emitida',valor:a.ingresos,extra:`${dinero(a.facturado)} con IVA`,nota:cambio(a.ingresos,b.ingresos),href:detalle('facturas')}, {titulo:'Gastos confirmados',valor:a.gastos,extra:`${dinero(gastoTotal)} con IVA`,nota:cambio(a.gastos,b.gastos),href:detalle('gastos')}, {titulo:'Resultado registrado',valor:a.resultado,extra:'Ingresos menos gastos, sin IVA',nota:'No incluye costes no registrados',href:detalle('resultado')}, {titulo:'Por cobrar',valor:incluyeHoy?c.pendiente:null,extra:incluyeHoy?'IVA incluido · situación actual':'Saldo al cierre del periodo',nota:incluyeHoy?(c.vencidas?`${c.vencidas} vencidas · ${dinero(c.vencido)}`:'Sin facturas vencidas'):'Sin histórico fiable',href:detalle('pendientes')}];
---
<div class="rep">
<header class="rep-header"><div><p class="rep-eyebrow">TU NEGOCIO, EN CIFRAS</p><h1>Informes</h1><p>Consulta la evolución de tu taller y el detalle de cada periodo.</p></div><a class="rep-link" href={`${Astro.url.pathname}${Astro.url.search}${Astro.url.search ? '&' : '?'}exportar=csv`}>Descargar CSV ↓</a></header>
<nav aria-label="Periodo de informes" class="rep-filtros"><div class="rep-tipos">{[['12meses','12 meses'],['mes','Mes'],['trimestre','Trimestre'],['anio','Año']].map(([t,n])=><a href={enlace(t as TipoPeriodo,periodo.hasta>dia?dia:periodo.hasta)} aria-current={(!personalizado && (ultimos12?t==='12meses':tipo===t))?'page':undefined}>{n}</a>)}</div><details class="rep-rango" open={personalizado}><summary>Personalizado</summary><form method="get" class="rep-custom"><input type="hidden" name="periodo" value="personalizado"/><label>Desde <input type="date" name="desde" value={periodo.desde} max={dia} required/></label><label>Hasta <input type="date" name="hasta" value={periodo.hasta} max={dia} required/></label><button type="submit">Aplicar rango</button></form></details><div class="rep-periodo"><a href={hrefAnterior} aria-label={personalizado?'Rango anterior':ultimos12?'Periodo anterior':`Periodo anterior: ${anterior.etiqueta}`}>← <span>Anterior</span></a><h2>{periodo.etiqueta}</h2>{haySiguiente?<a href={hrefSiguiente} aria-label={personalizado?'Rango siguiente':`Periodo siguiente: ${siguiente.etiqueta}`}><span>Siguiente</span> →</a>:<span class="rep-disabled" aria-disabled="true"><span>Siguiente</span> →</span>}</div></nav>
<ul class="rep-kpis" role="list">{kpis.map(k=><li><a href={k.valor===null?undefined:k.href} aria-disabled={k.valor===null?'true':undefined}><span>{k.titulo}</span><strong>{k.valor===null?'Sin datos suficientes':dinero(k.valor)}</strong><span class="rep-extra">{k.extra}</span><small>{k.nota}</small></a></li>)}</ul>
<div class="rep-grid"><section class="rep-card rep-chart" aria-label="Evolución"><Barras titulo="Ingresos y gastos por mes" categorias={evolucion.map((p)=>p.etiqueta)} nombres={evolucion.map((p)=>p.nombre)} series={[{nombre:'Ingresos sin IVA',color:'#52764a',valores:evolucion.map((p)=>p.ingresos)},{nombre:'Gastos sin IVA',color:'#b7895c',valores:evolucion.map((p)=>p.gastos)}]}/><div class="rep-registros"><a href={detalle('facturas')}>Ver facturas →</a><a href={detalle('gastos')}>Ver gastos →</a></div></section><section class="rep-card rep-cobros"><h2>Movimiento del periodo</h2><dl><div><dt>Facturado con IVA</dt><dd>{dinero(a.facturado)}</dd></div><div><dt>Cobrado con IVA</dt><dd>{dinero(a.cobrado)}</dd></div><div><dt>Gastos con IVA</dt><dd>{dinero(gastoTotal)}</dd></div><div><dt>IVA repercutido y recargo</dt><dd>{dinero(a.ivaRepercutido)}</dd></div><div><dt>IVA soportado registrado</dt><dd>{dinero(a.ivaSoportado)}</dd></div></dl><p>Los cobros se cuentan en su fecha de cobro. Gastos sin IVA desglosado: se usa su total como base.</p>{incluyeHoy&&porRevisar.length>0&&<a href="/panel/gastos">{porRevisar.length} gastos pendientes de revisión →</a>}</section></div>
{taller&&<section class="rep-card rep-comercial"><div class="rep-heading"><div><h2>Actividad comercial</h2><p>Presupuestos del periodo y oportunidades vigentes hoy</p></div><a href={detalle('presupuestos')}>Ver presupuestos →</a></div><ul role="list"><li><span>Aceptados</span><strong>{taller.aceptados}</strong></li><li><span>Tasa de aceptación</span><strong>{taller.decididos?`${Math.round(100*taller.aceptados/taller.decididos)} %`:'—'}</strong><small>Sobre aceptados y rechazados</small></li><li><span>{incluyeHoy?'Pendientes hoy':'Pendientes al cierre'}</span><strong>{incluyeHoy?dinero(taller.cartera):'Sin datos suficientes'}</strong><small>{incluyeHoy?`${taller.pendientes} presupuestos · IVA incluido`:'Sin histórico fiable'}</small></li><li><span>Caducan en 7 días</span><strong>{incluyeHoy?dinero(taller.valorCaduca):'Sin datos suficientes'}</strong><small>{incluyeHoy?`${taller.caducan} presupuestos · IVA incluido`:'Sin histórico fiable'}</small></li></ul></section>}
<div class="rep-desglose"><section class="rep-card"><h2>Antigüedad de cobros pendientes</h2><p>Situación actual · IVA incluido</p>{!incluyeHoy?<p>Sin datos suficientes para reconstruir la antigüedad al cierre de este periodo.</p>:[c.enPlazo,c.vencido30,c.vencidoMas30].some(v=>v<0)?<p>Sin datos suficientes para representar la antigüedad: hay rectificativas o saldos negativos. Consulta las facturas.</p>:<Reparto titulo="Cobros por vencimiento" partes={[{nombre:'En plazo',valor:c.enPlazo},{nombre:'Vencido hasta 30 días',valor:c.vencido30},{nombre:'Vencido más de 30 días',valor:c.vencidoMas30}].filter(x=>x.valor>0)} vacio="No hay cobros pendientes." color="#52764a"/>}{incluyeHoy&&<a href={detalle('pendientes')}>Consultar facturas →</a>}</section>{taller&&<section class="rep-card"><h2>Respuesta a presupuestos</h2><p>Presupuestos fechados en el periodo</p><Reparto titulo="Aceptados y rechazados" unidades partes={[{nombre:'Aceptados',valor:taller.aceptados},{nombre:'Rechazados',valor:taller.decididos-taller.aceptados}].filter(x=>x.valor>0)} vacio="Sin datos suficientes" color="#52764a"/><a href={detalle('presupuestos')}>Consultar presupuestos →</a></section>}<section class="rep-card"><Reparto titulo="Gastos por categoría" partes={categorias} vacio="No hay gastos confirmados en este periodo." color="#a36d3e"/><a href={detalle('gastos')}>Consultar gastos →</a></section><section class="rep-card"><Reparto titulo="Clientes con mayor facturación" partes={clientes} vacio="No hay facturas emitidas en este periodo." color="#52764a"/><a href={detalle('facturas')}>Consultar facturas →</a></section><section class="rep-card"><Reparto titulo="Productos y servicios más vendidos" partes={productos} vacio="No hay ventas en este periodo." color="#52764a"/><a href={detalle('facturas')}>Consultar facturas →</a></section></div>
<p class="rep-nota">Rentabilidad por obra y facturación por tipo de trabajo: sin datos suficientes para calcularlas de forma fiable.</p><p class="rep-nota">Las facturas borrador y los gastos pendientes de revisión no se incluyen. Las rectificativas restan. El IVA es orientativo; consulta la declaración con tu gestoría.</p>
</div>
<style is:inline>
.rep{--color-serie-1:#52764a;--color-serie-2:#b7895c;--color-serie-2-texto:#8b5e32;color:#282520}.rep *{box-sizing:border-box}.rep-header,.rep-heading{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}.rep h1{font-size:2rem;line-height:1.15;letter-spacing:-.04em;margin:0}.rep h2{font-size:1.1rem;margin:0}.rep-header p,.rep-heading p{color:#68615a;margin:.4rem 0 0;font-size:.9rem}.rep-header .rep-eyebrow{font-size:.72rem;font-weight:700;letter-spacing:.1em;color:#795331;margin:0 0 .4rem}.rep a{color:#604022}.rep-link,.rep-heading a{display:inline-flex;align-items:center;min-height:48px;font-weight:600;font-size:.88rem}.rep-filtros{margin:24px 0 18px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}.rep-rango summary{display:flex;align-items:center;min-height:48px;cursor:pointer;font-weight:600;font-size:.85rem;color:#604022}.rep-custom{display:flex;align-items:end;gap:8px;flex-wrap:wrap}.rep-custom label{display:grid;font-size:.75rem;gap:3px}.rep-custom input,.rep-custom button{min-height:48px;border:1px solid #ddd6cc;border-radius:10px;padding:8px;background:white;color:#282520}.rep-tipos{display:flex;background:#eeeae4;border-radius:13px;padding:4px}.rep-tipos a{display:grid;place-items:center;min-height:48px;min-width:90px;border-radius:10px;text-decoration:none;font-weight:600;color:#68615a}.rep-tipos a[aria-current=page]{background:white;color:#604022;box-shadow:0 1px 5px #00000014}.rep-periodo{display:grid;grid-template-columns:112px minmax(150px,210px) 112px;align-items:center;text-align:center}.rep-periodo h2{font-size:1rem}.rep-periodo h2::first-letter{text-transform:uppercase}.rep-periodo h2::first-letter{text-transform:uppercase}.rep-periodo>a,.rep-disabled{display:flex;align-items:center;justify-content:center;gap:5px;min-height:48px;border:1px solid #ddd6cc;border-radius:10px;text-decoration:none;font-size:.85rem;font-weight:600}.rep-disabled{color:#888;border-color:#ece8e2}.rep-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;list-style:none;padding:0;margin:0 0 20px}.rep-kpis a,.rep-card{background:#fffefd;border:1px solid #e9e5df;border-radius:18px;box-shadow:0 2px 9px #422d180a}.rep-kpis a{display:flex;flex-direction:column;gap:6px;min-height:166px;padding:18px;color:inherit;text-decoration:none}.rep-kpis a:hover{border-color:#9e8568}.rep-kpis a>span:first-child,.rep-comercial li>span{color:#68615a;font-size:.82rem}.rep-kpis strong,.rep-comercial strong{font-size:1.55rem;letter-spacing:-.04em;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.rep-extra{font-size:.84rem;font-weight:600;color:#4d633d}.rep-kpis small,.rep-comercial small{font-size:.75rem;color:#68615a;margin-top:auto}.rep-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,1fr);gap:18px}.rep-card{padding:20px;min-width:0}.rep-registros{display:flex;gap:20px;flex-wrap:wrap}.rep-registros a{display:inline-flex;align-items:center;min-height:48px;font-size:.85rem}.rep-chart svg{display:block;width:100%;max-width:650px;height:auto}.rep-chart figure{margin:0;overflow-x:auto}.rep-chart figcaption{font-size:1.1rem;font-weight:700}.rep-cobros dl{margin:16px 0}.rep-cobros dl div{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #eeeae5;font-size:.85rem}.rep-cobros dd{font-weight:700;text-align:right;margin:0}.rep-cobros p,.rep-nota{font-size:.78rem;color:#68615a}.rep-cobros a{display:inline-flex;align-items:center;min-height:48px}.rep-comercial{margin-top:18px}.rep-comercial ul{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;list-style:none;padding:0;margin:18px 0 0}.rep-comercial li{display:flex;flex-direction:column;gap:6px;padding:14px;background:#f8f6f2;border-radius:12px}.rep-desglose{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:18px}.rep-desglose section>a{display:inline-flex;align-items:center;min-height:48px}.rep-desglose h3{font-size:1rem}.rep-desglose ol{padding:0;list-style:none}.rep-desglose .h-2\.5{height:10px}.rep-nota{margin-top:20px}.rep :focus-visible{outline:3px solid #795331;outline-offset:2px}@media(max-width:1000px){.rep-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.rep-grid{grid-template-columns:1fr}.rep-desglose{grid-template-columns:1fr 1fr}}@media(max-width:600px){.rep h1{font-size:1.65rem}.rep-header p{max-width:27ch}.rep-filtros{display:grid}.rep-tipos a{min-width:0;flex:1}.rep-periodo{grid-template-columns:76px minmax(0,1fr) 76px}.rep-periodo h2::first-letter{text-transform:uppercase}.rep-periodo h2::first-letter{text-transform:uppercase}.rep-periodo>a,.rep-disabled{font-size:.72rem}.rep-periodo h2{font-size:.87rem}.rep-kpis{gap:9px}.rep-kpis a{padding:13px;min-height:150px}.rep-kpis strong,.rep-comercial strong{font-size:1.25rem}.rep-card{padding:16px}.rep-comercial ul,.rep-desglose{grid-template-columns:repeat(2,minmax(0,1fr))}.rep-desglose{grid-template-columns:1fr}}
</style>
