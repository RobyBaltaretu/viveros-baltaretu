---
/**
 * Inicio con el diseño nuevo: saludo, las cifras del mes (cada una lleva a su
 * sección), «Por hacer» con un botón por cosa, lo facturado en seis meses y
 * atajos para crear. Los cálculos están en inicio.ts.
 */
import Icono from '../components/panel/ui/Icono.astro';
import { dinero } from '../server/facturas/importes.ts';
import { hoy } from '../server/gastos/gastos.ts';
import { baseGasto, periodoAnterior, periodoDe } from '../server/informes/informes.ts';
import { menuDe } from '../server/panel/navegacion.ts';
import { sesionCon } from '../server/panel/pagina.ts';
import { puede } from '../server/panel/permisos.ts';
import { rutaDisponible } from '../plataforma/actual.ts';
import { evolucion, kpis, porHacer, saludo, type DatosInicio } from './inicio.ts';
import { accionesCrear } from './navegacion.ts';

const s = sesionCon(Astro.locals);
const rol = s?.usuario.rol ?? 'editor';
const dia = hoy();
const mes = periodoDe('mes', dia);
let desde = mes;
for (let i = 0; i < 5; i++) desde = periodoAnterior(desde);
const ver = {
  facturas: puede(rol, 'facturas') && rutaDisponible('/panel/facturas'),
  presupuestos: puede(rol, 'facturas') && rutaDisponible('/panel/presupuestos-cliente'),
  gastos: puede(rol, 'gastos') && rutaDisponible('/panel/gastos'),
  informes: puede(rol, 'informes') && rutaDisponible('/panel/informes'),
};
const [facturas, gastosMes, revisar, presupuestos] = s
  ? await Promise.all([
      ver.facturas ? s.repos.facturas.listar({ desde: desde.desde }) : [],
      ver.gastos ? s.repos.gastos.listar({ estado: 'confirmado', desde: mes.desde, hasta: mes.hasta }) : [],
      ver.gastos ? s.repos.gastos.listar({ estado: 'revisar' }).then((l) => l.length) : 0,
      ver.presupuestos ? s.repos.presupuestosCliente.listar() : [],
    ])
  : [[], [], 0, []];
// Las vencidas pueden ser de hace más de seis meses: se piden aparte.
const emitidas = ver.facturas && s ? await s.repos.facturas.listar({ estado: 'emitida' }) : [];
const idsFacturas = new Set(facturas.map(f => f.id));
const todas = [...facturas, ...emitidas.filter(f => !idsFacturas.has(f.id))];
const datos: DatosInicio = { hoy: dia, facturas: todas, gastosMes, ticketsPorRevisar: revisar, presupuestos, ver };
const cifras = kpis(datos);
const indicadores = [
  cifras.find((k) => k.id === 'facturado'),
  cifras.find((k) => k.id === 'enJuego'),
  ver.gastos ? { nombre: 'Gastos', valor: Math.round(gastosMes.reduce((total, gasto) => total + baseGasto(gasto), 0) * 100) / 100, formato: 'euros' as const, nota: 'Confirmados sin IVA este mes', href: '/panel/gastos' } : undefined,
  cifras.find((k) => k.id === 'porCobrar'),
].filter((k): k is NonNullable<typeof k> => !!k);
const tareas = porHacer(datos);
const meses = ver.facturas ? evolucion(datos) : [];
const maximo = Math.max(...meses.map((m) => m.base), 0);
const crear = accionesCrear(s ? menuDe(rol) : []);
const destacados = ['/panel/presupuestos-cliente/nuevo', '/panel/facturas/nueva', '/panel/gastos/nuevo', '/panel/pedidos/nuevo', '/panel/portafolio/nuevo'].map((href) => crear.find((c) => c.href === href)).filter((c): c is (typeof crear)[number] => !!c);
const proyectos = ver.presupuestos ? presupuestos.filter((p) => p.estado === 'aceptado' && !p.cobroResto).slice(0, 3) : [];
const verSimulador = rutaDisponible('/panel/simulador');

const eur = dinero;
const valor = (k: { valor: number | null; formato: 'euros' | 'porcentaje' }) => (k.valor === null ? '—' : k.formato === 'euros' ? eur(k.valor) : `${k.valor}\u00a0%`);
const ahora = new Date();
const hora = Number(ahora.toLocaleString('es-ES', { hour: 'numeric', hour12: false, timeZone: 'Europe/Madrid' }));
const nombre = (s?.usuario.nombre || '').split(' ')[0];
---

<div class="nv-inicio nv-estudio">
  <div class="nv-estudio-movil-titulo"><p>{saludo(hora)}{nombre ? `, ${nombre}` : ''}</p><h1>Creaciones Turia</h1></div>
  <header class="nv-estudio-hero">
    <div class="nv-estudio-bienvenida">
      <p class="nv-estudio-saludo">{saludo(hora)}{nombre ? `, ${nombre}` : ''}</p>
      <h1>Creaciones Turia</h1>
      <p>Carpintería a medida y proyectos singulares</p>
    </div>
  </header>
  {destacados.length > 0 && <section class="nv-estudio-crear" aria-label="Accesos rápidos">
    <ul role="list">{destacados.map((c) => <li><a class="nv-estudio-atajo" href={c.href}><Icono nombre={c.icono} clase="size-7" /><strong>{c.texto}</strong></a></li>)}</ul>
  </section>}
  <div class="nv-estudio-grid">
    <section class="nv-tarjeta nv-estudio-resumen" aria-labelledby="nv-estudio-resumen-titulo">
      <div class="nv-cabeza-tarjeta"><h2 id="nv-estudio-resumen-titulo">Resumen del negocio</h2><span class="nv-estudio-periodo">{mes.etiqueta}</span></div>
      {indicadores.length ? <><ul class="nv-estudio-metricas" role="list">{indicadores.map((k) => <li><a href={k.href} class="nv-estudio-metrica"><span>{k.nombre}</span><strong class="nv-cifra">{valor(k)}</strong><small>{k.nota}</small></a></li>)}</ul>{indicadores.length > 1 && <details class="nv-estudio-mas-metricas"><summary>Ver los otros indicadores</summary><ul role="list">{indicadores.slice(1).map((k) => <li><a href={k.href} class="nv-estudio-metrica"><span>{k.nombre}</span><strong class="nv-cifra">{valor(k)}</strong><small>{k.nota}</small></a></li>)}</ul></details>}</> : <p>Los indicadores aparecerán cuando haya datos y permisos para consultarlos.</p>}
      {meses.length > 0 && <div class="nv-estudio-grafico">
        <div class="nv-estudio-grafico-titulo"><strong>Facturado sin IVA</strong><span>Últimos 6 meses</span></div>
        {maximo > 0 ? <svg class="nv-estudio-linea" viewBox="0 0 600 96" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="relleno-inicio" x1="0" x2="0" y1="0" y2="1"><stop stop-color="#799262" stop-opacity=".32"/><stop offset="1" stop-color="#799262" stop-opacity=".02"/></linearGradient></defs><path d={`M0 96 L${meses.map((m,i)=>`${i*120} ${Math.round(84-(m.base / maximo)*72)}`).join(' L')} L600 96 Z`} fill="url(#relleno-inicio)"/><polyline points={meses.map((m,i)=>`${i*120},${Math.round(84-(m.base / maximo)*72)}`).join(' ')} fill="none" stroke="#526f42" stroke-width="2" vector-effect="non-scaling-stroke"/></svg> : <p class="nv-estudio-sin-grafica">Todavía no hay facturas emitidas en este período.</p>}
        <details><summary>Valores por mes</summary><ul>{meses.map((m)=><li>{m.etiqueta}: {eur(m.base)}</li>)}</ul></details>
        {ver.informes && <a href="/panel/informes" class="enlace-panel">Ver informes</a>}
      </div>}
    </section>
    <section class="nv-tarjeta nv-estudio-proyectos" aria-labelledby="nv-estudio-proyectos-titulo">
      <div class="nv-cabeza-tarjeta"><h2 id="nv-estudio-proyectos-titulo">Proyectos en curso</h2>{ver.presupuestos && <a href="/panel/presupuestos-cliente?ver=aceptados">Ver todos</a>}</div>
      {proyectos.length ? <ul class="nv-estudio-lista" role="list">{proyectos.map((p)=><li><a href={`/panel/presupuestos-cliente/${p.id}`}><span class="nv-estudio-proyecto-icono" aria-hidden="true"><Icono nombre="presupuestos" /></span><span><strong>{p.concepto}</strong><small>{p.cliente.nombre} · {p.facturaId ? 'Factura final preparada' : p.facturaAnticipoId ? 'Anticipo preparado' : 'Presupuesto aceptado'}</small></span><span aria-hidden="true">›</span></a></li>)}</ul> : <p class="nv-estudio-vacio">Aún no hay presupuestos aceptados pendientes de terminar. <a href="/panel/presupuestos-cliente">Ver presupuestos</a></p>}
    </section>
  </div>
  <section class="nv-tarjeta nv-estudio-pendientes" aria-labelledby="nv-estudio-pendientes-titulo"><div class="nv-cabeza-tarjeta"><h2 id="nv-estudio-pendientes-titulo">Por hacer</h2>{tareas.length > 0 && <span class="nv-chip">{tareas.length}</span>}</div>{tareas.length ? <ul class="nv-estudio-lista" role="list">{tareas.slice(0, 8).map((t)=><li><a href={t.href}><span class="nv-punto" aria-hidden="true"/><span><strong>{t.titulo}</strong><small>{t.detalle}</small></span><span aria-hidden="true">›</span></a></li>)}</ul> : <p>Todo al día. No hay acciones pendientes.</p>}{tareas.length > 8 && <p>Quedan {tareas.length - 8} asuntos más.</p>}</section>
  {verSimulador && <a href="/panel/simulador" class="nv-estudio-simulador"><Icono nombre="camara"/><span><strong>Simulador de reformas con IA</strong><small>Explora acabados a partir de una foto</small></span><span aria-hidden="true">›</span></a>}
</div>
