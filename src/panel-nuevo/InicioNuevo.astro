---
/**
 * Inicio con el diseño nuevo: saludo, las cifras del mes (cada una lleva a su
 * sección), «Por hacer» con un botón por cosa, lo facturado en seis meses y
 * atajos para crear. Los cálculos están en inicio.ts.
 */
import taller from './assets/taller.webp?inline';
import Icono from '../components/panel/ui/Icono.astro';
import { dinero } from '../server/facturas/importes.ts';
import { hoy } from '../server/gastos/gastos.ts';
import { periodoAnterior, periodoDe, evolucionMensual } from '../server/informes/informes.ts';
import { menuDe } from '../server/panel/navegacion.ts';
import { sesionCon } from '../server/panel/pagina.ts';
import { puede } from '../server/panel/permisos.ts';
import { clienteActual, rutaDisponible } from '../plataforma/actual.ts';
import { porHacer, saludo, type DatosInicio } from './inicio.ts';
import { resumenNegocio, proyectosDe, trazado } from './resumen';

const s = sesionCon(Astro.locals);
const rol = s?.usuario.rol ?? 'editor';
const dia = hoy();
const seleccion = Astro.url.searchParams.get('periodo') === 'anterior' ? 'anterior' : 'mes';
const mes = seleccion === 'anterior' ? periodoAnterior(periodoDe('mes', dia)) : periodoDe('mes', dia);
let desde = mes;
for (let i = 0; i < 11; i++) desde = periodoAnterior(desde);
const ver = {
  facturas: puede(rol, 'facturas') && rutaDisponible('/panel/facturas'),
  presupuestos: puede(rol, 'facturas') && rutaDisponible('/panel/presupuestos-cliente'),
  gastos: puede(rol, 'gastos') && rutaDisponible('/panel/gastos'),
  informes: puede(rol, 'informes') && rutaDisponible('/panel/informes'),
};
const [facturas, gastosMes, revisar, presupuestos] = s
  ? await Promise.all([
      ver.facturas ? s.repos.facturas.listar() : [],
      ver.informes ? s.repos.gastos.listar({ estado: 'confirmado', desde: desde.desde }) : [],
      ver.gastos ? s.repos.gastos.listar({ estado: 'revisar' }).then((l) => l.length) : 0,
      ver.presupuestos ? s.repos.presupuestosCliente.listar() : [],
    ])
  : [[], [], 0, []];
// Las vencidas pueden ser de hace más de seis meses: se piden aparte.
const emitidas = ver.facturas && s ? await s.repos.facturas.listar({ estado: 'emitida' }) : [];
const idsFacturas = new Set(facturas.map(f => f.id));
const todas = [...facturas, ...emitidas.filter(f => !idsFacturas.has(f.id))];
const datos: DatosInicio = { hoy: dia, facturas: todas, gastosMes, ticketsPorRevisar: revisar, presupuestos, ver };
const tareas = porHacer(datos);
const VISIBLES = 8;
const menu = s ? menuDe(rol) : [];
const acceso = (href: string) => menu.some(m => m.href === href);
const resumen = resumenNegocio(todas, gastosMes, presupuestos, mes).filter(k => ver[k.permiso]);
const proyectos = proyectosDe(presupuestos).filter(p => !p.terminado).slice(0, 3);
const evolucion = evolucionMensual(todas, gastosMes, mes.hasta).slice(-6);
const puntos = trazado(evolucion.map(m => m.ingresos));
const atajos = [
 { href: '/panel/presupuestos-cliente/nuevo', seccion: '/panel/presupuestos-cliente', texto: 'Nuevo presupuesto', corto: 'Presupuesto', icono: 'presupuestos' as const },
 { href: '/panel/facturas/nueva', seccion: '/panel/facturas', texto: 'Nueva factura', corto: 'Factura', icono: 'facturas' as const },
 { href: '/panel/gastos/nuevo', seccion: '/panel/gastos', texto: 'Registrar gasto', corto: 'Gasto', icono: 'gastos' as const },
 { href: '/panel/pedidos/nuevo', seccion: '/panel/pedidos', texto: 'Nuevo pedido', corto: 'Pedido', icono: 'proveedores' as const },
 { href: '/panel/proyectos/nuevo', seccion: '/panel/presupuestos-cliente', texto: 'Crear proyecto', corto: 'Proyecto', icono: 'inventario' as const },
].filter(a => acceso(a.seccion));
const verSimulador = rutaDisponible('/panel/simulador');

const ahora = new Date();
const hora = Number(ahora.toLocaleString('es-ES', { hour: 'numeric', hour12: false, timeZone: 'Europe/Madrid' }));
---

<div class="nv-inicio ux-inicio">
  <section class="ux-hero" aria-labelledby="ux-bienvenida">
    <div class="ux-saludo"><p>{saludo(hora)}</p><h1 id="ux-bienvenida">{clienteActual().nombre}</h1><p class="ux-lema">Carpintería a medida y proyectos singulares</p></div>
    <img src={taller} alt="" class="ux-hero-foto" fetchpriority="high" width="1600" height="533" />
  </section>
  <nav aria-label="Acciones rápidas" class="ux-acciones">
    {atajos.map((a, i) => <a href={a.href} class:list={['ux-accion', i === 0 && 'ux-accion-principal']}><Icono nombre={a.icono}/><span class="ux-accion-larga">{a.texto}</span><span class="ux-accion-corta">{a.corto}</span></a>)}
  </nav>
  <div class="ux-cuadricula">
    {resumen.length > 0 && <section class="ux-card ux-resumen" aria-labelledby="ux-resumen-titulo">
      <div class="ux-card-cabecera"><h2 id="ux-resumen-titulo">Resumen del negocio</h2><form method="get"><label class="sr-only" for="ux-periodo">Periodo del resumen</label><select id="ux-periodo" name="periodo"><option value="mes" selected={seleccion === 'mes'}>Este mes</option><option value="anterior" selected={seleccion === 'anterior'}>Mes anterior</option></select><button type="submit" class="ux-aplicar">Ver</button></form></div>
      <p class="ux-periodo">{mes.etiqueta} · importes sin IVA, salvo cobros</p>
      <ul class="ux-metricas" id="ux-metricas" role="list">{resumen.map(k => <li><a href={k.href}><span>{k.nombre}</span><strong class="nv-cifra">{k.euros ? dinero(k.valor) : k.valor}</strong><small class:list={[k.cambio !== null && (k.nombre === 'Gastos' ? k.cambio <= 0 : k.cambio >= 0) ? 'ux-positivo' : k.cambio !== null ? 'ux-negativo' : '']} >{k.cambio === null ? 'Sin comparación previa' : `${k.cambio >= 0 ? '↑ +' : '↓ '}${k.cambio.toLocaleString('es-ES')} %`}</small></a></li>)}</ul>
      {ver.facturas && <figure class="ux-grafica"><svg viewBox="0 0 600 120" preserveAspectRatio="none" role="img" aria-label="Evolución de lo facturado sin IVA en los últimos seis meses"><defs><linearGradient id="ux-relleno" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#779561" stop-opacity=".3"/><stop offset="1" stop-color="#779561" stop-opacity="0"/></linearGradient></defs><polygon points={`0,120 ${puntos} 600,120`} fill="url(#ux-relleno)"/><polyline points={puntos} fill="none" stroke="#64804e" stroke-width="2" vector-effect="non-scaling-stroke"/></svg><figcaption>Facturado · últimos 6 meses <a href="/panel/informes">Ver informes <span aria-hidden="true">→</span></a></figcaption><ul class="sr-only">{evolucion.map(m => <li>{m.nombre}: {dinero(m.ingresos)}</li>)}</ul></figure>}
      <button type="button" class="ux-expandir-cifras" aria-expanded="false" aria-controls="ux-metricas">Ver todas las cifras</button>
    </section>}
    {ver.presupuestos && <section class="ux-card ux-proyectos" aria-labelledby="ux-proyectos-titulo">
      <div class="ux-card-cabecera"><h2 id="ux-proyectos-titulo">Proyectos en curso</h2><a href="/panel/proyectos">Ver todos <Icono nombre="siguiente" clase="size-4"/></a></div>
      <p class="ux-periodo">Hitos de presupuesto, facturación y cobro</p>
      {proyectos.length ? <ul role="list">{proyectos.map(p => <li><a class="ux-proyecto" href={`/panel/presupuestos-cliente/${p.id}`}><span class="ux-proyecto-icono"><Icono nombre="inventario"/></span><span class="ux-proyecto-datos"><strong>{p.concepto} · {p.cliente.nombre}</strong><span class="ux-progreso"><progress max="100" value={p.avance} aria-label={`Avance administrativo: ${p.concepto}`}/><span>{p.avance} %</span></span><small>{p.etapa}</small></span><Icono nombre="siguiente" clase="size-4"/></a></li>)}</ul> : <div class="ux-vacio"><Icono nombre="inventario"/><p><strong>Tu próximo proyecto empieza aquí</strong><span>Al aceptar un presupuesto, podrás seguir aquí su facturación y cobros.</span></p><a href="/panel/proyectos/nuevo" class="nv-boton nv-boton-secundario">Crear proyecto</a></div>}
    </section>}
  </div>
  <section class="ux-card ux-pendientes" id="nv-por-hacer" aria-labelledby="nv-pendientes-titulo">
    <div class="ux-card-cabecera"><h2 id="nv-pendientes-titulo">Por hacer</h2><span class="nv-chip">{tareas.length}</span></div>
    {tareas.length ? <ul role="list">{tareas.slice(0,VISIBLES).map(t => <li class="nv-tarea"><span class:list={['nv-punto', `nv-punto-${t.color}`]} aria-hidden="true"/><span class="nv-tarea-texto"><strong>{t.titulo}</strong><span>{t.detalle}</span></span><a class="nv-boton nv-boton-secundario" href={t.href}>{t.accion}<span class="sr-only">: {t.titulo}</span></a></li>)}</ul> : <p class="ux-todo-dia"><Icono nombre="hecho"/>Todo al día. Aquí aparecerán tus próximos cobros y tareas pendientes.</p>}
    {tareas.length > VISIBLES && <p class="nv-mas">Y {tareas.length - VISIBLES} más. Resuelve estas primero.</p>}
  </section>
  {verSimulador && <a href="/panel/simulador" class="ux-asistente-enlace"><Icono nombre="camara"/><span><strong>Da forma a la próxima idea</strong><span>Prueba acabados con el simulador de reformas</span></span><Icono nombre="siguiente"/></a>}
</div>
<script is:inline>
  const periodo = document.querySelector('#ux-periodo');
  periodo?.addEventListener('change', () => periodo.form?.requestSubmit());
  const expandir = document.querySelector('.ux-expandir-cifras');
  expandir?.addEventListener('click', () => {
    const abierto = expandir.getAttribute('aria-expanded') !== 'true';
    expandir.setAttribute('aria-expanded', String(abierto));
    document.querySelector('.ux-resumen')?.classList.toggle('ux-cifras-abiertas', abierto);
    expandir.textContent = abierto ? 'Ver menos cifras' : 'Ver todas las cifras';
  });
</script>
