---
/**
 * Plantilla del panel interno: letra grande, mucho contraste, una tarea por
 * pantalla y nada de la cabecera ni el pie de la web pública.
 */
import '../styles/global.css';
import { Font } from 'astro:assets';
import { tp } from '../i18n/panel';
import { menuDe, seccionActual } from '../server/panel/navegacion.ts';

interface Props {
  titulo: string;
  /** Enlace "volver" (por defecto, al inicio del panel). `false` en el inicio. */
  volver?: string | false;
}

const { titulo, volver = '/panel' } = Astro.props;
const sesion = Astro.locals.panel;
const usuario = sesion?.estado === 'ok' ? sesion.usuario : null;
const menu = usuario ? menuDe(usuario.rol) : [];
const actual = seccionActual(Astro.url.pathname, menu);
// El enlace "volver" sobra si lleva a la sección que ya está en el menú.
const mostrarVolver = volver && volver !== '/panel' && volver !== actual;
---

<html lang="es" class="sin-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · {tp.tituloPanel}</title>
    <script is:inline>
      document.documentElement.classList.remove('sin-js');
      // Tras guardar, la página llega con un aviso de un solo uso (?hecho, ?resultado):
      // se quita de la URL para que recargar no lo repita y, al ir atrás, se salta el
      // formulario ya enviado en lugar de volver a mostrarlo.
      (() => {
        const CLAVE = 'panel:enviado';
        const UNA_VEZ = ['hecho', 'resultado', 'n'];
        try {
          const u = new URL(location.href);
          const nav = performance.getEntriesByType('navigation')[0];
          if (nav && nav.type === 'back_forward' && sessionStorage.getItem(CLAVE) === location.pathname) {
            sessionStorage.removeItem(CLAVE);
            history.back();
            return;
          }
          if (sessionStorage.getItem(CLAVE) === location.pathname) sessionStorage.removeItem(CLAVE);
          if (UNA_VEZ.some((p) => u.searchParams.has(p))) {
            const r = document.referrer ? new URL(document.referrer) : null;
            if (r && r.origin === location.origin) sessionStorage.setItem(CLAVE, r.pathname);
            UNA_VEZ.forEach((p) => u.searchParams.delete(p));
            history.replaceState(history.state, '', u.pathname + u.search + u.hash);
          }
        } catch {
          // Sin sessionStorage o historial, el panel funciona igual.
        }
      })();
    </script>
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-dm-sans" />
  </head>
  <body class="panel min-h-dvh text-lg">
    <a href="#principal" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-tarjeta focus:bg-papel focus:p-3">{tp.saltar}</a>
    <header class="superficie-oliva">
      <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 px-4 py-3">
        <a href="/panel" class="inline-flex min-h-12 items-center font-titular text-xl font-bold text-crema no-underline">{tp.tituloPanel}</a>
        {
          usuario && (
            <a href="/cdn-cgi/access/logout" class="boton-panel boton-panel-claro">
              {tp.salir}
            </a>
          )
        }
      </div>
      {
        menu.length > 1 && (
          <nav aria-label={tp.menu} class="menu-panel border-t border-crema/20">
            <ul class="mx-auto flex max-w-3xl gap-1 overflow-x-auto px-2" role="list">
              {menu.map((s) => (
                <li class="shrink-0">
                  <a href={s.href} aria-current={s.href === actual ? 'page' : undefined} class="menu-panel-enlace">
                    {s.texto}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </header>
    <main id="principal" class="mx-auto max-w-3xl px-4 pt-6 pb-16">
      {
        mostrarVolver && (
          <p class="mb-4">
            <a href={volver} class="enlace-panel">
              ← {tp.volver}
            </a>
          </p>
        )
      }
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* El panel es una herramienta: sin transiciones entre páginas (al enviar formularios
     o ir atrás daban la sensación de que la página se quedaba a medias). */
  @view-transition {
    navigation: none;
  }
  .menu-panel-enlace {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    padding: 0 0.875rem;
    font-weight: 600;
    color: var(--color-crema);
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  .menu-panel-enlace:hover {
    text-decoration: underline;
  }
  .menu-panel-enlace[aria-current='page'] {
    border-bottom-color: var(--color-crema);
  }
  /* Controles del panel: al menos 48 px de alto y foco bien visible. */
  .boton-panel {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius-tarjeta);
    padding: 0.625rem 1.25rem;
    font-weight: 600;
    text-decoration: none;
    background: var(--color-terracota);
    color: #fff;
  }
  .boton-panel-secundario {
    background: var(--color-papel);
    color: var(--color-tinta);
    border: 2px solid var(--color-oliva);
  }
  .boton-panel-claro {
    background: var(--color-crema);
    color: var(--color-oliva);
  }
  .enlace-panel {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    font-weight: 600;
    color: var(--color-oliva);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .campo-panel {
    min-height: 3rem;
    width: 100%;
    border: 2px solid var(--color-gris);
    border-radius: 0.5rem;
    background: var(--color-papel);
    padding: 0.5rem 0.75rem;
    font-size: 1.125rem;
  }
</style>
