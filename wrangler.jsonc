{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Nombre del Worker en Cloudflare. Si lo cambias, cámbialo también en el panel.
  "name": "viveros-baltaretu",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Rutas que siempre ejecutan el Worker. Sin esto, las navegaciones del navegador
    // (incluido enviar un formulario sin JavaScript) reciben la 404 estática.
    "run_worker_first": ["/api/*", "/keystatic", "/keystatic/*", "/panel", "/panel/*"]
  },
  // Envío de avisos de presupuesto con Cloudflare Email Service. Sin restricciones
  // en el binding: el plan gratuito solo permite enviar a direcciones de destino
  // verificadas en Email Routing (EMAIL_DESTINO).
  "send_email": [{ "name": "EMAIL" }],
  // Base de datos del panel propio (contenido, fotos, presupuestos). Las tablas las crea el Worker.
  "d1_databases": [{ "binding": "DB", "database_name": "viveros-baltaretu", "database_id": "6b9bb52c-f194-405d-ac4a-86bb6370cb35" }],
  // Conserva las variables y secretos definidos en el panel de Cloudflare
  // (EMAIL_DESTINO, EMAIL_REMITENTE, TURNSTILE_SECRET_KEY) al desplegar.
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  // Entorno local (CLOUDFLARE_ENV=desarrollo): `npm run dev`, tests y e2e con D1 en
  // modo local de wrangler, sin tocar recursos reales.
  "env": {
    "desarrollo": {
      "send_email": [{ "name": "EMAIL" }],
      // Entrar al panel sin Access, solo desde localhost (ver src/server/panel/acceso.ts).
      "vars": { "PANEL_PRUEBA_EMAIL": "propietario@example.com", "PROPIETARIO_EMAIL": "propietario@example.com" },
      "d1_databases": [{ "binding": "DB", "database_name": "viveros-baltaretu-local", "database_id": "00000000-0000-0000-0000-000000000000" }]
    }
  }
}
