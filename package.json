{
  "name": "viveros-baltaretu",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "wrangler types --include-runtime=false && astro dev",
    "build": "tsx scripts/contenido/descargar.ts && astro build",
    "preview": "astro preview",
    "types": "wrangler types --include-runtime=false",
    "check": "astro check",
    "lint": "wrangler types --include-runtime=false && eslint . && astro check",
    "test": "vitest run",
    "check:worker": "wrangler deploy --dry-run",
    "astro": "astro",
    "test:e2e": "playwright test",
    "contenido:importar": "tsx scripts/contenido/importar.ts",
    "contenido:equivalencia": "tsx scripts/contenido/equivalencia.ts && WORKERS_CI_BRANCH=pruebas tsx scripts/contenido/equivalencia.ts",
    "contenido:copia": "tsx scripts/contenido/copia.ts",
    "contenido:restaurar": "tsx scripts/contenido/restaurar.ts",
    "asistente:banco": "tsx scripts/asistente-banco.ts",
    "desplegar": "tsx scripts/contenido/desplegar.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.61",
    "@astrojs/cloudflare": "^14.3.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.141",
    "astro": "^7.3.6",
    "jose": "^6.2.12",
    "lucide-static": "^0.545.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3",
    "workers-ai-provider": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0",
    "yaml": "^2.9.1"
  }
}
